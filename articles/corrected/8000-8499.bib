Month = {DEC},
Note = {31st Symposium on Nuclear Physics, Cocoyoc, MEXICO, JAN 07-10, 2008},
Abstract = {A Detrended Fluctuation Analysis (DFA) method is applied to investigate
   the scaling properties of the energy fluctuations in the spectrum of
   Ca-48 obtained with (a) a large realistic shell model calculation
   (ANTOINE code) and (b) with a random shell model (TBRE) calculation. We
   compare the scale invariant properties of the energy fluctuations with
   similar analyses applied to the RMT ensembles GOE and GDE. A comparison
   with the related power spectra calculations is made. The possible
   consequences of these results are discussed.},
