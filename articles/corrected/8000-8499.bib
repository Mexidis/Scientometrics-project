Year = {2009},
Volume = {39},
Number = {6},
Pages = {1767-1779},
Abstract = {If we consider the 4-dimensional vector space of quasi-homogeneous maps
   in two variables of weights (1/3, 1/6) and degree 1, we get two
   1-parameter families f(epsilon)(x,y) = x(3) + (epsilon + 1)x(2)y(2) +
   epsilon xy(4) amd g(epsilon)(x,y) = x(3) + epsilon x(2)y(2) + xy(4) +
   epsilon y(6). We are interested in comparing the usual finite
   determination with a suitable group of diffeomorphisms. We prove
   analogous theorems of finite determination for such group. This work is
   a continuation of {[}3].},
