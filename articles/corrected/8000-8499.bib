@article{ WOS:000266776700007,
Author = {Greeney, Harold F. and Warren, Andrew D.},
Title = {The life history and shelter building behavior of Vettius coryna
   coryna Hewitson, 1866 in eastern Ecuador (Lepidoptera: Hesperiidae:
   Hesperiinae)},
Journal = {JOURNAL OF INSECT SCIENCE},
Year = {2009},
Volume = {9},
Month = {JUN 2},
Abstract = {We describe all life-stages of Vettius coryna coryna Hewitson, 1866 in
   eastern Ecuador. The details of larval shelter structure and associated
