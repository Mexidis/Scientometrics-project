Title = {Transition to irreversibility in sheared suspensions},
Booktitle = {IV MEXICAN MEETING ON MATHEMATICAL AND EXPERIMENTAL PHYSICS:
   RELATIVISTIC FLUIDS AND BIOLOGICAL PHYSICS},
Series = {AIP Conference Proceedings},
Year = {2010},
Volume = {1312},
Pages = {114+},
Note = {4th Mexican Meeting on Mathematical and Experimental Physics, Colegio
   Nacl, Mexico City, MEXICO, JUL 19-23, 2010},
Organization = {Univ Autonoma Metropolitana; Colegio Nacl; CONACYT; DAAD; CINVESTAV IPN},
Abstract = {The transition to irreversibility observed in experiments with
   suspensions of non-Brownian particles subjected to an oscillatory shear
   flow is explained by using the Gibbs entropy and the second law of
   thermodynamics. We show that the origin of the transition to
   irreversibility is the coupling between diffusion and inertial forces
   associated to the existence of a velocity gradient in the system. This
   coupling is characterizad by an Onsager coefficient and is responsible
   for the breakdown of the fluctuation-dissipation theorem. Using lattice
   Boltzmann simulations we characterize the transition through the power
   spectra of particle trajectories.},
