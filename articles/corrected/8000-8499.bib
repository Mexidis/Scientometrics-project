@article{ WOS:000274333100022,
Author = {Lopez-Valenzuela, R. and Lopez-Palacios, J. A. and Jimenez-Reyes, M. and
   Catano, G. and Tenorio, D.},
Title = {Characterization of ceramic ornaments of a theatre-like incense burner},
Journal = {JOURNAL OF RADIOANALYTICAL AND NUCLEAR CHEMISTRY},
Year = {2010},
Volume = {283},
Number = {3},
Pages = {675-681},
Month = {MAR},
Abstract = {Thirteen Teotihuacan-style ornaments of an incense burner were studied.
   Ceramic pastes, pigments and mica were analyzed by neutron activation,
   X-ray diffraction and scanning electron microscopy. Elemental (Sc, Cr,
   Fe, Co, Rb, Cs, La, Ce, Nd, Sm, Eu, Tb, Yb, Lu, Hf, Th and U) and
   statistical analyses of ceramic-body data showed that these pieces were
   made from the same raw material, which is chemically different from the
   fine orange ceramic of Teotihuacan. Montmorillonite and the classical
   components of sand were the minerals identified in the ceramic pastes.
   The white pigment contained calcium, titanium and aluminium, the yellow
   pigment was ocher, and the red pigment was a mixture of red ocher and
   cinnabar, the binder of the pigments being clay. Exoskeletons of diatoms
   and locust ootecs were found in the pigments. Mica was identified as
   biotite, identical with that coming from Monte Alban Oaxaca. We wish to
   undertake a historical reconstrution of these ornaments based on
   archaeometric and literature data.},
