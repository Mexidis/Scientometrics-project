Booktitle = {PROCEEDINGS OF THE 20TH INTERNATIONAL WORKSHOP ON DATABASE AND EXPERT
   SYSTEMS APPLICATION},
Year = {2009},
Pages = {181+},
Note = {20th International Conference on Database and Expert Systems
   Applications, Linz, AUSTRIA, AUG 31-SEP 04, 2009},
Organization = {DEXA Assoc; Austria Comp Soc; Res Inst Appl Knowledge Proc; Johannes
   Kepler Univ Linz},
Abstract = {Many applications process or transform a stream of data. Such
   applications are organized as a sequence of different stages, which may
   be independent enough to be simultaneously carried out. The original
   Pipes and Filters pattern and the Parallel Pipes and Filters pattern
   describe those actions. We present here the Secure Pipes and Filters
   pattern as a secure version of the original patterns, which contains a
   minimal set of security mechanisms to provide a set of basic security
   functions. The Secure Pipes and Filters pattern includes ways to add
   security controls at each stage of processing, controlling that only
   predefined operations are applied to data streams, as well as securing
   data movement.},
