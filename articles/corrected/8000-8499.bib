Title = {Absolute Differential and Total Cross Sections for the Production of
   Neutral Fragments from Dissociative Collisions of Triatomic Hydrogen
   Like Ions in He},
Booktitle = {APPLICATION OF ACCELERATORS IN RESEARCH AND INDUSTRY},
Series = {AIP Conference Proceedings},
Year = {2009},
Volume = {1099},
Pages = {188+},
Note = {20th International Conference on Application of Accelerators in Research
   and Industry, Ft Worth, TX, AUG 10-15, 2008},
Organization = {Univ N Texas; Sandia Natl Lab},
Abstract = {Neutral products from dissociative collisions of triatomic hydrogen like
   ions incident on He atoms were studied. Absolute differential and total
   cross sections are reported in the energy range of 1.25 and 5.00 keV for
   scattering angles between -5 degrees and 5 degrees. The differential
   cross sections have a decreasing behavior with a slight structure around
   2.0 degrees. The total cross sections show no dependence on the
   projectile mass at equal velocity. The cross sections are between 4 x
   10(-17) cm(2) and 2 x 10(-16) cm(2). A polynomial fit of fourth order
   was adjusted to the data indicating a maximum at 3.5 keV/amu, and
   showing an agreement with a previous work for H-3(+) at high energies.},
