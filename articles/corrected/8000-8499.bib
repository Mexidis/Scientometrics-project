@inproceedings{ WOS:000270976800002,
Author = {Lazcano, A.},
Editor = {Maurel, MC and Gerin, M},
Title = {Complexity, self-organization and the origin of life: The happy liaison?},
Booktitle = {ORIGINS OF LIFE: SELF-ORGANIZATION AND/OR BIOLOGICAL EVOLUTION?},
Year = {2009},
Pages = {13-22},
Note = {Workshop on Origins of Life: Self-Organization and/or Biological
   Evolution, Ecole Normale Superieure, Paris, FRANCE, OCT 03, 2008},
Organization = {CNRS},
Abstract = {The spontaneous assembly of amphiphiles into micelles and bilayer
   membranes, as well as the dynamical self-assembly properties of nucleic
   acids, suggest that self-organization phenomena played a role in the
   origin of life. However, current biology indicates that life could have
   not evolved in the absence of a genetic replicating mechanism insuring
   the stability and diversification of its basic components. This does not
   imply that explanations on the appearance of life should reduce
   themselves to the issue of the emergence of RNA or its predecessors.},
