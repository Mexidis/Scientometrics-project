@article{ WOS:000272641100023,
Author = {Rivera, Juan and Miramontes, Pedro and Mendez, Fausto and Pinero, Daniel},
Title = {Is it possible to characterize the phenotypic space from the
   relationship among the elements of a body plan? A systemic analysis in
   the lizard Uta stansburiana},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2009},
Volume = {80},
Number = {3},
Pages = {807-816},
Month = {DEC},
Abstract = {Quantitative relationships among the elements of the body plan of Uta
   stansburiana were analyzed to evaluate their influence on the structure
   and limits of its phenotypic space. A methodology based on conceiving
   organisms as systems was developed. The relations among the elements of
   the body plan are described by a system of simultaneous equations (SES)
   of the type x(i) = mx(j) + b, where x(i) and x(j) are morphometric
   variables, and in and b are constants. This system was employed to
   simulate the phenotypic variation of U. stansburiana and to characterize
   its phenotypic space. The results indicate that the structure and limits
   of the phenotypic space of a taxon are emergent properties of the system
   that constitutes the body plan. These properties can be considered
   internal constraints, which act jointly with natural selection
   generating discontinuous phenotypic spaces. In this paper we propose a
   methodology that defines and analyzes with a systemic approach the
   phenotypic space of a taxon. This may be useful for proposing and
   testing hypothesis related with the causal factors of this space.},
Publisher = {INST BIOLOGIA, UNIV NACIONAL AUTONOMA MEXICO},
Address = {APARTADO POSTAL 70-233, MEXICO, D F 00000, MEXICO},
Type = {Article},
Language = {Spanish},
Affiliation = {Rivera, J (Corresponding Author), Univ Nacl Autonoma Mexico, Inst Ecol, Dept Ecol Evolut, Apartado Postal 70-275, Mexico City 04510, DF, Mexico.
   Rivera, Juan; Pinero, Daniel, Univ Nacl Autonoma Mexico, Inst Ecol, Dept Ecol Evolut, Mexico City 04510, DF, Mexico.
   Miramontes, Pedro, Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Matemat, Mexico City 04510, DF, Mexico.
   Mendez, Fausto, Univ Nacl Autonoma Mexico, Inst Biol, Lab Herpetol, Mexico City 04510, DF, Mexico.},
ISSN = {1870-3453},
Keywords = {morphological variability; internal constraints; systemic morphometry;
   Uta stansburiana},
Keywords-Plus = {THEORETICAL MORPHOLOGY; CONSTRAINTS; EVOLUTION},
