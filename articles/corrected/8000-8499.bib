@article{ WOS:000277618800050,
Author = {Sinervo, Barry and Mendez-de-la-Cruz, Fausto and Miles, Donald B. and
   Heulin, Benoit and Bastiaans, Elizabeth and Villagran-Santa Cruz,
   Maricela and Lara-Resendiz, Rafael and Martinez-Mendez, Norberto and
   Lucia Calderon-Espinosa, Martha and Nelsi Meza-Lazaro, Rubi and Gadsden,
   Hector and Javier Avila, Luciano and Morando, Mariana and De la Riva,
   Ignacio J. and Victoriano Sepulveda, Pedro and Duarte Rocha, Carlos
   Frederico and Ibargueengoytia, Nora and Aguilar Puntriano, Cesar and
   Massot, Manuel and Lepetz, Virginie and Oksanen, Tuula A. and Chapple,
   David G. and Bauer, Aaron M. and Branch, William R. and Clobert, Jean
   and Sites, Jr., Jack W.},
Title = {Erosion of Lizard Diversity by Climate Change and Altered Thermal Niches},
Journal = {SCIENCE},
Year = {2010},
Volume = {328},
Number = {5980},
Pages = {894-899},
Month = {MAY 14},
Abstract = {It is predicted that climate change will cause species extinctions and
   distributional shifts in coming decades, but data to validate these
   predictions are relatively scarce. Here, we compare recent and
   historical surveys for 48 Mexican lizard species at 200 sites. Since
   1975, 12\% of local populations have gone extinct. We verified
   physiological models of extinction risk with observed local extinctions
   and extended projections worldwide. Since 1975, we estimate that 4\% of
   local populations have gone extinct worldwide, but by 2080 local
   extinctions are projected to reach 39\% worldwide, and species
   extinctions may reach 20\%. Global extinction projections were validated
   with local extinctions observed from 1975 to 2009 for regional biotas on
   four other continents, suggesting that lizards have already crossed a
   threshold for extinctions caused by climate change.},
