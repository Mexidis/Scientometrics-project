Year = {2010},
Volume = {55},
Number = {4},
Pages = {407-416},
Abstract = {In this article, we use quasi-conformal surgery to construct examples of
   meromorphic functions with k-nested, k is an element of N, doubly
   connected wandering domains W(j), 1 <= j <= k, in the Fatou set. These
   functions have at least one pole which is not omitted and either one or
   more essential singularities. Moreover, the nested doubly connected
   wandering domains W(j) contain a simply connected wandering domain which
   lies in the bounded component of W(k)(c).},
