Pages = {1538-1550},
Month = {AUG},
Abstract = {We establish the regular variation of the finite dimensional
   distributions of the multivariate GARCH(p, q) process with constant
   conditional correlations under mild assumptions on the noise
   distribution. We use this property for two main purposes: First, to
   describe the componentwise-maximum domain of attraction in which the
   process lies; and second, to relate the asymptotic behavior of the
   sample autocovariance function of the process to its regular variation
   index. (c) 2009 Elsevier Inc. All rights reserved.},
