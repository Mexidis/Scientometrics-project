@article{ WOS:000267895200005,
Author = {Cruz-Pacheco, Gustavo and Esteva, Lourdes and Vargas, Cristobal},
Title = {Seasonality and Outbreaks in West Nile Virus Infection},
Journal = {BULLETIN OF MATHEMATICAL BIOLOGY},
Year = {2009},
Volume = {71},
Number = {6},
Pages = {1378-1393},
Month = {AUG},
Abstract = {In this paper we analyze the impact of seasonal variations on the
   dynamics of West Nile Virus infection. We are interested in the
   generation of new epidemic peaks starting from an endemic state. In many
   cases, the oscillations generated by seasonality in the dynamics of the
   infection are too small to be observable. The interplay of this
   seasonality with the epidemic oscillations can generate new outbreaks
   starting from the endemic state through a mechanism of parametric
   resonance. Using experimental data we present specific cases where this
   phenomenon is numerically observed.},
