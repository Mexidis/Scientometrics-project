@article{ WOS:000265153800010,
Author = {Suarez, M. A. and Lara, A. G. and Sanchez-Arevalo, F. M. and Aluarez, O.
   and Colin, J. and Juarez-Islas, J. A.},
Title = {Prediction and characterization of growth temperatures in Al-Zn-Mg
   alloys},
Journal = {MATERIALS CHARACTERIZATION},
Year = {2009},
Volume = {60},
Number = {5},
Pages = {420-424},
Month = {MAY},
Abstract = {Growth temperatures of alpha-Al, intermetallic tau and eutectic
   alpha+tau phases in Al-12 wt.\% Zn 6 wt.\% Mg alloy has been determined
   as a function of growth velocity in the range of 3 x 10(-5) to 1 x
   10(-3) m/s at a temperature gradient of 2500 K/m, using a directional
