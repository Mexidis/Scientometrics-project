@article{ WOS:000259519600009,
Author = {Calas, H. and Otero, J. A. and Rodriguez-Ramos, R. and Monsivais, G. and
   Stern, C.},
Title = {Dispersion relations for SH wave in magneto-electro-elastic
   heterostructures},
Journal = {INTERNATIONAL JOURNAL OF SOLIDS AND STRUCTURES},
Year = {2008},
Volume = {45},
Number = {20},
Pages = {5356-5367},
Month = {OCT 1},
Abstract = {In the present work the dispersion relations of stationary SH waves in a
   heteroestructure with magneto-electro-elastic properties have been
