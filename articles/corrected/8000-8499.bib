@article{ WOS:000261564100017,
Author = {Austin, George T. and Warren, Andrew D. and Mielke, Olaf H. H.},
Title = {VARIATION OF COPAEODES MINIMA AND THE STATUS OF COPAEODES
   RAYATA (LEPIDOPTERA: HESPERIIDAE: HESPERIINAE)},
Journal = {FLORIDA ENTOMOLOGIST},
Year = {2008},
Volume = {91},
Number = {4},
Pages = {636-642},
Month = {DEC},
Abstract = {Examination of more than 600 specimens of Copaeodes minima (W. H.
   Edwards, 1870) (Hesperiidae: Hesperiinae) indicated phenotypic variation
   throughout its distribution. A dark form occurs in response to low
   temperatures during development. Its genitalia do not vary
   concomitantly. Both C. minima and its synonym, Copaeodes rayata Barnes
   \& McDunnough, 1913, were described from the pale form of the species. A
   lectotype is designated for Copaeodes rayata.},
