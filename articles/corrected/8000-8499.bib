@article{ WOS:000255897100006,
Author = {Cortez, Jeronimo and Mena Marugan, Guillermo A. and Velhinho, Jose M.},
Title = {Uniqueness of the Fock representation of the Gowdy
   S1xS2 and S3
   models},
Journal = {CLASSICAL AND QUANTUM GRAVITY},
Year = {2008},
Volume = {25},
Number = {10},
Month = {MAY 21},
Abstract = {After a suitable gauge fixing, the local gravitational degrees of
   freedom of the Gowdy S-1 x S-2 and S-3 cosmologies are encoded in an
   axisymmetric field on the sphere S-2. Recently, it has been shown that a
   standard field parametrization of these reduced models admits no Fock
   quantization with a unitary dynamics. This lack of unitarity is
   surpassed by a convenient redefinition of the field and the choice of an
   adequate complex structure. The result is a Fock quantization where both
   the dynamics and the SO( 3)- symmetries of the field equations are
   unitarily implemented. The present work proves that this Fock
   representation is in fact unique inasmuch as, up to equivalence, there
   exists no other possible choice of SO( 3)- invariant complex structure
   leading to a unitary implementation of the time evolution.},
Publisher = {IOP PUBLISHING LTD},
Address = {TEMPLE CIRCUS, TEMPLE WAY, BRISTOL BS1 6BE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Cortez, J (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Fis, A Postal 50-542, Mexico City 04510, DF, Mexico.
   Cortez, Jeronimo, Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Fis, A Postal 50-542, Mexico City 04510, DF, Mexico.
   Mena Marugan, Guillermo A., CSIC, Inst Estructura Mat, E-28006 Madrid, Spain.
   Velhinho, Jose M., Univ Beira Interior, Dept Fis, P-6201001 Covilha, Portugal.},
