@article{ WOS:000271345500018,
Author = {Maldonado, Carlos and Cuzon, Gerard and Guzman, Emilio and Brito,
   Roberto and Soto, Luis and Arena, Leticia and Gaxiola, Gabriela},
Title = {Effect of an herbivorous diet on energy balance of Litopenaeus
   vannamei at selected ontogenetic stages},
Journal = {AQUACULTURE},
Year = {2009},
