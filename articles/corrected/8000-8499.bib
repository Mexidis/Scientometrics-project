   Soria-Castro, Elizabeth, Inst Nacl Cardiol Ignacio Chavez, Dept Patol, Mexico City, DF, Mexico.},
DOI = {10.1016/j.anireprosci.2010.04.008},
ISSN = {0378-4320},
EISSN = {1873-2232},
Keywords = {Leydig cell; Testis; Chicken; Development},
