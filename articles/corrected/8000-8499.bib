@article{ WOS:000276063400011,
Author = {Hinojosa Espinosa, Oscar and Cruz Duran, Ramiro},
Title = {Brickellia jimenezii (Asteraceae, Eupatorieae), a New Species
   from Guerrero, Mexico},
Journal = {NOVON},
Year = {2010},
Volume = {20},
Number = {1},
Pages = {43-46},
Month = {MAR},
Abstract = {The new speciea Brickellia jinenezii Hinojosa \& Cruz Duran (Asteraceae,
   Eupoatoricae) is described from Guerrero, Mexico. It belongs to the
   Barroetea A. Gray complex within Brickellia and is similar to B.
   subuligera (Schauer) B. I,. Turner. The new species presents heads with
   more florets ({[}45 to]74. to 106 vs. 30 to 50 in B. subuligera), larger
   style launches and anthers (to 3.7 mm and 2.1 min, respectively, vs. to
   2 mm and to 1.3 111111, respectively, in B. subligera), as well as
   cypselae with four well-defined ribs On each face (vs. 1101111 or two on
   the exterior face and none or one on the interior face in B. subligera).
   A key to this species complex and an illustration of the new species are
   provided.},
