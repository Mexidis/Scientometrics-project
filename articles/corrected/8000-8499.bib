@article{ WOS:000266361300013,
Author = {Michan, Layla},
Title = {Systematics' Latin American Journals and institutionalization},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2009},
Volume = {80},
Number = {1},
Pages = {105-117},
Month = {APR},
Abstract = {I undertook bibliographic analysis of 11 185 systematic papers from 414
   Latin American journals from 1976 to 2006. I present results From
   journals' general production, Country of publishing, and disciplines. I
   identify the most productive journals, their characteristics,
   development, and details regarding temporal, regional and topical (Cocus
   and taxa) coverage. Results are discussed in terms of how they
