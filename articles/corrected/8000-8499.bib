@article{ WOS:000263442100010,
Author = {Avila-Poveda, Omar Hernando and Colin-Flores, Rafael Francisco and
   Rosas, Carlos},
Title = {Gonad Development During the Early Life of Octopus maya
   (Mollusca: Cephalopoda)},
Journal = {BIOLOGICAL BULLETIN},
Year = {2009},
Volume = {216},
Number = {1},
Pages = {94-102},
Month = {FEB},
Abstract = {Gonad development during the early life of Octopus maya is described in
   terms of histological, morphometric, oocytes growth. and somatic-oocyte
   relationship data obtained from Octopus Cultured at the UMDI-UNAM., in
   Sisal, Yucatan, Mexico. This Study is the first publication oil gonad
   development during the early life of Octopus maya. A total of 83 O. maya
   specimens were used; then, sizes ranged from 6.5 to 76 mm of total
   length (TL), 4 to 28 mill of dorsal mantle length (DML), 2.5 to 20 mm of
   ventral mantle length (VML), and 0.0180 to 7.2940 g of fixed body weight
   (fBW). Animals were weighed and measured only after preservation. A loss
   of 10\% of living weight was estimated for juvenile octopuses after
   formalin preservation. The relation of length to weight (VML, DML,
   TL/fBW) pooled for both sexes had a strong positive correlation (r), as
   shown by a potential power function that was quite close to 1. Compound
   images were produced from numerous microscopic fields. The histological
   examination revealed that, 4 months after hatching, male Octopus (24.5
   mill DML and 7.2940 fBW) were in gonad stages 2 (maturing) to 3
   (mature), with spermatogonia and spermatocytes in the tubule wall and
   abundant spermatids and spermatozoa ill the central lumen of the
   seminiferous tubules, suggesting the occurrence of different phases of:
   gonad development Lit different maturity stages. In contrast, females
   (22.5 mm DML and 4.8210 g fBW) at the same time since hatching were
   immature (stage 1), with many oogonia, few oocytes, and germinal
   epithelium. This suggests that males reach maturity earlier than
   females. indicating a probable onset of maturity for males at around 4
   months of culture or 8 g of wet body weight. Our results indicate the
   possibility that the size-at-weight can be recognized early with a
   degree of certainty that allows the sexes to be separated for Culture
   purposes: but more detailed studies oil reproduction in relation to
   endocrinology and nutrition are needed.},
