@article{ WOS:000259304500004,
Author = {Horta, Julio},
Title = {Philosophical theories of history: Rudiments for the study of
   communicative phenomena},
Journal = {ANDAMIOS},
Year = {2008},
Volume = {4},
Number = {8},
Pages = {81+},
Month = {JUN},
Abstract = {The purpose of this essay is to expose an area of speculation, which is
   necessary for the social communication investigator's understanding and
