@article{ WOS:000273079900005,
Author = {Palacios-Vargas, Jose G. and Simon Benito, Jose Carlos},
Title = {Three New Species of Palmanura (Collembola: Neanuridae) from
   Latin America},
Journal = {JOURNAL OF THE KANSAS ENTOMOLOGICAL SOCIETY},
Year = {2009},
Volume = {82},
Number = {3},
Pages = {263-272},
Month = {JUL},
Abstract = {Three new species of Palmanura are described and illustrated. Palmanura
   sernaius, new species, of Colombia differs from most Palmanura species
   in having more abundant and barbulate rather than palmate chaetotaxy.
   The Mexican Palmanura goyai, new species, lacks the cephalic seta
   ``G{''} and is the biggest in the genus (1.1 mm), while Palmanura
   hieronimus, new species, presents the cephalic seta ``G,{''} has only
   one palmate seta on the dorsolateral cephalic tubercle and it is very
   small (0.55 mm). A key for the species in the genus is included.},
