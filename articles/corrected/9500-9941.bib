   Rubluo, A},
Title = {Early stages in the development of somatic embryogenesis in Mammillaria
   san-angelensis Sanchez-Mejorada (Cactaceae) a severely endangered
   species},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1998},
Volume = {62},
Number = {1-2},
Pages = {181-186},
Abstract = {Ovules of flowers in anthesis of irt vitro derived plants of Mammillaria
   san-angelensis Sanchez-Mejorada were cultured in a modified solid B5
   medium supplemented with 2,4-D (4 mg l(-1)) plus Kin (2 mg l(-1)).
   Callus was induced from the integuments of the ovules. During the first
   three months in culture, early stages of somatic embryogenesis were
   detected. Histological analysis revealed the unicellular as well as the
   multicellular origin of the proembryonic structures. The presence of
   phenols negatively affected the progress of somatic embryogenesis.},
