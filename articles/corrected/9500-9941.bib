Title = {Pathophysiology of cholesterol gallstone disease},
Journal = {ARCHIVES OF MEDICAL RESEARCH},
Year = {1996},
Volume = {27},
Number = {4},
Pages = {433-441},
Month = {WIN},
Abstract = {The purpose of the present paper is to review the current knowledge
   about cholesterol gallstone disease. It is generally accepted that the
   formation of cholesterol gallstone requires three major pathogenic
   defects, namely, supersaturation, nucleation and crystal growth as well
   as disorder of gallbladder motility. The supersaturation is necessary
   but not sufficient to explain stone formation, It has been suggested
   that nucleation is the key factor for gallstone formation. However,
   those three factors are necessary for the formation of cholesterol
   gallstones, and the presence of just one or two factors does not lead to
   stones. We also touch briefly on the results from studies performed in
   Mexico in this area.},
