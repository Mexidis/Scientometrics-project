Title = {Microfungi from Venezuela.: A new species of Brachydesmiella, a new
   combination, and new records},
Journal = {MYCOTAXON},
Year = {2003},
Volume = {85},
Pages = {211-229},
Month = {JAN-MAR},
Abstract = {Brachydesmiella eugecapiellana anam. sp. nov., found on decaying fallen
   leaves of Nectandra sp. in a cloud forest from Venezuela, is described
   and illustrated. This is characterized by navicular, ampulliform to
   narrow fusiform, rostrate, 2-3septate, verruculose, very pale brown
   conidia: Selenodriella ponmudiensis comb. nov. is proposed. Some
   microfungi are recorded from cloud forests in Venezuela.},
