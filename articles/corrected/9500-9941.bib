@article{ WOS:A1996UJ01000004,
Author = {ColladoVides, L and West, JA},
Title = {Bostrychia calliptera (Montagne) Montagne (Rhodomelaceae, Rhodophyta), a
   new record for the central Gulf of Mexico},
