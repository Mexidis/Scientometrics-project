@article{ WOS:000073050000031,
Author = {Sierra, S and Cifuentes, J},
Title = {A new species of Phyllogloea from Mexico},
Journal = {MYCOTAXON},
Year = {1998},
Volume = {66},
Pages = {501-508},
Month = {JAN-MAR},
Abstract = {Phyllogloea herrerae is proposed as a new species within the genus
   Phyllogloea Lowy. This species is characterized by the pale yellow
   coloration of its basidiomes, elongate spores and cylindrical-arcuate
   metabasidia. This last character is shared with others species from
   other genera within the Auriculariaceae and Platygloeaceae, but
   basidiome form and growth are different. This is the sixth species in
   the genus worldwide and the second one from Mexico.},
