   V.},
Title = {Testing the predictive power of nuclear mass models},
Journal = {NUCLEAR PHYSICS A},
Year = {2008},
Volume = {812},
Pages = {28-43},
Month = {NOV 1},
Abstract = {A number of tests are introduced which probe the ability of nuclear mass
   models to extrapolate. Three models are analyzed in detail: the liquid
   drop model, the liquid drop model plus empirical shell corrections and
   the Duflo-Zuker mass formula. If predicted nuclei are close to the
   fitted ones, average errors in predicted and fitted masses are similar.
   However, the challenge of predicting nuclear masses in a region
   stabilized by shell effects (e.g., the lead region) is far more
   difficult. The Duflo-Zuker mass formula emerges as a powerful predictive
   tool. (c) 2008 Elsevier B.V. All rights reserved.},
