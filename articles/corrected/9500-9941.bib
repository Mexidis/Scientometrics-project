@article{ WOS:A1996UH99100004,
Author = {Trevino, C and Mendez, F and Higuera, FJ},
Title = {Heat transfer across a vertical wall separating two fluids at different
   temperatures},
Journal = {INTERNATIONAL JOURNAL OF HEAT AND MASS TRANSFER},
Year = {1996},
Volume = {39},
Number = {11},
Pages = {2231-2241},
Month = {JUL},
Abstract = {In this paper we study the conjugate heat transfer across a vertical
   wall separating two fluids at different temperatures. We present a
   classification of the solutions of the problem in terms of two main
   parameters; epsilon, the ratio of thickness to height of the wall and
   alpha, measuring the ratio of the thermal resistance of one of the
   boundary layers to the thermal resistance of the wail. Numerical and
   asymptotic solutions are presented for all possible values of alpha. We
   show that a maximum average Nusselt number or non-dimensional overall
   heat flux is attained for values of alpha much smaller than one, but
   still large compared with epsilon(2). Copyright (C) 1996 Elsevier
   Science Ltd.},
