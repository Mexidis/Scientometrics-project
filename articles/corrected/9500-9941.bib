@inproceedings{ WOS:A1997BJ03H00108,
Author = {Chicharro, R and PeraltaFabi, R and Velasco, RM},
Editor = {Behringer, RP and Jenkins, JT},
Title = {Segregation in dry granular systems},
Booktitle = {POWDERS \& GRAINS 97},
Year = {1997},
Pages = {479-482},
Note = {3rd International Conference on Powders and Grains, DURHAM, NC, MAY
   18-23, 1997},
Organization = {US Natl Sci Fdn; NASA; USAF, Off Sci Res; Duke Univ},
Abstract = {Segregation in rotating drums is studied experimentally in two and three
   dimensions with unexpected results. In the first case, we find that the
   spatial grain distribution oscillates between uniform and segregated
   states when the drum rotates below the fluidization regime. In three
   dimensions we find the startling result that the system axially
   segregates at (very) long times, and that the previously reported
   patterns are long lived transients.},
