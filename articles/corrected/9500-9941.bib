@article{ WOS:A1994NA53400019,
Author = {MAITI, RK and DELAROSAIBARRA, M and SANDOVAL, ND},
Title = {GENOTYPIC VARIABILITY IN GLOSSY SORGHUM LINES FOR RESISTANCE TO DROUGHT,
   SALINITY AND TEMPERATURE STRESS AT THE SEEDLING STAGE},
Journal = {JOURNAL OF PLANT PHYSIOLOGY},
Year = {1994},
Volume = {143},
Number = {2},
Pages = {241-244},
Month = {FEB},
Abstract = {The evaluation and selection of glossy sorghum lines for resistance to
   drought, salinity and moderately high temperature are described. Highly
   significant differences were observed among glossy lines for different
   variables for all these stresses, and several lines have been selected
   for multiple resistance to these stresses. Higher root growth under
   saline and temperature stress in some of the glossy lines might be a
   mechanism of resistance. Therefore, the finding of genetic variability
   and high heritability of some of the resistance traits in glossy sorghum
   lines offers good scope for the selection of lines in the genetic
   improvement of sorghum in semiarid tropics.},
