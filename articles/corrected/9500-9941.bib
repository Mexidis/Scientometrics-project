@article{ WOS:000073866900001,
Author = {Tinoco-Ruiz, JG and Barrera-Sanchez, P},
Title = {Smooth and convex grid generation over general plane regions},
Journal = {MATHEMATICS AND COMPUTERS IN SIMULATION},
