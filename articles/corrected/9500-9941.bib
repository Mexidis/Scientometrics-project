@article{ WOS:A1996VV73800015,
Author = {Braun, E and Fuchs, OL and Godoy, S},
Title = {Hydrodynamic interactions in a suspension with a structured fluid .1.
   General expressions for the mobilities},
Journal = {PHYSICA A},
Year = {1996},
Volume = {233},
Number = {1-2},
Pages = {175-190},
Month = {NOV 15},
Abstract = {In this work we treat the hydrodynamic interactions between any number
   of spheres immersed in a viscous fluid that has internal structure.
   These effects are due to internal angular momentum of the fluid
   molecules. We generalize the scheme proposed by Mazur and van Saarloos,
   and obtain general expressions for the translational, rotational and
   cross mobilities for the case under treatment. The limit of a
   non-structured fluid agrees with earlier known results.},
