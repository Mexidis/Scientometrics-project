@article{ WOS:000071106600004,
Author = {Gleason, RJ and Boldu, JL and Cabrera, E and Quintanar, C and Munoz, E},
Title = {EPR measurements of the spin-Hamiltonian zero-field splitting parameters
   as a function of temperature in Mn2+-doped
   Cs2NaLaCl6},
Journal = {JOURNAL OF PHYSICS AND CHEMISTRY OF SOLIDS},
Year = {1997},
Volume = {58},
Number = {10},
Pages = {1507-1512},
Month = {OCT},
Abstract = {The spin-Hamiltonian zero-field splitting parameter b(2)(0) is measured
   as a function of temperature in Mn2+ doped Cs2NaLaCl6 single crystals
   (elpasolite type). The experiments showed that the Mn2+ ion occupies two
   different tetragonal symmetry sites in the cubic crystalline lattice of
   Cs2NaLaCl6. Both sites possess principal Zaxes along (100)
   crystallographic directions. Electron spin resonance measurements were
   made at X-band frequencies (9.2 GHz) in the temperature range from 12.8
   to 300 K. The present results are taken into account in order to
   establish a possible relation between the spin-Hamiltonian parameter
   b(2)(0) and the temperature. A tentative determination of the Debye
   temperature is derived from the experimental data. (C) 1997 Elsevier
   Science Ltd.},
