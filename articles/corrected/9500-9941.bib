Title = {SUPERCONDUCTIVITY IN A NEW SUPERSYMMETRIC SCHEME},
Journal = {PHYSICS LETTERS A},
Year = {1995},
Volume = {208},
Number = {1-2},
Pages = {113-116},
Month = {NOV 20},
Abstract = {A new pairing theory for many-fermion systems is obtained via a
   framework related to the one recently introduced to describe Dirac
   particles in external potentials. It is shown that the standard
   Bogoliubov-Valatin canonical transformation treatment of the
   quasi-particle BCS singlet pairing mechanism naturally falls within this
   framework, Straightforward generalizations in which the fermions can be
   ascribed nu components (as for example two or more copper-oxide planes
   in a cuprate superconductor) could lead to enhanced gap energies and
   critical temperatures.},
