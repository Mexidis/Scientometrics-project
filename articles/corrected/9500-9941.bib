@article{ WOS:A1996VV48200017,
Author = {Andrade, J and Trevino, C and Medina, A},
Title = {Experimental evidence of density fluctuations in two-dimensional bins},
Journal = {PHYSICS LETTERS A},
Year = {1996},
Volume = {223},
Number = {1-2},
Pages = {105-110},
Month = {NOV 25},
Abstract = {We have found experimentally the existence of random density
   fluctuations, during the discharge of monodisperse granular material
   from flat bins, which follows a 1/f(alpha) noise, where alpha similar or
   equal to 1.32 just above, and alpha similar or equal to 1.0 just below
   the exit of the bin. The corresponding rescaled range analysis for the
   fractal noise obtained just above the exit gives a Hurst parameter H
   similar or equal to 0.16, and a fractal dimension D similar or equal to
   1.84.},
