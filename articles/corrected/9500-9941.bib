Volume = {125},
Number = {12},
Pages = {3725-3733},
Month = {DEC},
Abstract = {It is shown that an analog of Whyburn's theorem saying that open
   mappings do not increase order of a point of locally compact metric
   spaces is not true if the Menger-Urysohn order is replaced by order in
   the classical sense. On the other hand, this analog is true, even for a
   wider class of confluent mappings, under an additional condition that
   the mapping is light and the domain continuum is hereditarily
   unicoherent.},
