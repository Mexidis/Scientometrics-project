@article{ WOS:A1994QC69600093,
Author = {MENDEZMORENO, RM and MORENO, M and OROZCO, S and ORTIZ, MA and DELAMORA,
   P},
Title = {QUASI-NORMAL OCCUPANCY FOR HIGH-T-C SUPERCONDUCTOR CUPRATES},
