@article{ WOS:000074800600020,
Author = {Martínez-Vázquez, M and García-Argáez, AN and Bueno, JL and Espinosa, G
   and Calderón, JS},
Title = {Two isomeric glycoside sesquiterpenes from Machaeranthera
   tanacetifolia},
Journal = {PHYTOCHEMISTRY},
Year = {1998},
Volume = {48},
Number = {7},
Pages = {1221-1224},
Month = {AUG},
Abstract = {From the aerial parts of Machaeranthera tanacetifolia the known
   12-hydroxy-ent-kauren-16-en-19-oic acid and the two previously unknown
   (-)-11-O-alpha-D-arabinopyranosyl-beta-eudesmol and
   (+)-11-O-beta-L-arabinopyranosyl-beta-eudesmol were isolated. The
   structure elucidation of these compounds was based on spectroscopic and
   chemical evidences. (+)-11-O-beta-L-Arabinopyranosyl-beta-eudesmol was
   fully characterized by X-ray analysis of its peracetate derivative.
   According with these results, we propose that the previously reported
   (+)-11-O-alpha-arabinopyranosyl-beta-eudesmol and
   11-O-alpha-D-arabinopyranosyl-beta-eudesmol are identical to
   (+)-11-O-beta-L-arabinopyranosyl-beta-eudesmol. (C) 1998 Elsevier
   Science Ltd. All rights reserved.},
