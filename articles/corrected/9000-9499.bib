@article{ WOS:000184401500002,
Author = {Canseco-Márquez, L and Parra-Olea, G},
Title = {A new species of Pseudoeurycea (Caudata: Plethodontidae) from
   northern Oaxaca, Mexico},
Journal = {HERPETOLOGICAL JOURNAL},
Year = {2003},
Volume = {13},
Number = {1},
Pages = {21-26},
Month = {JAN},
Abstract = {We describe a new species of Pseudoeurycea from the northern-most high
   peak of the Sierra de Juarez, Oaxaca, Mexico. This species belongs to
   the P. juarezi group, a monophyletic assemblage restricted to northern
   Oaxaca and comprising three species: P. juarezi, P. saltator, and P.
   aurantia sp. nov. Pseudoeurycea aurantia is the sister taxon to the
   clade formed by P. juarezi and P. saltator. The new species is diagnosed
   by a distinctive coloration and by divergent mitochondrial DNA
   sequences.},
