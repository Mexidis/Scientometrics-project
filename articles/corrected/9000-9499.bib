Number = {2},
Pages = {174-184},
Month = {JUN},
Abstract = {We describe a new species of Xantusia from the Rio Juchipila in
   southwestern Zacetecas, Mexico. This southernmost known member of the
   genus is found in a semitropical habitat on the Pacific versant and
   lives under exfoliating bark of live mesquites, Prosopis. It is most
   similar in morphology to X. vigilis but differs in numbers of undivided
   fourth toe lamellae and scales composing the caudal annulus.},
