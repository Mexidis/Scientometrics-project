Volume = {50},
Number = {2},
Pages = {93-95},
Month = {APR},
Abstract = {A variational, study of the excited state 2sigma(g) of the H-2(+)
   molecular ion in a parallel configuration with a strong magnetic field
   of strength B = 1 a.u. (= 2.35 x 10(9) G) is presented. It is shown that
   a proper choice of a simple trial function gives accurate results in the
   total and binding energies.},
