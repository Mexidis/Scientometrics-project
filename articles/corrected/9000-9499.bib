   Galindo-Uribarri, A and Gross, CJ and Hausladen, PA and Lewis, TA and
   Mueller, PE and Padilla, E and Shapira, D and Stracener, DW and Yu, CH
   and Barton, CJ and Caprio, MA and Coraggio, L and Covello, A and
   Gargano, A and Hartley, DJ and Zamfir, NV},
Title = {Coulomb excitation of radioactive 132,134,136Te beams and the
   low B(E2) of 136Te -: art. no. 222501},
Journal = {PHYSICAL REVIEW LETTERS},
Year = {2002},
Volume = {88},
Number = {22},
Month = {JUN 3},
Abstract = {The B(E2;0(+)-->2(+)) values for the first 2(+) excited states of
   neutron-rich Te-132,Te-134,Te-136 have been measured using Coulomb
   excitation of radioactive ion beams. The B(E2) values obtained for
   Te-132,Te-134 are in excellent agreement with expectations based on the
   systematics of heavy stable Te isotopes, while that for Te-136 is
   unexpectedly small. These results are discussed in terms of
   proton-neutron configuration mixing and shell-model calculations using
   realistic effective interactions.},
