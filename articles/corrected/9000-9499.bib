Volume = {58},
Number = {4},
Pages = {492-497},
Month = {DEC},
Abstract = {We describe a new large species of Tantilla, from the Sierra Norte
   region of the Sierra Madre Oriental of Puebla, Mexico. This species most
   closely resembles Tantilla schistosa in color pattern, but differs by
   being much larger in size and having different scutellation. It differs
   from all other species of Mexican Tantilla by having a uniformly dark
   brown dorsum and head, and a pale cream venter.},
