@article{ WOS:000171976400003,
Author = {Contreras-Medina, R and Morrone, JJ and Vega, IL},
Title = {Biogeographic methods identify gymnosperm biodiversity hotspots},
Journal = {NATURWISSENSCHAFTEN},
Year = {2001},
Volume = {88},
Number = {10},
Pages = {427-430},
Month = {OCT},
Abstract = {A remarkable congruence among areas of endemism, panbiogeographic nodes,
   and refugia in western North America, Japan, south-western China,
   Tasmania, and New Caledonia indicates that these areas deserve special
   status for conservation. Here we propose that areas identified by
   different biogeographic methods are significant candidates for
   designation as hotspots.},
