Pages = {254-261},
Month = {SEP},
Note = {Conference held in honor of Leopoldo Garcia Colin Scherers 70th
   Birthday, UNIV AUTONOMA METROPOLITANA, IZTAPALAPA, MEXICO, NOV 29-30,
   2000},
Abstract = {We discuss an exactly soluble system, consisting of many independent
   objects with a structure, based on a very simple slave technique field
   theory. The Grand Canonical average quantities, such as the number of
   particles, energy, electric and magnetic polarization, of an ensemble of
   quantum objects in equilibrium with a reservoir of particles and energy,
   are derived in terms of the slaves instead of the electrons. The
   thermodynamic behavior, which depends on the parameters of the toy
   model, shows an interplay between several internal degrees of freedom.},
