@article{ WOS:000223046100005,
Author = {Gronenberg, W and López-Riquelme, GO},
Title = {Multisensory convergence in the mushroom bodies of ants and bees},
Journal = {ACTA BIOLOGICA HUNGARICA},
Year = {2004},
Volume = {55},
Number = {1-4},
Pages = {31-37},
Note = {10th Symposium of the
   International-Society-for-Invertebrate-Neurobiology, Tihany, HUNGARY,
   JUL 05-09, 2003},
Organization = {Int Soc Invertebrate Neurobiol},
Abstract = {The mushroom bodies, central neuropils in the arthropod brain, are
   involved in learning and memory and in the control of complex behavior.
   In most bisects, the mushroom bodies receive direct olfactory input in
   their calyx region. In Hymenoptera, olfactory input is layered in the
   calyx. In ants, several layers can be discriminated that correspond to
   different clusters of glomeruli in the antennal lobes, perhaps
   corresponding to different classes of odors. Only in Hymenoptera, the
   mushroom body calyx also receives direct visual input from the optic
   lobes. In bees, six calycal layers receive input from different classes
   of visual interneurons, probably representing different parts of the
   visual field and different visual properties. Taken together, the
   mushroom bodies receive distinct multisensory information in many
   segregated input layers.},
