@inproceedings{ WOS:000221506600035,
Author = {Gordillo, JL and Pardo-Guerra, JP and Stephens, CR},
Editor = {Monroy, R and ArroyoFigueroa, G and Sucar, LE and Sossa, H},
Title = {Adaptation in the presence of exogeneous information in an artificial
   financial market},
