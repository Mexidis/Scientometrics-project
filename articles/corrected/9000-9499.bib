@article{ WOS:000085186900033,
Author = {Goyenechea, I and Flores-Villela, O},
Title = {Designation of a neotype for Conopsis nasus (Serpentes:
   Colubridae)},
Journal = {COPEIA},
Year = {2000},
Number = {1},
Pages = {285-287},
Month = {FEB 1},
Abstract = {The designation of a neotype for Conopsis nasus is necessary because the
   type specimen is apparently lost, the original description is ambiguous
   and can be applied to more than one valid taxon, and there are
   inconsistencies with the previous designation of type locality. The
   neotype is chosen from the herpetological collections at the British
   Museum of Natural History and shows the typical characters as defined in
   the original description as well as the diagnostic characters for the
   species defined in a recent study.},
