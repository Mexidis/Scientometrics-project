   Univ Nacl Autonoma Mexico, Inst Invest Mat, Mexico City 04510, DF, Mexico.
   Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Fis, Mexico City 04510, DF, Mexico.},
DOI = {10.1103/PhysRevB.62.2220},
