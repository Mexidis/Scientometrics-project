@article{ WOS:000170765400002,
Author = {Lucano-Ramírez, G and Cruz, MVS and Ruiz-Ramírez, S and López-Murillo, T},
Title = {Histology of the oocytes of Lutjanus peru (Nichols and Murphy,
   1922) (Pisces: Lutjanidae)},
Journal = {CIENCIAS MARINAS},
Year = {2001},
Volume = {27},
Number = {3},
Pages = {335-349},
Month = {SEP},
Abstract = {The distinctive characteristics found in each of the development stages
   of the oocyte in the ovary of Lutjanus peru (Pacific red snapper) are
   described. The histological technique was used to identify the
   development stages of the oocytes and the averages of the diameters of
   the oocytes were obtained for these stages. Stage I, chromatin nucleolus
   oocyte: average diameter of 52.89 mum. Stage II, perinucleolus oocyte:
   average diameter of 117.78 mum. Stage III, yolk vesicle oocyte: average
   diameter of 166.18 mum. Stage IV, primary vitellogenesis oocyte: average
   diameter of 221.73 mum. Stage V, secondary vitellogenesis oocyte:
   average diameter of 333.7 mum. Stage VI, tertiary vitellogenesis oocyte:
   average diameter of 340.17 mum. Stage VII, mature oocyte: average
   diameter of 340.17 mum. With the identification of these stages, the
   observation of the process of the oogenesis in L. peru has been
   completed.},
