@article{ WOS:000176688500005,
Author = {Gallardo, PP and Pedroza-Islas, R and García-Galano, T and Pascual, C
   and Rosal, C and Sánchez, A and Gaxiola, G},
Title = {Replacement of live food with a microbound diet in feeding
   Litopenaeus setiferus (Burkenroad) larvae},
Journal = {AQUACULTURE RESEARCH},
Year = {2002},
Volume = {33},
Number = {9},
Pages = {681-691},
Month = {JUL 28},
Abstract = {Microbound feeds have been well accepted by shrimps and farmers in many
   penaeid shrimp hatcheries. The present study focused on an adequate
   level of replacement of Artemia nauplii and microalgae by a microbound
   diet for rearing Litopenaeus setiferus (Burkenroad) larvae. A microbound
   diet (MBD) consisting of fishmeal, squid meal, shrimp meal, yeast meal
   and soybean meal was used. The first experiment was designed to obtain
   the optimum level of MBD to complete the live feeding schedule, from
   Protozoea (PZ(III) ) to Mysis (M-III ). The experimental levels of the
   microbound diet tested were 2, 4, 6 and 8 mg MBD L-1 day(-1) . The next
   step was to determine the Artemia nauplii replacement level from PZ(I)
   to M-III by MBD. These experiments were carried out either in the
   presence (Experiment 2) or in the absence of algae (Experiment 3). Four
   replacement levels were tested: 0\% (4 mg MBD L-1 day(-1) : 1 Artemia
   nauplii mL(-1) ), 40\% (5.5 mg MBD L-1 day(-1) : 0.6 Artemia nauplii),
   60\% (6.5 mg MBD L-1 day(-1) : 0.4 Artemia nauplii) and 100\% (8 mg MBD
   L-1 day(-1) : 0 Artemia nauplii). In all experiments growth, survival,
   development, quality index (QI) and performance index (PI), were used to
   determine the optimum concentration of microbound diet. Results showed
   that 6 mg MBD L-1 day(-1) can be recommended as a complement to live
   food for L. setiferus larvae from PZ(III) to M-III . In the presence of
   algae, maximum growth and survival may be obtained in 40-60\% (5.5-6.5
   mg MBD L-1 day(-1) ) of Artemia nauplii replacement levels. In the
   absence of algae, the Artemia nauplii replacement resulted in slower
   development, less salinity resistance, lower growth and lower survival
   than was obtained in larvae fed with algae.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
