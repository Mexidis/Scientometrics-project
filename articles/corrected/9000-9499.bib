@article{ WOS:000184451200015,
Author = {Campos, I and Jiménez, JL and del Valle, G},
Title = {Canonical treatment of the rocket with friction linear in the velocity},
Journal = {EUROPEAN JOURNAL OF PHYSICS},
Year = {2003},
Volume = {24},
Number = {4},
Pages = {469-479},
Month = {JUL},
Abstract = {We show that the problem of the rocket with friction linear in the
   velocity can be treated by canonical methods. In order to achieve this
   we must abandon the restriction to natural Lagrangians of the form L = T
   - V, and use the method of S-equivalent Lagrangians. We also solve the
   problem with constant gravity. This example may be useful for the
   teaching of the application of canonical methods to dissipative systems,
   as well as to the teaching of the use of the method of S-equivalent
   Lagrangians.},
