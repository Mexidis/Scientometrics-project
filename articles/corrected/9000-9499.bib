@article{ WOS:000175327700030,
Author = {Castillo, P and Zamilpa, A and Márquez, J and Hernández, G and Lara, M
   and Alvarez, L},
Title = {Comparative study of differentiation levels and valepotriate content of
   in vitro cultures and regenerated and wild plants of Valeriana
   edulis ssp procera},
Journal = {JOURNAL OF NATURAL PRODUCTS},
Year = {2002},
Volume = {65},
Number = {4},
Pages = {573-575},
Month = {APR},
Abstract = {Valepotriate content levels in samples of in vitro cultures of Valeriana
   edulis ssp. procera were compared with those of roots and rhizomes of
   wild plants in the reproductive stage. Rhizomes and roots of regenerated
   and wild plants showed a similar valepotriate content. The data obtained
   support the hypothesis that valepotriate production in V. edulis spp.
   procera is closely related to rhizome and root differentiation. The
   large-scale propagation of this endangered plant may offer an attractive
   alternative for its production for medicinal purposes.},
