Pages = {112+},
Month = {MAR},
Abstract = {Distribution patterns of 139 Mexican land bird species were compared,
   through a panbiogeographic approach, and 14 generalized tracks were
   obtained. In the intersection of these generalized tracks, we found 15
   nodes, which were prioritized according to their complementarity,
   phylogenetic diversity, and conservation status of the species.
   ``Eastern Oaxaca{''} and ``central Guerrero{''} were detected as
   important for conservation of Mexican birds.},
