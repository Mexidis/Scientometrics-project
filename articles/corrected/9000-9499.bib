@article{ WOS:000224051700146,
Author = {Orozco, S and Ortiz, MA and Méndez-Moreno, RM and Moreno, M},
Title = {A model for the isotope effect in high-Tc
   superconductors},
Journal = {PHYSICA C-SUPERCONDUCTIVITY AND ITS APPLICATIONS},
Year = {2004},
Volume = {408},
Pages = {346-347},
Month = {AUG},
Note = {7th International Conference on Materials and Mechanisms of
   Superconductive and High Temperature Superconductors, Rio de Janeiro,
   BRAZIL, MAY 25-30, 2003},
Abstract = {In this work the isotope coefficient is calculated from the BCS gap
   equation, using a model with anomalous occupation in the momentum space.
   The specific case of cuprate oxide superconductors is considered in
   detail. The isotope exponent alpha(1) is obtained as a function of the
   anomalous occupation parameter alpha2 and the coupling constant gimel.
   In particular, the isotope coefficients for YBa2Cu3O7 and Bi2Sr2CaCu2O8
   are compared successfully with the experimental results. (C) 2004
   Elsevier B.V. All rights reserved.},
