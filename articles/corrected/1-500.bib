@article{ WOS:000510423800010,
Author = {Baxin Beltran, Claudio and Baxin Salazar, Fernando and Malaga Temich,
   Braulio and Medina Mena, Israel and Atanacio Lopez, Margarito and Flores
   Gutierrez, Margarito and Lozada Ronquillo, Martha Patricia and
   Calderon-Parra, Rafael and Ortega-Alvarez, Ruben},
Title = {Community-based monitoring for the Tuxtla Quail-Dove Zentrygon
   carrikeri: a contribution to the natural history of an elusive,
   endangered and micro-endemic species of Mexico},
Journal = {ORNITHOLOGICAL SCIENCE},
Year = {2020},
Volume = {19},
Number = {1},
Pages = {87-92},
Month = {JAN},
Abstract = {The Tuxtla Quail-Dove Zentrygon carrikeri is a poorly known,
   microendemic, and endangered species of southern Mexico. Almost no
   information has been published about this dove. We provide new
   information about its natural history, which resulted from
   community-based bird monitoring programs. We describe unknown breeding,
   feeding, bathing, social, alert, and roosting behaviors of the species.
   Moreover, we highlight the relevance of participatory science for
   studying and engaging society in the conservation of the Tuxtla
   Quail-Dove. Our observations on the species provide valuable information
   for guiding future research and enhancing conservation activities on
   this species.},
