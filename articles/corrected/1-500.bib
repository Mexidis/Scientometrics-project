@article{ WOS:000431148900004,
Author = {Marcos, Eduardo N. and Mendoza, Octavio and Saenz, Corina and Santiago,
   Valente},
Title = {Wide subcategories of finitely generated A-modules},
Journal = {JOURNAL OF ALGEBRA AND ITS APPLICATIONS},
Year = {2018},
Volume = {17},
Number = {5},
Month = {MAY},
Abstract = {We explore some properties of wide subcategories of the category mod(A)
   of finitely generated left A-modules, for some artin algebra A. In
   particular we look at wide finitely generated subcategories and give a
   connection with the class of standard modules and standardly stratified
   algebras. Furthermore, for a wide class chi in mod(A), we give necessary
   and sufficient conditions to see that chi = pres(P), for some projective
   A-module P; and finally, a connection with ring epimorphisms is given.},
