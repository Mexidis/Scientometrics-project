@article{ WOS:000561132900017,
Author = {Palacios-Vargas, Jose G.},
Title = {First Mexican species of Pseudachorudina (Collembola: Neanuridae:
   Pseudachorutinae) from Mapimi Desert, State of Durango},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2020},
Volume = {91},
Month = {APR-JUN},
Abstract = {Pseudachorudina navarretei sp. nov. from Mapimi Desert, Durango, Mexico,
   is described. It is similar to the American species P. texensis and P.
   ignotus Christiansen and Bellinger, 1980, all of them with 1 dorsal
   strong capitated tenent hair on tibiotarsi. It differs in the shape of
   the maxillary lamellae, one with 4 sharp big teeth and one semispherical
   with 5 stocky teeth while P. texensis has both lamellae toothed and
   similar; P. ignotus has only 1 serrate lamella and the maxillary
   capitulum is elongated. The new species has 5 long dental setae; P.
   texensis has 4 short and P. ignotus has 6 of different sizes.},
