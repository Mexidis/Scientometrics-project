@article{ WOS:000655317000001,
Author = {Ortiz-Sosa, Rosalinda and Israel Fuentes-Oliver, Edgar and
   Garcia-Segundo, Crescencio and Serrano-Loyola, Raul and
   Solalinde-Vargas, Rebeca},
