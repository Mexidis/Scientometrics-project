@article{ WOS:000511707400009,
Author = {Cruz Duran, Ramiro and Andrade Murguia, Gloria},
Title = {Lonchocarpus guerrerensis (Leguminosae: Papilionoideae,
   Millettieae), una nueva especie del estado de Guerrero, Mexico},
Journal = {BRITTONIA},
Year = {2019},
Volume = {71},
Number = {4},
Pages = {403-407},
Month = {DEC},
Abstract = {Lonchocarpus guerrerensis is illustrated and postulated as a new species
   from the state of Guerrero, Mexico. This species is similar to L.
   lindsayi, however, it is distinguished by presenting leaflets with a
   plane margin and obtuse base, pedicels, calyx and standard smaller,
   ovaries with fewer ovules (2-4 vs. 6-7), fruits with a wide, emarginate
   vexilar magin and obtuse apex, and different phenology and distribution.
   A dichotomous key to distinguish similar species from the new species is
   also included.},
