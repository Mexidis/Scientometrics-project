@article{ WOS:000529044400001,
Author = {Morales, Siddhartha and Dasgupta, Arundhati},
Title = {Scalar and fermion field interactions with a gravitational wave},
Journal = {CLASSICAL AND QUANTUM GRAVITY},
Year = {2020},
Volume = {37},
Number = {10},
Month = {MAY 21},
Abstract = {Given that gravitational waves are the future probes of the Universe, it
   is important to test various physical effects of these on matter. This
   article explores the first-order perturbation, caused by a planar
   gravitational wave, on massless scalar and chiral fermions. We find a
   new propagating mode for the perturbed fields with a new dispersion
   relation by solving inhomogeneous differential equations. We also
   discuss the massive scalar field, and find interesting effects due to
   the gravitational wave. Our results have physical implications for early
   Universe cosmology and also for ground-based observations, where the new
   mode might be able to help in the gravitational waves' detection on
   Earth.},
Publisher = {IOP Publishing Ltd},
Address = {TEMPLE CIRCUS, TEMPLE WAY, BRISTOL BS1 6BE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Dasgupta, A (Corresponding Author), Univ Lethbridge, Phys \& Astron, 4401 Univ Dr, Lethbridge, AB T1K 3M4, Canada.
   Morales, Siddhartha; Dasgupta, Arundhati, Univ Lethbridge, Phys \& Astron, 4401 Univ Dr, Lethbridge, AB T1K 3M4, Canada.
   Morales, Siddhartha, Fac Ciencias, UNAM Ciudad Univ, Mexico City, DF, Mexico.},
DOI = {10.1088/1361-6382/ab79d6},
Article-Number = {105001},
ISSN = {0264-9381},
EISSN = {1361-6382},
Keywords = {neutrinos; gravitational waves; scalar fields and gravitational waves;
