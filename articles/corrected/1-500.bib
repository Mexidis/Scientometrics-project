@article{ WOS:000503724700006,
Author = {Andres Rivera-Quiroz, F. and Alvarez-Padilla, Fernando},
Title = {Description of five new WuIfila (Araneae, Anyphaenidae) species
   from Mexico with comments on the taxonomy of the genus},
Journal = {ZOOTAXA},
Year = {2019},
Volume = {4712},
Number = {2},
Pages = {269-289},
Month = {DEC 19},
Abstract = {The genus Wulfila O. Pickard-Cambridge 1895 belongs to the family
   Anyphaenidae Bertkau, 1878, commonly called ghost spiders. Wulfila is
   endemic to the Americas and currently has 43 valid species; here we
   describe five new: Wulfila conchamonile spec. nov., W xilitlensis spec.
   nov., W. luisi spec. nov., W unguis spec. nov. and W phantasma spec.
   nov. Specimens were collected in Mexico as part of three biological
   inventories developed in Xilitla, San Luis Potosi, and Atotonilco and
   Xamaticpac, Veracruz, between 2011 and 2014. In addition, we provide an
   overview of Wulfila taxonomic literature with a discussion on the genus
   taxonomy, diagnostic characters, species placement, and novel genital
   characters.},
