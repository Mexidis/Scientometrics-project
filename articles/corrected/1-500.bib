@article{ WOS:000842925600001,
Author = {Rodriguez, Isaias and Valladares, Renela M. and Valladares, Alexander
   and Hinojosa-Romero, David and Valladares, Ariel A.},
Title = {Superconductivity Versus Magnetism in the Amorphous Palladium
   ``Ides{''}: Pd1-c(H/D/T)c},
Journal = {JOURNAL OF LOW TEMPERATURE PHYSICS},
Year = {2022},
Volume = {209},
Number = {1-2},
Pages = {232-243},
Month = {OCT},
Abstract = {In general, conventional superconductivity and magnetism are competing
   phenomena. In some alloys this competition is a function of the
   concentration of the elements. Here we show that in the palladium alloys
   Pd1-C (H/D/T)(C) (Pd-ides) the increase in the concentration c of the
   ides: hydrogen, deuterium, tritium (H/D/T), lowers the predicted
   magnetism of amorphous palladium (alpha-Pd) gradually, allowing
   superconductivity to appear for c approximate to 40\%. This magnetism
   explains why superconductivity does not manifest for smaller values of c
   (c <= 40\% in these Pd alloys. These results validate indirectly our
   predicted magnetism in the amorphous/porous palladium (a/p-Pd) providing
   a different strategy to explore the phase diagram of competing magnetic
   and superconducting phases.},
