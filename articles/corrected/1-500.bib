@article{ WOS:000661767200006,
Author = {Sheffee, Nurul Syahidah and Rubio-Reyes, Patricia and Mirabal, Mayelin
   and Calero, Romel and Carrillo-Calvet, Humberto and Chen, Shuxiong and
   Chin, Kai Ling and Shakimi, Nur Atiqah Syairah and Anis, Fadhilah
   Zulkipli and Suraiya, Siti and Sarmiento, Maria E. and Norazmi, Mohd Nor
   and Acosta, Armando and Rehm, Bernd H. A.},
Title = {Engineered Mycobacterium tuberculosis antigen assembly into
   core-shell nanobeads for diagnosis of tuberculosis},
Journal = {NANOMEDICINE-NANOTECHNOLOGY BIOLOGY AND MEDICINE},
Year = {2021},
Volume = {34},
Month = {JUN},
Abstract = {Despite recent advances in diagnosis, tuberculosis (TB) remains one of
   the ten leading causes of death worldwide. Here, we engineered
   Mycobacterium tuberculosis (Mtb) proteins (ESAT6, CFP10, and MTB7.7) to
   self-assemble into core-shell nanobeads for enhanced TB diagnosis.
   Respective purified Mtb antigen-coated polyester beads were
   characterized and their functionality in TB diagnosis was tested in
   whole blood cytokine release assays. Sensitivity and specificity were
   studied in 11 pulmonary TB patients (PTB) and 26 healthy individuals
   composed of 14 Tuberculin Skin Test negative (TSTn) and 12 TST positive
   (TSTp). The production of 6 cytokines was determined (IFN gamma, IP10,
   IL2, TNF alpha, CCL3, and CCL11). To differentiate PTB from healthy
   individuals (TSTp + TSTn), the best individual cytokines were IL2 and
   CCL11 (>80\% sensitivity and specificity) and the best combination was
   IP10 + IL2 (>90\% sensitivity and specificity). We describe an
   innovative approach using full-length antigens attached to biopolyester
   nanobeads enabling sensitive and specific detection of human TB. (C)
   2021 Published by Elsevier Inc.},
