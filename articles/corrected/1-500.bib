@article{ WOS:000504858100005,
Author = {Mammola, Stefano and Cardoso, Pedro and Angyal, Dorottya and Balazs,
   Gergely and Blick, Theo and Brustel, Herve and Carter, Julian and
   Curcic, Srecko and Danflous, Samuel and Danyi, Laszlo and Dejean,
