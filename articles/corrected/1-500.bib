@article{ WOS:001126103300011,
Author = {Martinez-Cadena, J. A. and Tamariz-Mascarua, A.},
Title = {THE C-BOUNDED-OPEN TOPOLOGY ON C (X)},
Journal = {HOUSTON JOURNAL OF MATHEMATICS},
Year = {2022},
Volume = {48},
Number = {2},
Pages = {395-414},
Abstract = {For the collection of C-bounded subsets of X (usually called bounded),
   Cb, and the collection of closed C-bounded subsets of X, (Cb) over bar,
   we study the spaces (C(X); T-Cb,T-u) and (C(X); T-Cb), where C(X) is the
   set of continuous real-valued functions defined on the Tychonoff space
   X, TCb;u is the topology of the uniform convergence on the C-bounded
   subsets of X, and T-Cb,T-u is the C-bounded-open topology. The spaces
   (C(X); T-(Cb) over bar ,T-u) and (C(X); T-(Cb) over bar) are also
   studied, where now what the symbols T-(Cb) over bar ,T-u and T-(Cb) over
   bar mean should be clear. We obtain: (1) For countably compact infinite
   zerodimensional spaces T-(Cb) over bar not equal subset of T-Cb; (2) The
   space (C(X); T-Cb) is a topological group if and only if T-Cb is
   contained in the topology of uniform convergence on X, T-u, if and only
   if, each element in Cb is a C-compact subset of X; (3) If X is
   pseudocompact and each element in (Cb) over bar is a C-compact subset of
   X, then T-(Cb) over bar = T-u subset of T-Cb, and, moreover, if there is
   an element in Cb which is not C-compact, then T-u not equal subset of
   T-Cb; (4) For a normal pseudocompact space X, (C(X); T-(Cb) over bar) is
   metrizable if and only if it is a q-space.},
