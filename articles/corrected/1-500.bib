@article{ WOS:001608160200001,
Author = {Aguilar-Aguilar, Rogelio},
Title = {Little-known members of the kelp forest: helminth parasites of the
   Garibaldi Damselfish Hypsypops rubicundus (Teleostei:
   Pomacentridae) from Bahía de Todos Santos, Baja California, Mexico, with
   the description of Opegaster gorgonioi sp. nov. (Trematoda:
   Opecoelidae)},
Journal = {MARINE BIODIVERSITY},
Year = {2025},
Volume = {55},
Number = {6},
Month = {NOV 5},
Abstract = {In order to describe the helminth fauna of the Garibaldi Hypsypops
   rubicundus (Girard, 1854) from Bah \& iacute;a de Todos Santos, Baja
   California, Mexico, 20 individuals were examined. Six helminth taxa were
   found. Of these, Opecoelus inimici Yamaguti, 1934, and Opegaster
   gorgonioi sp. nov. (Opecoelidae) were the most prevalent and numerically
   dominant species. The helminthological record for H. rubicundus is
   complemented with the trematode Genolinea tanyopa Montgomery, 1957
   (Hemiuridae), and Opecoelus sp. (Opecoelidae), the nematode Cucullanus
   sp. (Cucullanidae), and the acanthocephalan Pararhadinorhynchus sp.
   (Transvenidae). Except for G. tanyopa, all the helminth species
   represent new host records.},
