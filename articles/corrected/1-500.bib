@article{ WOS:001460882300001,
Author = {Huerta, Mindy Y. and Mendoza, Octavio and Saenz, Corina and Santiago,
   Valente},
Title = {Cut notions in extriangulated categories related to Auslander-Buchweitz
   theory and cotorsion theory},
Journal = {JOURNAL OF ALGEBRA AND ITS APPLICATIONS},
Year = {2025},
Month = {2025 APR 5},
Abstract = {In this work, we introduce cut notions for extriangulated categories
   related with Auslander-Buchweitz theory and cotorsion theory. Namely,
   cut n-cotorsion pairs, cut Frobenius pairs and cut AB contexts. We show
   that there are correspondences that relate these cut notions. Finally,
   by using this, we characterize co-t-structures in certain subcategories
   of triangulated categories.},
