@article{ WOS:000452006000003,
Author = {Arevalo-Lopez, Angel M. and Solana-Madruga, Elena and Arevalo-Lopez,
   Eugenia P. and Khalyavin, Dmitry and Kepa, Michal and Dos Santos-Garcia,
   Antonio J. and Saez-Puche, Regino and Attfield, J. Paul},
Title = {Evolving spin periodicity and lock-in transition in the frustrated
   ordered ilmenite-type β-Mn2InSbO6},
Journal = {PHYSICAL REVIEW B},
Year = {2018},
Volume = {98},
Number = {21},
Month = {DEC 4},
Abstract = {Polar magnets are promising materials for applications such as
   multiferroics or in spintronics. In double-corundum-related oxides, the
   cation ordering imposes a polar structure and the use of high pressure
   facilitates the insertion of magnetic cations into the compounds. Here
   we present the high-pressure synthesis of a polar and ferrimagnetic
   corundum derivative of Mn2InSbO6, which adopts the ordered-ilmenite-type
   structure. Neutron powder diffraction reveals that the high-temperature
   nearly collinear ferrimagnetic phase evolves to an incommensurate
   helical structure with k(delta) = {[}0 0 k(z)] propagation vector, which
   then locks to the commensurate value of k(z) = 1/8. This complex
   magnetic behavior is likely to be related to magnetic frustration and
   the polar nature of the ordered double-corundum structure.},
Publisher = {AMER PHYSICAL SOC},
Address = {ONE PHYSICS ELLIPSE, COLLEGE PK, MD 20740-3844 USA},
Type = {Article},
Language = {English},
Affiliation = {Arévalo-López, AM (Corresponding Author), Univ Lille, CNRS, Cent Lille, ENSCL,Univ Artois,UMR UCCS 8181, F-59000 Lille, France.
   Arevalo-Lopez, Angel M., Univ Lille, CNRS, Cent Lille, ENSCL,Univ Artois,UMR UCCS 8181, F-59000 Lille, France.
   Solana-Madruga, Elena; Kepa, Michal; Attfield, J. Paul, Univ Edinburgh, Ctr Sci Extreme Condit, Edinburgh EH9 3FD, Midlothian, Scotland.
