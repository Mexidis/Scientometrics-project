Year = {2017},
Volume = {451},
Number = {2},
Pages = {1154-1164},
Month = {JUL 15},
Abstract = {We give a new characterization of Valdivia compact spaces: A compact
   space is Valdivia if and only if it has a dense commutatively
   monotonically retractable subspace. This result solves Problem 5.12 from
   {[}6]. Besides, we introduce the notion of full c-skeleton and prove
   that a compact space is Corson if and only if it has a full c-skeleton.
