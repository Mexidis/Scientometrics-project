Pages = {307-315},
Abstract = {Answering questions posted by J. J. Charatonik and W. J. Charatonik, in
   this paper it is proved that the property of being a semi-Kelley
   continuum is preserved under open mappings and under monotone mappings.
   Also, a not semi-confluent mapping f : X -> Y, from a continuum X onto a
   continuum Y with the property of Kelley, which is the uniform limit of
   semi-confluent mappings from X onto Y is presented. In addition, we show
   that if a continuum X is a semi-Kelley continuum, then X does not
   contain R-2-continua.},
