@article{ WOS:000659356600011,
Author = {Zhang, Zhi-Qiang and Schatz, Heinrich and Pfingstl, Tobias and
   Goldschmidt, Tom and Martin, Peter and Pesic, Vladimir and Ramirez,
   Marcia and Schmidt, Karl-Heinz and Fan, Qing-Hai and Mironov, Sergey and
   Seeman, Owen and Halliday, Bruce},
Title = {Discovering and documenting Acari: the first twenty years in
   Zootaxa},
Journal = {ZOOTAXA},
Year = {2021},
Volume = {4979},
Number = {1},
Pages = {115-130},
Month = {MAY 28},
Abstract = {Acari represent the most diverse group within the arachnids with some
   60,000 described species. It is generally believed that most species of
   mites are waiting to be discovered and described. Zootaxa was the most
   important journal for mite taxonomy during the last twenty years (2001
   to 2020). It published 1,305 papers by 1,057 authors during these two
   decades, with descriptions of 3,271 new taxa/names, which account for
   24.4\% of the total indexed in Zoological Record. The numbers of new
   synonyms of Acari in Zootaxa (334) also accounted for nearly a quarter
   (24.9\%) of the total published during this period. These data indicate
   that Zootaxa has been an important and leading journal for acarologists
   to document the diversity of mites and ticks in the world.},
