@article{ WOS:000606995900002,
Author = {Ramiro Martinez-Gonzalez, Cesar and De Jesus Morales-Sandoval, Jose and
   Adrian Gonzalez-Martinez, Cesar and Jimenez-Ramirez, Jaime and
   Gallegos-Vazquez, Clemente},
Title = {Opuntia tehuacana and O. olmeca (Cactaceae,
   Opuntioideae) are to be considered as ascribed to a single species:
   morphological and molecular evidences},
Journal = {PHYTOTAXA},
Year = {2021},
Volume = {479},
Number = {2},
Pages = {160-172},
Month = {JAN 8},
Abstract = {Opuntia tehuacana and Opuntia olmeca are morphological similarity and
   have been considered during the time as the same species. However,
   neither a detailed morphological study nor a phylogenetic assessment has
   been made to confirm this statement. In fact, although several
   phylogenetic studies of the genus Opuntia have been carried out, both
   species have not been sampled to know their phylogenetic relationships.
   The present study is based on a morphological comparison of the two
   taxa, based on both live and herborized individuals. A total of eighteen
   sequences were generated, six ITS, six matK, and six h-nL-F. and a
   phylogenetic analysis was performed based on Bayesian inference. The
   results obatined provides evidences that support O. olmeca and O.
   tehuacana as the same species.},
