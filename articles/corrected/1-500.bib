@article{ WOS:001167388200001,
Author = {Torres-Rodriguez, Esperanza and Caballero, Margarita and
   Figueroa-Rangel, Blanca L. and Lopez-Caballero, Guadalupe Iriliana and
   Lozano-Garcia, Socorro},
Title = {Fire regime shift associated with the European colonization in
   Mesoamerica},
Journal = {JOURNAL OF SOUTH AMERICAN EARTH SCIENCES},
Year = {2024},
Volume = {135},
Month = {MAR},
Abstract = {This study reconstructs fire history of Lake Atezca, Hidalgo, revealing
   two significant phases of plant biomass burning: one from -1140 to 1523
   CE and another from -1523 to 2005 CE. The first phase shows frequent
   fires, likely linked to pre-Hispanic agricultural practices. The second
   phase, starting around the time of the Spanish Conquest, showed a
   decrease in biomass burning, indicating a major shift in agricultural
   practices and demographic density after the Spanish intervention. The
   pre-Hispanic era, particularly during the Postclassic period, was marked
   by anthropogenic deforestation, associated with intensive practices such
   as slash-and-burn agriculture and rainfed cultivation. We also observed
   low values in C/N ratio, which can be related to forest soil degradation
   and loss of terrestrial nitrogen, due to periods with high of fires
   recurrence associated to these agricultural practices. The Spanish
   arrival was associated with a drastic reduction in the indigenous
   population and, the subsequent colonization led to significant changes
   in land use and fire practices. The suppression of indigenous fire-use
   practices, combined with severe drought conditions during the Conquest,
   resulted in a decreased in biomass burning. The Spanish Colonial period
   and the transition to modern Mexico were characterized by an increase in
   terrestrial organic matter input, likely due to the adoption of European
   farming techniques and livestock husbandry, causing high erosion in the
   landscape. Notably, the study highlights three wood-burning events
   (-1746-1794 CE, -1880-1918 CE, and -1954-1992 CE) potentially linked to
   severe droughts in the region: ``El An similar to o de Hambre{''}
   drought (1785-1786), the ``Revolution Drought{''} (1909-1910), and the
   1950s drought (1951-1957) that occurred in the mid-20th century. The
   presence of these events suggests a complex interplay between
   anthropogenic and climatic drivers in shaping Lake Atezca's ecosystem.},
