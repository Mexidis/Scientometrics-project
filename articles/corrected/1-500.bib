@article{ WOS:000423435500010,
Author = {Uh Zapata, Miguel and Itza Balam, Reymundo and Montalvo-Urquizo,
   Jonathan},
Title = {High-order implicit staggered-grid finite differences methods for the
   acoustic wave equation},
Journal = {NUMERICAL METHODS FOR PARTIAL DIFFERENTIAL EQUATIONS},
Year = {2018},
Volume = {34},
Number = {2},
Pages = {602-625},
Month = {MAR},
Abstract = {Motivated by the idea that staggered-grid methods give a greater
   stability and give energy conservation, this article presents a new
   family of high-order implicit staggered-grid finite difference methods
   with any order of accuracy to approximate partial differential equations
   involving second-order derivatives. In particular, we numerically
   analyze our new methods for the solution of the one-dimensional acoustic
   wave equation. The implicit formulation is based on the plane wave
   theory and the Taylor series expansion and only involves the solution of
   tridiagonal matrix equations resulting in an attractive method with
   higher order of accuracy but nearly the same computation cost as those
   of explicit formulation. The order of accuracy of the proposal staggered
   formulas are similar to the methods with conventional grids for a (2M +
   2)-point operator: the explicit formula is (2M)th-order and the implicit
   formula is (2M +2) th-order; however, the results demonstrate that new
   staggered methods are superior in terms of stability properties to the
   classical methods in the context of solving wave equations.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Zapata, MU (Corresponding Author), CONACYT, CIMAT Unidad Merida PCTY, Ctr Invest Matemat AC, CP 97302, Merida, Yucatan, Mexico.
   Uh Zapata, Miguel, CONACYT, CIMAT Unidad Merida PCTY, Ctr Invest Matemat AC, CP 97302, Merida, Yucatan, Mexico.
