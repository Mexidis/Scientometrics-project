Title = {A characterization of the product of the rational numbers and complete
   Erdos space},
Journal = {CANADIAN MATHEMATICAL BULLETIN-BULLETIN CANADIEN DE MATHEMATIQUES},
Year = {2023},
Volume = {66},
Number = {1},
Pages = {87-102},
Month = {MAR},
Abstract = {Erdos space E and complete Erd.os space E-c have been previously shown
   to have topological characterizations. In this paper, we provide a
   topological characterization of the topological space Q x E-c, whereQis
   the space of rational numbers. As a corollary, we show that the Vietoris
   hyperspace of finite sets F(E-c) is homeomorphic to Q x E-c. We also
   characterize the factors of Q x E-c. An interesting open question that
   is left open is whether sE.c, the s-product of countablymany copies of
   E-c, is homeomorphic to Q x E-c.},
