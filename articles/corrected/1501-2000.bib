@article{ WOS:001608935900001,
Author = {Vazquez-Mata, J. A. and Hernandez-Toledo, H. M. and Avila-Reese, V. and
   Rodriguez-Puebla, A. and Martinez-Vazquez, L. A. and Herrera-Endoqui, M.
