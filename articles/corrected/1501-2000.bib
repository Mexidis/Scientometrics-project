@article{ WOS:000746184700007,
Author = {Polanco, Carlos and Uversky, Vladimir N. and Vargas-Alarcon, Gilberto
   and Buhse, Thomas and Huberman, Alberto and Marquez, Manlio F. and
   Andres, Leire},
Title = {Characterization of Proteins from Putative Human DNA and RNA Viruses},
Journal = {CURRENT PROTEOMICS},
Year = {2022},
Volume = {19},
Number = {1},
Pages = {65-82},
Abstract = {Background: In the vast variety of viruses known, there is a particular
   interest in those transmitted to humans and whose ability to disseminate
   represents a significant public health issue. Objective: The present
   study's objective is to bioinformatically characterize the proteins of
   the two main divisions of viruses, RNA-viruses and DNA-viruses. Methods:
   In this work, a set of in-house computational programs was used to
   calculate the polarity/charge profiles and intrinsic disorder
   predisposition profiles of the proteins of several groups of viruses
   representing both types extracted from the UniProt database. The
   efficiency of these computational programs was statistically verified.
   Results: It was found that the polarity/charge profile of the proteins
   is, in most cases, an efficient discriminant that allows the re-creation
   of the taxonomy known for both viral groups. Additionally, the entire
   set of ``reviewed{''} proteins in the UniProt database was analyzed to
   find proteins with polarity/charge profiles similar to those obtained
   for each viral group. This search revealed a substantial number of
   proteins with such polarity-charge profiles. Conclusion: Polarity/charge
   profile represents a physicochemical metric, which is easy to calculate,
   and which can be used to effectively identify viral groups from their
   protein sequences.},
