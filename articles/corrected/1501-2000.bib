@article{ WOS:001607881700001,
Author = {Diaz-Ortega, Isaac E. and Zuniga-Vega, Jaime and Flores-Villela, Oscar
   and Perez-Mendoza, Hibraim A.},
Title = {Habitat use and morphological evolution in Sceloporus: a single- and
   multi-trait comparative analysis},
Journal = {BIOLOGICAL JOURNAL OF THE LINNEAN SOCIETY},
Year = {2025},
Volume = {146},
Number = {3},
Month = {NOV},
Abstract = {Analyses of body shape and its relationship to habitat use are essential
   to understanding the process of biological adaptation. Habitat use is
   one of the main factors influencing body shape variation in lizards,
   resulting in a wide range of morphological responses to different
   selection pressures associated with locomotion across diverse
   substrates. In this study, we examined the evolutionary dynamics of
   eight morphological traits (derived from 11 measured traits after
   averaging left-right pairs) across 79 species of the genus Sceloporus.
   Using a suite of phylogenetic comparative methods, we tested whether
   habitat use drives morphological differentiation independently of
   phylogenetic relatedness. Our results indicate that although Sceloporus
   shows dynamic morphological evolution associated with habitat use, this
   pattern is not clear when multiple traits are analysed simultaneously.
   However, trait-specific analyses revealed associations between habitat
   type and traits such as head width and snout-vent length. These findings
   suggest that morphological similarity among species occupying similar
   environments might result from adaptive responses to habitat use,
   regardless of phylogenetic history. We discuss potential selective
   pressures and evolutionary mechanisms underlying these patterns of
   morphological evolution in Sceloporus.},
