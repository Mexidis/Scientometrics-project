@article{ WOS:001614248200001,
Author = {Maurino, Romina A. and Zurano, Juan P. and Zurita, Gustavo A. and Di
   Giacomo, Adrian S. and de Araujo, Carlos B.},
Title = {Optimizing passive acoustic monitoring (PAM) for biodiversity studies:
   Using species-area relationship (SAR) to predict species richness},
Journal = {ORNITHOLOGICAL APPLICATIONS},
Year = {2025},
Month = {2025 NOV 14},
Abstract = {Passive acoustic monitoring (PAM) using autonomous recording units
   (ARUs) has become a key tool in long-term, low-cost ecological studies.
   However, one of the main challenges lies in storing and analyzing the
   large volume of data it generates, which requires significant processing
   effort and species annotation. In this context, it is crucial to
   establish a sampling and acoustic data analysis protocol that maximizes
   the efficiency of ecological information retrieval. This study proposes
   the application of the species-area relationship (SAR) mathematical
   model to optimize the use of ARUs and reduce the effort required for
   acoustic data analysis, aiming to predict the number of detected species
   in 3 Neotropical ecoregions: Amazonia, Caatinga, and Campos y Malezales.
   Our results suggest that increasing the number of ARUs (12 in this
   study) while reducing the post-recording listening effort (12 min per
   ARU) enhances sampling efficiency, allowing for a more accurate
   representation of biodiversity in the study sites. The SAR model was
   first applied to estimate both alpha and beta diversity in relation to
   sampling effort. In addition, beta diversity increased by 20\% between
   ARUs spaced 500-1,000 m apart in Campos y Malezales; whereas in Amazonia
   and Caatinga, where distances between recorders were shorter (200-250
   m), the increase was much smaller (0.8-5\%). This highlights the
   importance of spatial configuration among recorders when interpreting
   species turnover patterns. Our findings support the design of sampling
   strategies adapted to different ecological contexts and levels of
   sampling effort. These insights provide a solid foundation for improving
   the management and optimization of biodiversity monitoring protocols in
   Neotropical environments. Similarly, they may be applied in other
   ecoregions using PAM, contributing to the development of more efficient
   methodologies for large-scale assessment of biological communities.
   Passive acoustic monitoring with autonomous recording units (ARUs) is a
   cost-effective tool for long-term ecological studies. The management and
   analysis of large volumes of acoustic data represent one of the main
   challenges in biodiversity studies based on passive acoustic monitoring,
   due to the time and effort required. This study applies the species-area
   relationship model to optimize acoustic sampling across three
   Neotropical ecoregions: Amazonia, Caatinga, and Campos y Malezales.
   Findings suggest that deploying 12 ARUs per site and analyzing 12 min
   per unit effectively captures species diversity (alfa and beta
   diversity), providing a robust representation of the ecoregions. These
   results provide a starting point for managing and optimizing
   biodiversity monitoring protocols in Neotropical environments.
   El monitoreo ac \& uacute;stico pasivo (PAM) mediante unidades de
   registro aut \& oacute;nomas (ARUs) se ha consolidado como una
   herramienta clave para estudios ecol \& oacute;gicos de largo plazo y
   bajo costo. Sin embargo, uno de sus principales desaf \& iacute;os es el
   an \& aacute;lisis del gran volumen de datos generados, que demanda un
   esfuerzo considerable en procesamiento y anotaci \& oacute;n de
   especies. En este contexto, es fundamental definir protocolos de
   muestreo y an \& aacute;lisis ac \& uacute;stico que optimicen la
   eficiencia en la obtenci \& oacute;n de informaci \& oacute;n ecol \&
   oacute;gica. Este estudio propone la aplicaci \& oacute;n del modelo
   matem \& aacute;tico de la relaci \& oacute;n especie-\& aacute;rea
   (SAR) para optimizar el uso de las ARUs y reducir el esfuerzo requerido
   en el an \& aacute;lisis de datos ac \& uacute;sticos, con el objetivo
   de predecir la riqueza de especies en tres ecorregiones neotropicales:
   Amazon \& iacute;a, Caatinga y Campos y Malezales. Nuestros resultados
   indican que aumentar el n \& uacute;mero de ARUs (12 en este estudio) y
   reducir el tiempo de escucha por ARU (12 minutos) mejora la eficiencia
   del muestreo y permite una representaci \& oacute;n m \& aacute;s
   precisa de la biodiversidad local. El modelo SAR permiti \& oacute;
   estimar la diversidad alfa y beta en funci \& oacute;n del esfuerzo de
   muestreo. Luego, se analiz \& oacute; el efecto de la distancia entre
   grabadoras sobre la diversidad beta, observ \& aacute;ndose un aumento
   del 20\% en Campos y Malezales entre ARUs separadas por 500-1000 metros.
   En cambio, en Amazon \& iacute;a y Caatinga, donde las distancias fueron
   menores (200-250 m), el incremento fue mucho menor (0.8-5\%), lo que
   resalta la importancia de la configuraci \& oacute;n espacial para
   interpretar los patrones de recambio de especies. Estos hallazgos
   permiten desarrollar estrategias de muestreo m \& aacute;s eficientes y
   adaptables a distintos contextos ecol \& oacute;gicos, y son aplicables
   a otras regiones que utilizan PAM para evaluar comunidades biol \&
   oacute;gicas a gran escala.},
