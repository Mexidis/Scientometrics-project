@article{ WOS:001219682200001,
Author = {Cabrera, Sandra and Garcia-Vicente, Angeles and Gutierrez, Pamela and
   Sanchez, Andrea and Gaxiola, Miguel and Rodriguez-Bobadilla, Carolina
   and Selman, Moises and Pardo, Annie},
Title = {Increased ER Stress and Unfolded Protein Response Activation in
   Epithelial and Inflammatory Cells in Hypersensitivity Pneumonitis},
Journal = {JOURNAL OF HISTOCHEMISTRY \& CYTOCHEMISTRY},
Year = {2024},
Volume = {72},
