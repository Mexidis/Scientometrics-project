@article{ WOS:000665167600001,
Author = {Torres-Hernandez, A. and Brambila-Paz, F. and Iturraran-Viveros, U. and
   Caballero-Cruz, R.},
Title = {Fractional Newton-Raphson Method Accelerated with Aitken's Method},
Journal = {AXIOMS},
Year = {2021},
Volume = {10},
Number = {2},
Month = {JUN},
Abstract = {In the following paper, we present a way to accelerate the speed of
   convergence of the fractional Newton-Raphson (F N-R) method, which seems
   to have an order of convergence at least linearly for the case in which
   the order alpha of the derivative is different from one. A simplified
   way of constructing the Riemann-Liouville (R-L) fractional operators,
   fractional integral and fractional derivative is presented along with
   examples of its application on different functions. Furthermore, an
   introduction to Aitken's method is made and it is explained why it has
   the ability to accelerate the convergence of the iterative methods, in
   order to finally present the results that were obtained when
   implementing Aitken's method in the F N-R method, where it is shown that
   F N-R with Aitken's method converges faster than the simple F N-R.},
