@article{ WOS:000411534900007,
Author = {Maya, David and Pellicer-Covarrubias, Patricia and Pichardo-Mendoza,
   Roberto},
Title = {Induced mappings on the hyperspace of convergent sequences},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2017},
Volume = {229},
Pages = {85-105},
Month = {SEP 15},
Abstract = {The symbol S-c(X) denotes the hyperspace of all nontrivial convergent
   sequences in a Hausdorff space X. This hyperspace is endowed with the
   Vietoris topology. For a given mapping between Hausdorff spaces f : X ->
   Y, define the induced mapping Sc(f) by 8,(f)(A) = f {[}A] (the image of
   A under f) for every A is an element of S-e(X). In the current paper, we
   study under which conditions the fact that f belongs to a given class of
   mappings M implies that S-c(f) belongs to M, and vice versa. (C) 2017
   Elsevier B.V. All rights reserved.},
