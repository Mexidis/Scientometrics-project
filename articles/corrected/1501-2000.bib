@article{ WOS:000342607700011,
Author = {Mo, Edgar and Cetzal, William and Carnevali, German and Perez-Garcia,
   Eduardo and Basu, Saikat},
Title = {A new natural hybrid between Prosthechea cochleata and P.
   radiata (Orchidaceae) from Alta Verapaz, Guatemala},
Journal = {TURKISH JOURNAL OF BOTANY},
Year = {2014},
Volume = {38},
Number = {5},
Pages = {988-998},
Abstract = {A new natural hybrid between Prosthechea cochleata and P. radiata
   (Orchidaceae, Laeliinae) from the central part of Guatemala, P x
   chixoyensis Mo \& Cetzal, is herein described, illustrated, and
   characterized based on the morphological characters. The new
   nothospecies is most similar to P. cochleata but the petals are
   proportionally broader and the mucro of the labellum is subapical, as
   observed in P. radiata. Additionally, the perianth segments are neither
   as strongly reflexed as they are in P. cochleata nor patent as in P.
   radiata. A table of diagnostic characters for the new hybrid and its
   putative parents, a comparative figure, and a map showing their
   geographical distributions are also provided. Furthermore, a key to
   diagnose the hybrid from parental taxa and related species is also
   featured.},
