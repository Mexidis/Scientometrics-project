@article{ WOS:001607021000001,
Author = {Rivera-Herrera, Montserrat and Alcocer, Javier and Palma-Castro,
   Alejandro and Sanchez-Carrillo, Salvador and Garcia-Oliva, Felipe and
   Vargas-Sanchez, Mariana and Soria-Reinoso, Ismael and Oseguera, Luis A.},
Title = {Ecological Impacts of Land-use and Land-Cover Change in a Tropical
   Karst: The Río Grande de Comitán Basin, Mexico (1974-2025)},
Journal = {EARTH SYSTEMS AND ENVIRONMENT},
Year = {2025},
Month = {2025 NOV 1},
Abstract = {This study analyzes land-use and land-cover change (LULCC) in the R \&
   iacute;o Grande de Comit \& aacute;n Basin (RGCB), Chiapas, Mexico, from
   1974 to 2025, using Landsat satellite imagery and supervised
   classification techniques. Over the past 50 years, the RGCB has
   undergone a significant transformation: forest cover declined by 23.5\%,
   while agricultural land remained the dominant land use, peaking in 1999.
   Urban settlements expanded rapidly, particularly around Comit \&
   aacute;n de Dom \& iacute;nguez city, contributing to the loss of
   natural vegetation and increased landscape fragmentation. The Montebello
   lakes, a karstic system located in the southeastern part of the basin,
   have been significantly affected by these changes. Plateau lakes, which
   are hydrologically connected to the Grande de Comit \& aacute;n River
   and surrounded by agricultural and urban land, have undergone
   progressive eutrophication since the 1990s. In contrast, mountain lakes
   remain oligotrophic due to their surface isolation and surrounding
   forest cover. Our findings highlight the spatial and temporal dynamics
   of LULCC and their ecological consequences in a tropical karst
   watershed. The results underscore the need for inte-grated land-use
   planning, improved wastewater management, and conservation strategies to
   protect the region's vulnerable aquatic ecosystems. Graphical Abstract
   This study investigates land use and land cover change (LULCC) in the
   Rio Grande de Comit \& aacute;n Basin (RGCB), Chiapas, Mexico, from 1974
   to 2025. A karstic lake district with more than 130 water bodies is
   situated in the lower southeastern part of the RGCB. Using Landsat
   imagery from five decades, we tracked LULCC dynamics through supervised
   classifica-tion based on a maximum likelihood algorithm, validated with
   field data and official land use maps. Our results showed a continued
   increase in agricultural land and urban areas, which covered 64.6\% of
   the total basin at the expense of forest cover, which declined by 23.5\%
   over the study period. In the early 1990s, the lakes on the NW plateau
   became eutrophic, while the lakes in the SE mountainous region have
   remained oligotrophic. Our findings indicate that the change in LULCC
   has led to the trophic degradation of the Montebello lakes, mainly due
   to nutrient-rich runoff from agricultural land and poor wastewater
   management treatment. These changes are closely connected to historical
   land reforms, population growth, and economic pressures. This study
   emphasizes the importance of integrating basin-wide remote sensing for
   long-term environ-mental assessments and the potential impacts on
   aquatic ecosystems.},
Publisher = {SPRINGER INT PUBL AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Alcocer, J (Corresponding Author), Univ Nacl Autonoma Mexico, FES Iztacala, Grp Invest Limnol Trop, Tlalnepantla, Estado De Mexic, Mexico.
