@article{ WOS:001584617300007,
Author = {Antonyan, S. A. and van Mill, J. and West, J. E.},
Title = {Based-free involutions},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2025},
Volume = {374},
Month = {NOV 15},
Abstract = {Let B denote the closed unit ball of Hilbert space l2 endowed with the
   standard involution sigma : x -{*} -x. It is proved that for every
   separable metrizable space (X, tau) with a based-free involution (i.e.,
   an involution that has a unique fixed point), the equivariant maps (X,
   tau)-{*} (B, sigma) separate points and closed sets in X. This is
   applied to give a direct proof of a result by the second two authors
   {[}10] that (l2, sigma) is universal for all based-free involutions. Two
   new characterizations of equivariant based-free compactifications are
   given. (c) 2025 Elsevier B.V. All rights are reserved, including those
   for text and data mining, AI training, and similar technologies.},
