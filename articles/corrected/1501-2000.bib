@article{ WOS:001607260200001,
Author = {Pinedo-Escatel, J. Adilson and Blanco-Rodriguez, Edith and Jarillo,
   Antonio Marin and Becerra-Chiron, Iskra M. and Torres-Moreno, Rosaura
   and Vega-Ovando, Fabricio R. and Chavez-Gutierrez, M. Victoria and
   Baez-merino, Alejandra and Ortiz-tovar, Victor H. and Brailovsky, Harry},
Title = {Annotated type catalogue of the leafhoppers and treehoppers (Insecta:
   Hemiptera: Auchenorrhyncha) deposited in the collection of Instituto
   Nacional de Investigaciones Forestales, Agrícolas y Pecuarias,
   Guanajuato, Mexico},
Journal = {ZOOTAXA},
Year = {2025},
Volume = {5691},
Number = {2},
Pages = {151-192},
Month = {SEP 9},
Abstract = {The Insect Collection of the Instituto Nacional de Investigaciones
   Forestales, Agr \& iacute;colas y Pecuarias (CNI-INIFAP) in Guanajuato
   state is one of the oldest collections in Mexico with remarkable and
   historical holding of 240,000 specimens primarily composed of insect
   orders of economic importance. With 14,500 specimens obtained over 70
   years from most agricultural areas in Mexico, Auchenorrhyncha is well
   represented in the collection, but has received little attention and its
   value has been largely ignored in research. However, it holds a valuable
   stock of types designated by taxonomic authorities such as James P.
   Kramer, David Young Jr., Robert F. Ruppel, Dwight M. DeLong, and
   Charles. C. Plummer. Here, an annotated Auchenorrhyncha catalogue of the
   Insect Collection of the INIFAP is presented. Complete information for
   each species, including those designated as types, specialized
   references, labels data from original description, and high-quality
   photographs are given. A total of 28 types (one holotype and 27
   paratypes) are listed, of which six species belong to Membracidae and 22
   to Cicadellidae. A total of 147 Auchenorrhyncha species are retained
   into the INIFAP collection, 132 spp. of 68 genera for leafhoppers and 12
   spp. of six genera for treehoppers. Three leafhopper species: Parallaxis
   ornata Osborn, 1928, Rhabdotalebra signata (McAtee, 1926), and
   Diceratalebra sanguinolinea (Baker, 1903), are presented as new records
   for Mexico.},
