@article{ WOS:001621420200004,
Author = {Rodriguez-Millan, Ambar and Lopez-Uriarte, Ernesto and Rosas, Carlos and
   Cruz-Lopez, Honorio and Vargas-Abundez, Arturo and Cisneros-Gaytan,
   Sergio and Perez-Munoz, Alejandro and Gallardo, Pedro},
Title = {Effect of maternal diet on the fecundity and biochemical composition of
   eggs of the octopus Octopus hubbsorum Berry, 1953
   (Mollusca:Cephalopoda)},
Journal = {AQUACULTURE},
Year = {2026},
Volume = {613},
Number = {1},
Month = {FEB 1},
Abstract = {The present study focuses on determining the optimal dietary for the
   octopus species Octopus hubbsorum, with a specific emphasis on improving
   the reproductive performance of female individuals. Three experimental
   diets were formulated using distinct protein sources: crab (Callinectes
   arcuatus), squid (Dosidicus gigas), and fish (Epinephelus labriformis).
   Diet A contained 23 \% crab and 71 \% squid mantle; diet B contained 30
   \% crab and 62 \% fish muscle; diet C contained 26 \% crab, 40 \% squid
   mantle, and 27 \% fish muscle. A fourth diet (D) was used as a
   reference, consisting only of fresh crab. The diets (68 and 9.2 of
   protein and lipids respectively) were provided ad libitum to 4 female
   breeders per diet with an average body weight of 485 +/- 92 g. Egg
   production was quantified, and morphometric parameters such as egg
   length, width, eye diameter, arm length, and yolk volume were recorded
   at midpoint and final embryonic development stages (11 and 18 days).
   Females fed diet B were the ones that spawned the highest average of
   eggs, although no differences were observed among diets. Principal
   component analysis revealed that egg characteristics were influenced by
   fatty acids including tridecanoic (C13:0), stearic (C18:0), tricosanoic
   (C23:0), paulinic (C20:1n7), hexadecadienoic (C16:2n4), gamma-linolenic
   (C18:3n6), and arachidonic acid (ARA, C20:4n6). The most abundant amino
   acids in the diets were glutamic acid, glycine, and arginine, while
   taurine, glutamate, and leucine predominated in the eggs. These findings
   suggest that diet B enhances the reproductive performance of O.
   hubbsorum, underscoring the importance of mixed diets in optimizing
   sustainable aquaculture strategies.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
