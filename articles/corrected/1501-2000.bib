@article{ WOS:A1985AEM9300027,
Author = {MORENOMARTINEZ, E and MANDUGANO, L and MENDOZA, M and VALENCIA, G},
Title = {USE OF FUNGICIDES FOR CORN SEED VIABILITY PRESERVATION},
Journal = {SEED SCIENCE AND TECHNOLOGY},
Year = {1985},
Volume = {13},
Number = {1},
Pages = {235-241},
Abstract = {Two storage experiments were carried out on the effect of different
   application rates of 6 fungicides on the viability of stored maize
   {[}Zea mays] seed. The tested fungicides were benomyl, captafol, captan,
   carbendazim maneb, chlorothalonil and thiabendazole. Seeds of the hybrid
   `'H-412'' were adjusted to 16.0\% moisture content and treated with the
   fungicides at rates of 750 and 1125 ppm of active ingredient. In another
   storage experiment seeds of the cultivar VS-524 with a moisture content
   of 12.5 were treated with the same fungicides at rates of 125 and 750
   ppm. Both storage experiments were carried out at 85\% RH {[}relative
   humidity] and 26.degree. C. The statistical analysis, in both cases,
   showed no significant differences between application rates, but
   significant differences were detected between treatments. The untreated
   seeds had lower germinations than the treated ones.},
