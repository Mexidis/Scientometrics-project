@article{ WOS:001568230300001,
Author = {Benitez-Flores, E. and Reyes-Montero, A. and Depablos-Rivera, O. and
   Carreno-Jimenez, B. and Acuautla, M. and Castaneda-Guzman, R.},
Title = {Exploring oxygen pressure effects on phase transitions, ferroelectric
   properties, and ultrasonic transducer performance in
   (Ba0.85Ca0.15)(Ti0.9Zr0.1)O3 thin films by pulsed laser deposition},
Journal = {THIN SOLID FILMS},
Year = {2025},
Volume = {827},
Month = {OCT 1},
Abstract = {This study investigates the effect of oxygen pressure (PO2) during
   pulsed laser deposition on the structural, ferroelectric, and
   piezoelectric properties of (Ba0.85Ca0.15)(Ti0.9Zr0.1)O3 thin films.
   Films were deposited at PO2 levels of 8.6, 10, 11.5, and 12.7 Pa. The
   optimal ferroelectric properties were observed at 10 Pa, with a remnant
   polarization of 2.97 mu C/cm2, a coercive field of 33.80 kV/cm, and a
   saturation polarization of 11.88 mu C/cm2, closely matching the target
   composition. X-ray diffraction and Raman spectroscopy confirmed the
   presence of a morphotropic phase boundary (MPB) near room temperature.
   The MPB shifts toward lower temperatures with increasing PO2, as
   characterized by the photoacoustic technique. Frequency measurements
   based on photoacoustic and piezoelectric effects demonstrated promising
   performance for piezoelectric micromachined ultrasonic transducers, with
   resonance frequencies ranging from 9.5 to 13 MHz.},
