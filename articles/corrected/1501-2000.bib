@article{ WOS:001128004200001,
Author = {Skalny, Anatoly V. and Aschner, Michael and Tsatsakis, Aristidis and
   Rocha, Joao B. T. and Santamaria, Abel and Spandidos, Demetrios A. and
   Martins, Airton C. and Lu, Rongzhu and Korobeinikova, Tatiana V. and
