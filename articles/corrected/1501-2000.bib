@article{ WOS:000188978400040,
Author = {Phelps, DS and Umstead, TM and Mejia, M and Carrillo, G and Pardo, A and
   Selman, M},
Title = {Increased surfactant protein-A levels in patients with newly diagnosed
   idiopathic pulmonary fibrosis},
Journal = {CHEST},
Year = {2004},
Volume = {125},
Number = {2},
Pages = {617-625},
Month = {FEB},
Abstract = {Study objectives: To measure surfactant protein-A (SP-A) in the BAL of
   patients with idiopathic pulmonary fibrosis (IPF).
   Design: We examined SP-A in BAL and lung tissue of patients with IPF who
   met the stricter recommended criteria for IPF at the time of diagnosis
   and prior to the beginning of treatment.
   Patients: Twenty-six patients with IPF confirmed at biopsy and 22
   patients with hypersensitivity pneumonitis (HP) were compared with 9
   normal volunteers.
   Interventions: All patients were subjected to pulmonary function
   testing, BAL, and lung biopsy prior to the beginning of treatment.
   Measurements and results: We measured SP-A in BAL fluids and performed
   SP-A immunohistochemistry on lung specimens. Lung tissues of patients
   with IPF showed extensive type II cell hyperplasia, usually containing
   greatly increased levels of immunoreactive SP-A. By enzyme-linked
   immunosorbent assay, we found a twofold increase over normal values in
   BAL SP-A without changes in total phospholipids. These data were in
   agreement with semiquantitative assessments of SP-A by protein
   immunoblotting and by Western blotting of sodium dodecyl sulfate gels.
   Patients with HP exhibited a threefold increase of BAL SP-A.
   Conclusions: The reasons for the difference between our results and
   previously published reports describing decreased SP-A levels in OF is
   not clear. It may relate to the stricter criteria for diagnosis, the
   absence of treatment prior to BAL, differences in the patient
   population, or to other methodologic differences.},
