@article{ WOS:000229166400018,
Author = {Pellicer-Covarrubias, P},
Title = {The hyperspaces K(X)},
Journal = {ROCKY MOUNTAIN JOURNAL OF MATHEMATICS},
Year = {2005},
Volume = {35},
Number = {2},
Pages = {655-674},
Abstract = {Let C(X) denote the hyperspace of subcontinua of a continuum X. For p is
   an element of X, define the hyperspaces C(p,X) = \{A is an element of
   C(X) : p is an element of A\} and K(X) = \{C(p,X) : p is an element of
   X\}. The hyperspace K(X) is not always a continuum. Conditions under
   which it is compact, connected, arcwise connected and locally connected
   are studied. A characterization of hereditarily indecomposable continua
   is also given.},
