Year = {1989},
Volume = {76},
Number = {1},
Pages = {128-135},
Abstract = {A new family, genus {[}LACANDONIA] and species {[}L. schismetica] are
   described. The new family is placed in Triuridales. It differs from
   Triuridaceae by the unexpected and unknown elsewhere position of the
   gynoecium, which surrounds the androecium, and by the introrsely
   dehiscent anthers. This is the first record of the order for Mexico.},
