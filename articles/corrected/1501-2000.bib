@article{ WOS:000711895800001,
Author = {Alejandro Ramos-Fabiel, Melbi and Martorell, Carlos},
Title = {Testing competing hypotheses about the behaviour of floral visitors in
   mixed-flower stands},
Journal = {ECOLOGICAL ENTOMOLOGY},
Year = {2022},
Volume = {47},
Number = {2},
Pages = {158-169},
Month = {APR},
Abstract = {1. Plants occur in mixed stands and flower simultaneously. Most
   hypotheses about how flowers affect the visitation rates of conspecific
   or heterospecific neighbours involve attractiveness. Attractive flowers
   are thought to monopolise visitors, but also to act as magnets
   increasing visits to unattractive neighbours. Attractiveness may be
   density-dependent: Visitors could profit from focusing on abundant
   species, sometimes forming search images that make rare flowers less
   detectable. 2. We tested four hypotheses using data on visitation rates
   by honeybees (Apis melifera) and bee flies (Bombyliidae) to 1072 stands
   comprising six plant species in different densities. Hypotheses were
   compared through multi-model inference using the disc equation (a
   functional response model) modified for co-flowering species and
   density-dependent attractiveness. 3. We found that the most attractive
   flowers had attributes (colour, position, mobility) that elicit strong
   responses in the sensory apparatus of each type of visitor. 4.
   Attractiveness usually increased with conspecific floral density,
   indicating that visitors focus on abundant species. The most attractive
   flowers strongly reduced the attractiveness of their neighbours,
   reinforcing visitor monopolisation. However, mildly attractive species
   increased the attractiveness of less alluring flowers, acting as
   magnets. 5. In bombyliids, flowers increased the attractiveness of
   same-coloured heterospecifics but reduced it when colours differed,
   suggesting search-image formation. The results were similar for both
   types of visitors but were weaker and less consistent in honeybees. This
   suggests that Apis behaviour is not as rapidly adjusted to local
   densities as that of bombyliids, perhaps because of longer-term memory
   or a strong role of sociality in determining individual behaviour.},
