   Escobar, M. L.; Echeverria, O. M.; Ortiz, R.; Vazquez-Nin, G. H., Univ Nacl Autonoma Mexico, Fac Sci, Dept Cell Biol, Mexico City 04510, DF, Mexico.},
DOI = {10.1007/s10495-008-0248-z},
ISSN = {1360-8185},
EISSN = {1573-675X},
