@inproceedings{ WOS:000433124000014,
Author = {Sanchez, A. and Guerra, K. Y. and Porta, A. V. and Orozco, S.},
Editor = {HernandezCalderon, I and Henini, M},
Title = {Theoretical Study of the Transmission Properties of a One-Dimensional
   Polycarbonate-Liquid Photonic Array},
Booktitle = {8TH INTERNATIONAL CONFERENCE ON LOW DIMENSIONAL STRUCTURES AND DEVICES
   (LDSD 2016)},
Series = {AIP Conference Proceedings},
Year = {2018},
Volume = {1934},
Note = {8th International Conference on Low Dimensional Structures and Devices
   (LDSD), MEXICO, AUG 28-SEP 02, 2016},
Abstract = {The opto-fluidics systems can be used for label free refractometric and
   biosensensing applications. In this work transmission properties of
   one-dimensional polycarbonate-liquid photonic arrays are studied, where
   methanol and ethanol were proposed as liquid components. The band
   structure and the transmission spectrum were calculated using the
   transference matrix method, in which we consider the dispersion relation
   for the refractive index n(w) of each material in the visible range.
   Using lattice parameters of 1 mu m, 10 mu m, and 4 mu m, we obtained
   forbidden bandgaps in the visible region. When lattice parameters of
   1000 mu m were considered, we obtained several narrow bandgaps in the
   visible range.},
