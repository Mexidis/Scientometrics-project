@article{ WOS:001233825800001,
Author = {Polanco, Carlos and Uversky, Vladimir N. and Huberman, Alberto and
   Pimentel-Hernandez, Claudia and Castro, Martha Rios and Hernandez-Lemus,
   Enrique and Buhse, Thomas and Alarcon, Gilberto Vargas and Gomez,
   Francisco J. Roldan and Martinez-Garcia, Mireya and Corona, Gabriela
   Calvo-Leroux and Becerra-Luna, Brayans and Gutierrez Juarez, Cynthia
   Karen and Diaz Gonzalez, Juan Luciano and Martinez-Memije, Raul and Ch,
   Pedro L. Flores},
Title = {Bioinformatics Characteristics and Genomic Patterns of the Envelope
   Glycoproteins of the Crimean-congo Hemorrhagic Fever Viruses},
Journal = {CURRENT ANALYTICAL CHEMISTRY},
Year = {2025},
Volume = {21},
Number = {2},
Pages = {106-123},
Abstract = {Background Rodents and many wild and domestic animals, including cattle,
   donkeys, goats, hares, ostriches, and sheep, spread the Crimean-Congo
   Hemorrhagic Fever Virus (CCHFV), acting as hosts for infected ticks
   primarily of the Hyalomma genus, which serve as vectors and reservoirs
   of the virus. CCHF is a severe, potentially lethal, and widespread
   disease, making it a serious public health issue. Environmental changes
   impacting rodent populations affect their global distribution and,
   therefore, play a role in the spread of CCHFV.Objective This study aims
   togain a deeper understanding of the envelope glycoproteins expressed by
   the CCHFV.Methods Multiple computational algorithms determined the
   Intrinsic Disorder Predisposition (PIDP), Polarity Index, and genomic
   profiles of each sequence of the glycoproteins.Results When examining
   the Polarity Index Method Profile, 3.0v profile, and the PIDP profile,
   the envelope glycoproteins of the CCHFV showed different patterns. With
   these patterns, it was possible to identify structural and morphological
   similarities.Conclusion With the PIM 3.0v profile, our computer programs
   were able to identify isolated CCHFV envelope glycoproteins. We believe
   that this research provides a deeper understanding of this virus.},
