@article{ WOS:001625073600004,
Author = {Benitez-Bobadilla, German and Pastrana-Ramirez, Laura},
Title = {In-domatic number and some operations in digraphs},
Journal = {ARS MATHEMATICA CONTEMPORANEA},
Year = {2026},
Volume = {26},
Number = {1},
Abstract = {Let D be a digraph, a subset S of V (D) is called in-dominating set in D
   if for each vertex x is an element of V (D) \textbackslash{} S there is
   a vertex w is an element of S such that (x, w) is an element of A(D). An
   in-domatic partition of D is a partition of V (D) where all parts are
   in-dominating sets in D. The maximum number of parts of an in-domatic
   partition of D is the in-domatic number of D and it is denoted by d-(D).
   In this work, the in-domatic number for some families of digraphs such
   as complete digraphs, transitive digraphs, directed cycles and the
   cartesian product of two cycles, is calculated. Also, in-domatically
   critical digraphs are characterized. Additionally, the indomatic
   partitions of the line digraph and some other operations which reflect
   the adjacency and incidence relations in digraphs are explored.},
Publisher = {UP FAMNIT},
Address = {GLAGOLJASKA 8, KOPER, SI-6000, SLOVENIA},
