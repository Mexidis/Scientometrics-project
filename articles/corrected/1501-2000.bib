@article{ WOS:001596206400001,
Author = {Vargas-Bustamante, J. and Benitez-Flores, E. and Duran-Alvarez, Juan C.
   and Serrano-Lazaro, Amauri and Pilo, J. and Antonio, J. E. and Munoz, H.
   and Cervantes, J. M. and Arevalo-Lopez, E. P. and Escamilla, R. and
   Romero, M.},
Title = {Hierarchically structured NiFe2O4 /CeO2
   nanocomposites for visible light photocatalytic degradation of
   oxytetracycline},
Journal = {JOURNAL OF PHOTOCHEMISTRY AND PHOTOBIOLOGY A-CHEMISTRY},
Year = {2026},
Volume = {472},
Month = {MAR 1},
Abstract = {Nickel ferrite (NiFe2O4, NFO)/cerium dioxide (CeO2) nanocomposites
   (NFCs) with varying ratios were synthesized by a hydrothermal route and
   tested as photocatalysts for oxytetracycline (OTC) degradation under
   visible light. Unlike conventional ferrite-ceria composites, this work
   introduces hierarchical flowerlike architectures with reduced
   crystallite sizes (approximate to 8.2 nm-10 nm) and an S-scheme
   (broken-gap) heterojunction that promotes efficient charge separation.
   Structural and spectroscopic analyses, including X-ray diffraction
   (XRD), X-ray photoelectron spectroscopy (XPS), scanning electron
   microscopy (SEM), infrared spectroscopy (IR), and ultraviolet-visible
   diffuse reflectance spectroscopy (UV-Vis DRS) confirmed strong
   interfacial coupling and defect-rich surfaces, enhancing redox activity.
   Among the samples, NFC4 achieved the highest degradation efficiency
   (84.72\%), while NFC1 exhibited the fastest kinetics (k = 0.0122
   min(-1)). Scavenger tests identified hydroxyl radicals ( <middle dot>
   OH) as the main active species, synergistically assisted by Fe3+/Fe(2+
   )and Ni3+/Ni(2+ )redox cycling through a photo-Fenton-like pathway. The
   composites showed high stability, with NFC4 retaining >96\% activity
   after four reuse cycles. These findings highlight the novelty of
   designing hierarchical NFO/CeO2 nanocomposites as efficient, durable,
   and magnetically recoverable photocatalysts for the visible-light
   remediation of emerging pharmaceutical contaminants.},
Publisher = {ELSEVIER SCIENCE SA},
Address = {PO BOX 564, 1001 LAUSANNE, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Romero, M (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias, AP 70-399, Ciudad De Mexico 04510, Mexico.
   Vargas-Bustamante, J.; Benitez-Flores, E.; Pilo, J.; Antonio, J. E.; Arevalo-Lopez, E. P.; Romero, M., Univ Nacl Autonoma Mexico, Fac Ciencias, AP 70-399, Ciudad De Mexico 04510, Mexico.
   Duran-Alvarez, Juan C.; Serrano-Lazaro, Amauri, Univ Nacl Autonoma Mexico, Inst Ciencias Aplicadas \& Tecnol, AP 70-360, Ciudad De Mexico 04510, Mexico.
   Munoz, H.; Cervantes, J. M.; Escamilla, R., Univ Nacl Autonoma Mexico, Inst Invest Mat, AP 70-360, Ciudad De Mexico 04510, Mexico.},
DOI = {10.1016/j.jphotochem.2025.116803},
EarlyAccessDate = {OCT 2025},
