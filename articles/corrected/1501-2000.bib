@article{ WOS:A1982NP54700001,
Author = {MARQUEZGUZMAN, J and LAGUNAHERNANDEZ, G},
Title = {SEED ANATOMY AND GERMINATION OF TURBINA-CARUMBOSA (L) RAF,
   CONVOLVULACEAE},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1982},
Volume = {42},
Number = {1},
Pages = {1-8},
Abstract = {The seed of T. corymbosa is small, oval, red-chestnut colored and of
   velvety aspect due to fine hairs covering the surface. The seed coat
   consists of: epidermis and subepidermis, both single layered;
   sclerenchymatous palisade, formed by 2-3 layers (in its outer edge is
   located the light line); and several layers of parenchymatous crushed
   cells traversed by the vascular bundle. In the pad zone there is a
   multilayered epidermis. The endosperm consists of a living cell layer
   and cell wall debris. The embryo has long and flat cotyledons. They are
   folded and partially surround the embrionary axis. The hard and
   waterproof seed coat hinders the germination; this may be overcome by
   scarification.},
