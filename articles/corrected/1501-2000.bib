@article{ WOS:001451286000001,
Author = {Furmanczyk, Hanna and Zuazua, Rita},
Title = {Adjacent vertex distinguishing total coloring of corona product of
   graphs},
Journal = {ARS MATHEMATICA CONTEMPORANEA},
Year = {2020},
Volume = {25},
Number = {2},
Abstract = {An adjacent vertex distinguishing total k-coloring f of a graph G is a
   proper total k coloring of G such that no pair of adjacent vertices has
   the same color sets, where the color set at a vertex v, CfG(v), is \{f
   (v)\} boolean OR \{f(vu)|u is an element of V(G),vu is an element of
   E(G)\}. In 2005 Zhang et al. posted the conjecture (AVDTCC) that every
   simple graph G has adjacent vertex distinguishing total (triangle(G) +
   3)-coloring. In this paper we confirm the conjecture for many types of
   coronas, in particular for generalized, simple and l-coronas of graphs,
   not relating the results to particular graph classes of the factors.},
