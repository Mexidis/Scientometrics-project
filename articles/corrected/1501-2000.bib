@article{ WOS:A1980KA37600003,
Author = {PEREZTAMAYO, R and MONTFORT, I and PARDO, A},
Title = {WHAT CONTROLS COLLAGEN RESORPTION INVIVO},
Journal = {MEDICAL HYPOTHESES},
Year = {1980},
Volume = {6},
Number = {7},
Pages = {711-726},
Abstract = {The local control of collagen degradation in mammals in vivo depends
   primarily on variations on the level of activity of specific
   collagenases. Such variations apparently depend on 3 factors: the rate
   of active collagenase synthesis and/or of activation of inactive enzyme
   precursors, the action of serum and/or tissue collagenase inhibitors
   different combinations of both mechanisms. Apparently another element
   contributing to the regulation of collagen degradation in vivo is the
   substrate susceptibility. Support for this suggestion is derived from 2
   sources: experimental data, indicating that the rate of collagen
   degradation depends on the genetic type of substrate, on its state of
   aggregation (including degree of cross-linking) the nature and amount of
   other macromolecules associated with collagen in vivo, the universal
   presence of collagen-bound collagenase, the apparent greater affinity of
   the enzyme for the more recently synthetized substrate molecules and the
   increased amounts of intact collagen that may be solubilized from some
   tissues undergoing massive collagen degradation; analogy with
   intracellular protein catabolism mechanisms, which cannot be rejected a
   priori as irrelevant to the problem.},
Publisher = {ELSEVIER},
