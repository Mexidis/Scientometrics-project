   Cruz-Irisson, Miguel},
Title = {Doped silicene for acetone molecule trapping and sensing: DFT
   calculations},
Journal = {MATERIALS LETTERS},
Year = {2026},
Volume = {404},
Month = {FEB 1},
Abstract = {Density functional theory calculations were employed to investigate the
   electronic and detection properties of bare silicene and M-doped
   silicene (M = B, Al, Ga). The geometrical stability of M-doped silicene
   was confirmed based on substitution energy. The primary objective of
   this study was to detect acetone and facilitate the early detection of
   diseases, such as diabetes, using M-doped silicene as the base
   nanomaterial. The adsorption of acetone molecules onto both pristine and
   M-doped silicene was examined. This was done focusing on key parameters
   such as adsorption energy, work function and molecular dynamics.
   Furthermore, the interaction of acetone with M-doped silicene altered
   the adsorption energy of pristine silicene (0.5 eV), which ranged from
   0.87 to 1.32 eV.},
