@article{ WOS:001607788200029,
Author = {Zamarron-Montes, L. and Espinosa-Gonzalez, D. and Espinosa-Magana, F.},
Title = {Effect of Mn doping on the piezoelectric and ferroelectric properties of
   orthorhombic KNbO3 nanofibers},
Journal = {CERAMICS INTERNATIONAL},
Year = {2025},
Volume = {51},
Number = {27, C},
Pages = {55773-55781},
Month = {NOV},
Abstract = {Pure and Mn-doped potassium niobate nanofibers with Mn concentrations of
   2.5 \%, 5 \%, and 10 \% were synthesized using the electrospinning
   method. The morphology, microstructure, and crystal structure of as-spun
   and annealed composite nanofibers were characterized by scanning
   electron microscopy (SEM), X-ray diffraction (XRD), and transmission
   electron microscopy (TEM). With the use of Raman spectroscopy, the sites
   where Mn ions enter the doped structures were established by recording
   the shift and width of peaks in Mn-doped structures with respect to pure
   potassium niobate. We were able to prove that, at low Mn concentrations,
   Mn ions enter the Nb sites, while at higher concentrations, the dopant
   substitutes for both K and Nb sites. First-principles calculations were
   performed within the density functional theory (DFT), including
   lattice-dynamics calculations of the phonon modes at the zone center
   (Gamma point), for the pure structure to find the irreducible
   representation (IR) of the modes. The piezoelectric and ferroelectric
   properties of pure and Mn-doped nanofibers were probed by switching
   spectroscopy piezoresponse force microscopy (SS-PFM) analysis, and we
   found that the ferroelectric response in doped structures decreases
   compared to the pure sample.},
