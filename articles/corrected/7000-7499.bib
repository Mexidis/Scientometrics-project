   Sanchez Licea, Gerardo, Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Matemat, Mexico City 04510, DF, Mexico.},
DOI = {10.1093/imamci/dns011},
ISSN = {0265-0754},
Keywords = {optimal control; sufficient conditions for optimality; local minima;
   singularity; strengthened Legendre-Clebsch condition; equality
   constraints},
