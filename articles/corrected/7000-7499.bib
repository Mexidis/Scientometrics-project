Year = {2013},
Volume = {58},
Number = {3},
Pages = {325-329},
Month = {SEP},
Abstract = {We studied the reproductive cycle of female Sceloporus aeneus from a
   population southeast of Mexico City (Milpa Alta), Mexico, from April
   1993-March 1994. Females have a seasonal reproductive pattern with
   maximum activity in spring, a pattern typical of temperate oviparous
   species of the genus. Each female produces up to two clutches per
   breeding season, with a clutch size ranging from 4-10, which is not
   correlated with snout-vent length of females.},
