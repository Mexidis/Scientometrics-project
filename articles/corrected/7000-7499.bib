@article{ WOS:000315838300005,
Author = {Zuniga, Oscar and Olivares, Alberto and Rojo, Manuel and Eugenia Chimal,
   Maria and Diaz, Fernando and Uriarte, Iker and Rosas, Carlos},
Title = {Thermoregulatory behavior and oxygen consumption of Octopus mimus
   paralarvae: The effect of age},
Journal = {JOURNAL OF THERMAL BIOLOGY},
Year = {2013},
Volume = {38},
Number = {2},
Pages = {86-91},
Month = {FEB},
Abstract = {Octopus mimus is an important cephalopod species in the coastal zone of
   Peru and Chile that is exposed to temperature variations from time to
   time due to El Nino/Southern Oscillation (ENSO) episodes when surface
   temperatures can reach 24 degrees C, 6 degrees C above typical
   temperatures in their habitat. The relationships between temperature and
   food availability are important factors that determine the recruitment
   of juveniles into the O. mimus population. The present study was to
   evaluate the relationship between thermoregulatory behavior and the age
   of paralarvae (summer population) to determine whether changes in this
   behavior occur during internal yolk consumption, making larvae more
   vulnerable to environmental temperature change. Oxygen consumption of
   paralarvae when 1-4 d old was determined to establish if respiration
   could be used to monitor the physiological changes that occur during
   yolk consumption. Horizontal thermal selection (17-30 degrees C),
   critical thermal maxima (CTMax), minima (CTMin), and oxygen consumption
   experiments were conducted with fasting paralarvae 1-4 d old at 20
   degrees C. Preferred temperatures were dependent on the age of O. mimus
   paralarvae. One day old paralarvae selected a temperature 1.1 degrees C
   (23.4 degrees C) higher than 2 - 4 d old paralarvae (22.3 degrees C).
   The CTMax of paralarvae increased with age with values of 31.9 +/- 1.1
   degrees C in 1-d-olds and 33.4 +/- 0.3 to 4-d-olds. CTMin also changed
   with age with low values in 2-d-old paralarvae (9.1 +/- 1.3 degrees C)
   and 11.9 +/- 0.9 degrees C in 4-d-old animals. The temperature tolerance
   range of paralarvae was age-dependent (TTD=difference between CTMax and
   CTMin) with higher values in 2 and 3 d old paralarvae (25-26 degrees C)
   as compared to 1 d old (23.1 degrees C) and 4 d old animals (22.7
   degrees C). Oxygen consumption was not affected by the age of
   paralarvae, suggesting that mechanisms exist that compensate their
   metabloism until at least 4 d of age. The temperature tolerance range of
   a planktonic paralarvae of octopus species is presented for the first
   time. This range was dependent on the age of paralarvae, and so rendered
   the paralarvae more vunerable to a combination of high temperature and
   food deprivation during first days of life. Results in the present study
   provide evidence that O. mimus could be under ecological pressure if a
   climate change causes increased or decreased temperatures into their
   distribution range. (c) 2012 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
