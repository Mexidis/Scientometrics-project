@inproceedings{ WOS:000346699806044,
Author = {Francisco Peraza-Garzon, Juan and Estrada-Lizarraga, Rogelio and
   Zaldivar-Colado, Anibal and Mendoza-Zatarain, Rafael and del Carmen
   Olivarria-Gonzalez, Monica and Peraza-Garzon, Alvaro and Zaragoza
   Gonzalez, Jose Nicolas and Alfredo Cobian-Campos, Jose},
Editor = {Chova, LG and Martinez, AL and Torres, IC},
Title = {IMPLEMENTATION OF ``IBOOKS AUTHOR{''} ON THE DEVELOPMENT OF LEARNING
   OBJECTS ON BLENDED LEARNING EDUCATION},
Booktitle = {7TH INTERNATIONAL TECHNOLOGY, EDUCATION AND DEVELOPMENT CONFERENCE
   (INTED2013)},
Series = {INTED Proceedings},
Year = {2013},
Pages = {6320-6325},
Note = {7th International Technology, Education and Development Conference
   (INTED), Valencia, SPAIN, MAR 04-06, 2013},
Abstract = {The advance on the development of new technologies has evolved
   exponentially in recent years. This improvement has a direct impact on
   education where there are now very popular tools for conducting
   electronic academic presentations as ``Power Point{''}, ``Adobe
   Reader{''} (PDF) and ``Prezi{''} because of its compatibility with
   different platforms and its simplicity on interface management.
   Recently arises a new option that combines static text with multimedia
   objects, this could improve learning objects known as now and opens new
   ways for education using ``iBooks Author{''} the first truly intuitive
   and easy tool for publishing eBooks, a strong multimedia component.
   {[}1]
   ``IBooks Author{''} offers a new world of possibilities where auto
   edition is reachable to anyone without (or with very little) prior
   knowledge, eBooks can be published in a visual and simple way.
   Textbooks are just one example, the possibilities go far beyond. The
   Faculty of Computing Mazatlan, in Autonomous University of Sinaloa in
   its implementation of a degree of blended learning mode, uses iBook
   Author to digitalize its classes in an interactive way in which teachers
   can keep their teaching materials on an e-portfolio server which,
   according to Greenberg (2004) {[}2], the e-portfolio is a Network
   Application that provides the author with administrative functions for
   managing and organizing work (files) created with different applications
   and for controlling who can see the work and who can discuss the work
   (access).
   This gives the student the opportunity not only to see the content but
   also to hear the multimedia teaching material, as many times as
   necessary, and strengthen their learning in a much more attractive. All
   this without being in person at the university, only by visiting the
   e-portfolio hosted on some service of ``Cloud Computing{''}.
   In this sense, this paper attempts to measure the level of feasibility
   on the implementation of this new technology and the replacement of any
   other format through an analysis of acceptance with students that
   consult materials developed with ``iBooks Author{''} from Apple, within
   the learning management system used in the Faculty.},
