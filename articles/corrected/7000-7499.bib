@article{ WOS:000328551800002,
Author = {De los Rios-Escalante, Patricio and Morrone, Juan J. and Rivera,
   Reinaldo},
Title = {A CHECKLIST OF HYALELLA (AMPHIPODA) FROM CHILE},
Journal = {CRUSTACEANA},
Year = {2013},
Volume = {86},
Number = {12, SI},
Pages = {1426-1432},
Abstract = {Distributional patterns in Chile of species of the freshwater amphipod
   genus Hyalella were analysed. The results show that H. fossamanchini and
   H. kochi can be found in Andean mountain inland waters between 18-27
   degrees S, H. costera in coastal inland waters between 24-40 degrees S,
   H. chiloensis and H. patagonica in inland waters between 39-51 degrees
   S, and finally H. simplex and H. franciscae in inland waters south of 44
   degrees S. The literature is mainly based on studies recording species
   in northern and southern Patagonia and the Atacama desert. Few studies
   on the presence of Hyalella have been carried out in central Chilean and
   northern and central Patagonian inland waters.},
