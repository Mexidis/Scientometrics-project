@article{ WOS:000314563100005,
Author = {Illanes, Alejandro and Martinez-Montejano, Jorge M.},
Title = {Concerning k-mutual aposyndesis in symmetric products},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2013},
Volume = {160},
Number = {2},
Pages = {292-295},
Month = {FEB 1},
Abstract = {Given a metric continuum X, let F-n (X) denote the hyperspace of
   nonempty subsets of X with at most n points. We prove that F-n (X) is
   k-mutually aposyndetic for every k >= 2 and n >= 3. That is, given k
   distinct elements in F-n (X), there are k disjoint subcontinua of F-n
   (X), each containing one of the elements in its interior. (C) 2012
   Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER SCIENCE BV},
