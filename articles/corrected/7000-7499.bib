@article{ WOS:000327036900003,
Author = {Bautista-Santiago, C. and Cano, J. and Fabila-Monroy, R. and
   Flores-Penaloza, D. and Gonzalez-Aguilar, H. and Lara, D. and Sarmiento,
   E. and Urrutia, J.},
Title = {On the Connectedness and Diameter of a Geometric Johnson Graph},
Journal = {DISCRETE MATHEMATICS AND THEORETICAL COMPUTER SCIENCE},
Year = {2013},
Volume = {15},
Number = {3},
Pages = {21-30},
Abstract = {Let P be a set of n points in general position in the plane. A subset I
   of P is called an island if there exists a convex set C such that I = P
   boolean AND C. In this paper we define the generalized island Johnson
   graph of P as the graph whose vertex consists of all islands of P of
   cardinality k, two of which are adjacent if their intersection consists
   of exactly l elements. We show that for large enough values of n, this
   graph is connected, and give upper and lower bounds on its diameter.},
