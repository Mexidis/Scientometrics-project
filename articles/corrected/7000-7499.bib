@article{ WOS:000311974800003,
Author = {Abrego, Bernardo M. and Fabila-Monroy, Ruy and Fernandez-Merchant,
   Silvia and Flores-Penaloza, David and Hurtado, Ferran and Meijer, Henk
   and Sacristan, Vera and Saumell, Maria},
Title = {Proximity graphs inside large weighted graphs},
Journal = {NETWORKS},
Year = {2013},
Volume = {61},
Number = {1},
Pages = {29-39},
Month = {JAN},
Abstract = {Given a weighted graph G = (V,E) and a subset U of V, we define several
   graphs with vertex set U in which two vertices are adjacent if they
   satisfy a specific proximity rule. These rules use the shortest path
   distance in G and generalize the proximity rules that generate some of
   the most common proximity graphs in Euclidean spaces. We prove basic
   properties of the defined graphs and provide algorithms for their
   computation. (c) 2012 Wiley Periodicals, Inc. NETWORKS, 2013},
