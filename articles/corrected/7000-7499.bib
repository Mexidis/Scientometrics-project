   Oliva, Malena; Montiel, Salvador; Garcia, Ana, IPN, CINVESTAV, Ctr Invest \& Estudios Avanzados, Dept Ecol Humana,Unidad Merida, Merida 97310, Yucatan, Mexico.
   Vidal, Laura, Univ Nacl Autonoma Mexico, Fac Ciencias, Unidad Acad Sisal, Hunucma 97356, Yucatan, Mexico.},
DOI = {10.1177/194008291400700414},
ISSN = {1940-0829},
Keywords = {Wildlife management; protected areas; stakeholder acknowledgement;
