Title = {On the geometric resolution of the Schwarzschild black hole singularity
   within effective loop quantum gravity models},
Booktitle = {IX MEXICAN SCHOOL ON GRAVITATION AND MATHEMATICAL PHYSICS: COSMOLOGY FOR
   THE XXIST CENTURY},
Series = {AIP Conference Proceedings},
Year = {2013},
Volume = {1548},
