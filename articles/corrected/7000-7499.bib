@article{ WOS:000310949600007,
Author = {Guillen-Burguete, S. and Sanchez-Larios, H. and Vazquez-Vazquez, J. G.},
Title = {An Optimal Transportation Schedule of Mobile Equipment},
Journal = {JOURNAL OF APPLIED RESEARCH AND TECHNOLOGY},
Year = {2012},
Volume = {10},
Pages = {713-723},
Month = {OCT},
Abstract = {Motivated by a problem faced by road construction companies, we develop
   a new model to obtain an optimal transportation schedule of mobile
   machines which have to travel to execute tasks. In this problem, each
   task is characterized by the location where it is to be executed, a
   work-content in terms of machine-time units, and one or more time
   intervals within which it can be performed. The machines can be
   transported from one location to another at any time, thus the problem
   has an indefinite number of variables. However, this indefinite number
   of variables can be reduced to a definite one because, as we prove, the
   problem has an optimal solution in which the arrivals of machines occur
   only at certain time instants. The objective is to minimize the total
   transportation cost such that all the tasks are executed within their
   time intervals. The constraints ensuring that the tasks are processed
   within their prescribed time intervals are nonlinear; nevertheless, due
   to the sets of the possible arrival times of the machines forming
   bounded convex polyhedra, our problem can be transformed into a mixed
   integer linear program by the same device used in the decomposition
   principle of Dantzig-Wolfe.},
Publisher = {UNIV NACIONAL AUTONOMA MEXICO},
Address = {APARTADO POSTAL 70-399, MEXICO CITY, D.F. 21, MEXICO},
Type = {Article},
Language = {English},
Affiliation = {Guillén-Burguete, S (Corresponding Author), Univ Nacl Autonoma Mexico, Inst Ingn, Mexico City 04510, DF, Mexico.
   Guillen-Burguete, S., Univ Nacl Autonoma Mexico, Inst Ingn, Mexico City 04510, DF, Mexico.
   Sanchez-Larios, H., Univ Nacl Autonoma Mexico, Fac Ingn, Mexico City 04510, DF, Mexico.
   Vazquez-Vazquez, J. G., Univ Nacl Autonoma Mexico, Fac Ciencias, Mexico City 04510, DF, Mexico.},
ISSN = {1665-6423},
Keywords = {transportation schedule; generalized linear programming; bounded convex
   polyhedron; work-content},
Keywords-Plus = {TIME WINDOWS; VEHICLE},
Author-Email = {herica.sanchez@ciencias.unam.mx},
