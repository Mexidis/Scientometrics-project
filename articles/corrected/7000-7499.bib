Year = {2014},
Volume = {162},
Pages = {34-42},
Month = {FEB 1},
Abstract = {Let CL(X) and K(X) denote the hyperspaces of non-empty closed and
   non-empty compact subsets of X, respectively, with the Vietoris
   topology. In this paper we show that, given an ordinal number gamma, the
   space K({[}0,gamma)) is C-embedded in CL({[}0,gamma)) if and only if
   cof(gamma) not equal omega. Moreover we answer some problems posed by
   the first author and Jun Terasawa. (C) 2013 Elsevier B.V. All rights
   reserved.},
