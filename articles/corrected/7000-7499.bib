@article{ WOS:000323212400021,
Author = {Berenice Mondragon, Aidee and Rodriguez-Legorreta, Jannet and Bashir
   Yousif, Farook and Elizabeth Fuentes, Beatriz and Martinez Valencia,
   Horacio and Rivera Islas, Marco Antonio},
Title = {Electronegativity of Hollow Cathode DC Discharge in O2
   Employing Electrostatic Probe Diagnostics},
Journal = {IEEE TRANSACTIONS ON PLASMA SCIENCE},
Year = {2013},
Volume = {41},
Number = {8, 3},
Pages = {2387-2393},
Month = {AUG},
Abstract = {Electron temperature and number density are investigated employing
   hollow cathode dc discharge in O-2. Electron temperature is found to
   decrease from 3 to 1.85 eV as the pressure increases from 75 to 375
   mTorr. Positive and negative ion densities are determined as a function
   of plasma gas pressure. I-V curves are evaluated employing the
   Allen-Boyd-Reynolds (ABR), current balance, orbital motion limited, and
   the floating potential (FP) methods. The ABR method is found to yield
   the highest positive ion number density, whereas the FP method results
   for n(+) are extremely small for any meaningful data. Present results
   are compared to those obtained employing global simulation method as
   well as with other experimental groups. O-2 electronegativity results
   are compared with other experimental and theoretical groups. Optical
   emission spectroscopy is employed and intensity ratio for the 777 and
   845-nm lines is obtained for comparison with other groups concluding
   that O- is the dominant species.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article},
Language = {English},
Affiliation = {Mondragón, AB (Corresponding Author), Univ Autonoma Estado Morelos, Fac Ciencias, Cuernavaca 62210, Morelos, Mexico.
   Berenice Mondragon, Aidee; Bashir Yousif, Farook, Univ Autonoma Estado Morelos, Fac Ciencias, Cuernavaca 62210, Morelos, Mexico.
   Rodriguez-Legorreta, Jannet, Univ Autonoma Estado Morelos, Fac Ciencias, Field Atom Mol \& Opt Phys, Cuernavaca 62209, Morelos, Mexico.
