@article{ WOS:000326212600016,
Author = {Guerrero-Arenas, Rosalia and Jimenez-Hidalgo, Eduardo and
   Garcia-Barrera, Pedro},
Title = {New records of temperate mollusks in two Late Pleistocene terrestrial
   localities from northeastern Oaxaca, Southern Mexico},
Journal = {JOURNAL OF SOUTH AMERICAN EARTH SCIENCES},
Year = {2013},
Volume = {47},
Pages = {213-219},
Month = {NOV},
Abstract = {The Mixteca Alta Oaxaquena is in the state of Oaxaca, southern Mexico.
   This region is characterized by numerous Pleistocene fossiliferous
   localities. The objective of this study is to describe a diverse
   assemblage of Late Pleistocene freshwater and terrestrial mollusks in
   two localities from northeastern Oaxaca, Coixtlahuaca District. We
   identified 10 taxa of gastropods and one of bivalves. By the
   sedimentological characteristics and the mollusks assemblage, it is
   possible to relate the first locality with meandriform river deposits,
   without vegetation. The second locality was associated with a fioodplain
   with short-lived associated vegetation. Five identified species
