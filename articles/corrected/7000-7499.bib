Year = {2013},
Volume = {91},
Number = {2},
Pages = {129-133},
Month = {JUN},
Abstract = {Deiregyne callifera Salazar \& Hernandez-Cardona, a new orchid species
   from the foothills of the Sierra Madre Oriental in the state of Hidalgo,
   Mexico is described and illustrated. The new species is similar to
   sympatric D. eriophora (B.L.Rob. \& Greenm.) Garay, differing in the
   glabrous inflorescence with more numerous, smaller flowers arranged in
   several intertwined spirals, proximal part of the labellum wider than
   long and provided with a lunate, prominently papillose callus, and
   proportionately much shorter column with inflexed apex.},
