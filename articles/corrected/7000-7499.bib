@article{ WOS:000314858500001,
Author = {Acosta, Roxana and Literak, Ivan and Sychra, Oldrich and Capek, Miroslav},
Title = {FLEAS ON WILD BIRDS IN COSTA RICA},
Journal = {PROCEEDINGS OF THE ENTOMOLOGICAL SOCIETY OF WASHINGTON},
Year = {2013},
Volume = {115},
Number = {1},
Pages = {1-8},
Month = {JAN},
Abstract = {A total of 1878 birds of 217 species were examined for the presence of
   fleas in Costa Rica during 2004, 2009, and 2010. Altogether 58 specimens
   of fleas belonging to four species of the family Ceratophyllidae were
   collected from 43 individuals of 27 bird species. The fleas Dasypsyllus
   (Dasypsyllus) gallinulae perpinnatus (Baker 1905), which were the most
   common, were found in 25 bird species. Dasypsyllus (Neornipsyllus)
   stejnegeri (Jordan 1929) and Ceratophyllus (Ceratophyllus) niger Fox,
   1908 were found in three and one bird species, respectively. Six
   Plusaetis equatoris (Jordan 1933)-like fleas were collected from one
   individual of the timberline wren Thryorchilus browni (Passeriformes,
   Troglodytidae).},
