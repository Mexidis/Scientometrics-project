@article{ WOS:000327567100009,
Author = {Ibargueen-Mondragon, Eduardo and Esteva, Lourdes},
Title = {On the interactions of sensitive and resistant Mycobacterium
   tuberculosis to antibiotics},
Journal = {MATHEMATICAL BIOSCIENCES},
Year = {2013},
Volume = {246},
Number = {1},
Pages = {84-93},
Month = {NOV},
Abstract = {In this work we propose a system of non linear ordinary differential
   equations for the dynamics of Mycobacterium tuberculosis (Mtb) within
   the host, in order to study the role of macrophages, T cells and
   antibiotics in the control of sensitive and resistant Mtb. Conditions
   for the persistence of sensitive and resistant bacteria are given in
   terms of the secondary infections produced by bacteria and macrophages,
   the immune response, and the antibiotic treatment. Model analysis
   predicts backward bifurcations for certain values of the parameters. In
   this case, the dynamics is characterized by the coexistence of two
   infection states with low and high bacteria load, respectively. (C) 2013
   Elsevier Inc. All rights reserved.},
Publisher = {ELSEVIER SCIENCE INC},
