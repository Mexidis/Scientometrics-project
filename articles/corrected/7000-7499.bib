@article{ WOS:000336242800006,
Author = {Campbell, Jonathan A. and Brodie, Jr., Edmund D. and Flores-Villela,
   Oscar and Smith, Eric N.},
Title = {A Fourth Species of Minute Salamander (Thorius: Plethodontidae)
   from the Sierra Madre del Sur of Guerrero, Mexico},
Journal = {SOUTH AMERICAN JOURNAL OF HERPETOLOGY},
Year = {2014},
Volume = {9},
Number = {1},
Pages = {46-51},
Month = {APR},
Abstract = {A new minute salamander of the genus Thorius is described from the
   western highlands of the Mexican state of Guerrero. Previously, three
   congeners were known from the central portion of the state. The fourth
   species we herein describe occurs in the western portion of the Sierra
   Madre del Sur of Guerrero and is allopatric from nearest congeners by
   about 80 km. The new species is distinguished from Guerreran congeners
   by a combination of body size, external morphology, and dentition.},
