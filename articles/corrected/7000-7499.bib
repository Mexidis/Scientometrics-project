@article{ WOS:000209520500007,
Author = {Balvanera, Patricia and Uriarte, Maria and Almeida-Lenero, Lucia and
   Altesor, Alice and DeClerck, Fabrice and Gardner, Toby and Hall,
   Jefferson and Lara, Antonio and Laterra, Pedro and Pena-Claros, Marielos
   and Silva Matos, Dalva M. and Vogl, Adrian L. and Piedad Romero-Duque,
   Luz and Felipe Arreola, Luis and Piedad Caro-Borrero, Angela and
   Gallego, Federico and Jain, Meha and Little, Christian and Xavier,
   Rafael de Oliveira and Paruelo, Jose M. and Emilio Peinado, Jesus and
   Poorter, Lourens and Ascarrunz, Nataly and Correa, Francisco and
   Cunha-Santino, Marcela B. and Paula Hernandez-Sanchez, Amabel and
   Vallejos, Maria},
Title = {Ecosystem services research in Latin America: The state of the art},
Journal = {ECOSYSTEM SERVICES},
Year = {2012},
Volume = {2},
Pages = {56-70},
Month = {DEC},
Abstract = {Ecosystem services science has developed at a fast rate in Latin
   America, a region characterized by a high biological and cultural
   diversity, strong emphasis in foreign investment, and high socioeconomic
   inequities. Here we conducted the following analyses at the regional and
   national scales: (1) how and when did the study of ecosystem services
   arise in each country?, (2) what is our present understanding of
   ecosystem service supply, delivery to societies, and social and economic
   values?, (3) what is the state of the art in integrating tradeoffs among
   services and in using interdisciplinary perspectives?, and (4) how has
   ecosystem service research been connected to policy design or management
   for sustainability? A large literature review ( > 1000 references)
   showed that in Latin America ES supply and links to policy have been the
   most frequently assessed. Overall, emphasis has been placed on a few
   services, namely carbon and water. Payments for ecosystem services have
   received considerable attention in the region, though with strong
   differences across nations and with important limitations in their
   application. The future of the ecosystem service paradigm in Latin
   America will largely depend on its capacity to demonstrate effectiveness
   in meeting both conservation and development goals. (C) 2012 Elsevier
   B.V. All rights reserved.},
