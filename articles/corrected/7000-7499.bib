@article{ WOS:000317158000008,
Author = {Cosio-Castaneda, C. and de la Mora, P. and Morales, F. and Escudero, R.
   and Tavizon, G.},
Title = {Magnetic behavior of the
   Bi2-ySryIr2O7
   pyrochlore solid solution},
Journal = {JOURNAL OF SOLID STATE CHEMISTRY},
Year = {2013},
Volume = {200},
Pages = {49-53},
Month = {APR},
Abstract = {The temperature dependence of magnetic susceptibility of the
   Bi2-ySryIr2O7 system was studied from 2 to 300 K. According to these
   measurements, the solid solution (0 <= y <= 0.9) does not show any
   magnetic transition; however, a noticeable deviation from the
   Curie-Weiss law occurs and the magnetic behavior of this system can be
   ascribed to short-range magnetic order that is also present in several
   geometrically frustrated systems. The Pauli magnetic susceptibility
   decreases as the Sr content increases, this can be associated with a
   shift towards Ir5+ in samples; also the Ir effective magnetic moment
   decreases. The estimated Wilson-ratio indicates the presence of strong
   electron-electron correlations. (C) 2013 Elsevier Inc. All rights
   reserved.},
