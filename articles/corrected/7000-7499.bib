Title = {Biochemical physics modeling of biological nano-motors},
Booktitle = {SPECIAL TOPICS ON TRANSPORT THEORY: ELECTRONS, WAVES, AND DIFFUSION IN
   CONFINED SYSTEMS: V LEOPOLDO GARCIA-COLIN MEXICAN MEETING ON
   MATHEMATICAL AND EXPERIMENTAL PHYSICS},
