@article{ WOS:000439438200005,
Author = {Zubillaga, Alfredo and Soto, Luis A. and Salcedo, Diana L. and Botello,
   Alfonso V.},
Title = {Presence of Oil Mineral Aggregates (OMAs) in Surface Sediments from
   Mexico's Exclusive Economic Zone, NW Gulf of Mexico},
Journal = {BULLETIN OF ENVIRONMENTAL CONTAMINATION AND TOXICOLOGY},
Year = {2018},
Volume = {101},
Number = {2},
Pages = {173-177},
Month = {AUG},
Abstract = {We assessed the presence and distribution of oil mineral aggregates
   (OMAs) in surficial sediments of Mexican waters in the NW Gulf of
   Mexico, their potential sources and their correlation with polycyclic
   aromatic hydrocarbons (PAH). In summer of 2010, OMAs were detected in
   three shallow sites. In winter of 2011, OMAs were observed in ten sites,
   two of them in the northernmost area at > 1500 m depth. These particles
   were possibly advected from the north Gulf and Mississippi area
   following the deep-water currents of the zone. The OMAs from shallower
   sites may reflect local pollution sources. PAHs displayed low
   concentrations in both surveys (from 0.01 to 0.7 A mu g g(-1) in summer,
   and from 0.01 to 0.51 A mu g g(-1) in winter), and showed rather a local
   origin. The expansion of the oil and port industry in the region is
   accountable for most of the OMAs detected.},
