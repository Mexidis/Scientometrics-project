@article{ WOS:000424701400005,
Author = {Chavez, I. and Garcia, L. A. and Grether, M. and de Llano, M. and
   Tolmachev, V. V.},
Title = {Extended BCS-Bose Crossover},
Journal = {JOURNAL OF SUPERCONDUCTIVITY AND NOVEL MAGNETISM},
Year = {2018},
Volume = {31},
Number = {3, SI},
Pages = {631-637},
Month = {MAR},
Note = {Superstripes Conference, ITALY, JUN, 2017},
Abstract = {Applying the generalized Bose-Einstein condensation (GBEC) formalism, we
   extend the BCS-Bose crossover theory by explicitly including hole Cooper
   pairs (2hCPs). From this, follows a phase diagram with two pure phases,
   one with 2hCPs and the other with electron Cooper pairs (2eCPs), plus a
   mixed phase with arbitrary proportions of 2eCPs and 2hCPs. The
   special-case phase when there is perfect symmetry, i.e., with ideal
   50-50 proportions between 2eCPs and 2hCPs, corresponds to the usual
   BCS-Bose crossover. Explicitly including 2hCPs yields an extended
   BCS-Bose crossover which predicts improved T (c) /T (F) values for some
   conventional superconductors (i.e., with electron-phonon dynamics) when
   compared with experiment. To do this, we employ the BCS dimensionless
   coupling constant lambda (B C S) via the BCS gap equation and compare
   with the Bogoliubov et al. upper limit lambda (B C S) <= 1/2. Another
   phase diagram presented exhibits experimental T (c) /T (F) values for
   some conventional superconductors for arbitrary proportions between
   2eCPs and 2hCPs as function of Delta n = n/n (f) - 1, where n is the
   electron concentration and n (f) that of unbound electrons at T = 0. The
   extended crossover is compared with experimental T (c) /T (F) values as
   well as to the gap-to- T (c) ratio.},
