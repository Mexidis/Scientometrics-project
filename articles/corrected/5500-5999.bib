@article{ WOS:000438480300011,
Author = {Afratis, Nikolaos A. and Selman, Moises and Pardo, Annie and Sagi, Irit},
Title = {Emerging insights into the role of matrix metalloproteases as
   therapeutic targets in fibrosis},
Journal = {MATRIX BIOLOGY},
Year = {2018},
Volume = {68-69},
Number = {SI},
Pages = {167-179},
Month = {AUG},
Abstract = {Fibrosis is the extensive accumulation and buildup of extracellular
   matrix components, especially fibrillar collagens, during wound healing
   in response to tissue injury. During all individual stages of fibrosis
   ECM proteases, mainly matrix metalloproteinases, have diverse roles. The
   functional role of MMPs and their endogenous inhibitors are
   differentiated among their family members, and according to the
   different stages of fibrosis. MMPs levels are elevated in several
   inflammatory and non-inflammatory fibrotic tissues contributing to the
   development, progression or resolution of the disease, whereas in other
   tissues their expression levels can be diminished or be stable to the
   baseline. The biological roles of MMPs during fibrosis are not fully
   resolved, but they seem to differ according the specific member of the
   family, the affected tissue and the stage of the fibrotic response.
   Remarkably, some members of the family exhibit profibrotic actions while
   other function as antifibrotic molecules. Diverse animal models indicate
   that MMPs are contributing in processes related to immunity, tissue
   repair and ECM turnover, providing significant impact on mechanisms
   related to fibrosis. For that purpose, these proteases are considered as
   pharmacological targets and new biological drugs have been developed in
   order to treat fibrosis. (C) 2018 Elsevier B.V. All rights reserved.},
Publisher = {ELSEVIER SCIENCE BV},
Address = {PO BOX 211, 1000 AE AMSTERDAM, NETHERLANDS},
Type = {Review},
Language = {English},
Affiliation = {Sagi, I (Corresponding Author), Weizmann Inst Sci, Dept Biol Regulat, IL-7610001 Rehovot, Israel.
   Afratis, Nikolaos A.; Sagi, Irit, Weizmann Inst Sci, Dept Biol Regulat, IL-7610001 Rehovot, Israel.
   Selman, Moises, Inst Nacl Enfermedades Resp Ismael Cosio Villegas, Mexico City 14080, DF, Mexico.
   Pardo, Annie, Univ Nacl Autonoma Mexico, Fac Ciencias, Mexico City 04510, DF, Mexico.},
DOI = {10.1016/j.matbio.2018.02.007},
ISSN = {0945-053X},
EISSN = {1569-1802},
Keywords = {Fibrosis; Extracellular matrix enzymes; Matrix metalloproteinases;
   Pharmacological targeting},
