@article{ WOS:000440243600061,
Author = {Silva-Cuevas, Carolina and Paleo, Ehecatl and Leon-Rayo, David F. and
   Armando Lujan-Montelongo, J.},
Title = {An expeditious and efficient bromomethylation of thiols: enabling
   bromomethyl sulfides as useful building blocks},
Journal = {RSC ADVANCES},
Year = {2018},
Volume = {8},
Number = {43},
Pages = {24654-24659},
Abstract = {A facile and highly efficient method for the bromomethylation of thiols,
   using paraformaldehyde and HBr/AcOH, has been developed, which
   advantageously minimizes the generation of highly toxic byproducts. The
   preparation of 22 structurally diverse alpha-bromomethyl sulfides
   illustrates the chemo-tolerant applicability while bromo-lithium
   exchange and functionalization sequences, free radical reductions, and
