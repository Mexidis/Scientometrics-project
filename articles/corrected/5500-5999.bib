@article{ WOS:000419733500009,
Author = {Valencia-A, Susana and Coombes, Allen and Luis Villasenor, Jose},
Title = {Quercus candicans (Fagaceae) is not a Quercus but a
   Roldana (Asteraceae)},
Journal = {PHYTOTAXA},
Year = {2018},
Volume = {333},
Number = {2},
Pages = {251-258},
Month = {JAN 9},
Abstract = {A revision of type material of Quercus candicans at the Herbarium of the
   Real Jardin Botanico de Madrid (MA), as well as the original description
   revealed misplacement in the genus Quercus (Fagaceae). The type of Q.
   candicans clearly corresponds to Roldana lineolata (Asteraceae). A
   detailed study of types and protologues of the synonyms previously
   placed under Q. candicans by Muller and Trelease, indicate the oldest
   valid name for this species is Q. calophylla, which the material
   referred to this species must now be called. The taxonomic confusion is
   clarified and a new combination in Roldana, based on Q. candicans is
   proposed.},
Publisher = {MAGNOLIA PRESS},
Address = {250F Marua Road Mt Wellington, AUCKLAND, ST LUKES 1023, NEW ZEALAND},
