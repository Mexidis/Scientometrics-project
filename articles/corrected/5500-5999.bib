   Haddad, Celio F. B., Univ Estadual Paulista, UNESP, Inst Biociencias, Dept Zool, Caixa Postal 199, BR-13506900 Rio Claro, SP, Brazil.
   Haddad, Celio F. B., Univ Estadual Paulista, UNESP, Inst Biociencias, Ctr Aquicultura, Caixa Postal 199, BR-13506900 Rio Claro, SP, Brazil.},
DOI = {10.1016/j.ympev.2018.02.010},
ISSN = {1055-7903},
