@article{ WOS:000440677900001,
Author = {Ortigosa, Deneb and Yolimar Suarez-Mozo, Nancy and Barrera, Noe C. and
   Simoes, Nuno},
Title = {First survey of Interstitial molluscs from Cayo Nuevo, Campeche Bank,
   Gulf of Mexico},
Journal = {ZOOKEYS},
Year = {2018},
Number = {779},
Pages = {1-17},
Month = {AUG 2},
Abstract = {Six sediment samples weighing between 224-735 g were collected in June
   of 2016 from Cayo Nuevo reef, located at the Campeche Bank, southern
   Gulf of Mexico. Samples were collected by SCUBA diving, from were two
   stations at depths of 7.6 and 18.2 m. Sediment was sieved and molluscs
   (adults and micromolluscs <= 10 mm) were sorted, examined, and
   identified to the lowest taxonomic level. A total of 1,347 specimens was
   found, of which 224 shells were dead and 1,123 were alive. Thirty- four
   families, 53 genera, and 67 species were identified. The most abundant
   families were Chamidae and Arcidae for the Bivalvia class, and Caecidae
   and Tornidae for the Gastropoda class. The vertical range of Bentharca
   sp. was extended.},
