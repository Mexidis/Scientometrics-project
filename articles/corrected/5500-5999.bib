@article{ WOS:000413889100019,
Author = {Antonyan, Natella and Antonyan, Sergey A. and Mata-Romero, Armando and
   Vargas-Betancourt, Enrique},
Title = {A characterization of G-ANR and G-AR spaces for proper
   actions of Lie groups},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2017},
Volume = {231},
Pages = {292-305},
Month = {NOV 1},
Abstract = {Let G be a matrix Lie group. We prove that a proper G-space X of finite
   structure, which is metrizable by a G-invariant metric, is a G-ANR
   (resp., a G-AR) if for any compact subgroup H subset of G the H-fixed
   point set X-H is an ANR (resp., an AR). An equivariant embedding result
   for proper G-spaces of finite structure is also obtained. (C) 2017
   Elsevier B.V. All rights reserved.},
