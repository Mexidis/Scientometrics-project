   Reyes-Castillo, Pedro, Inst Ecol AC, Red Biodiversidad \& Sistemat, Xalapa, Veracruz, Mexico.},
DOI = {10.1111/jbi.13172},
ISSN = {0305-0270},
EISSN = {1365-2699},
Keywords = {biogeography; ecological niche modelling; Mammalia; Nearctic;
   Neotropical; parsimony analysis of endemicity; Passalidae; Pleistocene;
