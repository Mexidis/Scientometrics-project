@article{ WOS:000431794300007,
Author = {Rivaz Hernandez, J. A.},
Title = {New replacement name for Anaperus Graff, 1911 (Acoelomorpha:
   Acoela: Convolutidae)},
Journal = {ZOOTAXA},
Year = {2018},
Volume = {4418},
Number = {5},
Pages = {499-500},
Month = {MAY 10},
Abstract = {The acoel genus Anaperus was established by Graff in 1911 for
   Amphiscolops gardineri Graff, 1910, making Anaperus gardineri (Graff,
   1910) its type species. Since then, six more valid species were
   described: A. tvaerminnensis (Luther, 1912); A. sulcatus Beklemischev,
   1914; A. rubellus Westblad, 1945; A. biaculeatus Boguta, 1970; A.
   ornatus Beltagi, 2001; A. singularis Hooge \& Smith, 2004. A seventh
   species, A. australis Westblad, 1952, is incertae sedis (Dorjes \&
   Karling, 1975). The genus was placed to family Convolutidae Graff, 1905,
   until Dorjes (1968) erected the family Anaperidae on the basis of a
   distinctive male copulatory apparatus. Jondelius et al. (2011) returned
   it to Convolutidae on the basis of molecular-sequence data.
   As pointed out by Paulay (2012) Anaperus, Graff 1911 is a junior homonym
   of Anaperus Troschel, 1846, in the family Cucumariidae (Echinodermata:
   Dendrochirotida). According to the International Code of Zoological
   Nomenclature, a replacement name is needed, and I propose
   Thalassoanaperus nom. nov., for Anaperus Graff, 1911. Accordingly, eight
   new combinations are herein proposed for the acoel species previously
   included in Anaperus Graff, 1911: Thalassoanaperus gardineri (Graff,
   1910), Thalassoanaperus tvaerminnensis (Luther, 1912), Thalassoanaperus
   sulcatus (Beklemischev, 1914), Thalassoanaperus rubellus (Westblad,
   1945), Thalassoanaperus australis (Westblad, 1952), Thalassoanaperus
   biculeatus (Boguta, 1970), Thalassoanaperus ornatus (Beltagi, 2001) and
   Thalassoanaperus singularis (Hooge \& Smith, 2004).},
