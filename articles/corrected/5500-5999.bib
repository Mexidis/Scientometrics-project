@article{ WOS:000440017400007,
Author = {Nunez Resendiz, Maria Luisa and Ardito, Sonia and Leon-Tejera, Hilda and
   Dreckmann, Kurt M. and Senties, Abel},
Title = {Solieria incurvata (Solieriaceae, Rhodophyta), a new
   species from Venezuela based on morpho-anatomical and molecular evidence},
Journal = {BOTANICA MARINA},
Year = {2018},
Volume = {61},
Number = {4},
Pages = {383-393},
Month = {AUG},
Abstract = {Solieria incurvata from Puerto Escondido, Estado Falcon, Venezuela, is
   described as a new species based on morpho-anatomical and molecular
   data. Morphologically S. incurvata differs from other Solieria species,
   with which it shares its distributional range, by its narrow branches
   that become gradually constricted toward their bases, by possessing
   acute and incurved apices, and by its branching pattern and anatomical
   morphometrics. On the basis of COI-5P and rbcL sequences, the new
   species forms an independent lineage that clearly belongs in the
   Solieria Glade of the Solieriaceae.},
