@article{ WOS:000433961800077,
Author = {Rodriguez, Jannet and Bashir Yousif, Farook and Fuentes, Beatriz E. and
   Vazquez, Federico and Rivera, Marco and Lopez-Patino, J. and Figueroa,
   Aldo and Martinez, Horacio},
Title = {Photo-detachment of negative ions in Ar-CO2 dc discharge
   employing Langmuir probe},
Journal = {PHYSICS OF PLASMAS},
Year = {2018},
Volume = {25},
Number = {5},
Month = {MAY},
Abstract = {The electronegativity of the Ar - CO2 gas mixture was investigated, and
   the total relative negative oxygen ion density O-2(-) + O- in the bulk
   of a dc discharge has been determined employing Langmuir probe assisted
   laser photo-detachment. The relative electron density and absolute
   temperature were obtained for the mixture at discharge powers between
   200 and 3000 mW and pressures between 0.2 and 0.6 mbar, employing the
   collisional radiative model for several Ar gas mixtures. The absolute
   metastable number density for 1s(3) and 1s(5) levels was measured, and
   both showed an increasing trend as a function of pressure and power. The
   absolute number density of the 1s(5) level was found to be higher than
   that of the 1s(3) level. Electronegativity was found to decrease as a
   function of power and as a function of the increasing Ar percentage in
   the gas mixture. Published by AIP Publishing.},
