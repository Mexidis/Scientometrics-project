@article{ WOS:000437794300003,
Author = {Calleja, Renato and Doedel, Eusebius and Garcia-Azpeitia, Carlos},
Title = {Symmetries and choreographies in families that bifurcate from the
   polygonal relative equilibrium of the n-body problem},
Journal = {CELESTIAL MECHANICS \& DYNAMICAL ASTRONOMY},
