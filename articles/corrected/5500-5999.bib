   Coombes, Allen, Benemerita Univ Autonoma Puebla, Herbario \& Jardin Bot, Puebla 72000, Mexico.
   Luis Villasenor, Jose, Univ Nacl Autonoma Mexico, Inst Biol, Dept Bot, Apartado Postal 70-233, Ciudad De Mexico 04510, Mexico.},
DOI = {10.11646/phytotaxa.333.2.9},
ISSN = {1179-3155},
EISSN = {1179-3163},
