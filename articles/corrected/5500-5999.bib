@article{ WOS:000414845100018,
Author = {Hernandez-Gomez, Candelario and Basurto-Flores, Rogelio and
   Obregon-Quintana, Bibiana and Guzman-Vargas, Lev},
Title = {Evaluating the Irregularity of Natural Languages},
Journal = {ENTROPY},
Year = {2017},
Volume = {19},
Number = {10},
Month = {OCT},
Abstract = {In the present work, we quantify the irregularity of different European
   languages belonging to four linguistic families (Romance, Germanic,
   Uralic and Slavic) and an artificial language (Esperanto). We modified a
   well-known method to calculate the approximate and sample entropy of
   written texts. We find differences in the degree of irregularity between
   the families and our method, which is based on the search of
   regularities in a sequence of symbols, and consistently distinguishes
   between natural and synthetic randomized texts. Moreover, we extended
   our study to the case where multiple scales are accounted for, such as
   the multiscale entropy analysis. Our results revealed that real texts
   have non-trivial structure compared to the ones obtained from
   randomization procedures.},
