@article{ WOS:000434710200117,
Author = {Concepcion Rodriguez-Robledo, M. and Azucena Gonzalez-Lozano, M. and
   Ponce-Pena, Patricia and Quintana Owen, Patricia and Angel
   Aguilar-Gonzalez, Miguel and Nieto-Castaneda, Georgina and Bazan-Mora,
   Elva and Lopez-Martinez, Ruben and Ramirez-Galicia, Guillermo and
   Poisot, Martha},
Title = {Cellulose-Silica Nanocomposites of High Reinforcing Content with Fungi
   Decay Resistance by One-Pot Synthesis},
Journal = {MATERIALS},
Year = {2018},
Volume = {11},
Number = {4},
Month = {APR},
Abstract = {Hybrid bionanocomposites based on cellulose matrix, with silica
   nanoparticles as reinforcers, were prepared by one-pot synthesis of
   cellulose surface modified by solvent exchange method to keep the
   biopolymer net void for hosting inorganic nanoparticles. Neither
   expensive inorganic-particle precursors nor crosslinker agents or
   catalysts were used for effective dispersion of reinforcer concentration
   up to 50 wt \%. Scanning electron microscopy of the nanocomposites shows
   homogeneous dispersion of reinforcers in the surface modified cellulose
   matrix. The FTIR spectra demonstrated the cellulose features even at 50
   weight percent content of silica nanoparticles. Such a high content of
   silica provides high thermal stability to composites, as seen by
   TGA-DSC. The fungi decay resistance to Trametes versicolor was measured
   by standard test showing good resistance even with no addition of
   antifungal agents. This one-pot synthesis of biobased hybrid materials
   represents an excellent way for industrial production of high
   performance materials, with a high content of inorganic nanoparticles,
   for a wide variety of applications.},
