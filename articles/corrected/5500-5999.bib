@article{ WOS:000411978900023,
Author = {Morrone, Juan J.},
Title = {Biogeographic regionalization of the Sierra Madre del Sur province,
   Mexico},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2017},
Volume = {88},
Number = {3},
Pages = {710-714},
Month = {SEP},
Abstract = {The biogeographic regionalization of the Sierra Madre del Sur province
   is reviewed, considering recent proposals and applying the International
   Code of Area Nomenclature to name the 3 subprovinces and 5 districts
   recognized. The Western Sierra Madre del Sur subprovince, situated in
   the states of Jalisco, Colima and Michoacan, comprises the Jaliscan and
   Jaliscan-Manantlan districts. The Central Sierra Madre del Sur subprov.
   nov., situated in the state of Michoacan, comprises the Michoacan
   district. The Eastern Sierra Madre del Sur subprovince, situated in the
   states of Guerrero, Oaxaca and Puebla, comprises the Guerreran and
   Oaxacan Highlands districts. Diagnoses of these areas are provided and
   their endemic taxa are listed. (C) 2017 Universidad Nacional Autonoma de
   Mexico, Instituto de Biologia.},
