@article{ WOS:000438325800003,
Author = {Illanes, Alejandro and Naranjo-Murillo, Jimmy A. and Vega, Jorge E. and
   Velazquez-Inzunza, Yajaida N.},
Title = {Induced mappings on symmetric products, some answers},
