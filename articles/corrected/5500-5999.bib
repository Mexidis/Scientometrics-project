@article{ WOS:000409152800062,
Author = {Solis, C. and Solis-Meza, E. and Morales, M. E. and Rodriguez-Ceja, M.
   and Martinez-Carrillo, M. A. and Garcia-Calderon, D. and Huerta, A. and
   Chavez, E.},
Title = {AMS-14C analysis of modern teeth: A comparison between two
   sample preparation techniques},
Journal = {NUCLEAR INSTRUMENTS \& METHODS IN PHYSICS RESEARCH SECTION B-BEAM
   INTERACTIONS WITH MATERIALS AND ATOMS},
Year = {2017},
Volume = {406},
Number = {A},
Pages = {292-295},
Month = {SEP 1},
Note = {12th European Conference on Accelerators in Applied Research and
   Technology (ECAART), Univ Jyvaskyla, Jyvaskyla, FINLAND, JUL 03-08, 2016},
Organization = {Univ Jyvaskyla, Dept Phys; Federat Finnish Learned Soc; High Voltage
   Engn Europa B V; NEC; Crytur; HS Foils; CAEN; Panimoyhtio Hiisi;
   DREEBIT; DOSECO; Ionplus; Kurt J Lesker Co; Oerlikon Leybold Vacuum; YTM
   Ind},
Abstract = {AMS-C-14 analysis of modern teeth has become important for forensic
   studies. C-14 content in human teeth reflects the C-14 atmospheric
   concentration during its formation and allows the calculation of the
   actual year of birth. Through AMS, it is possible to measure the C-14
   concentrations in a tissue with high precision. However, there is a
   debate about which should be the best fraction for teeth carbon dating:
   collagen or enamel. This work focuses on the results obtained from
   enamel and collagen extracted from Mexican people in order to compare
   them. Collagen from dental pieces donated from people older than
   60-years old have been included to understand the turnover process and
   usefulness of collagen to determine the date of birth. Our results
   indicate that when a single dental piece is available, enamel method
   allows the determination of the tooth formation date. Dating collagen of
   the same tooth helps to discriminate if the formation date belongs to
   the left or the right side of the peak bomb, but also corroborates, the
   ages obtained through enamel analysis. (C) 2017 Elsevier B.V. All rights
   reserved.},
