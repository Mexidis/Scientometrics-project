@article{ WOS:000418755700033,
Author = {Manreza Paret, D. and Perez Martinez, A. and Ayala, Alejandro and
   Piccinelli, G. and Sanchez, A.},
Title = {Charged fermion gas polarization in strong magnetic fields},
Journal = {ASTRONOMISCHE NACHRICHTEN},
Year = {2017},
Volume = {338},
Number = {9-10, SI},
Pages = {1131-1135},
Month = {DEC},
Abstract = {We study the polarization of a charged fermion gas in the presence of
   intense magnetic fields by finding an exact numerical expression for the
   gas number density. We compute the polarization as a function of the
   magnetic field, chemical potential, and temperature and compare them
   with approximate analytical results. We find that the analytical
   approximations are in agreement with the numerical results only in the
   asymptotic limit of these parameters.},
