Pages = {1136-1141},
Month = {DEC},
Abstract = {We analyze the decay of a heavy scalar boson to two light-charged
   scalars, in presence of a uniform, constant magnetic field. The effect
   of magnetic fields on the particle decay process has been studied in
   many contexts, in the presence of different ingredients and with a
   variety of methods. After reviewing some results that can be found in
   the literature, we present our findings and discuss the differences.},
