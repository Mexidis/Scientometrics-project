@article{ WOS:000468470200015,
Author = {Pineda-Vazquez, Diana and Polanco-Mendoza, Alejandro J. and
   Morales-Luna, Gesuri and Rodriguez-Gomez, Arturo and Reyes-Coronado,
   Alejandro and Pirruccio, Giuseppe and Garcia-Valenzuela, Augusto and
   Barrera, Ruben G.},
Title = {Internal reflectance from a disordered monolayer of small gold
   nanoparticles on a glass substrate: Theory vs. experiment},
Journal = {MATERIALS TODAY-PROCEEDINGS},
Year = {2019},
Volume = {13},
Number = {2, SI},
Pages = {404-412},
Note = {International Conference on Nanotechnology (Tec.Nano), Monterrey,
   MEXICO, NOV 28-30, 2018},
Abstract = {In this work we study theoretically and experimentally, the reflectance
   of a monolayer of nanoparticles randomly located onto a substrate,
   immersed in a homogeneous medium. The system is illuminated with a laser
   of wavelength lambda = 543 nm in an internal incidence configuration and
   both p and s polarizations are investigated. The samples are prepared by
   means of the direct current magnetron sputtering technique, using short
   erosion times to allow the growing of a non-percolated single layer of
   gold nanoparticles over the surface of a glass substrate. The particles'
   average radius is 5.8 +/- 1.25 nm and the surface coverage is estimated
   to be 29.6 +/- 1\%. We compare the reflectance predicted by five
   theoretical models-equivalent-volume, Van de Hulst, Maxwell Garnett,
   dipolar and coherent scattering-with the measured reflectance of the
   samples, obtaining a good agreement between the prediction of the
   dipolar and Maxwell Garnett models with the measured data. These results
   motivate further studies to consider an application of this system as an
   ultrasensitive sensor. (C) 2019 Elsevier Ltd. All rights reserved.},
