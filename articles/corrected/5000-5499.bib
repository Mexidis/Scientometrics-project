@article{ WOS:000452426100002,
Author = {Jimenez-Rivillas, Carlos and Garcia, Juan J. and Alberto Quijano-Abril,
   Mario and Daza, Juan M. and Morrone, Juan J.},
Title = {A new biogeographical regionalisation of the Paramo biogeographic
   province},
Journal = {AUSTRALIAN SYSTEMATIC BOTANY},
