@article{ WOS:000487931900005,
Author = {Garcia-Gomez, Arturo and Palacios-Vargas, Jose G.},
Title = {Description of a new species of Willemia (Collembola:
   Hypogastruridae) from Panama with key to Willemia species
   occurring in the Americas},
Journal = {ZOOTAXA},
Year = {2019},
Volume = {4674},
Number = {5},
Pages = {564-570},
Month = {SEP 27},
Abstract = {Willemia panamaensis sp. nov. from Panama is described and illustrated.
   It is characterised by the presence of sensilla I (S2) and i1 (S9) on
   antennal segment IV, nine vesicles in the postantennal organ, and having
   dorsal setae and sensilla on abdominal segments V and VI twice as long
   than on segments I and II. A dichotomous key to species recorded from
   the Americas is provided. Reference is given to the DNA barcoding
   sequences of the new species.},
