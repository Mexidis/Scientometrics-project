@article{ WOS:000496545700018,
Author = {Poot-Lopez, Gaspar R. and Lopez-Rocha, Jorge A. and Gonzalez-Salas,
   Carlos and Guillen-Hernandez, Sergio and Villegas-Hernandez, Harold},
Title = {Sex related differences in density, selectivity and vulnerability of the
   Atlantic blue crab, Callinectes sapidus (Rathbun, 1896), in the
   southern Gulf of Mexico},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2019},
Volume = {32},
Month = {NOV},
Abstract = {The density, selectivity and vulnerability by sex of Atlantic blue crab
   (Callinectes sapidus) in the Yucatan coast were estimated using a
   Jolly-Seber mark-recapture model. A total of 614 individuals of C.
   sapidus were captured, of which 336 were marked and of these 20 were
   recaptured. Overall male:female ratio was 1:3.78. The selectivity of
   fishing gear (L-50) was estimated at 143.9 and 141.4 mm carapace width
   for females and males, respectively. Catch per unit effort (CPUE) was
   estimated at 0.41 (males) and 1.55 (females) individuals trap(-1). With
   the model of Jolly-Seber density was estimated at 39 males ha(-1) and
   323 females ha(-1). The average catchability (q) of the males was 0.0340
   and 0.0243 for the females, and the relative vulnerability was higher
   for males of small sizes and females of large sizes. Our results
   indicated that sex related demographic variations should be considered
   in further design and application of fishery management measures since
   differences in density, selectivity, catchability and vulnerability by
   sex were found. (c) 2019 Elsevier B.V. All rights reserved.},
