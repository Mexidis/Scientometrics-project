@incollection{ WOS:000464818600005,
Author = {Benitez-Perez, Hector and Ortega-Arjona, Jorge L. and Rubio-Acosta,
   Ernesto and Mendez-Monroy, Paul E. and Esquivel-Flores, Oscar A.},
