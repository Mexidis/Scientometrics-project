@article{ WOS:000484918700022,
Author = {Cruz-Rosas, Hugo I. and Riquelme, Francisco and Santiago, Patricia and
   Rendon, Luis and Buhse, Thomas and Ortega-Gutierrez, Fernando and
   Borja-Urby, Raul and Mendoza, Doroteo and Gaonal, Carlos and Miramontes,
   Pedro and Cocho, Germinal},
Title = {Multiwall and bamboo-like carbon nanotubes from the Allende chondrite: A
   probable source of asymmetry},
Journal = {PLOS ONE},
Year = {2019},
Volume = {14},
Number = {7},
Month = {JUL 1},
Abstract = {This study presents multiwall and bamboo-like carbon nanotubes found in
   samples from the Allende carbonaceous chondrite using high-resolution
   transmission electron microscopy (HRTEM). A highly disordered lattice
   observed in this material suggests the presence of chiral domains in it.
   Our results also show amorphous and poorly-graphitized carbon,
   nanodiamonds, and onion-like fullerenes. The presence of multiwall and
   bamboo-like carbon nanotubes have important implications for hypotheses
   that explain how a probable source of asymmetry in carbonaceous
   chondrites might have contributed to the enantiomeric excess in soluble
   organics under extraterrestrial scenarios. This is the first study
   proving the existence of carbon nanotubes in carbonaceous chondrites.},
