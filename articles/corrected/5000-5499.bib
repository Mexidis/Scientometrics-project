@article{ WOS:000477614200001,
Author = {Krengel, Felix and de Jesus Olivera-Flores, Teresa and Herrera-Santoyo,
   Josefina and Reyes-Chilpa, Ricardo},
Title = {Strategies for the in vitro production of antiaddictive ibogan type
   alkaloids from Apocynaceae species},
Journal = {PLANT CELL TISSUE AND ORGAN CULTURE},
