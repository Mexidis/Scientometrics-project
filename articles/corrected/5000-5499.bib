@article{ WOS:000462907300010,
Author = {Jaber-Urquiza, Jorge and Piccinelli, Gabriella and Sanchez, Angel},
Title = {Response to an external magnetic field of the decay rate of a neutral
   scalar field into a charged fermion pair},
Journal = {PHYSICAL REVIEW D},
Year = {2019},
Volume = {99},
Number = {5},
Month = {MAR 22},
Abstract = {In this work, we explore the effects of a weak magnetic field on the
   decay process of a neutral scalar boson into a pair of charged fermions
   in vacuum. Since the analytical computation of the decay width needs
   some approximation, following two different approaches, we study the low
   and high transverse momentum limits. Our findings indicate that the
   magnetic field effect depends on the kinematics of the scalar particle.},
