@article{ WOS:000487713600007,
Author = {Acosta, Roxana and Salceda-Sanchez, Beatriz},
Title = {A New Species of Flea of the Genus Kohisia Traub, 1950
   (Siphonaptera: Ceratophyllidae) from Veracruz, Mexico},
Journal = {ZOOTAXA},
Year = {2019},
Volume = {4671},
Number = {4},
Pages = {564-570},
Month = {SEP 19},
Abstract = {A new flea species, Kohlsia misantlensis, is described from the central
   mountains of Veracruz, Mexico. The hosts of this new species are the
   Mexican deer mouse Peromyscus mexicanus (Saussure, 1860) (Mammalia:
   Rodentia:\_Muridae) and the Mexican spiny pocket mouse Heteromys sp.
   (Heteromyidae). This flea species is easily recognized by the great
   development of sternite VIII with a tuft of seven long bristles near the
   apex. The new species is included in a taxonomic key for the species of
   genus Kohlsia occurring in Mexico.},
