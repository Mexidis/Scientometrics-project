@article{ WOS:000456691100011,
Author = {Carmona-Suarez, Carlos A. and Guerra-Castro, Edlin J.},
Title = {Populations of Cardisoma guanhumi Latreille in Latreille, Le
   Peletier, Serville \& Guerin, 1828 (Decapoda: Brachyura: Gecarcinidae)
   in mangrove forests and coastal grasslands in Venezuela},
Journal = {JOURNAL OF CRUSTACEAN BIOLOGY},
Year = {2018},
Volume = {38},
Number = {6},
Pages = {739-747},
Month = {NOV},
Abstract = {Population studies of the economically important blue land crab,
   Cardisoma guanhumi Latreille in Latreille, Le Peletier, Serville \&
   Guerin, 1828, were undertaken in a mangrove forest (Avicennia germinans)
   and in grasslands dominated by sacaton grass (Sporobolus spp.)
   Population density, size of crabs (indirect estimation of individuals in
   burrows), and percentage of covered burrows (an indication of molting)
   were measured during eighteen months from 2010 to 2011. These population
   variables were compared between habitats and also correlated with
   rainfall. Crab size was significantly larger in the mangrove forest than
   in the grassland (mean carapace length 55.92 mm and 51.93 mm,
   respectively; P < 0.05). The largest individuals were found in May and
   the smallest in February and March in both habitats. Burrow density was
   also higher in the mangrove forest (mean 3.08 burrows m(-2)) than in the
   grassland (0.53 burrows m(-2)) throughout the sampling period (P <
   0.05), but showed a decreasing tendency in the mangrove, whereas density
   remained stable in the grassland. Covered burrow density in both
   habitats was inversely related to precipitation (P < 0.05), indicating
   that crabs seal their burrows for molting and to prevent desiccation.},
