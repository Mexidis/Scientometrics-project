Year = {2019},
Volume = {26},
Number = {1},
Pages = {219-244},
Month = {JAN-MAR},
Abstract = {This paper provides an overview of the state of Mexican genetics and
   biomedical knowledge during the second half of the twentieth century, as
   well as its impact on the visual representation of human groups and
   racial hierarchies, based on social studies of scientific imaging and
   visualization (SIV) and theoretical concepts and methods. It also
   addresses the genealogy and shifts of the concept of race and
   racialization of Mexican bodies, concluding with the novel visual
   culture that resulted from genetic knowledge merged with the racist
   phenomenon in the second half of the twentieth century in Mexico.},
