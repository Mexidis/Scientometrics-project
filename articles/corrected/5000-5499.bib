@incollection{ WOS:000464818600004,
Author = {Benitez-Perez, Hector and Ortega-Arjona, Jorge L. and Rubio-Acosta,
   Ernesto and Mendez-Monroy, Paul E. and Esquivel-Flores, Oscar A.},
Book-Author = {BenitezPerez, H
   OrtegaArjona, JL
   MendezMonroy, PE
   RubioAcosta, E
   EsquivelFlores, OA},
Title = {Distributed Systems Modelling},
Booktitle = {CONTROL STRATEGIES AND CO-DESIGN OF NETWORKED CONTROL SYSTEMS:
   CONSIDERING TIME DELAY EFFECTS},
Series = {Modeling and Optimization in Science and Technologies},
Year = {2019},
Volume = {13},
Pages = {41-82},
Abstract = {Distributed systems have a lot of applications, commonly with multitasks
   where the information exchange is high through a communication network,
   this exchange presents inherent time delays that degrade the system. For
   obtaining an acceptable performance in the distributed system, time
   delays need to be taken into consideration during design. This chapter
   is devoted to reviewing some representations of time delays in function
   of some features as the operative system, network, scheduling. These
   include the scalability, concurrency, feasibility and extensibility.
   Several situations are reviewed, such as aperiodic communications or
   consensus needs, among other situations. Finally, an introduction to a
   helicopter dynamic model is given, focusing on real-time representation
   with a relationship matrix of transmission frequencies through True-time
