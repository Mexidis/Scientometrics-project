@article{ WOS:000495970300014,
Author = {Ferrer, E. J. and Sanchez, A.},
Title = {Magnetic field effect in the fine-structure constant and electron
   dynamical mass},
Journal = {PHYSICAL REVIEW D},
Year = {2019},
Volume = {100},
Number = {9},
Month = {NOV 11},
Abstract = {We investigate the effect of an applied constant and uniform magnetic
   field in the fine-structure constant of massive and massless QED. In
   massive QED, it is shown that a strong magnetic field removes the so
   called Landau pole and that the fine-structure constant becomes
   anisotropic having different values along and transverse to the field
   direction. Contrary to other results in the literature, we find that the
   anisotropic fine-structure constant always decreases with the field. We
   also study the effect of the running of the coupling constant with the
   magnetic field on the electron mass. We find that in both cases of
   massive and massless QED, the electron dynamical mass always decreases
   with the magnetic field, what can be interpreted as an inverse magnetic
   catalysis effect.},
Publisher = {AMER PHYSICAL SOC},
Address = {ONE PHYSICS ELLIPSE, COLLEGE PK, MD 20740-3844 USA},
Type = {Article},
Language = {English},
Affiliation = {Ferrer, EJ (Corresponding Author), Univ Texas Rio Grande Valley, Dept Phys \& Astron, 1201 West Univ Dr, Edinburg, TX 78539 USA.
   Ferrer, EJ (Corresponding Author), CUNY, Grad Ctr, New York, NY 10314 USA.
   Ferrer, E. J., Univ Texas Rio Grande Valley, Dept Phys \& Astron, 1201 West Univ Dr, Edinburg, TX 78539 USA.
