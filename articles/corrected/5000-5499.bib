@article{ WOS:000472982900001,
Author = {Aquino-Galvez, Arnoldo and Gonzalez-Avila, Georgina and Lorena
   Jimenez-Sanchez, Laura and Aquiles Maldonado-Martinez, Hector and
   Cisneros, Jose and Toscano-Marquez, Fernanda and Castillejos-Lopez,
   Manuel and Maria Torres-Espindola, Luz and Velazquez-Cruz, Rafael and
   Olivera Rodriguez, Victor Hugo and Flores-Soto, Edgar and
   Solis-Chagoyan, Hector and Cabello, Carlos and Zuniga, Joaquin and
   Romero, Yair},
Title = {Dysregulated expression of hypoxia-inducible factors augments
   myofibroblasts differentiation in idiopathic pulmonary fibrosis},
Journal = {RESPIRATORY RESEARCH},
Year = {2019},
Volume = {20},
Month = {JUN 24},
Abstract = {BackgroundIdiopathic pulmonary fibrosis (IPF) is an age-related,
   progressive and lethal disease, whose pathogenesis is associated with
   fibroblasts/myofibroblasts foci that produce excessive extracellular
   matrix accumulation in lung parenchyma. Hypoxia has been described as a
   determinant factor in its development and progression. However, the role
   of distinct members of this pathway is not completely
   described.MethodsBy western blot, quantitative PCR, Immunohistochemistry
   and Immunocitochemistry were evaluated, the expression HIF alpha subunit
   isoforms 1, 2 \& 3 as well, as their role in myofibroblast
   differentiation in lung tissue and fibroblast cell lines derived from
   IPF patients.ResultsHypoxia signaling pathway was found very active in
   lungs and fibroblasts from IPF patients, as demonstrated by the
   abundance of alpha subunits 1 and 2, which further correlated with the
   increased expression of myofibroblast marker SMA. In contrast, HIF-3
   showed reduced expression associated with its promoter
   hypermethylation.ConclusionsThis study lends further support to the
   involvement of hypoxia in the pathogenesis of IPF, and poses HIF-3
   expression as a potential negative regulator of these phenomena.},
