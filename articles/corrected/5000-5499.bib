@article{ WOS:000470044400012,
Author = {Casarrubias-Segura, F. and Rojas-Hernandez, R.},
Title = {Hereditarily monotonically Sokolov spaces have countable network weight},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2019},
Volume = {260},
Pages = {178-188},
Month = {JUN 15},
Abstract = {We provide an example to show that the monotone Sokolov property is not
   necessarily preserved under compact continuous images. Furthermore, we
   prove that if X-2 \textbackslash{} Delta(X) is either monotonically
   Sokolov or monotonically retractable, then X must be cosmic; and that if
   X is either hereditarily monotonically Sokolov or hereditarily
   monotonically retractable, then X has a countable network. Moreover, we
   characterize the Lindelof Sigma-property in C-p-spaces on Alexandrov
   doubles, and show that the L Sigma(L Sigma( <= omega ))-property is
   equivalent to the L Sigma( <= omega )-property for the class of
   C-p-spaces and for the class of Gul'ko spaces. These results solve some
   problems published by Kalenda {[}7], Tkachuk {[}23], Garcia-Ferreira and
   Rojas-Hernandez {[}5], and Molina-Lara and Okunev {[}11]. (C) 2019
   Elsevier B.V. All rights reserved.},
