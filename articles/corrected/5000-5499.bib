Title = {STUDY OF THE OPEN CLUSTER NGC 1528 THROUGH uvby - β PHOTOELECTRIC
   PHOTOMETRY},
Journal = {REVISTA MEXICANA DE ASTRONOMIA Y ASTROFISICA},
Year = {2019},
Volume = {55},
Number = {2},
Pages = {203-209},
Month = {OCT},
Abstract = {uvby - beta photoelectric photometry of sixty-five stars in the
   direction of the open cluster NGC 1528 is presented. From the uvby -
   beta photometry of the cluster we classified the spectral types of the
   stars which allowed us to determine the reddening (E(b-y) of 0.196 +/-
   0.054) and hence, their distance, in parsecs, of (954 +/- 154). We
   determined membership of the stars to the cluster and the age (Log age
   equal 8.04) of the cluster. A metallicity {[}Fe/H] of -0.31 +/- 0.08 was
   calculated.},
