@article{ WOS:000502364900009,
Author = {Galeana-Sanchez, Hortensia and Rojas-Monroy, Rocio and Sanchez-Lopez,
   Rocio and Zavala-Santana, Berta},
Title = {H-kernels by walks in an RH(D) digraph},
Journal = {AKCE INTERNATIONAL JOURNAL OF GRAPHS AND COMBINATORICS},
Year = {2019},
Volume = {16},
Number = {3},
Pages = {291-299},
Month = {DEC},
Abstract = {Let H be a digraph possibly with loops and D a digraph without loops
   whose arcs are colored with the vertices of H (D is said to be an
   H-colored digraph). A directed walk W in D is said to be an H-walk if
   and only if the consecutive colors encountered on W form a directed walk
   in H. A subset N of the vertices of D is said to be an H-kernel by walks
   if (1) for every pair of different vertices in N there is no H-walk
   between them and (2) for each vertex u in V(D)-N there exists an H-walk
   from u to N in D.
   Let H be a digraph and suppose that D is a digraph possibly infinite. In
   this paper we will work with the digraph R-H(D), where R-H(D) is an
   H-colored digraph defined as follows: V(R-H(D)) = V(D) boolean OR A(D)
   and A(R-H(D)) = A(D) boolean OR \{(u, a) : a = (u, v) is an element of
   A(D)\} boolean OR \{(a, v) : a = (u, v) is an element of A(D)\}, where
   (u, a, v) is an H-walk in R-H(D) for every a = (u, v) in A(D) and every
   arc of D in R-H(D) is colored with a vertex of H. We will show
   sufficient conditions on both D and R-H(D) in order to guarantee the
   existence or uniqueness of H-kernels by walks in R-H(D). (C) 2019
   Kalasalingam University. Production and Hosting by Elsevier B.V.},
