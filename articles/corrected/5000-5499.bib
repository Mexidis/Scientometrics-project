@article{ WOS:000457037500073,
Author = {Rodriguez, Pilar and Ochoa-Ochoa, Leticia M. and Munguia, Mariana and
   Sanchez-Cordero, Victor and Navarro-Siguenza, Adolfo G. and
   Flores-Villela, Oscar A. and Nakamura, Miguel},
Title = {Environmental heterogeneity explains coarse-scale β-diversity of
   terrestrial vertebrates in Mexico},
Journal = {PLOS ONE},
Year = {2019},
Volume = {14},
Number = {1},
Month = {JAN 25},
Abstract = {We explored the hypothesis that high beta-diversity of terrestrial
   vertebrates of Mexico is associated with a high environmental
   heterogeneity (HEH) and identify the drivers of beta-diversity at
   different spatial scales. We used distribution range maps of 2,513
   species of amphibians, reptiles, mammals, and birds occurring in Mexico.
   We estimated beta-diversity for each taxon at four spatial scales (grid
   cells of 2 degrees, 1 degrees,0.5 degrees and 0.25 degrees) using the
   multiplicative formula of Whittaker beta(w). For each spatial scale, we
   derived 10 variables of environmental heterogeneity among cells based on
   raw data of temperature, precipitation, elevation, vegetation and soil.
   We applied conditional autoregressive models (CAR) to identify the
   drivers of beta-diversity for each taxon at each spatial scale. CARs
   increased in explanatory power from fine-to-coarse spatial scales in
   amphibians, reptiles and mammals. The heterogeneity in precipitation
   including both, coefficient of variation (CV) and range of values (ROV),
   resulted in the most important drivers of beta-diversity of amphibians;
   the heterogeneity in temperature (CV) and elevation (ROV) were the most
   important drivers of beta-diversity for reptiles; the heterogeneity in
   temperature (ROV) resulted in the most important driver in
   beta-diversity for mammals. For birds, CARs resulted significant at fine
   scales (grid cells of 0.5 degrees and 0.25 degrees), and the
   precipitation (ROV and CV), temperature (ROV), and vegetation (H) and
   soil (H) were heterogeneity variables retained in the model. We found
   support for the hypothesis of environmental heterogeneity (HEH) for
   terrestrial vertebrates at coarse scales (grid cell of 2 degrees).
   Different variables of heterogeneity, mainly abiotic, were significant
   for each taxon, reflecting physiological differences among terrestrial
   vertebrate groups. Our study revealed the importance of mountain areas
   in the geographic patterns of beta-diversity of terrestrial vertebrates
   in Mexico. At a coarse scale, specific variables of heterogeneity can be
   used as a proxy of beta-diversity for amphibians and reptiles.},
