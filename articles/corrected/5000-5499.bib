@article{ WOS:000491375800001,
Author = {Escobar, Maria L. and Echeverria, Olga M. and Palacios-Martinez,
   Sebastian and Juarez-Chavero, Silvia and Sanchez-Sanchez, Luis and
   Vazquez-Nin, Gerardo H.},
Title = {Beclin 1 Interacts With Active Caspase-3 and Bax in Oocytes From Atretic
   Follicles in the Rat Ovary},
Journal = {JOURNAL OF HISTOCHEMISTRY \& CYTOCHEMISTRY},
Year = {2019},
Volume = {67},
Number = {12},
Pages = {873-889},
Month = {DEC},
Abstract = {Oocyte cell death is a normal process in the mammalian ovary during
   follicular growth. Recent reports have demonstrated the presence of
   pro-apoptotic and pro-autophagic proteins during oocyte elimination. The
   goal of this study was to identify the interactions between proteins
   involved in different types of programmed cell death in the same oocyte
   during follicular atresia. We evaluated the presence of Beclin 1 and its
   interaction with the pro-apoptotic proteins active caspase-3, Bax, and
   Bak by means of histochemical observations, ultrastructural
   immunodetection, and immunoprecipitation techniques in ovaries from
   prepubertal (28- and 33-day-old), juvenile (40-day-old), and young adult
   (90-day-old) rats. In this study, we identified that oocyte elimination
   occurred with a high quantity of pro-autophagic protein Beclin 1 and
   increased the presence of the pro-apoptotic proteins active caspase-3,
   Bax, and Bak. Conversely, the antiapoptotic protein Bcl-2 was reduced in
   oocytes from atretic follicles. In addition, Beclin 1 was shown to
   interact with active caspase-3 and Bax. Our results suggest that the
   increase in Beclin 1 is directly related to the rise of pro-apoptotic
   proteins, which could promote the apoptotic process during oocyte
   elimination.},
