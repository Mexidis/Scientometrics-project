@article{ WOS:000460572400014,
Author = {Alberto Hernandez-Jimenez, Carlos and Flores-Villela, Oscar and Atwood
   Campbell, Jonathan},
Title = {A new species of patch-nosed snake (Colubridae: Salvadora Baird
   and Girard, 1853) from Oaxaca, Mexico},
Journal = {ZOOTAXA},
Year = {2019},
Volume = {4564},
Number = {2},
Pages = {588-600},
Month = {MAR 6},
Abstract = {A new species of snake of the genus Salvadora from Oaxaca, Mexico, is
   described. This taxon was confused with S. intermedia in previous
   taxonomic descriptions. It is characterized by lacking a pale vertebral
   stripe and by having incomplete dorsolateral stripes that do not reach
   the posterior part of the body, which is typical of congeners; by having
   both dorsolateral stripes separated each other by five to six scale rows
   on anterior part of body; and other scalation characters as well as the
   number maxillary teeth. The importance of this snake and its
   conservation is discussed.},
