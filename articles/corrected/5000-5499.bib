@inproceedings{ WOS:000619257500032,
Author = {Raul Gio-Argaez, Frank and Gomez-Espinosa, Catalina and Antonio
   Flores-de-Bois, Luis and Cruz-Flores, Delfina and Salgado-Souto, Sergio},
Editor = {Boughdiri, M and Badenas, B and Selden, P and Jaillard, E and Bengtson, P and Granier, BRC},
Title = {Composition of the Pliocene Meiofauna from Punta Maldonado Formation,
   Guerrero (Mexico)},
Booktitle = {PALEOBIODIVERSITY AND TECTONO-SEDIMENTARY RECORDS IN THE MEDITERRANEAN
   TETHYS AND RELATED EASTERN AREAS},
