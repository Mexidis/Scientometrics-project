@article{ WOS:000513176300005,
Author = {Peralta, Oscar and Ortinez-Alvarez, Abraham and Basaldud, Roberto and
   Santiago, Naxieli and Alvarez-Ospina, Harry and de la Cruz, Karen and
   Barrera, Valter and de la Luz Espinosa, Maria and Saavedra, Isabel and
   Castro, Telma and Martinez-Arroyo, Amparo and Paramo, Victor H. and
   Ruiz-Suarez, Luis G. and Vazquez-Galvez, Felipe A. and Gavilan, Arturo},
Title = {Atmospheric black carbon concentrations in Mexico},
Journal = {ATMOSPHERIC RESEARCH},
Year = {2019},
Volume = {230},
Month = {DEC 1},
Abstract = {Atmospheric black carbon concentrations were measured at two urban sites
   (Mexico City and Monterrey), one suburban site (Juriquilla) and one
   high-altitude site (Altzomoni) in Mexico during 2015 and part of 2016.
   Black carbon concentrations were compared against other criteria gases
   finding a strong correlation with carbon monoxide at the urban sites.
   The carbon monoxide-black carbon correlation for the Mexico City site is
   0.77. Urban sites had an average black carbon concentration of above 2.5
   mu g m(-3), the suburban site 0.75 mu g m(-3), and the high-altitude
   site 0.27 mu g m(-3). Compared to other studies, the average levels are
   comparable, and the urban and suburban locations showed a trend towards
   increased atmospheric black carbon concentrations at year end. Other
   urban places (Guadalajara, Cuernavaca, and Iztapalapa) reported black
   carbon concentrations, but for less than a year. For the first time, a
   Latin-American country (Mexico) measured black carbon continuously at
   several sites for a year applying the same data quality assurance.},
