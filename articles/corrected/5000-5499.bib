@article{ WOS:000446346500028,
Author = {Balanov, Zalman and Garcia-Azpeitia, Carlos and Krawcewicz, Wieslaw},
Title = {ON VARIATIONAL AND TOPOLOGICAL METHODS IN NONLINEAR DIFFERENCE EQUATIONS},
Journal = {COMMUNICATIONS ON PURE AND APPLIED ANALYSIS},
Year = {2018},
Volume = {17},
Number = {6},
Pages = {2813-2844},
Month = {NOV},
Abstract = {In this paper, first we survey the recent progress in usage of the
   critical point theory to study the existence of multiple periodic and
   subharmonic solutions in second order difference equations and discrete
   Hamiltonian systems with variational structure. Next, we propose a new
   topological method, based on the application of the equivariant version
   of the Brouwer degree to study difference equations without an extra
   assumption on variational structure. New result on the existence of
   multiple periodic solutions in difference systems (without assuming that
   they are their variational) satisfying a Nagumo-type condition is
   obtained. Finally, we also put forward a new direction for further
   investigations.},
