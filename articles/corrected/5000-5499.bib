Pages = {1-8},
Month = {SEP 15},
Abstract = {A space Z is weakly pseudocompact if Z is G(delta)-dense in at least one
   of its compactifications. In 1996 F.W. Eckertson {[}3] proposed the
   following problem: Find examples of Baire non Lindelof spaces which are
   not weakly pseudocompact. Eckertson proposed a list of natural
   candidates. In this article we show that part of this list produces
   examples of this type by providing examples of product spaces which are
   Baire non-Lindekif and not weakly pseudocompact. (C) 2018 Elsevier B.V.
   All rights reserved.},
