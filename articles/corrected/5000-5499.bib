Organization = {Natl Autonomous Univ Mexico, Complex Sci Ctr; Philips Healthcare;
   ScientyMed},
Abstract = {From the point of view of Complexity Sciences, health can be considered
   as the homeostatic state of balance between the robustness and the
   adaptability to changes in the environment. We consider that living
   under extreme conditions (like homeless) will affect the subjects,
   producing a loose of this homeostatic state of balance. Here, we find
   this imbalance by analyzing the heart rate variability in time and
   frequency domains.},
