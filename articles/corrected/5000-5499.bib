@article{ WOS:000468225400001,
Author = {Bayard, Pierre},
Title = {Spinorial Representation of Submanifolds in SLn(C)/SU(n)},
Journal = {ADVANCES IN APPLIED CLIFFORD ALGEBRAS},
Year = {2019},
Volume = {29},
Number = {3},
Month = {JUL},
Abstract = {We give a spinorial representation of a submanifold of any dimension and
   co-dimension in a symmetric space G/H, where G is a complex semi-simple
   Lie group and H is a compact real form of G. This in particular includes
   SLn(C)/SU(n), and extends the previously known spinorial representation
   of a surface in H3 if n=2. We also recover the Bryant representation of
   a surface with constant mean curvature 1 in H3 and its generalization
   for a surface with holomorphic right Gauss map in SLn(C)/SU(n). As a new
   application, we obtain a fundamental theorem for the submanifold theory
   in that spaces.},
