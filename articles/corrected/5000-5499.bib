@article{ WOS:000468470200005,
Author = {Angel Castellanos-Reyes, Jose and Castrejon-Figueroa, Jesus and
   Maciel-Escudero, Carlos and Reyes-Coronado, Alejandro},
Title = {Electronic tweezers for magnesium oxide nanoparticles},
Journal = {MATERIALS TODAY-PROCEEDINGS},
