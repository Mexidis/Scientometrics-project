@article{ WOS:000460719000011,
Author = {Maciel-Escudero, C. and Reyes-Coronado, A.},
Title = {Electromagnetic fields produced by a swift electron: A source of white
   light},
Journal = {WAVE MOTION},
Year = {2019},
Volume = {86},
Pages = {137-149},
Month = {MAR},
Abstract = {In this work we calculate the electromagnetic fields generated by a
   swift electron in both time and frequency domains. Although the
   electromagnetic fields in the time domain produced by a bare fast
   electron are obtained in standard textbooks, their time Fourier
   transform is not satisfactorily discussed neither are the integrals
   involved in the computation of it. We show that care must be taken when
   calculating the electromagnetic fields in the frequency domain to
   preserve their real nature. (C) 2019 Elsevier B.V. All rights reserved.},
