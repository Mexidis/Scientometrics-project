@article{ WOS:000458880000001,
Author = {Grego, Jozef and Angyal, Dorottya and Lievano Beltran, Luis Arturo},
Title = {First record of subterranean freshwater gastropods (Mollusca,
   Gastropoda, Cochliopidae) from the cenotes of Yucatan state},
Journal = {SUBTERRANEAN BIOLOGY},
Year = {2019},
Volume = {29},
Pages = {79-88},
Month = {FEB 18},
Abstract = {The biospeleological investigations of several cenotes in the eastern
   region of Yucatan state, Mexico, during January 2018 yielded, among
   other invertebrates, two new truncatelloid gastropod species described
   herein as Mexicenotica xochii gen. n. et sp. n. and Pyrgophorus
   thompsoni sp. n. Both species represent the first record of stygobiont
   gastropod species from the cenotes of Yucatan indicating the high
   biodiversity potential of the studied area.},
