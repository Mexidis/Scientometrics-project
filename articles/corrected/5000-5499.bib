@article{ WOS:000474453700008,
Author = {DeVos, Matt and McDonald, Jessica and Montejano, Amanda},
Title = {Non-monochromatic Triangles in a 2-Edge-Coloured Graph},
Journal = {ELECTRONIC JOURNAL OF COMBINATORICS},
Year = {2019},
Volume = {26},
Number = {3},
Month = {JUL 5},
Abstract = {Let G = (V, E) be a simple graph and let \{R, B\} be a partition of E.
   We prove that whenever vertical bar E vertical bar + min\{vertical bar R
   vertical bar, vertical bar B vertical bar\} > (vertical bar V vertical
   bar 2), there exists a subgraph of G isomorphic to K-3 which contains
   edges from both R and B. If instead equality holds, and G has no such
   subgraph, then we show that G is in one of a few simple classes.},
