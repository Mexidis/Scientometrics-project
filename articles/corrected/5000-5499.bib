@article{ WOS:000447961800018,
Author = {Caro, Yair and Hansberg, Adriana and Montejano, Amanda},
Title = {Zero-sum subsequences in bounded-sum \{-1,1\}-sequences},
Journal = {JOURNAL OF COMBINATORIAL THEORY SERIES A},
Year = {2019},
Volume = {161},
Pages = {387-419},
Month = {JAN},
Abstract = {The following result gives the flavor of this paper: Let t, k and q be
   integers such that q >= 0, 0 <= t < k and t equivalent to k (mod 2), and
   let s is an element of {[}0, t + 1] be the unique integer satisfying s
   equivalent to q + k-t-2/2 (mod (t + 2)).Then for any integer n such that
   n >= max\{k, 1/2(t + 2) k(2) + q - s/t + 2 k - t/2 + s\}
   and any function f : {[}n] -> \{-1, 1\} with vertical bar Sigma(n)(i=1)
   f(i)vertical bar <= q, there is a set B subset of {[}n] of k consecutive
   integers with vertical bar Sigma(y is an element of B) f(y) )vertical
   bar <= t. Moreover, this bound is sharp for all the parameters involved
   and a characterization of the extremal sequences is given.
   This and other similar results involving different subsequences are
   presented, including decompositions of sequences into subsequences of
   bounded weight. (C) 2018 Elsevier Inc. All rights reserved.},
