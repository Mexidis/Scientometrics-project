@article{ WOS:000458672000004,
Author = {Arias, Salvador and Tapia, Hector J. and Guzman, Ulises},
Title = {A new species of Cephalocereus (Cactaceae) from southern Mexico},
Journal = {PHYTOTAXA},
Year = {2019},
Volume = {392},
Number = {2},
Pages = {147-156},
Month = {FEB 14},
Abstract = {Cephalocereus parvispinus sp. nov. (Cactaceae) from the Mixtecan region
   (Oaxaca state, Mexico) is described and illustrated. Morphological,
   ecological, and molecular evidences support its recognition as a
   distinct species. The new species is characterized by arborescent habit
   up to 8 m in height, acrotonic branching, stems 15-23-ribbed, flowers
   3.5-4.0 cm long, pericarpel and receptacular tube without podaria or
   spines, fruit 1.7-2.2 cm long, darkred, with white flesh, seeds ca. 1.4
   x 0.6 mm, dark brown, with a rugose micro-relief. The phylogenetic
   analysis using seven cpDNA markers, shows that C. parvispinus is the
   sister species of C. polylophus, and C. euphorbioides.},
Publisher = {MAGNOLIA PRESS},
