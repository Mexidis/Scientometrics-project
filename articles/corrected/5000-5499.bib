@article{ WOS:000461993900030,
Author = {Hernandez-Camache, Norma and Antonio Moreno-Perez, Marco and
   Acosta-Gutierrez, Roxana and del Carmen Guzman-Cornejo, Maria and
   Pineda-Lopez, Ruben and Jones, Bert W. and Zamora-Ledesma, Salvador and
   Camacho-Macias, Brenda and Vergara-Pineda, Santiago},
Title = {Ectoparasite Arthropod Diversity of the Gray Fox (Urocyon
   cinereoargenteus) and Domestic Dogs of Central Mexico},
Journal = {SOUTHWESTERN ENTOMOLOGIST},
Year = {2019},
Volume = {44},
Number = {1},
Pages = {281-295},
Month = {MAR},
Abstract = {The study of the arthropod parasite community of wild and peridomestic
   fauna in the urban-rural-natural interphase is of public health
   importance, because these communities may serve as the link between
   possible zoonotic pathogens in the arthropod parasites and humans. This
   is the case of the grey fox (Urocyon cinereoargenteus) and peridomestic
   dogs (Canis lupus familiaris) in central Mexico. Because of freedom of
   movement of the dogs between the urbanized and natural environments, the
   possibility exists of the interchange of species of parasites between
   the two canids. The present study was done in central Mexico, where nine
   grey foxes and 21 peridomestic dogs were inspected for arthropod
   parasites. In total, 339 ectoparasites were found, including seven
   species of Siphonatera from three families and six genera (324
   individuals), as well as 15 tick species of the family Ixodidae. Both
   canids had similar total species richness, with six ectoparasite
   species, but the structure of the community was different. The dominant
   species in both canids was Pulex simulans, suggesting that this species
   may play a role as a vector of important zoonotic diseases. The
   differences found between the two ectoparasitic communities indicates
   that despite the shared use of the habitat by both species, fleas were
   more common and had greater richness in the grey fox which indirectly
   reflects differences by the two canids in the use the habitats.},
