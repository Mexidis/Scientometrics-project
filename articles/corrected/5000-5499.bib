Title = {Dosimetric Characterization of a Cesium-137 Irradiator for Irradiation
   of Cell Cultures},
Booktitle = {XV MEXICAN SYMPOSIUM ON MEDICAL PHYSICS},
Series = {AIP Conference Proceedings},
Year = {2019},
Volume = {2090},
Note = {15th Mexican Symposium on Medical Physics, Mexico City, MEXICO, JUN
   13-15, 2018},
Organization = {Natl Autonomous Univ Mexico, Complex Sci Ctr; Philips Healthcare;
   ScientyMed},
Abstract = {In the Instituto Nacional de Cancerologia (INCan), new treatments
   involving the use of radiotherapy are investigated, evaluating their
   effects on cell cultures. For irradiation it is necessary to
   characterize a 137Cs BIOBEAM-GM 2000 irradiator. The characterization
   was carried out using a dosimetric system composed of a radiochromic dye
   film GAFCHROMIC R EBT3, a Scanmaker 8700 Microteck scanner and the
   Matlab R2016b program. As a result of the characterization, a dose rate
   of 4.8 +/- 0.4 Gy min(-1) and a distribution with a radial dose gradient
   over three cell culture dishes are obtained. In conclusion, a protocol
   was established to irradiate three cell culture dishes at the same dose
   in a single exposure.},
