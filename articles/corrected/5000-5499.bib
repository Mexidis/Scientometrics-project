Title = {Quantum Phase Transitions within the Semimicroscopic Algebraic Cluster
   Model},
Journal = {NUCLEAR PHYSICS A},
Year = {2019},
Volume = {992},
Month = {DEC},
Abstract = {Quantum Phase Transition (QPT) properties are investigated within the
   Semimicroscopic Algebraic Cluster Model (SACM), as an example of a model
   with involved structure. The catastrophe theory is applied to obtain a
   physical insight and analytic formulas for the process of QPTs. QPTs are
   obtained up to the third order. We propose a novel procedure which can
   be used in several models in various sectors of physics. (C) 2019
   Published by Elsevier B.V.},
