@article{ WOS:000536218400001,
Author = {Ramirez-Renteria, Claudia and Espinosa-De-Los-Monteros, Ana Laura and
   Etual, Espinosa-Cardenas and Marrero-Rodriguez, Daniel and Castellanos,
   Guillermo and Arreola-Rosales, Rocio and Montoya-Martinez, Guillermo and
   Taniguchi-Ponciano, Keiko and Briseno-Diaz, Paola and Padilla-Cristerna,
   Mayte Lizeth and Figueroa-Corona, Maria del Pilar and Moises, Mercado},
Title = {From ACTH-Dependent to ACTH-Independent Cushing's Syndrome from a
   Malignant Mixed Corticomedullary Adrenal Tumor: Potential Role of
   Embryonic Stem Cells},
Journal = {CASE REPORTS IN ENDOCRINOLOGY},
Year = {2020},
Volume = {2020},
Month = {MAY 4},
Abstract = {Context. Truly, mixed corticomedullary adrenal tumors (MCATs) may not
   come from colliding tumors but from a single stem cell. Objective. To
   report the immunohistochemical and molecular evaluation of a patient
   with ectopic ACTH syndrome (EAS) from a MCAT which has single cells with
   features of both 96 medullary and cortical differentiation. Case
   Description and Methods. A 16-year-old woman presented with severe EAS
   and a large right MCAT composed of ACTH-secreting cells resembling
   pheochromocytoma and another lineage similar to adrenal carcinoma.
   Immunohistochemistry (IHC) showed positivity for medullary (ACTH,
   chromogranin A, synaptophysin, and PS-100) and epithelial components
   (inhibin, melan-A, and calretinin). Embryonic stem cell markers were
   evaluated using RT/PCR and immunofluorescence. After initial surgery,
   the tumor recurred shifting to rapidly progressive ACTH-independent
   liver metastasis. Results. Histopathology and IHC revealed two distinct
   and intermingled cellular patterns, while some cells immunostained for
   both medullary and cortical markers. Demonstration of all stem cell
   biomarkers by RT/PCR and immunofluorescence was predominantly localized
   to the nucleus, whereas SOX2 immunoreactivity was evident in the
   cytoplasm as well. Conclusion. The expression of cancer stem cell
   biomarkers points towards the involvement of primitive embryonic cells
   as the origin of this neoplasm and maybe to the clinically aggressive
   and biochemically changing behavior.},
