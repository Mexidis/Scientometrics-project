@article{ WOS:000607461100027,
Author = {Campos Gonzalez, Erick and Nieves-Uribe, Sandra and Llorente-Bousquets,
   Jorge},
Title = {Description of the Exochorion on Three Species of Coeini},
Journal = {SOUTHWESTERN ENTOMOLOGIST},
Year = {2020},
Volume = {45},
Number = {4},
Pages = {1091-1120},
Month = {DEC},
Abstract = {We described and compared the exochorion of three species of the tribe
   Coeini, with specimens from Mexico: Historis odius dious, Colobura dirce
   dirce, and Smyrna blomfildia datis. We characterized the main structural
   features of the exochorion: color, shape, size, `ornamentation',
   differentiation on the micropylar, perimicropylar, and transition zones,
   as well as equatorial and basal structures, both with the staining
   technique and scanning electron microscope. We recognized autapomorphic
   microstructural characters in the chorion of these genera (calgarys,
   rows), as well as specializations at the base (bridges and domes). For
   better understanding of these structures, diagrams and a glossary with
   the terms adopted in this work are included. We compared and discussed
   our results with published descriptions for these species, as well as
   with some phylogenies of Nymphalinae subfamily.},
