@article{ WOS:000603378700015,
Author = {Yolocalli Cisneros-Bernal, Antonio and Palacios-Aguilar, Ricardo and
   Medina-Rangel, Gonzalo and Campillo-G, Gustavo and Rivera-Reyes, Ricardo},
Title = {New distributional records of amphibians and reptiles from the Mixteca
   region of Oaxaca, Mexico},
Journal = {NORTH-WESTERN JOURNAL OF ZOOLOGY},
Year = {2020},
Volume = {16},
Number = {2},
Pages = {220-224},
Month = {DEC},
Abstract = {We report new distributional records for 16 species of amphibians and
   reptiles from the northern Mixteca region of Oaxaca, Mexico. Notable
   observations include the first state record of Leptodeira splendida
   (Squamata, Colubridae), a new locality for the endemic Tantalophis
   discolor (Squamata, Colubridae), the first record of Barisia planifrons
   (Squamata, Anguidae) in Mixteca. We comment on an issue with the
   identification of the tadpoles used to describe a new taxon, Sarcohyla
   ameibothalame (Anura, Hylidae) from the Mixteca (Canseco-Marquez et al.
   2002). Additionally, we updated the regional checklist of 31 species (5
   amphibians and 26 reptiles), of which more than 80\% are Mexican
   endemics and 13\% are state endemics.},
