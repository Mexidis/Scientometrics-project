@article{ WOS:000571751400010,
Author = {Martinez-De-La-Vega, Veronica and Martinez-Montejano, Jorge M.},
Title = {CONCERNING WHEN F1 (X) IS A CONTINUUM OF COLOCAL
   CONNECTEDNESS IN HYPERSPACES AND SYMMETRIC PRODUCTS},
Journal = {COLLOQUIUM MATHEMATICUM},
Year = {2020},
Volume = {160},
Number = {2},
Pages = {297-307},
Abstract = {Given a continuum X and a positive integer n, we consider its
   hyperspaces 2(x) = \{A subset of X : A is closed and nonempty\}, C-n(X)
   = \{A is an element of 2(x) : A has at most n components\} and F-n(X) =
   \{A is an element of 2(x) : A has at most n points\}. For a subcontinuum
   A of X consider the following properties: A is a continuum of colocal
   connectedness, not weak cut, nonblock, shore, not strong center and
   noncut in X.
   We study when F-1 (X) has one of these properties in F-n(X), 2(x) or
   C-n(X).},
