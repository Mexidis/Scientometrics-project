@article{ WOS:000575766200017,
Author = {Rivera-Galicia, Sara and Nieves-Uribe, Sandra and Llorente-Bousquets,
   Jorge},
Title = {Exochorionic Study on Three Species of Heliconiinae from Mexico},
Journal = {SOUTHWESTERN ENTOMOLOGIST},
