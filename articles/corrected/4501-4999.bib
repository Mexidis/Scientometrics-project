Title = {Aggregation operators as an alternative for cloud resource selection},
Booktitle = {2020 IEEE CONGRESO BIENAL DE ARGENTINA, ARGENCON},
Year = {2020},
Note = {2020 Congress of Argentina, Resistencia, ARGENTINA, DEC 01-04, 2020},
Abstract = {In the last decade, advances in communications and computing have
   changed the way people and organizations conduct their activities,
   particularly those that utilize technological resources. In other words,
   traditional computing, where an operating system coexisted with programs
   and files on a user terminal, is being replaced by new technologies that
   enable ubiquitous access to computing capabilities as services through a
   data network or the Internet. This is one of the characteristics that
   make cloud computing (CC) an attractive model. Both users and
   information technology (IT) personnel are in a transitional phase, where
   questions arise about which services are appropriate for a particular
   task, how they can be selected, and who can provide them. Accordingly,
   this paper presents the characteristics of CC, the technologies that
   enable its development, and a valid alternative for resource/supplier
   selection through a model that utilizes aggregation operators.},
