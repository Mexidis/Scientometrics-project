@article{ WOS:000530021100008,
Author = {Mejia-Madrid, Hugo H. and Pena-Santiago, Reyes},
Title = {Morphological and molecular characterisation of Aporcelinus
   zapotitlanensis sp. n. (Dorylaimida: Aporcelaimidae) from central
   Mexico},
Journal = {NEMATOLOGY},
Year = {2020},
Volume = {22},
Number = {4},
Pages = {468-477},
Month = {APR},
Abstract = {A new species of Aporcelinus, collected in a natural habitat of central
   Mexico, is described and illustrated, including molecular (D2-D3
   28S-rRNA) data. Aporcelinus zapotitianensis sp. n. is characterised by
   its 1.19-1.43 mm long body, lip region offset by a deep constriction and
   16.5-18.5 mu m broad, odontostyle 195-22 long, neck 325-368 mu m long,
   pharyngeal expansion 150-201 mu m long or 46-55\% of the total neck
   length, uterus 130-167 mu m long and tripartite, V = 54-56, tail conical
   with finely rounded tip (30-37 mu m, c = 34-43, c' = 1.2-1.4) lacking a
   distinct dorsal concavity, spicules 48-51 mu m long, and 11-12 spaced
   ventromedian supplements with one or two of them located within the
   range of the spicules. Molecular analyses confirm the monophyly of
   Aporcelinus and places the new species within a Glade shared with A.
   infiutdibulicaudatus and A. amazonicus.},
