@article{ WOS:000581918000012,
Author = {Hugo Diaz-Granados, Victor and Manuel Lopez-Lopez, Jorge and
   Flores-Sanchez, Jesus and Olguin-Alor, Roxana and Bedoya-Lopez, Andrea
