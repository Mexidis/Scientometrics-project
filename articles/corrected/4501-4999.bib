@article{ WOS:000536895800010,
Author = {Esteban Contreras-Mendoza, Fernando and Hernandez-Cruz, Cesar},
Title = {Minimal obstructions to (s, 1)-polarity in cographs},
Journal = {DISCRETE APPLIED MATHEMATICS},
Year = {2020},
Volume = {281},
Number = {SI},
Pages = {111-117},
Month = {JUL 15},
Abstract = {Let s, k be non negative integers. A graph G is (s, k)-polar if its
   vertex set admits a partition (A, B) such that A induces a complete
   multipartite graph with at most s parts, and B induces a disjoint union
   of atmost k cliques with no other edges. A notable case is that of (1,
   1)-polar graphs, which are exactly split graphs. The concepts of (s,
   infinity)-, (infinity, k)- and (infinity, infinity)-polar graphs can be
   analogously defined. A graph is a cograph if it does not contain P-4 as
   an induced subgraph.
   Ekim, Mahadev and de Werra first investigated polar cographs, obtaining
   forbidden induced subgraph characterizations for (infinity, )-polar
   cographs, and also for the union of (1, infinity)- and (infinity,
   1)-polar cographs. So far, for fixed s and k, complete lists of minimal
   (s, k)-polar cograph obstructions are known only for the pairs (1, 1),
   (1, 2), (2, 1) and (2, 2). In this paper we find the list of cograph
   minimal (s, 1)-polar obstructions for any fixed positive integer s, as
   well as the list of cograph minimal (infinity, 1)-polar obstructions. By
   considering the complement of such graphs, these results extend to (1,
   k)- and (1,infinity)-polar cographs. (c) 2018 Elsevier B.V. All rights
   reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
