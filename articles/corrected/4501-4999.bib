@article{ WOS:000518679900011,
Author = {Hernandez-Banos, Blanca E. and Zamudio-Beltran, Luz E. and Mila, Borja},
Title = {Phylogenetic relationships and systematics of a subclade of Mesoamerican
   emerald hummingbirds (Ayes: Trochilidae: Trochilini)},
Journal = {ZOOTAXA},
Year = {2020},
Volume = {4748},
Number = {3},
Pages = {581-591},
Month = {MAR 9},
Abstract = {Phylogenetic relationships among major hummingbird clades are relatively
   well resolved, yet due to the lack of morphological synapomorphics and
   relative phenotypic homogeneity, the systematics of several hummingbird
   groups remain unresolved. Here, we present the results of a multilocus
   study of a Glade of emerald hummingbirds composed of Cynanthus,
   Chlorostilbon, Riccordia and Phaeoptila (sensu Stiles et al. 2017). We
   include taxa not analyzed in previous studies (C. lawrencei, C. auriceps
   and C. forficatus, from Tres Marias Islands, Western Mexico, and Cozumel
   Island, respectively), and this allows us to develop a new hypothesis
   for the phylogenetic relationships within this group. We found that this
   Glade originated in Mesoamerica about 12 million years ago, and
   comprises four geographically congruent Glades: (a) the most basal
   Glade, Phaeoptila sordida, of the Balsas River basin, Mexico; (b)
   Riccordia bicolor, R. maugaeus, R. ricordii and R. swainsonii of the
   West Indies; (c) Chlorostilbon assimilis, C. aureoventris, C.
   melanorhynchus, C mellisugus, C. poortmani and C. pucherani, all of
   South America, except C. assimilis of Central America; and (d) a
   Mesoamerican Glade with two Cynanthus subclades: a widespread Mexican
   Glade that includes species formerly belonging to the genus
   Chlorostilbon: Cynanthus auriceps, C. canivetii, C. douhledayi and C.
   forficatus; and a Glade restricted to the west coast of Mexico and the
   Tres Marias Islands and composed of C. latirostris and C. lawrencei. Our
   results help clarify the systematics of this group of emeralds,
   reconstruct its true evolutionary history, and advance understanding of
   phenotypic evolution in hummingbirds.},
Publisher = {MAGNOLIA PRESS},
