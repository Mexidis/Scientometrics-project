Affiliations = {Universidad Nacional Autonoma de Mexico},
Funding-Acknowledgement = {UNAM-DGAPA PAPIIT {[}IN214916]},
Funding-Text = {We would like to thank Jagoba Malumbres-Olarte and Jeremy Miller for
   their valuable comments and thorough reviews of an earlier version of
   this work. The authors would like to thank Rosamond I. Coates-Lutes and
   Estacion de Biologia Los Tuxtlas IB-UNAM for allowing the conduction of
   this inventory. Special thanks to the following arachnologists for their
   help with the morphospecies identifications: Wayne Maddison, Uriel
