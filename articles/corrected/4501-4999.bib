@article{ WOS:000507233300016,
Author = {Cruz-Puerto, Juan and Ramirez-Carrillo, Cristina and Puga-Lechuga, Jorge
   and de la Mora, Pablo and Tavizon, Gustavo},
Title = {Crystal structure and optical absorption properties of Er and Yb doped
   InTaO4 and InTaO4-yNy as photocatalysts
   under visible light},
Journal = {CHEMICAL PHYSICS LETTERS},
Year = {2020},
Volume = {739},
Month = {JAN},
Abstract = {Polycrystalline samples of In1-xRExTaO4 (RE = Er and Yb) in the 0 <= x
   <= 0.20 range, crystallizing in the wolframite structure, were prepared
   by the solid-state reaction method. All samples were characterized by
   X-ray diffraction, and their structural parameters were obtained by
   Rietveld refinements. The optical response of these compounds was
   obtained by diffuse reflectance spectroscopy in the UV-vis range to
   determine the effect of the Er3+ and Yb3+ cations and the N anion on the
   band gap value of InTaO4. Even though it was found that Er3+
   substitution at In3+ sites in the InTaO4 lattice provides an expanded
   range of light absorption from 300 nm to the visible range of the light
   spectrum, this is only reflected in a small drop of the optical bandgap.
   For the In1-xRExTaO4 system, there are two optical band gap sets, one of
   them ranging from 3.94 to 4.15 eV, and the other one, from 2.8 to 3.2
   eV. In the N-doped In1-xRExTaO4 compounds, these values were practically
   the same for the first set, and slightly lower for the second set, from
   2.9 to 3.0 eV. A DFT-based method was used to compute the electronic
   structure of the RE3+ and N-doped compounds. Based on experimental and
   theoretical results, the effect of the RE and N doping on InTaO4 is
   discussed.},
