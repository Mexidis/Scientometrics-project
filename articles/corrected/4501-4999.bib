Volume = {58},
Number = {2},
Pages = {497-515},
Month = {FEB},
Abstract = {A generalized Lengyel-Epstein oscillating reaction model is proposed and
   analyzed. The existence of limit cycles is proved using Hopf and Bautin
   bifurcation theory. We analyze the dynamics of the well known chlorine
   dioxide-iodine-malonic acid reaction, using a differential equations
   system. The numerical results are shown and these agree with the
   experimental data reported in the literature. We found that the
   oscillatory behavior depends on the stoichiometric coefficients and the
   reactant concentrations. This work gives valuable information for
   applications like design, optimization, dynamics and control of the
   industrial chemical reactors.},
