@article{ WOS:000680501300001,
Author = {Galvez-Zeferino, Neysi and Rivaz Hernandez, Jose Amet and Veronica
   Morales-Zarate, Maria and Aguilar-Aguilar, Rogelio and Augusto
   Salinas-Zavala, Cesar},
Title = {New records of peanut worms (Sipuncula) from a transitional coastal
   lagoon in Guerrero Negro, Baja California Peninsula, Mexico and notes on
   Nephasoma (Nephasoma) laetmophilum (Fisher, 1952)},
Journal = {CAHIERS DE BIOLOGIE MARINE},
Year = {2020},
Volume = {61},
Number = {5},
Pages = {477-488},
Abstract = {Five species of sipunculan worms belonging to two families and three
   genera were identified from the western coast of Baja California
   Peninsula and collected in Guerrero Negro lagoon. This lagoon system,
   located in western Baja California Peninsula, exhibits characteristics
   of marine connectivity, temperature, sediment transport and
   precipitation that, together, allow it to be considered as a
   transitional environment. This work constitutes the first approach to
   sipunculans in transitional aquatic systems and coastal lagoons in
   Mexico. Four species are new records for the marine fauna of the
   country. The morphological and distributional features of all species
   are critically discussed. Moreover, the species Nephasoma (Nephasoma)
   laetmophilum (Fisher, 1952), which has a narrow distribution in the
   Eastern Pacific (southern California and western coast of Baja
   California Peninsula), is noted after almost 67 years after its
   description. Our results represent a significant contribution for the
   taxonomic composition and distribution of sipunculans in Mexico. In
   addition, we point out the relevance of detailed redescriptions in
   neglected groups, such as sipunculans, as an essential tool for the
   proper evaluation of species status of specific doubtful names.},
