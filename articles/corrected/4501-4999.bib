@article{ WOS:000575178900001,
Author = {Santana, David J. and Rincon, Luis},
Title = {Approximations of the ruin probability in a discrete time risk model},
Journal = {MODERN STOCHASTICS-THEORY AND APPLICATIONS},
Year = {2020},
Volume = {7},
Number = {3},
Pages = {221-243},
Month = {SEP},
Abstract = {Based on a discrete version of the Pollaczeck-Khinchine formula, a
   general method to calculate the ultimate ruin probability in the
   Gerber-Dickson risk model is provided when claims follow a negative
   binomial mixture distribution. The result is then extended for claims
   with a mixed Poisson distribution. The formula obtained allows for some
   approximation procedures. Several examples are provided along with the
   numerical evidence of the accuracy of the approximations.},
