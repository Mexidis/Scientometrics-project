@article{ WOS:000525424900002,
Author = {Chatterjee, Tapas and Dovgal, Igor and Mayen-Estrada, Rosaura and
   Fernandez-Leboran, Gregorio},
Title = {A checklist of ciliates (Ciliophora) inhabiting on ostracods (Crustacea,
   Ostracoda)},
Journal = {ZOOTAXA},
Year = {2020},
Volume = {4763},
Number = {1},
Pages = {17-30},
Month = {APR 8},
Abstract = {A compilation of the ciliated species found on freshwater and marine
   ostracods as cpibiont or parasite (endobiont) has been carried out based
   on published records. The checklist includes the taxonomic position of
   each species of cpibiontic and endobiontic ciliate. the species of
   basibiont ostracodes, the geographic zones and the bibliographic
   references where they were recorded. Altogether 7 suctorian, 29
   peritrich, one apostomc and one scuticociliatid species were listed. Two
   of recorded suctorian species are possible specific to marine
   ostracodcs, whereas only one. Tokophrya sib irica to freshwater hosts.
   Fourteen species of peritrichs arc likely specific to freshwater
   ostracodcs, while three possible specific to marine ostracode hosts.
   Other suctorian and peritrich ciliate species were found on a variety of
   host taxa. One species of scuticociliatid was recorded as endobiont in
   ostracod.},
