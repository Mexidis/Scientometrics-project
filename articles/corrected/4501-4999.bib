@article{ WOS:000525801200029,
Author = {Morales-Diaz, Jorge and Colunga-Salas, Pablo and Romero-Salas, Dora and
   Sanchez-Montes, Sokani and Estrada-Souza, Iris M. and Ochoa-Ochoa,
   Leticia M. and Becker, Ingeborg and Flores-Primo, Argel and Cruz-Romero,
   Anabel},
Title = {Molecular detection of reptile-associated Borrelia in Boa
   constrictor (Squamata: Boidae) from Veracruz, Mexico},
Journal = {ACTA TROPICA},
Year = {2020},
Volume = {205},
Month = {MAY},
Abstract = {The reptile-associated Borrelia represent a monophyletic group of
   bacteria transmitted by several species of hard ticks, which has been
   reported to only infect amphibians and reptiles in Eurasia and Middle
   East, however, this bacterial group has not been studied in North
   America. The aim of this study was to assess the presence of Borrelia
   spirochetes in blood samples of native reptiles of Mexico. Blood samples
   were directly obtained from individuals, DNA extractions were performed
   using Chelex-100. The Borrelia detection was performed by conventional
   PCR. From 102 reptiles tested, only five individuals of Boa constrictor
   were positive for the presence of DNA of the reptile-associated Borrelia
   group. Supported by phylogenetic analysis, this study presents the first
   record of these spirochetes group in Mexico, and initial evidence of B.
   constrictor as a host of this group.},
