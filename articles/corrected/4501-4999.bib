@article{ WOS:000517656100002,
Author = {Illanes, Alejandro and Marquez, Emanuel R. and Naranjo-Murillo, Jimmy A.
   and Rodriguez-Castro, I, Erick and Vega, Jorge E.},
Title = {Induced mappings on hyperspaces C(p, X) and
   K(X), some answers},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2020},
Volume = {272},
Month = {MAR 1},
Abstract = {Given a metric continuum X, let C(X) denote the hyperspace of all
   subcontinua of X. For p is an element of X, define the hyperspaces C(p,
   X) = \{A is an element of C(X) : p is an element of A\} and K(X) =
   \{C(q, X) : q is an element of X\}. For a mapping f : X -> Y between
   continua, we consider the natural induced mappings f(C) : C(X) -> C(Y),
   f(K) : K(X) -> K(Y) and f(K,C) : K(X) -> C(C(Y)), given by f(C)(A) =
   f(A) (the image of A under f), f(K)(C(p, X)) = C(f(p),Y) and f(K,C)(C(p,
   X)) = \{f(A) is an element of C(Y) : p is an element of A is an element
   of C(X)\}. Given a class of mappings M, in this paper we consider
   relations between the statements f is an element of M, f(C) is an
   element of M, f(K) is an element of M and f(K,C) is an element of M and
   we answer some questions considering the following classes of mappings:
   confluent, weakly confluent, light and open. (C) 2020 Elsevier B.V. All
   rights reserved.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
