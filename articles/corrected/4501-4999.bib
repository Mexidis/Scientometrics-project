@article{ WOS:000508014700002,
Author = {Valencia-A, Susana and Coombes, Allen J.},
Title = {Nomenclatural revision and lectotypification of five species of Mexican
   oaks: Quercus (Fagaceae)},
Journal = {PHYTOTAXA},
Year = {2020},
Volume = {428},
Number = {2},
Pages = {81-92},
Month = {JAN 9},
Abstract = {The nomenclature of Quercus splendens, Q. peduncularis, Q. sororia, Q.
   lancifolia, Q. leiophylla, Q. toxicodendrifolia, Q. gentryi and Q.
   confertifolia is reviewed by a study of the type specimens, original
   descriptions and herbarium material. Quercus splendens is regarded as a
   synonym of Q. peduncularis; Q. sororia and Q. toxicodendrifolia are
   recognized as accepted names and Q. confertifolia is regarded as the
   accepted name for Q. gentryi. Fourteen names are lectotypified and one
   epitype is designated.},
