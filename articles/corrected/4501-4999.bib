Month = {JUL 31},
Abstract = {The tropical montane cloud forest is an important reservoir of the
   diversity of Mexican ascomycetes. We cite and describe 17 species that
   had not been recorded in this vegetation type. Fifteen of them are new
   records for Mexico. Some of these species are associated with
   angiosperms and some with other fungi. Ongoing efforts are required to
   carry out floristic, taxonomic, phylogenetic and ecological studies of
   this group of fungi in such a diverse ecosystem that is cataloged as
   threatened.},
