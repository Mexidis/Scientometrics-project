@article{ WOS:000617458500005,
Author = {Pantoja Peschard, Maria Jose},
Title = {How to Face the Imminent Arrival of the Other? Some Thoughts on Jacques
   Derrida's Concept of Hospitality},
Journal = {REVISTA MEXICANA DE CIENCIAS POLITICAS Y SOCIALES},
Year = {2020},
Volume = {65},
Number = {238},
Pages = {107-129},
Month = {JAN-APR},
Abstract = {Jacques Derrida argues that the best way to approach today's urgent
   matter of transnational migration is to adopt the perspective of
   hospitality. This paper conducts a philosophical analysis of this
   argument. First, it discusses Derrida's understanding of hospitality,
   and how this concept allows him to claim that there is an inextricable
   yet contradictory relationship between ethics and politics. It then
   explains how this link between ethics and politics leads Derrida to
   conclude that a policy of hospitality that strives to welcome the other
   unconditionally is both possible and necessary, and that this implies
   that it is possible to build social and political bonds beyond the
   nation-state and grounded on hospitality.},
Publisher = {UNAM, FAC CIENCIAS POLITICAS \& SOCIALES},
