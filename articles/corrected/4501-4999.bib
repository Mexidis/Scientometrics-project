@article{ WOS:000508437800022,
Author = {Carlos Fernandez, Juan and Palmas, Oscar and Petean, Jimmy},
Title = {SUPERCRITICAL ELLIPTIC PROBLEMS ON THE ROUND SPHERE AND NODAL SOLUTIONS
   TO THE YAMABE PROBLEM IN PROJECTIVE SPACES},
Journal = {DISCRETE AND CONTINUOUS DYNAMICAL SYSTEMS},
Year = {2020},
Volume = {40},
Number = {4},
Pages = {2495-2514},
Month = {APR},
Abstract = {Given an isoparametric function f on the n-dimensional round sphere, we
   consider functions of the form u= w circle f to reduce the semilinear
   elliptic problem
   -Delta(g0) u + lambda u = lambda vertical bar u vertical bar(p-1 )u on
   S-n
   with lambda > 0 and 1 < p, into a singular ODE in {[}0, pi] of the form
   w `' + h(r)/sinr w' + lambda/l(2) (vertical bar w vertical bar(p-1) w -
   w) = 0 where h is an strictly decreasing function having exactly one
   zero in this interval and l is a geometric constant. Using a double
   shooting method, together with a result for oscillating solutions to
   this kind of ODE, we obtain a sequence of sign-changing solutions to the
   first problem which are constant on the isoparametric hypersurfaces
   associated to f and blowing-up at one or two of the focal submanifolds
   generating the isoparametric family. Our methods apply also when p >
   n+2/n-2, i.e., in the supercritical case. Moreover, using a reduction
   via harmonic morphisms, we prove existence and multiplicity of
   sign-changing solutions to the Yamabe problem on the complex and
   quaternionic space, having a finite disjoint union of isoparametric
   hipersurfaces as regular level sets.},
