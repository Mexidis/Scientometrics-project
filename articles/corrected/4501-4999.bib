@article{ WOS:000594383000013,
Author = {Ramirez Pulido, Karla and Luis Ortega-Arjona, Jorge and Gonzalez Huesca,
   Lourdes del Carmen},
Title = {Gradual Typing Using Union Typing With Records},
Journal = {ELECTRONIC NOTES IN THEORETICAL COMPUTER SCIENCE},
Year = {2020},
Volume = {354},
Number = {SI},
Pages = {171-186},
Month = {DEC 1},
Note = {12th Latin American Workshop on Logic/Languages, Algorithms and New
   Methods of Reasoning (LANMR), Puebla, MEXICO, NOV 15, 2019},
Abstract = {Dynamic typed languages are characterized by their expressiveness and
   flexibility to develop prototypes, while static typed languages allow
   early detection of errors and the optimization of source code. Gradual
   typing languages allow programmers to make use of both approaches,
   static and dynamic typing, and thus, obtaining the advantages that both
   represent.
   The objective here is to revisit the static part of the approach to a
   gradual interpretation of union types based on the design of Gradual
   Union Types through an extension with the record data-structure. This
   contributes to understand the abstraction and reasoning behind Gradual
   Typing in order to have useful future extensions for other
   data-structures.},
