Title = {k-quasi-transitive digraphs of large diameter},
Journal = {JOURNAL OF GRAPH THEORY},
Year = {2021},
Volume = {96},
Number = {2},
Pages = {310-325},
Month = {FEB},
Abstract = {Given an integerkwithk >= 2, a digraphD=(VD,AD)isk-quasi-transitive if
   for everyuv-directed path of lengthkinD, we have(u,v)is an element of
   ADor(v,u)is an element of AD(or both). In this study, we prove that
   ifkis an odd integer,k >= 5, then every strongk-quasi-transitive digraph
   of diameter at leastk+2admits a partition of its vertex
   setVD=(V1,V2)such thatD{[}V1]is Hamiltonian, and
   bothD{[}V1]andD{[}V2]are semicomplete bipartite, whenDis bipartite, or
   semicomplete, otherwise. As a consequence, for an odd integerk >= 3, it
   is easy to prove that every non-bipartite strongk-quasi-transitive
   digraph with diameter at leastk+2has a Hamiltonian path.},
