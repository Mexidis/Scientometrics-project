@article{ WOS:000594383000009,
Author = {Miranda-Perea, Favio E. and Gonzalez Huesca, Lourdes del Carmen and
   Selene Linares-Arevalo, P.},
Title = {On Interactive Proof-Search for Constructive Modal Necessity},
Journal = {ELECTRONIC NOTES IN THEORETICAL COMPUTER SCIENCE},
Year = {2020},
Volume = {354},
Number = {SI},
Pages = {107-127},
Month = {DEC 1},
Note = {12th Latin American Workshop on Logic/Languages, Algorithms and New
   Methods of Reasoning (LANMR), Puebla, MEXICO, NOV 15, 2019},
Abstract = {We present a dual sequent calculus for the necessity fragment of the
   constructive modal logic S4 and show its adequacy for proof-search in
   the style of modern interactive theorem provers. The main feature of
   dual systems is the use of two contexts to capture the notions of true
   and valid formulas, without using any formal semantics. This attribute
   allows us to give simple rules for the square operator that, most of the
   time, grant the substitution of a strict modal reasoning by a pure
   propositional one, thus simplifying the proof-search process. Moreover,
   we introduce a formal notion of backward proof corresponding to a
   bottom-up construction of a derivation tree by means of a left-to-right
   depth-first proof-search.},
