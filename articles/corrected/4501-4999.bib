@article{ WOS:000574924500057,
Author = {Lopez-Camara, Diego and Moreno Mendez, Enrique and De Colle, Fabio},
Title = {Disc formation and jet inclination effects in common envelopes},
Journal = {MONTHLY NOTICES OF THE ROYAL ASTRONOMICAL SOCIETY},
Year = {2020},
