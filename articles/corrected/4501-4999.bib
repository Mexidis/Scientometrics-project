Number = {961},
Pages = {31-39},
Month = {AUG 19},
Abstract = {We here describe a new Collembola species, Hylaeanura emiliae sp. nov.,
   from the Luquillo Experimental Forest in Puerto Rico. We describe H.
   emiliae sp. nov. as a distinct species based on the enlarged sensilla s3
   in antennal segment IV, the absence of modified sensorial setae in
   abdominal segment IV and the presence of four setae on each dens. An
   updated key with illustrations for the identification of worldwide
   species of the genus is included.},
