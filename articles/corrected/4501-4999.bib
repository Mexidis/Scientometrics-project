@article{ WOS:000591637100024,
Author = {Martinez-Morales, J. A. and Rojas-Sanchez, A. D. and Tamariz-Mascarua,
   A.},
Title = {On HC-completeness and Katetov extensions},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2020},
Volume = {284},
Month = {OCT 1},
Abstract = {We say that a Hausdorff topological space X is HC-completeif there
   exists a countable family \{A(n): n is an element of N\} of open covers
   of the space X with the following property: if F is a centered family of
   closed subsets of X satisfying that for each n < omega there exist F-n
   is an element of F and A(n) is an element of A(n) such that F-n subset
   of A(n), then boolean AND F is non-empty. We study the HC-completeness
   in the Katetov extension kappa X of a Hausdorff space X. We determine
   the Katetov extension of a free topological sum and the Katetov
   extension of a product. Moreover we show: (1) if Xis HC-complete with a
   dense subset constituted by isolated points, then kappa X is
   HC-complete, (2) for every countably compact HC-complete space, kappa X
   is HC-complete, and (3) if X does not have isolated points and kappa X
   is HC-complete, then X must be feebly compact. (C) 2020 Elsevier B.V.
   All rights reserved.},
