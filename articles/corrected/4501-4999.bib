@article{ WOS:000530144000001,
Author = {Barrios-Izas, Manuel A.},
Title = {Taxonomy of the weevil genus Plumolepilius Barrios-Izas \&
   Anderson (Coleoptera: Curculionidae: Molytinae: Conotrachelini): new
   species from Central America},
Journal = {ZOOTAXA},
Year = {2020},
Volume = {4768},
Number = {2},
Pages = {151-192},
Month = {MAY 1},
Abstract = {Seventeen new species of the genus Plumolepilius Barrios-Izas \&
   Anderson 2016, are described. Images of habitus and genitalia of both
   sexes are presented, as well as a dichotomous key for the identification
   of males and females of the known species of the genus. The species
   included here are P. andersoni Barrios-Izas, new species (Costa Rica and
   Panama), P. antonioi Barrios-Izas, new species (Honduras), P. camuna
   Barrios-Izas, new species (Nicaragua), P. genieri Barrios-Izas, new
   species (Honduras), P. guaimacaensis Barrios-Izas, new species
   (Honduras), P. hectori Barrios-Izas, new species (Costa Rica), P.
   linaresi Barrios-Iza.s, new species (Honduras), P. maesi Barrios-Izas,
   new species (Nicaragua), P. molinai Barrios-Izas, new species
   (Honduras), P. monzoni Barrios-Izas, new species (Guatemala), P.
   morronei Barrios-Izas, new species (Honduras), P. nelsoni Barrios-Izas,
   new species (Honduras), P. nicaraguensis Barrios-Izas, new species
   (Nicaragua), P. obrienorum Barrios-Izas, new species (Costa Rica), P.
   solisi Barrios-Izas. new species (Costa Rica), P. velizi Barrios-Izas,
