@article{ WOS:000534354000002,
Author = {Hernandez-Tapia, Jessica E. and Jimenez-Ramirez, Jaime and Vovides,
   Andrew P.},
Title = {Taxonomic revision of the genus Dioon (Zamiaceae)},
Journal = {PHYTOTAXA},
