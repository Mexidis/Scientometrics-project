@article{ WOS:000357047700005,
Author = {Delgado Baron, Mariana},
Title = {Colombian Armed Conflict's Victims and the Victims and Land Restitution
   Law: Appropriation and Significance of a Legal Category},
Journal = {PERFILES LATINOAMERICANOS},
Year = {2015},
Volume = {23},
Number = {46},
Pages = {121-145},
Month = {JUL-DEC},
Abstract = {Law 1448 of 2011, or Victims and Land Restitution's Law, was implemented
   on 2012 as a juridical mechanism adopted in the middle of the Colombian
   armed conflict for the land's restitution to those who were deprived of
   it for some of the armed actors. This law establishes who has access to
   the right of restitution and reparation (symbolic or economical), and in
   this way once again it defines a victim's universe. The implementation
   of this law allow to broaden the debate about the victim's notion not
   only as a juridical category, clearly delimited and defined in the text
   of the law, but also as a notion that characterizes and delimited
   particular kinds of subjects. In this article, the author to contribute
   to the discussion about the meaning of the victim's notion that the law
   has produced and about the dynamics of political subjectivation related
   with this social, political and juridical process.},
