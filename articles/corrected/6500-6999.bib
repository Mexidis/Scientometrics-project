   Lugo Vazquez, Alfonso, Univ Nacl Autonoma Mexico, Fac Estudios Super Iztacala, Proyecto Limnol Trop, Tlalnepantla, Edo Mexico, Mexico.},
DOI = {10.1016/j.exppara.2014.07.001},
