Volume = {177},
Number = {3},
Pages = {163-170},
Month = {AUG 29},
Abstract = {A new species of Cascabela endemic to the Balsas Basin from Michoacan,
   Mexico is described and illustrated. Cascabela balsaensis can be
   separated from all known species of the genus because of its
   elliptic-lanceolate to lanceolate and subcoriaceous leaves with dense
   pubescence, very small calycine colleters, and shorter corollas. In
   addition, we provide an evaluation of conservation, a map of
   distribution, and a species key.},
