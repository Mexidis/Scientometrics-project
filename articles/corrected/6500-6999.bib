@article{ WOS:000392627400007,
Author = {Sierra, Sigfrido and Izquierdo-San Agustin, Laura and Castro-Santiuste,
   Sandra and Rodriguez-Gutierrez, Ibeth and Alcantara-Mojica, Amanda and
   Perez-Ramirez, Lilia and Cifuentes, Joaquin},
Title = {New records of the genus Scutellinia (Pyronemataceae, Pezizales)
   for the Mexican mycobiota},
Journal = {ACTA BOTANICA MEXICANA},
Year = {2016},
Volume = {117},
Pages = {79-89},
Abstract = {Background and Aims: The genus Scutellinia is cosmopolitan. Seven
   species have been reported in Mexico. A partial taxonomic revision of
   the genus Scutellinia in the country is presented.
   Methods: Seven species were studied, using traditional mycological
   techniques.
   Key results: Three species are cited for the first time in the country:
   Scutellinia balansae, S. colensoi and S. pennsylvanica. The main
   characteristics used for species identification in this study are
   marginal hairs and the ascospore ornamentation. Taxonomic descriptions
   of the three new records and previously reported species for the country
   are realized.
   Conclusions: The taxonomic knowledge of Scutellinia in Mexico remains
   scarce, so the development of more studies focused on the fungal
   systematic in the country is necessary.},
