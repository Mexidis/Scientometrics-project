Year = {2015},
Volume = {86},
Number = {3},
Pages = {569-572},
Month = {SEP},
Abstract = {Geastrum violaceum is recorded for the first time to the Mexican
   mycobiota of the tropical dry forest. The exclusive macromorphological
   features are: exoperidium pink, red to pale violet, peristome with a few
   folds and not delimited. This species is described and illustrated with
   photographs and drawing-lines of the macro and microscopic structures of
   the basidiome. The specimens are deposited in Herbaria ENCB, FCME, MEXU
   and UJAT. All Rights Reserved (C) 2015 Universidad Nacional Autonoma de
   Mexico, Institut de Biologia.},
