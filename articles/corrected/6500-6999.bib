Year = {2015},
Volume = {112},
Pages = {67-72},
Month = {JUL},
Abstract = {Rhodocollybia popayanica is described as a new record for the Mexican
   mycobiota in the states of Chiapas, Hidalgo, Mexico, Michoacan and
   Nayarit. The studied specimens are congruent with descriptions from
   Colombia and Costa Rica. With this record, Mexico becomes the
