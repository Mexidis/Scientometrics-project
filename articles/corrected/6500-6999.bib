@article{ WOS:000348321700007,
Author = {Sanchez, Vicenta and Wang, Chumin},
Title = {Improving the ballistic AC conductivity through quantum resonance in
   branched nanowires},
Journal = {PHILOSOPHICAL MAGAZINE},
Year = {2015},
Volume = {95},
Number = {3},
Pages = {326-333},
Month = {JAN 22},
Abstract = {Frequency-dependent electrical conductivity is studied by means of the
   Kubo-Greenwood formula and a real-space renormalization plus convolution
   method. An analytical solution of the alternating current (AC)
   conductivity is found for periodic chains. In this article, we report
   enhancements to this ballistic AC conductivity when periodically or
   quasiperiodically placed Fano-Anderson impurities are introduced to an
   otherwise periodic chain, which is connected to two semi-infinite
   periodic leads at its ends. Moreover, the temperature effects on these
   resonant AC conducting states are remarkably different in periodic and
   in quasiperiodic systems. Finally, such enhancement is further analysed
   in branched nanowires with a small cross section.},
