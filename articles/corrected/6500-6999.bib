@article{ WOS:000343722700003,
Author = {Medina-Gomez, Israel and Kjerfve, Bjorn and Marino, Ismael and
   Herrera-Silveira, Jorge},
Title = {Sources of Salinity Variation in a Coastal Lagoon in a Karst Landscape},
Journal = {ESTUARIES AND COASTS},
