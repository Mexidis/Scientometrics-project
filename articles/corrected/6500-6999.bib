@article{ WOS:000360216400018,
Author = {Letcher, Susan G. and Lasky, Jesse R. and Chazdon, Robin L. and Norden,
   Natalia and Joseph Wright, S. and Meave, Jorge A. and Perez-Garcia,
   Eduardo A. and Munoz, Rodrigo and Romero-Perez, Eunice and Andrade, Ana
