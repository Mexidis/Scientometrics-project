Pages = {4194-4199},
Month = {MAR 22},
Abstract = {In this work a study of the improvement of titanium hydrogenation by low
   energy ion irradiation is presented. 3 mm titanium slices were
   irradiated at room temperature with 5 key H ions and annealed at
   different temperatures (300, 450 and 600 degrees C) in a hydrogen
   atmosphere in order to study the absorption of hydrogen. ERDA
   measurements as well as X-ray diffraction analysis show an improvement
   in hydrogen absorption relative to those samples that were not
   irradiated previously to hydrogenation. Copyright (C) 2015, Hydrogen
   Energy Publications, LLC. Published by Elsevier Ltd. All rights
   reserved.},
