@article{ WOS:000364249100045,
Author = {Castro-Torres, Ibrahim Guillermo and de Jesus Cardenas-Vazquez, Rene and
   Velazquez-Gonzalez, Claudia and Ventura-Martinez, Rosa and De la
   O-Arciniega, Minarda and Brosla Naranjo-Rodriguez, Elia and
   Martinez-Vazquez, Mariano},
Title = {Future therapeutic targets for the treatment and prevention of
   cholesterol gallstones},
Journal = {EUROPEAN JOURNAL OF PHARMACOLOGY},
Year = {2015},
Volume = {765},
Pages = {366-374},
Month = {OCT 15},
Abstract = {The formation of cholesterol gallstones involves very complex
   imbalances, such as alterations in the secretion of biliary lipids
   (which involves the ABCG5, ABCG8, ABCB4 and ABCB11 transporters),
   biochemical and immunological reactions in the gallbladder that produce
   biliary sludge (mucins), physicochemical changes in the structure of
   cholesterol (crystallization), alterations in gallbladder motility,
   changes in the intestinal absorption of cholesterol (ABCG5/8
   transporters and Niemann-Pick C1L1 protein) and alterations in small
   intestine motility. Some of these proteins have been studied at the
   clinical and experimental levels, but more research is required. In this
   review, we discuss the results of studies on some molecules involved in
   the pathophysiology of gallstones that may be future therapeutic targets
   to prevent the development of this disease, and possible sites for
   treatment based mainly on the absorption of intestinal cholesterol
   (Niemann-Pick C1L1 and ABCG5/8 proteins). (C) 2015 Published by Elsevier
   B.V.},
