@inproceedings{ WOS:000376685706006,
Author = {Olivarria Gonzalez, Monica del Carmen and Peraza Garzon, Juan Francisco
   and Estrada Lizarraga, Rogelio and Zaragoza Gonzalez, Jose Nicolas and
   Mendoza Zatarain, Rafael and Tostado Ramirez, Ivan and Cobian Campos,
   Jose Alfredo},
Editor = {GomezChova, L and LopezMartinez, A and CandelTorres, I},
Title = {ANALYSIS OF EDUCATIONAL PERFORMANCE WITH THE IMPLEMENTATION OF NEW
   TECHNOLOGIES FOR THE DEVELOPMENT OF LEARNING OBJECTS IN HIGHER EDUCATION},
Booktitle = {EDULEARN15: 7TH INTERNATIONAL CONFERENCE ON EDUCATION AND NEW LEARNING
   TECHNOLOGIES},
Series = {EDULEARN Proceedings},
Year = {2015},
Pages = {5977-5981},
Note = {7th International Conference on Education and New Learning Technologies
   (EDULEARN), Barcelona, SPAIN, JUL 06-08, 2015},
Abstract = {Information technologies and communications (ICT) are in constant
   evolution, the arrival of multimedia to classrooms had a strong impact
   on education, where one of the first and most used tools was
   ``PowerPoint{''} of Microsoft's Family.
   Nowadays with the great technological evolution and the improvement of
   Internet connections, new tools like Pearltrees, Prezzi, SpicyNodes,
   among others, are incorporated. The educational area is linked to this
   evolution and its benefits often are compromised because the
   technological needs of students are increasing day by day, and this is
   greatly reflected in the lack of interest for certain educational issues
   or attention problems.
   This paper aims to incorporate into the classrooms the usage of
   interactive e-books as a Learning Object (OA) with the iBooks Author
   tool from Apple, this in order to assess their impact on academic
   performance in students of the Faculty of Computer Mazatlan degree in
   Information Systems Engineering specifically in Multimedia Technology I
   class, of the Autonomous University of Sinaloa in Mexico.
   This tool is intended to be a support in the teaching work, especially
   for those teachers wishing to be updated and are pending the concerns of
   students of these new generations, which are born and immersed in
   technology. One benefit of this material is the interactive part, which
   helps in promoting meaningful learning and even autonomous.
   Every student has a different learning style and for that reason this
   didactic material pretends to adapt on the needs of every single
   student, one of the main problems for this case could be the pace of
   learning. This didactic material is composed of lectures on the theme
   supported by images, graphics, 2d or 3d animations, videos, audios and
   exercises in each subject to assess knowledge acquired in students.
   The purpose is to make a comparison between the results of academic
   achievement in students who were working with the interactive electronic
   book (generated with iBooks Author) and students who continue working
   with obsolete and not so new tools, as it is PowerPoint. Based on that,
   compare the level of achievement for each case of study, and determine
   if is feasible to apply in other areas of the curriculum of the Faculty,
   the ones that could be benefited are those which are too theoretical or
   complexes.
   This research will be of documentary and experimental type, working with
   two groups, one of control group and the other one of experimental
   group, tests will be applied in order to evaluate the significant
   progress of students and some interviews will be applied to assess the
   qualitative level of acceptance of this tool and ease of use.},
Publisher = {IATED-INT ASSOC TECHNOLOGY EDUCATION A\& DEVELOPMENT},
