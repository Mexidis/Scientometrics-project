   Ricardo and Mendez Ambrosio, Bruno and De-Miguel, Francisco F. and
   Fossion, Ruben},
Editor = {MassillonJL, G and Fossion, R and RosadoMendez, IM and AvilaRodriguez, MA and LopezPerez, DA},
Title = {Human aging and loss variability brain networks based on
   electroencephalogram (EEG) data},
Booktitle = {MEDICAL PHYSICS: Fourteenth Mexican Symposium on Medical Physics},
Series = {AIP Conference Proceedings},
Year = {2016},
Volume = {1747},
Note = {14th Mexican Symposium on Medical Physics, Mexico City, MEXICO, MAR
