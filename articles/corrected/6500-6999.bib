@article{ WOS:000341733700011,
Author = {Cruz-Pacheco, Gustavo and Esteva, Lourdes and Vargas, Cristobal},
Title = {Vaccination Strategies for SIR Vector-Transmitted Diseases},
Journal = {BULLETIN OF MATHEMATICAL BIOLOGY},
Year = {2014},
Volume = {76},
Number = {8},
Pages = {2073-2090},
Month = {AUG},
Abstract = {Vector-borne diseases are one of the major public health problems in the
   world with the fastest spreading rate. Control measures have been
   focused on vector control, with poor results in most cases. Vaccines
   should help to reduce the diseases incidence, but vaccination strategies
   should also be defined. In this work, we propose a vector-transmitted
   SIR disease model with age-structured population subject to a
   vaccination program. We find an expression for the age-dependent basic
   reproductive number , and we show that the disease-free equilibrium is
   locally stable for , and a unique endemic equilibrium exists for . We
   apply the theoretical results to public data to evaluate vaccination
   strategies, immunization levels, and optimal age of vaccination for
   dengue disease.},
Publisher = {SPRINGER},
