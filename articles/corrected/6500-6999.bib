@inproceedings{ WOS:000370791600007,
Author = {Mendez-Fragoso, Ricardo and Ley-Koo, Eugenio},
Editor = {Sabin, JR and CabreraTrujillo, R},
Title = {Angular Momentum Theory in Bases of Lame Spheroconal Harmonics},
Booktitle = {CONCEPTS OF MATHEMATICAL PHYSICS IN CHEMISTRY: A TRIBUTE TO FRANK E.
   HARRIS - PT A},
