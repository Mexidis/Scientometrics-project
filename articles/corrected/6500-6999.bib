Year = {2014},
Volume = {243},
Pages = {969-981},
Month = {SEP 15},
Abstract = {In this paper, we introduce and analyze two structured models for the
   transmission of a vector-borne infectious disease. The first of these
   models assumes that the level of contagiousness and the rate of removal
   (recovery) of infected hosts depends on the infection age. In the second
   model the hosts population is structured with respect to the physical
   age of the hosts, and the susceptibility of the hosts is assumed to be
   age-dependent. For these models, the threshold parameter for the
   existence of a positive (endemic) equilibrium state is determined, and
   the global asymptotic stability of the equilibrium states are
   established by the Lyapunov's direct method. (C) 2014 Elsevier Inc. All
   rights reserved.},
