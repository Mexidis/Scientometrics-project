@article{ WOS:000354874000004,
Author = {Gonzalez-Santillan, Edmundo and Alvarez-Padilla, Fernando},
Title = {The male of Megacormus granosus (Gervais, 1844) with comments on
   its hemispermatophore (Scorpiones, Euscorpiidae)},
Journal = {ZOOKEYS},
Year = {2015},
Number = {504},
Pages = {75-91},
Abstract = {The male of Megacormus granosus is described for the first time and the
   female redescribed. A homology scheme proposed recently is applied to
   hemispermatophore structures. The specimens were collected in an oak
   forest from Pico de Orizaba Volcano at an average altitude of 2340 m.
   All adult males were collected by pitfall traps, whereas all adult
   females and both sex immatures were collected using Berlese funnels,
   suggesting that males are comparatively more mobile within the leaf
   litter layer, probably due to mating season.},
