@inproceedings{ WOS:000386388500023,
Author = {Valdes-Souto, Francisco},
Editor = {JuarezRamirez, R and Calleros, SJ and Oktaba, HJ and Fernandez, CFY and Vera, RA and Sandoval, GL and Cisneros, JA},
Title = {Creating a Historical Database for Estimation Using the EPCU
   Approximation Approach for COSMIC (ISO 19761)},
Booktitle = {2016 FOURTH INTERNATIONAL CONFERENCE IN SOFTWARE ENGINEERING RESEARCH
   AND INNOVATION - CONISOFT 2016},
Year = {2016},
Pages = {159-166},
Note = {4th International Conference in Software Engineering Research and
   Innovation (CONISOFT), Puebla, MEXICO, APR 27-29, 2016},
Organization = {IEEE Comp Soc; IEEE; RED MIS; POR PLENA HOMBRE; Univ Autonoma San Luis
   Potosi; Facultad Ingenieria UASLP; Univ Politecnica San Luis Potosi;
   UPAEP; Univ Nacl Colombia; Corporac Centro Investigac Desarrollo Nuevas
   Tecnologias; Benemerita Univ Autonoma Puebla; Univ Iberoameicana; Inst
   Tecnologico Super Atlixco; Univ Xicotepetl; Univ Politecnica Puebla;
   Univ Politecnica Amozoc; Latin Amer Software Engn Symposium},
Abstract = {In the actual competitive software industry, software development
   organizations need a better and formal estimation approaches in order to
   increase the success rate of software projects. However, currently the
   estimation approach typically employed in industry is the expert
   judgment ('experience-based'). Using measures and estimations that
   continue to be based on researchers' intuition does not contribute to
   obtaining successful projects nor to mature software engineering.
   Any organization that aims to have or develop estimation approaches
   needs historical data, and the majority of the organizations do not have
   this information. Additionally acquisition of this information has
   expensive cost and time/effort consuming.
   This paper proposed the use of the EPCU approximation approach-that has
   demonstrated a several benefits- aiming to create a formal database with
   low cost and effort, that can be employed as a starting point to improve
   estimations in organizations without historical databases.},
