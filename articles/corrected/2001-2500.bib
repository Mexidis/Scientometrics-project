@article{ WOS:001354281700001,
Author = {Quiroz-Gonzalez, Nataly and Ponce-Marquez, Ma. Edith and
   Aguilar-Estrada, Luis Gabriel and Rodriguez, Deni},
Title = {The first record of Gelidium divaricatum (Gelidiaceae,
   Rhodophyta) in Mexico based on a molecular and morphological approach},
Journal = {PHYCOLOGICAL RESEARCH},
Year = {2025},
Volume = {73},
Number = {1},
Pages = {3-7},
Month = {JAN},
Abstract = {The species Gelidium divaricatum was originally described from Hong Kong
   by G. Martens (1866). Mexico did not have any records of this species
   until the present study. The species was found from a study for which
   the research objective is to evaluate specimens of Gelidium collected in
   Bah \& iacute;a de La Paz, Baja California Sur (the entrance to the Gulf
   of California) using morphological and molecular techniques, including
   the rbcL marker. Phylogenetic analyses using the rbcL marker revealed
   that the studied specimens are in the same clade of G. divaricatum from
   the type locality with their sequence differences being less than 0.3\%,
   indicating that the specimens are the same species as G. divaricatum.
   This is the first record of the species for Mexico. The most important
   morphological difference was the branching pattern, which was irregular
   to pinnate in the Hong Kong specimens, whereas it was simple or
   irregular in the Mexican thalli.},
