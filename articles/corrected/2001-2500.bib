Volume = {674},
Number = {3},
Pages = {265-274},
Month = {NOV 28},
Abstract = {Barkeria wixarika is described from Nayarit, Mexico. This new species is
   morphologically similar to B. uniflora but distinct in its flowering
   phenology, inflorescence type, petal shape, column morphology, and
   geographic distribution. Detailed comparisons with related species,
   including digital plates along with a map highlighting the distribution
   of the novel species in relation to others are presented. Finally, an
   updated identification key for Barkeria is provided.},
