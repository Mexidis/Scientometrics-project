Author = {Tobar, Harol Revelo and Martinez, Pablo A. and Palacios-Vargas, Jose G.
   and Otero-Colina, Gabriel},
Title = {New species of oribatid mites (Acari, Oribatida) of the genera
   Ommatocepheus (Cepheusidae) and Eremella (Eremellidae) from
   Mexico},
Journal = {ZOOTAXA},
