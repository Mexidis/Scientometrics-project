@inproceedings{ WOS:001565660400055,
Author = {Ibanez, Edgar R. and Alonso, Paula R. and Ares, Alicia E.},
Editor = {Edwards, L},
Title = {Structure and Mechanical Properties of Directionally Solidified Al-Si
   Alloys},
Booktitle = {LIGHT METALS 2025},
Series = {Minerals Metals and Materials Series},
Year = {2025},
Pages = {411-418},
Note = {154th Minerals Metals and Materials Society Meeting-TMS-Annual, Las
   Vegas, NV, MAR 23-27, 2025},
Abstract = {In the present research, unidirectional solidification tests were
   carried out with Al-4 wt\%Si and Al-6 wt\%Si alloys, using different
   cooling rates and thermal gradients. The effects of the solidification
   parameters were analyzed. It was observed that when the thermal
   gradients reach values between 1.9 and -2.3 degrees C/cm, the columnar
   to equiaxed transition (CET) occurs. Also, the values of the Vickers
   microhardness (HV) and the tensile strength (sigma) were measured,
   determining that the HV and sigma values increased with the increasing
   in Si content, due to the increase in the refinement of the eutectic
   phase.},
