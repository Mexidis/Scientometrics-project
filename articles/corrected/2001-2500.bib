Title = {Hydnum (Cantharellales) of the neotropics: four new
   species and new reports from Belize, Costa Rica, Dominican Republic,
   Mexico, and Panama},
Journal = {MYCOLOGICAL PROGRESS},
Year = {2025},
Volume = {24},
Number = {1},
Month = {FEB 17},
Abstract = {Four new species of Hydnum are described from the neotropics, and six
   additional eastern North American species are documented for the first
   time from this region as well. Morphological and molecular data (ITS and
   TEF-1 sequences) were used to confirm identification and placement of
   these taxa in a larger phylogenetic overview. Descriptions and images of
   the new taxa are presented. A key to all species now known from
   neotropical habitats with the ectotrophic symbionts Quercus, Pinus,
   Oreomunnea, or Coccoloba is also provided.},
