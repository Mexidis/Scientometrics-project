Year = {2024},
Volume = {197},
Month = {DEC},
Abstract = {In this work we give a complete description of germs of foliation pairs
   - non dicritical and dicritical- given by generic analytic differential
   equations with degenerated non dicritical and dicritical singularities,
   by means of local analytic representatives (local models) and analytic
   normalizing transformations. We give a realization theorem of local
   models, prove the existence and uniqueness of them, and obtain the
   analytic invariants for non dicritical and dicritical foliation pairs.
