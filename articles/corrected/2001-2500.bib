@article{ WOS:001515789300002,
Author = {Alcantara-Ayala, Othon and Luna-Vega, Isolda and Alvarado-Sizzo, Hernan},
Title = {Ternstroemia sierragordensis (Pentaphylacaceae), a new
   cloud forest tree species from Querétaro and San Luis Potosi, Mexico},
Journal = {PHYTOTAXA},
Year = {2025},
Volume = {705},
Number = {3},
Pages = {247-259},
Month = {JUN 17},
Abstract = {Ternstroemia sierragordensis, a new species from the states of Quer \&
   eacute;taro and San Luis Potosi, Mexico, is described and illustrated,
   using molecular, phylogenetic, and morphological data. This tree
   inhabits a conserved tropical montane cloud forest with Liquidambar
   styraciflua, Pinus greggii, Tilia mexicana, Podocarpus matudae, and
   Magnolia aff. schiedeana and Quercus spp., as part of the canopy. This
   new species is related to Ternstroemia huasteca, but differs because it
   is a taller tree, the evident presence of lenticels in the bark and
   branches, the crenate margin of the leaves, and the long and thin
   peduncles.},
Publisher = {MAGNOLIA PRESS},
