@article{ WOS:001526931500001,
Author = {Miranda-Rojas, Renata and de la Mora, Pablo and Huerta, Lazaro and
   Olicon, Oscar and Pradal-Velazquez, Emilio and Tavizon, Gustavo},
Title = {Crystal structure, electrical, and magnetic properties of
   Gd2-xSrxNiO4±δ, a gadolinium nickelate with K2NiF4 structure},
Journal = {JOURNAL OF ALLOYS AND COMPOUNDS},
Year = {2025},
Volume = {1036},
Month = {JUL 20},
Abstract = {The Gd2-xSrxNiO4 +/- s solid solution, crystallizing with the K2NiF4
   structure, was synthesized in the 0.75 <= x <= 1.25 range. The following
   compositions: x = 0.75, 0.775, 0.8, 0.825, 0.85, 0.875, 0.90, 0.95, 1.0,
   1.05, 1.1, 1.15, 1.20, 1.225, and 1.25 were prepared via the complex
   polymeric route or via solid state synthesis and were studied by X-ray
   powder diffraction (XRPD) with Rietveld refinements, DC electrical
   resistivity (15-300 K), DC magnetization measurements (2-300 K),
   UV-visible spectroscopy and XPS. Despite substituting Gd3+ for a larger
   ion (Sr2+), the crystal unit cell shrinks with increasing x, decreasing
   the c/a ratio almost linearly. For x = 1.25, a metal-insulator
   transition is observed at 220 K; for high temperatures, the electrical
   transport is well described by a thermally activated mechanism, while at
   low temperatures, a 2D variable-range hopping equation describes such an
   electrical behavior well. Iodometric titrations and the XPS spectroscopy
   revealed the presence of electronic holes as a consequence of Sr doping.
   No magnetic ordering was detected in the studied temperature range.},
