@article{ WOS:001516187400004,
Author = {Antonio, J. E. and Cervantes, J. M. and Munoz, H. and Arevalo-Lopez, E.
   P. and Pilo, J. and Vargas-Bustamante, J. and Benitez-Flores, E. and
   Escamilla, R. and Romero, M.},
Title = {Lithium and sodium effects on the structural, electronic, and
   electrochemical properties of TiTe2 monolayers for batteries},
Journal = {SURFACES AND INTERFACES},
Year = {2025},
Volume = {69},
Month = {JUL 15},
Abstract = {Transition metal dichalcogenides are attractive for energy storage
   systems in LIBs and SIBs. Besides, nanostructures based on surfaces
   (monolayers) have been found to have more favorable properties for
   applications in electrochemical systems. In particular, the
   dichalcogenide TiTe2 has been demonstrated to be very useful in these
   systems due to its structural (compact symmetry), electronic and
   electrochemical properties (storage capacity, voltage, etc.). In this
   work, a systematic study was conducted to examine the Li/Na atom effects
   on the different adsorption-sites in TiTe2 monolayer using DFT based on
   the Generalized Gradient Approximation. This allows observing how Li/Na
   atoms adsorption impacts the structural, electronic, and electrochemical
   properties. In this context, describing which adsorption-sites have the
   optimal structural, electronic and electrochemical properties is an
   important parameter for potential battery applications. As a result of
   the Li/Na atom adsorption, it has been observed that the Top- and
   Hollow-sites are the most favorable for adsorption .In addition, the
   Li/Na atoms adsorption caused an increase in lattice parameters.
   Nevertheless, the percentage change in the area of Pristine is <1.35 \%.
   Also, it is important to note that the Top- and Hollow-sites are the
   best for adsorption. Furthermore, the cohesive energy analysis indicates
   that Li adsorption-sites are more stable than Na ones. Electronic band
   structure can confirm the metallic behavior of the different monolayer
   models with Li/Na. Furthermore, the theoretical capacity of Pristine is
   640.954 mAh/g. In contrast to Li adsorption-sites, the energy diffusion
   barriers for Na ones were lower. These results demonstrate that the Na
   atom adsorption is more favorable for their possible ion-battery
   applications.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
