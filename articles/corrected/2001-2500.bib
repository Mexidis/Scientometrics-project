@article{ WOS:001498004600007,
Author = {Porras, Alejandra Salas},
Title = {RIGHT-WING THINK TANK NETWORKS IN LATIN AMERICA. ELITE MACHINERY TO STOP
   PROGRESSIVE MOVEMENTS},
Journal = {E-LATINA-REVISTA ELECTRONICA DE ESTUDIOS LATINOAMERICANOS},
Year = {2025},
Volume = {23},
Number = {91},
Pages = {105-127},
Month = {APR-JUN},
Abstract = {The increasingly prominent presence of think tanks in various spheres of
   Latin American society has sparked growing interest among political
   scientists, sociologists, and economists, who are attempting to explain
   the origins of this phenomenon, its impact on public policy, and its
   implications from different perspectives. Although the theoretical
   orientation of these studies is highly diverse, several factors can be
   identified in the literature that explain the origin and growth of think
   tanks in Latin America. This article analyzes the close, multifaceted,
   and mutually constitutive relationship between think tanks and the right
   wing in Latin America. It argues that the emergence and proliferation of
   think tanks cannot be understood without taking into account the social
   struggles they are part of and that these organizations help shape and
   structure. They become both a cause and effect of the dynamics in which
   they are immersed, particularly the rapid expansion of the right wing,
   whose ideas these organizations disseminate in order to contain or
   reverse progressive movements in the region, as well as the rights
   acquired over many years.},
