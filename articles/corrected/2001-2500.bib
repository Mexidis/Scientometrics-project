@article{ WOS:001524263000001,
Author = {Lopez, Armando Campos and Estebanez-de-Miguel, Elena and Acedo, Tania
   Camou and Garcia-Pelagio, Karla Paola and Albarova-Corral, Isabel and
   Malo Urries, Miguel and Villanueva-Melendez, Paulina},
Title = {Reliability of myotonometry in the assessment of cervico-mandibular
   musculature: Inter/intra-examiner and inter/intra-session reliability
   study},
Journal = {CRANIO-THE JOURNAL OF CRANIOMANDIBULAR \& SLEEP PRACTICE},
Year = {2025},
Month = {2025 JUL 6},
Abstract = {BackgroundThe MyotonPRO is a valid, portable device to assess
   musculoskeletal tissue properties, but its reliability for
   cervico-mandibular muscles remains unclear.ObjectiveTo evaluate the
   intra/inter-rater and intra/inter-session reliability of the MyotonPRO
   in cervico-mandibular muscle assessment.MethodsA total of 30
   measurements were performed on 15 healthy participants by two raters at
   two moments. MyotonPRO evaluated tone, stiffness, elasticity, relaxation
   time, and creep. Reliability was calculated using intraclass correlation
   coefficients (ICC), standard error of measurement, and minimal
   detectable change.ResultsIntra-rater intra-session reliability was good
   to excellent (ICC = 0.753-0.976). Inter-session values were moderate to
   good (ICC = 0.585-0.888), with excellent reliability for ECOM relaxation
   time (ICC = 0.955) and masseter elasticity (ICC = 0.910). Inter-rater
   reliability was moderate to good (ICC = 0.686-0.896).ConclusionThe
   MyotonPRO is a reliable tool for assessing cervico-mandibular muscle
   mechanical properties across different raters and sessions.},
Publisher = {TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
Type = {Article; Early Access},
Language = {English},
Affiliation = {López, AC (Corresponding Author), Orthoped Manual Therapy Ctr, Acad Dept, Hermosillo 83150, Mexico.
   Lopez, Armando Campos; Acedo, Tania Camou, Orthoped Manual Therapy Ctr, Acad Dept, Hermosillo 83150, Mexico.
