@article{ WOS:001526874800003,
Author = {Basurto-Pena, Francisco A. and Garcia-Perea, Filiberto and
   Nambo-Camacho, Antonio A. and Martinez-Gordillo, Martha J. and
   Ortiz-Mendoza, Nancy and Zavala-Ocampo, Lizeth M. and Gonzalez-Trujano,
   Maria Eva and Aguirre-Hernandez, Eva},
Title = {Increasing the knowledge of medicinal flora of the Mixteca Alta, Oaxaca,
   the case of Santiago Huauclilla},
Journal = {JOURNAL OF ETHNOPHARMACOLOGY},
Year = {2025},
Volume = {352},
Month = {AUG 29},
Abstract = {Ethnobotanical relevance: Mexico ranks second in the world in the number
   of recognized medicinal plants. Unfortunately, despite important
   advances in the knowledge of the flora of Mexico, specifically the
   medicinal flora, this knowledge of the flora may still be incomplete.
   Aim of the study: The purpose of this work is to find evidence that will
   allow us to know if the medicinal flora of the Mixteca Alta has been
   sufficiently documented through the ethnobotanical study of Santiago
   Huauclilla as a case of study. Material and methods: Open and
   semi-structured interviews were conducted with 30 people from Santiago
   Huauclilla, selected by snowball sampling. Using ethnobotanical data
   from Santiago Huauclilla, among other places, a data matrix was
   constructed to analyze the inventory of the medicinal flora of the
   Mixteca Alta. A Species Accumulation Curve and a Cluster Analysis were
   performed to compare the medicinal flora of nine communities of the
   Mixteca Alta. Results: Information on 94 species of medicinal plants
   from 44 botanical families for Santiago Huauclilla was integrated. Oral
   administration and preparation as a decoction of leaves and aerial parts
   were the most common forms of use of these medicinal species. From this
   study, 41 species were added to the medicinal flora of the Mixteca Alta,
   with 22 new records of medicinal flora for the state of Oaxaca. Thus,
   the inventory for the Mixteca Alta reached 292 species, of which more
   than 50 \% are exclusive to a single community. Conclusion: According to
   the research on medicinal plants in the case of Santiago Huauclilla and
   some other communities of the Mixteca Alta, it is confirmed that the
   inventory of the medicinal flora of this region of the state of Oaxaca
   is still incomplete and requires the continuity of this type of
   ethnobotanical studies to rescue and preserve the ancestral knowledge of
   popular medicine that still supports indigenous and rural communities.},
