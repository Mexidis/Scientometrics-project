@article{ WOS:001575171000019,
Author = {Roman, Mario Pavel Diaz and Gonzalez, Carolina Jasso and Govea, Luis
   Bravo},
Title = {YOUTH VIOLENCE IN MEXICO CITY: CRIMINOLOGICAL AND STRUCTURAL FACTORS OF
   HOMICIDE},
Journal = {ANDAMIOS},
Year = {2025},
Volume = {22},
Number = {58},
Pages = {497-528},
Month = {MAY-AUG},
Abstract = {This article examines the phenomenon of youth homicide in Mexico City
   using a mixed-methods approach that critically engages with the
   theoretical frameworks of juvenicide and the sociology of crime. Through
   a variable-oriented analysis, it investigates factors such as levels of
   marginalization, educational attainment, the presence of organized
   crime, alcohol sales, and the availability of firearms. The results
   reveal a significant association between these factors and the risk of
   youth homicide, underscoring the need for more comprehensive analysis.
   This research contributes to the accumulation of empirical evidence and
   highlights the relevance of juvenicide as a category for understanding
   the violent deaths of young people.},
