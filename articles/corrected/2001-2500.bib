@article{ WOS:001458917200001,
Author = {Cabrera-Rivera, Elizabeth and Molina-Hernandez, Ana and
   Medellin-Maldonado, Francisco and Guendulain-Garcia, Sergio and
   Perez-Cervantes, Esmeralda and Rioja-Nieto, Rodolfo and Medina-Valmased,
   Alexis E. and Alvarez-Filip, Lorenzo},
Title = {Night surveys reveal abundant populations of sea urchins with high
   erosive potential in Cayo Arenas, Campeche Bank},
Journal = {CIENCIAS MARINAS},
Year = {2025},
Volume = {50},
Number = {SI},
Abstract = {Sea urchins perform key ecological functions in coral reefs, such as
   bivory and erosion of calcareous structures, which intensify at night.
   The Cayo Arenas Campeche Bank, Mexico, is located far from the coast,
   which has helped to protect it direct anthropogenic threats. However,
   there is no information available on the status urchin populations and
   the bioerosion processes they perform in the reef. For this reason,
   conducted diurnal and nocturnal surveys to characterize urchin density
   as a function diel cycle and to calculate their bioerosive potential.
   The surveys were conducted at with different depths (10-19 m) and
   varying reef heterogeneity related to 2 components: coral cover and sand
   cover. All surveys were conducted in July 2023. In general, an abundant
   population of urchins was observed, which was mainly composed of Diadema
   antillarum. At night, the abundance (14.5 f 3.8 ind) and bioerosion rate
   (1.55 f 0.53 kg CaCO3<middle dot>m-2<middle dot>y-1) were higher than
   during the day (2.6 f 0.8 ind and 0.2 f 0.06 kg CaCO3<middle
   dot>m-2<middle dot>y-1). In addition, depth and reef geomorphology
   seemed to influence the pattern of urchin density. At sites high reef
   heterogeneity, sea urchin density was higher at night, which could be
   associated with a greater availability of refuge from predators. Our
   results show an underestimation urchin population densities in daytime
   surveys and, therefore, their impact on the ecosystem as bioerosion
   agents because sea urchins are mostly nocturnal but are commonly
   surveyed during the day.},
