@article{ WOS:001526652700001,
Author = {Jimenez-Diaz, Edgar and Peto-Gutierrez, Cindy and Hautefeuille, Mathieu
   and Fiordelisio, Tatiana},
Title = {Two-photon polymerization-based fabrication of high aspect ratio pillars
   for quantifying pituitary pericytes contractility},
Journal = {JOURNAL OF MICROMECHANICS AND MICROENGINEERING},
Year = {2025},
Volume = {35},
Number = {7},
Month = {JUL 31},
Abstract = {Two-photon polymerization (2PP) enables the fabrication of complex three
   dimensional microstructures with submicron precision, making it a
   powerful tool for mechanobiology studies. In this work we present a
   highly reproducible 2PP- based method to fabricate high aspect ratio
   micropillars, achieving aspect ratios up to 1:20 while maintaining
   structural stability. These micropillars were employed to quantify the
   contractile forces exerted by pituitary pericytes in response to ATP
   stimulation, providing novel insights into their mechanobiology. Using a
   custom-designed perfusion chamber and confocal microscopy, we measured
   both intracellular calcium dynamics and pillar displacements, revealing
   that pericytes generate contractile forces primarily through their
   peripheral extensions, with forces reaching up to 77.81 +/- 26.85 nN
   post-stimulation. The study also introduces a novel protocol for
   isolating and culturing primary pituitary pericytes, confirming their
   identity through immunostaining for PDGFR-beta and NG2 markers. Our
   results demonstrate that pericytes exhibit a delayed but sustained
   contractile response to ATP, correlating with intracellular calcium
   signaling. This work advances our understanding of pericyte
   mechanotransduction and their role in microvascular regulation, offering
   a robust platform for future mechanobiology research.},
