@article{ WOS:001506958400001,
Author = {Schroder, Noelia Malena and Chelaliche, Anibal Sebastian and Rodriguez,
   Maria Daniela and Fonseca, Maria Isabel and Zapata, Pedro Dario},
Title = {Exploring Novel Tyrosinase Enzymes in Basidiomycota Fungi from
   Paranaense Rainforest (Argentina)},
Journal = {ARABIAN JOURNAL FOR SCIENCE AND ENGINEERING},
Year = {2025},
Month = {2025 JUN 11},
Abstract = {Tyrosinases (E.C. 1.14.18.1) are enzymes widely distributed in fungi
   that catalyze the ortho-hydroxylation of monophenols to diphenols and
   the oxidation of diphenols to quinones and present a wide spectrum of
   phenolic compounds as substrates and are among enzymes with high
   potential for industrial applications. We present here the screening of
   tyrosinases-producing fungi isolated in the Paranaense rainforest of
   Argentina, as well as the intracellular and extracellular expression of
   this enzyme in three culture media. Additionally, we analyzed the
   mycelial proteome of P. brevispora BAFC 633 and its secretome in liquid
   media, aiming to explore differences in the expression profile of
   tyrosinases and other endogenous proteins that may interfere with this
   enzymatic activity. P. brevispora BAFC633 presented higher tyrosinase
   secretion, showing enhanced enzymatic activity when mycelium is cultured
   on potato medium. A peak in activity was observed, in each experiment,
   between days 6 and 8 of incubation period, followed by a precipitous
   decline in activity that was experimentally attributed to the secretion
   of proteases into the medium. Finally, biotechnological implications of
   the results are discussed.},
