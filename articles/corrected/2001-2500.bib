@article{ WOS:001508299200001,
Author = {Carrillo-Santamaria, Jesus and Lopez-Camara, Diego and De Colle, Fabio
   and Mendez, Enrique Moreno and Sanchez-Salcedo, F. J.},
Title = {The role of wind asphericity in dynamical friction},
