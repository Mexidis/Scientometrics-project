Author = {de Jong, Johan and Poorter, Lourens and de Jong, Wil and Bongers, Frans
   and Lohbeck, Madelon and Veenendaal, Elmar and Meave, Jorge A. and
   Jakovac, Catarina C. and Brancalion, Pedro H. S. and Amissah, Lucy and
   Martinez-Ramos, Miguel and Bartholomeus, Harm and Laurance, Susan G. W.
