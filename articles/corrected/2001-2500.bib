@article{ WOS:001453268400001,
Author = {Molina-Castillo, Gabriela and Monroy-Garcia, Alberto and Garcia-Rocha,
   Rosario and Weiss-Steider, Benny and Montesinos-Montesinos, Juan Jose
   and Hernandez-Montes, Jorge and Don-Lopez, Christian Azucena and
   Castro-Manrreza, Marta Elena and Escobar-Sanchez, Maria Luisa and
   Mora-Garcia, Maria de Lourdes},
Title = {TGF-β Induces the Secretion of Extracellular Vesicles Enriched with CD39
   and CD73 from Cervical Cancer Cells},
Journal = {INTERNATIONAL JOURNAL OF MOLECULAR SCIENCES},
Year = {2025},
Volume = {26},
Number = {6},
Month = {MAR 7},
Abstract = {The presence of TGF-beta in the tumor microenvironment of cervical
   cancer (CC) is important for tumor progression. In this study, we
   analyzed the effect of TGF-beta on the expression of the
   ectonucleotidases CD39 and CD73, which are involved in the generation of
   adenosine (Ado), in CC cells and in extracellular vesicles (EVs)
   secreted by these cells. Treatment of HeLa and CaSki cells for 72 h with
   recombinant human TGF-beta increased the expression of CD39 and CD73 by
   20 and 30\% and by 40 and 100\%, respectively. The addition of SB505124,
   an inhibitor of the TGF-beta 1 receptor, or GW4869, an inhibitor of
   exosome formation and release, reduced the expression and release of
   both ectonucleotidases in CC cells. Furthermore, TGF-beta promoted the
   secretion of medium-large EVs (>130 nm) in HeLa cells (HeLa +
   TGF-beta/EVs) and CaSki cells (CaSki + TGF-beta/EVs), which increased
   the expression of CD39 (>20\%) and CD73 (>60\%), and EVs obtained from
   cells treated with TGF-beta had a greater capacity to generate Ado than
   did EVs obtained from cells cultured in the absence of this factor
   (HeLa/EVs and CaSki/EVs). These findings suggest that the production of
   TGF-beta in the CC TME can promote neoplastic progression through the
   secretion of EVs enriched with CD39 and CD73. Therefore, the inhibition
   of CD39+ CD73+ EVs could be a strategy for the treatment of CC.},
