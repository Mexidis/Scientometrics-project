@article{ WOS:001539989500001,
Author = {Velazquez, Rolando and Lopez-Diaz, Linda and Lopez-Hernandez, Leonardo
   and Hernandez, Eduardo and Arevalo-Aguilar, L. M. and Velazquez, V.},
Title = {Delayed Choice for Entangled Photons},
Journal = {PHOTONICS},
Year = {2025},
Volume = {12},
Number = {7},
Month = {JUL 10},
Abstract = {The wave-particle duality is the quintessence of quantum mechanics. This
   duality gives rise to distinct behaviors depending on the experimental
   setup, with the system exhibiting either wave-like or particle-like
   properties, depending on whether the focus is on interference (wave) or
   trajectory (particle). In the interaction with a beam splitter, photons
   with particle behavior can transform into a wave behavior and vice
   versa. In Wheeler's delayed-choice gedanken experiment, this interaction
   is delayed so that the wave that initially travels through the
   interferometer can become a particle, avoiding the interaction. We show
   that this contradiction can be resolved using polarized entangled photon
   pairs. An analysis of Shannon's entropy supports this proposal.},
