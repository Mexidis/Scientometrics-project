@article{ WOS:001588316200004,
Author = {Marquez, Gonzalo J. and Keller, Hector A.},
Title = {ABOUT THE PRESENCE OF PTERIS PROPINQUA (PTERIDACEAE) IN ARGENTINA},
Journal = {BOLETIN DE LA SOCIEDAD ARGENTINA DE BOTANICA},
Year = {2025},
Volume = {60},
Number = {3},
Pages = {253-260},
Month = {SEP},
Abstract = {Background and aims: In this contribution the aim is to present the
   first record of Pteris propinqua from Argentina for the first time,
   based on specimens found in the department of Iguaz \& uacute;,
   Misiones. M\&M: The specimens were deposited in the CTES and LP
   herbaria. Updated bibliography were used for species identification. SEM
   was used to illustrate the spores. Results: The distinctive architecture
   of its reticulate venation, which features a single costal areole
   between costulae, distinguishes it from other Argentine Pteris species.
   Conclusions: This discovery brings the number of Pteris species in
   Argentina to 15 and highlights the importance of promoting botanical
   collections, which are essential for understanding our biological
   diversity, vulnerable to human pressure.},
