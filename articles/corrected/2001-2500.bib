@article{ WOS:001334275500001,
Author = {Lamattina, Daniela and Martinez, Mariela Florencia and Couto, Esteban
   Manuel and Scarry, Clara and Tujague, Maria Paula and Arrabal, Juan
   Pablo and Di Nucci, Dante Luis and Lestani, Eduardo Ariel and Bombelli,
   Diego and Lopez, Marcela Andrea and Sasoni, Natalia and Piloni, Rossana
   and Kim, Angelica and Zenobi, Carlos and Marfil, Maria Jimena and Trigo,
   Roberto and Perez, Nestor Eduardo and Caceres, Maria Gabriela and
   Salomon, Oscar Daniel},
Title = {Detection of Mycobacterium bovis in Free-Ranging Sapajus
   nigritus, Argentina},
Journal = {ZOONOSES AND PUBLIC HEALTH},
Year = {2025},
Volume = {72},
Number = {1},
Pages = {95-99},
Month = {FEB},
Abstract = {Mycobacterium bovis and Mycobacterium tuberculosis are the most relevant
   among pathogenic mycobacteria, both belonging to the M. tuberculosis
   complex (MTC). Samples of blood, liver, spleen, kidneys, lungs and
   caseous tubercles were collected from a free-ranging juvenile black
   capuchin monkey (Sapajus nigritus) showing non-specific signs of
   illness. Macroscopic findings included emaciation, a caseous lesion in a
   tooth and gingiva, disseminated nodules in both lungs and left kidney
   parenchyma and caseous nodules on the pleura and mesentery. The lesions
   suggested MTC infection, a diagnosis subsequently supported in the lung
   by bacilloscopy, immunochromatography and PCR. A multiplex PCR further
   validated the presence of M. bovis genes. Cases of tuberculosis in
   platyrrhine primates have only been reported in animals maintained in
   captivity. We describe for the first time the pathological and molecular
   findings of M. bovis infection in a free-ranging platyrrhine monkey
   within an area of intense human-wildlife interaction, which has
   important implications from a One Health perspective.},
