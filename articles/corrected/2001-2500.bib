@article{ WOS:001499617600011,
Author = {Diaz-Talamantes, Rodrigo and Gonzalez, Edgar J. and Munoz, Rodrigo and
   Enriquez, Moises and Davila-Hernandez, Gerardo and Sandoval-Granillo,
   Valentina and Lebrija-Trejos, Edwin and Meave, Jorge A.},
Title = {Successional Growth Dynamics of Woody Saplings in Tropical Dry Forest
   Understory},
Journal = {BIOTROPICA},
Year = {2025},
Volume = {57},
Number = {3},
Month = {MAY},
Abstract = {Thoroughly understanding tropical forest secondary succession requires
   insights into the processes occurring in the forest understory, the
   vegetation component where the regenerating community develops. Although
   sapling growth is essential to this process, information on how it
   changes along succession is scarce. Here, we examine relative growth
   rates (RGR) of woody species saplings along a broad successional
   gradient in a tropical dry forest based on height and basal area data
   gathered over 15 years of vegetation monitoring in permanent plots
   differing in successional age (1-73 years) plus a mature forest plot. We
   used mixed-effects models to examine the link between individual size,
   fallow age, and plant traits, and from this link model their
   relationship with sapling RGR. Despite sizable RGR variability, growth
   was generally slow over the successional gradient, except in the first
   10 years of succession, when growth rates were highest for most groups.
   Species' successional guild and their identity as members of the
   Leguminosae family were the main factors responsible for growth in basal
   area, while for growth in height, the main factors involved were
   successional guild and growth form. A generalized decrease in sapling
   growth rates in the understory suggests that this process is
   increasingly limited by light rather than by water towards later
   successional stages. Enhanced knowledge of the dynamics of the
   regenerating community in tropical dry forests is fundamental for
   gaining a comprehensive view of their recovery.
   El conocimiento de los procesos que ocurren en el sotobosque, el
   componente de la vegetaci \& oacute;n que representa la comunidad en
   regeneraci \& oacute;n, permite comprender a fondo la sucesi \& oacute;n
   secundaria de los bosques tropicales. El crecimiento es un componente
   esencial de este proceso pero se sabe poco sobre los cambios que
   experimenta a lo largo de la sucesi \& oacute;n. En este trabajo
   analizamos las tasas relativas de crecimiento (TRC) de brinzales de
   especies le \& ntilde;osas en un gradiente sucesional amplio en un
   bosque tropical caducifolio. Datos de di \& aacute;metro basal y altura
   obtenidos durante 15 a \& ntilde;os de monitoreo en parcelas permanentes
   con diferentes edades sucesionales (1-73 a \& ntilde;os) y una parcela
   de bosque maduro permitieron aproximar los valores de TRC. Utilizamos
   modelos de efectos mixtos para determinar los nexos entre el tama \&
   ntilde;o individual, la edad de la parcela y los rasgos funcionales, y a
   partir de ellos modelamos su relaci \& oacute;n con las tasas de
   crecimiento de los brinzales. A pesar de la alta variabilidad en las
   TRC, en general el crecimiento fue muy lento a lo largo del gradiente
   sucesional, excepto en los primeros 10 a \& ntilde;os de la sucesi \&
   oacute;n, cuando hubo tasas m \& aacute;s altas para la mayor \&
   iacute;a de los grupos. El gremio sucesional y la adscripci \& oacute;n
   a Leguminosae fueron los principales factores involucrados en el patr \&
   oacute;n de crecimiento en \& aacute;rea basal, mientras que el gremio
   sucesional y la forma de crecimiento fueron los principales factores que
   afectan el crecimiento en altura. Una disminuci \& oacute;n generalizada
   de las TRC de los brinzales en el sotobosque sugiere que este proceso se
   ve progresivamente limitado por la luz, y no por el agua, hacia las
   etapas sucesionales avanzadas. Un conocimiento m \& aacute;s amplio
   sobre la din \& aacute;mica de la comunidad en regeneraci \& oacute;n de
   los bosques tropicales secos es fundamental para obtener una visi \&
   oacute;n integral de su recuperaci \& oacute;n.},
