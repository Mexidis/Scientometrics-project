Pages = {55-69},
Month = {JAN 8},
Abstract = {The synonymy of Quercus salicifolia is reviewed and an amended
   description that allows its recognition is presented. The main
   characteristics that separate Q. salicifolia from species that have been
   recently proposed as its synonyms are presented. Additionally, Q.
   salasiae is proposed as a new species of the section Lobatae. It is
   compared with Q. salicifolia and Q. nixoniana, with which it presents
   morphological similarity.},
