@article{ WOS:001320349200006,
Author = {Castro, Telma and Peralta, Oscar and Prieto, Cristina and Santiago,
   Naxieli and Alvarez-Ospina, Harry and Garcia, Rocio and Saavedra, Isabel
   and Espinosa, Maria de la Luz and Hernandez, Enrique and Miranda, Javier
   and Gomez, Violeta and Solis, Corina and Salcedo, Dara and
   Torres-Jardon, Ricardo and Martinez-Arroyo, Amparo and Ortinez-Alvarez,
   Abraham and Ruiz-Suarez, Gerardo and Ortiz, Elba},
Title = {Characterization of PM2.5 during the ACU15 campaign in Mexico
   City},
Journal = {GEOFISICA INTERNACIONAL},
Year = {2024},
Volume = {63},
Number = {4},
Pages = {1225-1238},
Month = {OCT-DEC},
Abstract = {We collected daily PM 2.5 samples from January 19 to March 20, 2015, in
   the south of Mexico City and performed chemical analysis. The analyses
   showed an overall composition of 39\% organic carbon, 12\% elemental
   carbon, 20\% water-soluble ions (NO3-, SO4-2,Cl-,Na+, K+, NH4+, and
   Ca-2(+)), and 23\% elements (Al, Si, S, P, Cl, Cr, Mn, Fe, Pb, and Hg)
   in mass. Sulfur and phosphorus showed a correlation coefficient 0.91,
   likely indicating fossil fuel emissions. The samples contain secondary
   inorganic aerosols typical of urban areas, and the oxidation ratios of
   sulfur and nitrogen suggest that oxidative reactions from vehicle
   emissions probably produce them. Furthermore, modern carbon in PM (2.5)
   represents half of the total carbon, indicating carbon sources other
   than fossils.},
