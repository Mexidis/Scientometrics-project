@article{ WOS:001408799500001,
Author = {Jimeno, Diana and Chavez, Daniel and Enriquez, Moises and Fonseca, Rosa
   Maria and Gallardo-Cruz, J. Alberto and Martinez-Camilo, Ruben and
   Meave, Jorge A.},
Title = {Floristic and Structural Heterogeneity in a Neotropical Riparian
   Wetland: Conservation Implications},
Journal = {WETLANDS},
Year = {2025},
Volume = {45},
Number = {1},
Month = {JAN},
Abstract = {Despite the incontrovertible importance of wetland ecosystems, our
   understanding of the causes underlying the spatial heterogeneity of
   their attributes is still insufficient. Here, we assess the spatial
   variation of the floristics (species composition and their relative
   abundances) and quantitative structure (vegetation cover) of the San
   Pedro M \& aacute;rtir River riparian herbaceous wetlands (Tabasco,
   Mexico), and explore potential factors responsible for within- and among
   community variation. Vegetation was sampled at 10 sites along a 40-km
   stretch of the river. Per site cover of the recorded morphospecies was
   assessed with digital photography, and community diversity was analyzed
   using the Hill numbers framework. Total richness was 76 morphospecies
   (67 identified to some taxonomic category); the drastic decrease in true
   diversity with increasing q values indicated that few species dominate
   the community matrix, while numerous remaining species occupy the small
   interstices among them. Three Cyperaceae species had the largest
   importance in the community, with Cladium jamaicense being the most
   frequent and having the largest cover along the river. Ward's site
   classification and NMDS ordination indicated the existence of four
   floristically and structurally different vegetation groups. Within
   sites, GLMMs showed a weak inverse relationship between species richness
   and distance from the river, but no relationship for plant cover.
   Fluvial geomorphology, and possibly regional geological heterogeneity,
   are the main factors determining the spatial variation of these
   herbaceous wetlands. Deep understanding of the relationship of
   herbaceous riparian wetlands with their environment will improve the
   prediction of the effects of modifications of fluvial dynamics and
   support efficient conservation strategies.
   A pesar de la incuestionable importancia de los humedales, no conocemos
   bien los factores responsables de la heterogeneidad espacial de sus
   atributos. Evaluamos la variaci \& oacute;n espacial de la estructura
   flor \& iacute;stica (composici \& oacute;n de especies y sus
   abundancias relativas) y cuantitativa (cobertura vegetal) de los
   humedales herb \& aacute;ceos ribere \& ntilde;os del r \& iacute;o San
   Pedro M \& aacute;rtir (Tabasco, M \& eacute;xico) y exploramos factores
   potencialmente responsables de su variaci \& oacute;n dentro y entre
   comunidades. Se muestre \& oacute; la vegetaci \& oacute;n en 10 sitios
   en un tramo de 40 km del r \& iacute;o. La cobertura por sitio de las
   morfoespecies se evalu \& oacute; con fotograf \& iacute;a digital y la
   diversidad de las comunidades se analiz \& oacute; con n \& uacute;meros
   de Hill. La riqueza total incluy \& oacute; 76 morfoespecies (67
   identificadas hasta alguna categor \& iacute;a taxon \& oacute;mica); la
   dr \& aacute;stica disminuci \& oacute;n de la diversidad verdadera al
   usar valores de q mayores indic \& oacute; que pocas especies dominan la
   matriz comunitaria, mientras que las numerosas especies restantes ocupan
   los intersticios entre ellas. Tres especies de Cyperaceae fueron las m
   \& aacute;s importantes en la comunidad, siendo Cladium jamaicense la m
   \& aacute;s frecuente y la de mayor cobertura. La clasificaci \&
   oacute;n de Ward de los sitios y su ordenaci \& oacute;n por NMDS
   indicaron la existencia de cuatro grupos de vegetaci \& oacute;n
   diferentes flor \& iacute;stica y estructuralmente. Dentro de los
   sitios, los GLMM mostraron una relaci \& oacute;n inversa d \&
   eacute;bil entre la riqueza de especies y la distancia al r \& iacute;o,
   pero no as \& iacute; para la cobertura vegetal. La geomorfolog \&
   iacute;a fluvial y posiblemente la geolog \& iacute;a regional son los
   principales factores que determinan la variaci \& oacute;n espacial de
   estos humedales ribere \& ntilde;os. La comprensi \& oacute;n profunda
   de la relaci \& oacute;n de los humedales ribere \& ntilde;os herb \&
   aacute;ceos con su ambiente mejorar \& aacute; la predicci \& oacute;n
   de los efectos de modificaciones de la din \& aacute;mica fluvial y dar
   \& aacute; sustento a estrategias eficientes de conservaci \& oacute;n.},
