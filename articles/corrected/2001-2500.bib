Pages = {4858-4886},
Month = {NOV 2},
Abstract = {This paper focuses on defining an analog of differential-graded
   triangular matrix algebra in the context of differential-graded
   categories. Given two dg-categories U and T and M is an element of
   DgMod(U circle times Top) we construct the differential graded
   triangular matrix category Lambda:={[}T0MU]. Our main result, is that
   there is an equivalence of dg-categories between the dg-comma category
   (DgMod(T),G(DgMod(U))) and the category DgMod({[}T0MU]). This result is
   an extension of a well known result for artin algebras (see for example
   {[}2, III.2]).},
