@article{ WOS:000944562300005,
Author = {Gomez, Julio Cesar Horta},
Title = {Models in Science: The Diagrammatic Condition of Knowledge},
Journal = {STOA},
Year = {2022},
Volume = {13},
Number = {26},
Pages = {78-91},
Month = {JUL-DEC},
Abstract = {In this work we will review the semiotic conditions of a scientific
   model, to consider the operations that allow constituting the
   theoretical entities as an observa-ble phenomenon. At this point we will
   defend a nominalist condition of science in the semiotic construction of
   scientific experience. Subsequently, the function of the index as a
   fundamental semiotic operator in the construction of science will be
   discussed. Faced with a nominalist position of scientific models, we
   will complement the review by contrasting a realist position that from
   Ch. S. Peirce defends the icon and the index as categories that allow
   modeling the existence of scientific objects and entities.},
Publisher = {UNIV VERACRUZANA, INST FILOSOFIA},
Address = {LOMAS ESTADIO S-N, AREA HUMANIDADES, EDIF B CUB 23, XALAPA, VERACRUZ,
   91090, MEXICO},
Type = {Article},
Language = {English},
Affiliation = {Gómez, JCH (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias Polit \& Sociales, Mexico City, Mexico.
   Gomez, Julio Cesar Horta, Univ Nacl Autonoma Mexico, Fac Ciencias Polit \& Sociales, Mexico City, Mexico.},
DOI = {10.25009/st.2022.26.2702},
ISSN = {2007-1868},
Keywords = {Icon; Index; Semiotic object; Model; Representation; Diagram},
