   Leptotyphlopidae)},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2022},
Volume = {93},
Month = {JAN},
Abstract = {A new snake species of the genus Rena is described from northern
   Jalisco, Mexico. The new species represents an isolated member of the R.
   dulcis group in the extreme southwest Mesa Central of the country. We
   redefine the R. dulcis and R. humilis groups within the genus Rena. The
   status of the other species allocated to these groups is discussed.},
