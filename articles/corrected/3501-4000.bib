@article{ WOS:000761830400001,
Author = {Leon Galeana, Alicia and Ortiz Morales, Martin and Santiago Vargas,
   Valente},
Title = {Triangular matrix categories II: Recollements and functorially finite
   subcategories},
Journal = {ALGEBRAS AND REPRESENTATION THEORY},
Year = {2023},
