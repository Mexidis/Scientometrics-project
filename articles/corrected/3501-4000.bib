@article{ WOS:000798833100001,
Author = {Flores-Villela, Oscar and Smith, Eric N. and Campillo-Garcia, Gustavo
   and Martinez-Mendez, Norberto and Campbell, Jonathan A.},
Title = {A new species of Sceloporus of the torquatus group
   (Reptilia: Phrynosomatidae) from West Mexico},
Journal = {ZOOTAXA},
Year = {2022},
Volume = {5134},
Number = {2},
Pages = {286-296},
Month = {MAY 10},
Abstract = {We describe Sceloporus huichol sp. nov., a new species of spiny lizard
   of the genus Sceloporus, that is found in the mountainous regions of
   Jalisco and Nayarit in western Mexico. The new species belongs to the
   torquatus species group and has previously been confused with Sceloporus
   melanogaster, from which it differs by its smaller size, head color and
   nuchal collar. Additionally, Sceloporus huichol sp. nov. is different
   from the rest of its congeners by relevant genetic and morphologicall
   data. Despite having a complete nuchal collar, characteristic of
   Sceloporus torquatus, S. huichol sp. nov. is more closely related
   phylogenetically to S. melanogaster. Recognition of this new species
   brings the number of species in the torquatus group to nine.},
