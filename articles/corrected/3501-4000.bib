@article{ WOS:000764367000001,
Author = {Palacios-Aguilar, Ricardo and Colin-Martinez, Victor H. and
   Hernandez-Rubio, Salvador and Canseco-Marquez, Luis and Nieto-Montes De
   Oca, Adrian and Ochoa-Ochoa, Leticia M.},
Title = {Another case of colour pattern polymorphism in Earth Snakes of the genus
   Geophis (Dipsadidae) from southern Mexico},
Journal = {JOURNAL OF NATURAL HISTORY},
Year = {2021},
Volume = {55},
Number = {47-48},
Pages = {2985-2997},
Month = {DEC 17},
Abstract = {Geophis laticollaris and G. russatus are rare Mexican snakes currently
   known in the scientific literature only from their holotypes. However,
   fieldwork conducted in the states of Guerrero and Oaxaca by us and other
   workers during the last decades has made a few specimens of each taxon
   available for study. We review the taxonomic status of G. russatus on
   the basis of scutellation, colour pattern, maxillary, and hemipenial
   characters and sequences of a fragment of the cyt-b mitochondrial gene.
   We conclude that G. russatus is a colour morph and a junior synonym of
   G. laticollaris.},
