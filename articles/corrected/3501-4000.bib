@article{ WOS:000720520100007,
Author = {Carabali, Giovanni and Villanueva-Macias, Jose and Ladino, Luis A. and
   Alvarez-Ospina, Harry and Raga, Graciela B. and Andraca-Ayala, Gema and
   Miranda, Javier and Grutter, Michel and Silva, Ma Montserrat and
   Riveros-Rosas, David},
Title = {Characterization of aerosol particles during a high pollution episode
   over Mexico City},
Journal = {SCIENTIFIC REPORTS},
Year = {2021},
Volume = {11},
Number = {1},
Month = {NOV 18},
Abstract = {More than 7 thousand wildfires were recorded over Mexico in 2019,
   affecting almost 640 thousand hectares. Most of these fires occurred
   during the spring season generating dense smoke plumes, impacting urban
   areas in the central part of the Mexican plateau. From May 10 to 17,
   2019, biomass burning (BB) plumes affected Mexico City (MC) and diffused
   across the basin, producing PM2.5 levels similar to 2 times higher than
   the nation's air quality standards. Average PM2.5 concentrations
   increased sharply from 29.4 +/- 7.2 mu g m(-3) to 65.1 +/- 13.6 mu g
   m(-3) when the dense smoke plumes were detected. The higher particle
   concentration impacted the aerosol optical depth (AOD) as values similar
   to 3 times greater than the annual mean (0.32 +/- 0.12) were measured,
   which resulted in a 17\% loss of global horizontal irradiation (GHI).
   Under these severe pollution conditions, the visibility (V-a) was
   reduced by similar to 80\%. The high incidence of strong absorbent
   particles, such as soot and tarballs was revealed through electron
   microscopy and X-ray fluorescence (XRF) analysis. These techniques show
   chemical similarities between MC aerosols and those from the
   high-altitude (similar to 4010 m. a. g. l.) Altzomoni Atmospheric
   Observatory, evidencing a strong influence of the BB emissions,
   suggesting a regional transport of these pollutants.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Carabali, G (Corresponding Author), Univ Nacl Autonoma Mexico, Inst Geofis, Mexico City, DF, Mexico.
   Carabali, Giovanni; Villanueva-Macias, Jose; Riveros-Rosas, David, Univ Nacl Autonoma Mexico, Inst Geofis, Mexico City, DF, Mexico.
   Villanueva-Macias, Jose, Univ Nacl Autonoma Mexico, Fac Quim, Mexico City, DF, Mexico.
