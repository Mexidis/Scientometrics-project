Pages = {557-573},
Month = {JAN 17},
Abstract = {A new procedure to find the ultimate ruin probability in a discrete-time
   risk model is presented for claims with a mixture of m negative binomial
   distributions. The method involves the theory of linear recurrence
   sequences. It requires to find the zeroes of an m degree polynomial and
   the solution of a system of m linear equations. Numerical results and
   plots are provided as examples.},
