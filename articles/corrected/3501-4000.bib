@article{ WOS:000791947800015,
Author = {Higueras-Montano, Luisa F. and Jonard-Perez, Natalia},
Title = {On the topology of some hyperspaces of convex bodies associated to
   tensor norms},
Journal = {JOURNAL OF MATHEMATICAL ANALYSIS AND APPLICATIONS},
Year = {2022},
Volume = {509},
Number = {2},
Month = {MAY 15},
Abstract = {For every tuple d1, . . . , dl >= 2, let R-d1 (circle times) middot
   middot middot (circle times) R-dl denote the tensor product of R-di, i =
   1, ... , l. Let us denote by B(d) the hyperspace of centrally symmetric
   convex bodies in R-d, d = d(1) middot middot middot d(l), endowed with
   the Hausdorff distance, and by B-circle times(d(1), . . . , d(l)) the
   subset of B(d) consisting of the convex bodies that are closed unit
   balls of reasonable crossnorms on R-d1 circle times middotmiddotmiddot
   circle times R-dl. It is known that B-circle times (d(1), ... , d(l)) is
   a closed, contractible and locally compact subset of B(d). The
   hyperspace B-circle times(d(1), . . . , d(l)) is called the space of
   tensorial bodies. In this work we determine the homeomorphism type of
   B-circle times(d1, . . . , dl). We show that even if B-circle
   times(d(1), . . . , d(l)) is not closed with respect to the Minkowski
   sum, it is an absolute retract homeomorphic to Q x R-p, where Q is the
   Hilbert cube and p = d(1)(d(1)+1)+middotmiddotmiddot+d(l)(d(l)+1)/2 .
   Among other 2 results, the relation between the Banach-Mazur compactum
   and the Banach-Mazur type compactum associated to B-circle times(d(1), .
   . . , d(l)) is examined. (c) 2021 Elsevier Inc. All rights reserved.},
Publisher = {ACADEMIC PRESS INC ELSEVIER SCIENCE},
Address = {525 B ST, STE 1900, SAN DIEGO, CA 92101-4495 USA},
Type = {Article},
Language = {English},
Affiliation = {Higueras-Montaño, LF (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias, Dept Matemat, Ciudad De Mexico 04510, Mexico.
