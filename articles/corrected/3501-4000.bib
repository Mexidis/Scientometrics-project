@article{ WOS:000747123800002,
Author = {Cerda-Leon, Erwin and Rincon-Mejia, Hugo},
Title = {ON LATTICES ASSOCIATED TO RINGS WITH RESPECT TO A PRERADICAL},
Journal = {INTERNATIONAL ELECTRONIC JOURNAL OF ALGEBRA},
Year = {2022},
Volume = {31},
Pages = {13-37},
Abstract = {We introduce some new lattices of classes of modules with respect to
   appropriate preradicals. We introduce some concepts associated with
   these lattices, such as the sigma-semiartinian rings, the
   sigma-retractable modules, the sigma-V-rings, the sigma-max rings. We
   continue to study sigma-torsion theories, sigma-open classes,
   sigma-stable classes. We prove some theorems that extend some known
   results. Our results fall into well known situations when the preradical
   a is chosen as the identity preradical.},
