@article{ WOS:000976336300004,
Author = {Aguirre, Pablo Armando Gonzalez Ulloa and Munoz, Jorge Federico Marquez},
Title = {Social and Institutional Reconfigurations for the Environment and
   Sustainability: Lessons for Mexico},
