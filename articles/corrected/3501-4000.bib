@article{ WOS:000800646600001,
Author = {Benitez-Bobadilla, German and Galeana-Sanchez, Hortensia and
   Hernandez-Cruz, Cesar},
Title = {PANCHROMATIC PATTERNS BY PATHS},
Journal = {DISCUSSIONES MATHEMATICAE GRAPH THEORY},
Year = {2024},
Volume = {44},
Number = {2},
Pages = {519-537},
Abstract = {Let H = (V-H, A(H)) be a digraph, possibly with loops, and let D = (V-D,
   A(D)) be a loopless multidigraph with a colouring of its arcs c : A(D)
   -> V-H. An H-path of D is a path (v(0), ..., v(n)) of D such that
   (c(v(i-1), v(i)), c(v(i), v(i+1))) is an arc of H for every 1 <= i <= n
   - 1. For u, v is an element of V-D, we say that u reaches v by H-paths
   if there exists an H-path from u to v in D. A subset S subset of V-D is
   absorbent by H-paths of D if every vertex in V-D - S reaches some vertex
   in S by H-paths, and it is independent by H-paths if no vertex in S can
   reach another (different) vertex in S by H-paths. A kernel by H-paths is
   a subset of V-D which is independent by H-paths and absorbent by
   H-paths.
   We define (B) over tilde (1) as the set of digraphs H such that any
   H-arc-coloured tournament has an absorbent by H-paths vertex; the set
   (B) over tilde (2) consists of the digraphs H such that any
   H-arc-coloured digraph D has an independent, absorbent by H-paths set;
   analogously, the set (B) over tilde (3) is the set of digraphs H such
   that every H-arc-coloured digraph D contains a kernel by H-paths.
   In this work, we point out similarities and differences between
   reachability by H-walks and reachability by H-paths. We present a
   characterization of the patterns H such that for every digraph D and
   every H-arc-colouring of D, every H-walk between two vertices in D
   contains an H-path with the same endpoints. We provide advances towards
   a characterization of the digraphs in (B) over tilde (3). In particular,
   we show that if a specific digraph is not in (B) over tilde (3), then
   the structure of the digraphs in the family is completely determined.
   Keywords: kernel of a digraph, kernel by monochromatic paths,
   panchromatic pattern, kernel by H-walks, kernel by H-paths.},
