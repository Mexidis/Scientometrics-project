Pages = {73-101},
Month = {JAN-APR},
Abstract = {This article analyzes the challenges of over-coming the environmental
   crisis. It examines the main antecedents of sustainable develop-ment on
   a global scale, as well as advances on the subject in Mexican
   legislation and institu-tions. This is followed by a proposal of various
   functional relationships for sustainable devel-opment, such as the
   political, economic, social, ethical, technological, international, and
   ad-ministrative system. Lastly, they highlight the importance of public
   policies that would help achieve a comprehensive approach to
   environ-mental matters and the key role that must be played by the
   state.},
