@article{ WOS:000833860400002,
Author = {Galeana-Moran, M. A. and Quiroz-Barragan, J. and Sour-Tovar, F.},
Title = {Richthofenid Brachiopods (Productida) and microfacies analysis of the
   Las delicias formation, middle Permian from Coahuila, Mexico:
   Paleoenvironmental and paleobiogeographical considerations},
Journal = {JOURNAL OF SOUTH AMERICAN EARTH SCIENCES},
Year = {2022},
Volume = {118},
Month = {OCT},
Abstract = {Five genera and six species of richthofenid brachiopods from two
   sections of the Las Delicias Formation (Gua-dalupian) at southwestern
   Coahuila are described. In ``Las Difuntas{''} section we found Sicularia
   sicula, Sestropoma cribriferum, Sestropoma mexicanum, Sestropoma sp. 1
   and Sestropoma sp. 2. While in the ``Las Manuelas 2{''} section occur
   Hercosestria cribrosa, Cyclacantharia aff. kingorum and Teguliferina?
   sp. Species described confirmed the affinity of Coahuila with other
   reefal faunas of the Grandian Province (i.e. Texas and New Mexico, USA).
   Microfacies analysis in the studied sections allows recognizing of a
   great content of carbonated rocks (Rudstone, Floatstone) with numerous
   bioclasts and autochtonous reefal framework (Framestone). A terrigenous
   platform paleoenvironment are inferred. The fossil association occurred
   in different events of deposition in situ whose facies are alternating
   with stages of volcanic activity which produce flows of sediments,
   volcanic material and organic remains towards the slope.},
