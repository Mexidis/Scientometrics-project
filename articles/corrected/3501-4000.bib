Volume = {67},
Number = {246},
Pages = {15-42},
Month = {SEP-DEC},
Abstract = {This article analyzes interest group studies and examines the empirical
   findings and method-ological challenges of two literature areas: 1) the
   effect of contributions to political campaigns on public decisions and
   2) the influence of lobby-ing on legislative votes. The document points
   out the methodological limitations of interest group studies and
   identifies obstacles that pre-vent the development of this field of
   study outside the United States and the European Union.},
