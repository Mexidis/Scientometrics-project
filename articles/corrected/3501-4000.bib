Volume = {149},
Number = {11},
Pages = {4923-4930},
Month = {NOV},
Abstract = {We give a new proof of the equivalence between the existence of a
   complete action of a Lie algebroid on a surjective submersion and its
   integrability. The main tools in our approach are double Lie groupoids
   and multiplicative foliations; our proof relies on a simple
   characterization of those vacant double Lie groupoids which induce a Lie
   groupoid structure on their orbit spaces.},
