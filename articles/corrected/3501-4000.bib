@article{ WOS:000763760100001,
Author = {Licea, Gerardo Sanchez},
Title = {A Straightforward Sufficiency Proof for a Nonparametric Problem of Bolza
   in the Calculus of Variations},
Journal = {AXIOMS},
Year = {2022},
Volume = {11},
Number = {2},
Month = {FEB},
Abstract = {We study a variable end-points calculus of variations problem of Bolza
   containing inequality and equality constraints. The proof of the
   principal theorem of the paper has a direct nature since it is
   independent of some classical sufficiency approaches invoking the
   Hamiltonian-Jacobi theory, Riccati equations, fields of extremals or the
   theory of conjugate points. In contrast, the algorithm employed to prove
   the principal theorem of the article is based on elementary tools of the
   real analysis.},
