@article{ WOS:000759303000002,
Author = {Galeana, Alicia Leon and Morales, Martin Ortiz and Vargas, Valente
   Santiago},
Title = {Triangular Matrix Categories I: Dualizing Varieties and Generalized
   One-point Extensions},
Journal = {ALGEBRAS AND REPRESENTATION THEORY},
Year = {2023},
Volume = {26},
Number = {3},
Pages = {831-880},
Month = {JUN},
Abstract = {Following Mitchell's philosophy, in this paper we define the analogous
   of the triangular matrix algebra to the context of rings with several
   objects. Given two preadditive categories U and T and M is an element of
   Mod(U circle times T-op) we construct the triangular matrix category.
   Lambda:= {[}T 0 M U]. First, we prove that Mod(Lambda) is equivalent to
   a comma category (Mod(T), GMod(U)) which is induced by a functor G :
   Mod(U) -> Mod(T). One of our main results is that if U and T are
   dualizing K-varieties and M is an element of Mod(U circle times T-op)
   satisfies certain conditions then Lambda : = {[}T 0 M U] is a dualizing
   variety (see Theorem 6.10). In particular, mod(Lambda) has
   Auslander-Reiten sequences. Finally, we apply the theory developed in
   this paper to quivers and give a generalization of the so called
   one-point extension algebra.},
