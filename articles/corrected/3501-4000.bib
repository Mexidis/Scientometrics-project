@article{ WOS:000812565400074,
Author = {Brown, Joshua I. and Hernandez, Flor and Engilis, Jr., Andrew and
   Hernandez-Banos, Blanca E. and Collins, Dan and Lavretsky, Philip},
Title = {Genomic and morphological data shed light on the complexities of shared
   ancestry between closely related duck species},
Journal = {SCIENTIFIC REPORTS},
Year = {2022},
Volume = {12},
Number = {1},
Month = {JUN 17},
Abstract = {Causes for genomic and morphological similarities among recently
   radiated species are often multifaceted and are further convoluted among
   species that readily interbreed. Here, we couple genomic and
   morphological trait comparisons to test the extent that ancestry and
   gene flow explain the retention of mallard-like traits within a sister
   species, the Mexican duck. First, we confirm that these taxa remain
   genetically structured, and that Mexican ducks exhibit an
   isolation-by-distance pattern. Despite the assumption of wide-spread
   hybridization, we found only a few late-stage hybrids, all from the
   southwestern USA. Next, assessing 23 morphological traits, we developed
   a genetically-vetted morphological key that is > 97\% accurate in
   distinguishing across sex-age cohorts of Mexican ducks, mallards, and
   hybrids. During key development, we determined that 25\% of genetically
   pure, immature male Mexican ducks of the northern population naturally
   displayed mallard-like traits in their formative plumage. In fact,
   applying this key to 55 museum specimens, we identified that only four
   of the 14 specimens originally classified as phenotypic hybrids were
   truly hybrids. We discuss how genomic and morphological comparisons shed
   light into the mechanism(s) underlying the evolution of complex
   phenotypic traits in recent radiations, and how misunderstanding the
   true morphological diversity within Mexican ducks resulted in taxonomic
   revisions that hindered conservation efforts.},
