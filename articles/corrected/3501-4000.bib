@article{ WOS:000829934300002,
Author = {Gonzalez-Moreno, Diego and Guevara, Mucuy-Kak and
   Montellano-Ballesteros, Juan Jose},
Title = {An Anti-Ramsey Theorem of k-Restricted Edge-Cuts},
Journal = {GRAPHS AND COMBINATORICS},
Year = {2022},
Volume = {38},
Number = {4},
Month = {AUG},
Abstract = {Given a graph G (with multiple edges allowed), a k-restricted edge-cut
   of G is an edge-cut R subset of E(G) of G such that every connected
   component in G - R has order at least k. A graph G is
   lambda(k)-connected if k-restricted edge cuts exist. Given an
   edgecoloring of G, an edge-cut of G will be called heterochromatic if
   all its edges receive different colors. Given a graph G and an integer k
   >= 2, let h(G, k) be the minimum integer p such that every p-coloring of
   the edges of G produces an heterochromatic k-restricted edge-cut of G.
   In this paper we prove that for a 2 k -connected graph G of size m,
   order n >= 3k - 2, and with no k-restricted edge-cut of size 1, we have
   that m - n min\{kappa(0) (G) - 2, t(G, k)\} + 2 <= h(G , k) <= m - n +
   t(G, k) + 2, where kappa(0) (G) is the vertex-connectivity of G and t(G,
   k) is the maximum cardinality of a set S subset of V(G) such that the
   connected components in G{[}S] have order at most k - 1. As a corollary
   we see that h(G, k) <= m - n + alpha(G)(k - 1) + 2, with alpha(G) the
   independence number of G.},
Publisher = {SPRINGER JAPAN KK},
Address = {SHIROYAMA TRUST TOWER 5F, 4-3-1 TORANOMON, MINATO-KU, TOKYO, 105-6005,
