@article{ WOS:000788075600002,
Author = {Martinez-Gordillo, Martha and Felix Ramos-Ordonez, Maria},
Title = {Begonia ostulensis (Begoniaceae), a new species from Michoacan, Mexico},
Journal = {PHYTOTAXA},
Year = {2022},
Volume = {543},
Number = {1},
Pages = {89-94},
Month = {APR 8},
Abstract = {Begonia ostulensis sp. nov. is a new species from section Knesebeckia,
   known solely from the state of Michoacan; it is similar to Begonia
   monophylla, an endemic species from Mexico with a distribution in the
   states of Mexico, Colima, Michoacan, Guerrero and Morelos, but B.
   ostulensis differs from it in having an orbicular, peltate, solitary
   leaf, with the lower and upper surfaces glabrous, a lobed and
   double-dentate, non-ciliate margin, inflorescences terminal, peduncle
   and rachis glabrous and fruit with primary wing asymmetrically
   triangular, glabrous.},
