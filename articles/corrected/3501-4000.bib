@article{ WOS:000849146500001,
Author = {Garcia-Meza, D. and Martorell, C.},
Title = {Drivers of seed preferences and dispersal by granivorous ants in a
   semiarid grassland},
Journal = {INSECTES SOCIAUX},
Year = {2022},
Volume = {69},
Number = {4},
Pages = {325-333},
Month = {NOV},
Abstract = {Granivory by ants affects plant populations negatively, although the
   interaction may become beneficial if ants disperse some seeds. Ants
   prefer seeds depending on their availability, weight, and dispersal
   structures. Nevertheless, the factors determining the fraction of seeds
   that are dispersed rather than eaten have not been analyzed. It may be
   expected that the most preferred seeds are the least dispersed, so
   dispersal would depend on the same seed traits driving predation. We
   assess whether seed weight, wind-dispersal structures, plant species
   abundance, and seasonal seed availability determine the preferences for
   different seed species in two species of ants in the genus Pheidole in
   Mexico. We also examine whether seed dispersal by Pheidole was affected
   by seed preferences, seed weight, plant species abundance, and seasonal
   availability. We conducted a cafeteria experiment with 11 seed species
   in 2 months with contrasting seed availability, and measured preferences
   based on the removal rates of different seed species. To determine the
   fraction of seed dispersed, some seeds were painted with fluorescent ink
   and tracked with UV light. Ants preferred seeds without dispersal
   structures, perhaps because they hamper seed transport, increasing the
   foraging costs. No other variables affected preferences. 11\% of the
   removed seeds were dispersed. The probability that a seed was dispersed
   decreased with its preference. Dispersal probability was larger for
   common species and in the season when seeds are abundant These results
   suggest that ants tend to disperse seeds when they have good chances to
   find their preferred resources easily or closer to their nest.},
