@article{ WOS:000975063200006,
Author = {Gonzalez-Oliver, Angelica and Ortega-Munoz, Allan},
Title = {Family formation expectations between young indigenous and mestizos of
   central Mexico and Quintana Roo},
Journal = {PAPELES DE POBLACION},
Year = {2022},
Volume = {28},
Number = {112},
Pages = {163-198},
Month = {APR-JUN},
Abstract = {We compare the family formation preferences of 149 -Mestizo, Nahua,
   Totonaco, and Maya- young-single individuals from Puebla and Quintana
   Roo, Mexico. We analyzed inter-group and inter-sex preferences by size
   of locality and marriages market characteristics. The results show that
   young indigenous and mestizo individuals of both sexes, with no
   statistical differences by size of locality prefer marriage at elder
   ages, a legal married status, neolocality and homogamy, with slight
   differences between social groups. We conclude that there is continuity
   of the tradi-tional nuptiality system, with some glimpses of issues
   linked to SDT thesis.},
