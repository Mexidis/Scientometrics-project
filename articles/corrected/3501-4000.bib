@article{ WOS:000829758100005,
Author = {Herrera-Mares, Angel and Guzman-Cornejo, Carmen and Ulloa-Garcia,
   Armando and Cordoba-Aguilar, Alex and Carolina Silva-de la Fuente, Maria
   and Suzan, Gerardo},
Title = {Mites, rodents, and pathogens: A global review for a multi-species
   interaction in disease ecology},
Journal = {ACTA TROPICA},
Year = {2022},
Volume = {232},
Month = {AUG},
Abstract = {More than ever, there is a need to understand how pathogens, vectors and
   hosts occur temporally and spatially to predict the occurrence of
   zoonotic outbreaks. Related to this, mites of the Mesostigmata and
   Trombidiformes orders have the potential to transmit several diseases,
   yet their information of occurrence, distribution and zoonotic
   accompanying agents have not been systematically organized. We conducted
   a systematic review using a combination of words through the Sysrev
   platform, as well as literature searches in specialised databases to
   identify global patterns of infections, trends in mite-rodent-pathogen
   research and existing knowledge gaps. The inclusion criterion was the
   detection of pathogens in mites, either by molecular or serological
   techniques or by direct observation under the microscope, which rendered
   125 papers. Most works have been carried out in Asia, mainly around the
   transmission of Orientia tsutsugamushi. Interestingly, co-infections,
   i.e., the presence of more than one pathogen in an individual, are
   common in other Acari groups such as ticks. Moreover, this is not the
   case for Trombidiformes and Mesostigmata as only 4.7 percent of the
   articles reviewed detected more than one pathogen in these mites. It is
   important to include a multi-host, multi-vector and multi-pathogen
   approaches to understand complex systems in disease ecology. A synergy
   between mite taxonomists, physicians and veterinarians, decision-makers,
   governmental organisations, and society is needed to address the
   emergence of miteborne new or neglected diseases.},
