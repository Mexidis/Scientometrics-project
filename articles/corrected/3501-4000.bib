@article{ WOS:000820187600005,
Author = {Guzman-Cornejo, Carmen and Rebollo-Hernandez, Andrea and Herrera-Mares,
   Angel and Munoz-Leal, Sebastian and Del Castillo-Martinez, Laura and
   Lopez-Perez, Andres M. and Cabrera-Garrido, Martin and
   Oceguera-Figueroa, Alejandro},
Title = {Rickettsia spp. in ticks from a tropical dry forest reserve on
   Mexico's Pacific Coast},
Journal = {TICKS AND TICK-BORNE DISEASES},
Year = {2022},
Volume = {13},
Number = {3},
Month = {MAY},
Abstract = {The present study analyzes the diversity of bacteria of the genus
   Rickettsia in ticks collected from wild mammals and vegetation at the
   Chamela Biological Station (EBCh), Jalisco, Mexico, a core area in the
   Chamela-Cuixmala Biosphere Reserve, which is characterized by the
   presence of tropical dry forest, one of the most threatened ecosystems
   in the world. Ticks were collected during April and November 2018 and
   2019, determined to species, and subsequently processed for rickettsiae.
   Genomic DNA was extracted from each of 349 ticks (198 from mammals, 151
   from vegetation) and screened for Rickettsia by targeting the gltA and
   ompA genes. Overall, 75 ticks (21.5\%) were positive for rickettsiae (46
   from mammals, 29 from vegetation). Through BLASTn and maximum likelihood
   analysis, four Rickettsia taxa were identified. Only Rickettsia
   amblyommatis had been previously recorded in the vicinity of the EBCh,
   and we confirm its presence in this reserve, associated with Amblyomma
   mixtum, Amblyomma cf. oblongoguttatum and Amblyomma parvum.
   Additionally, we record for the first time at EBCh the taxa Rickettsia
   parkeri strain Atlantic rainforest, which is known to cause spotted
   fever illness in humans, detected in Amblyomma ovale; Rickettsia bellii
   in A. parvum and Ornithodoros talaje; and an undescribed Rickettsia sp.
   in Ixodes sinaloa.},
