@article{ WOS:000734186600025,
Author = {Garcia-Rodriguez, Auda and Luna-Vega, Isolda and Yanez-Ordonez, Olivia
   and Cesar Ramirez-Martinez, Julio and Espinosa, David and
   Contreras-Medina, Raul},
Title = {Distributional Patterns of Bees of the Montane Cloud Forest in the
   Sierra Madre Oriental, Mexico},
Journal = {SOUTHWESTERN ENTOMOLOGIST},
Year = {2021},
Volume = {46},
Number = {4},
Pages = {1021-1035},
Month = {DEC},
Abstract = {Bee species from the Sierra Madre Oriental (SMOr) were studied to obtain
   patterns of richness and endemism. We divided the study area into a 0.5
   degrees x 0.5 degrees latitude/longitude grid where 4,547 records of
   bees in 279 species, 73 genera, and five families were collected from
   institutional databases and one museum. The data indicated that species
   richness was concentrated in the northern portion of the SMOr. The
   complementary index for each combination of grid-cells resulted in high
   values (IC > 0.8). Within the SMOr, nine grid-cells (of 21) were enough
   to represent 82\% of the species. The Arteaga grid-cell had the most
   species richness, and values of endemism indices coincided with two
   natural protected areas known as Cumbres de Monterrey National Park and
   Bajo Rio San Juan Protection Resources Area. We concluded that the
   northern portion of the SMOr is the most biodiverse region of bee
   species in this mountain chain.},
