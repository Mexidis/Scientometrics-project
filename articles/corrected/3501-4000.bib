Year = {2021},
Volume = {67},
Number = {6},
Month = {NOV-DEC},
Abstract = {In this paper, we analyze the Efficient Market Hypothesis for automated
   high-frequency stock markets. Using the Hurst exponent as a measure of
   efficiency, we show that the time series of high-frequency stock prices
   do not follow random walks, rejecting then (as we discuss in the text)
   the EMH for these markets.},
