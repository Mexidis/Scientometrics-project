Year = {2022},
Volume = {43},
Number = {1, SI},
Pages = {98-109},
Month = {JAN},
Abstract = {We describe the nu-lines of curvature on an embedding of the double
   torus into R-4, defined as the complete intersection of a small sphere
   with a polynomial hypersurface in R-4, where nu is the gradient of such
   polynomial. Through this analysis, we present a complete description of
   the foliation of lines of curvature on the embedding, defined as the
   image of the stereographic projection of this complete intersection into
   R-3.},
