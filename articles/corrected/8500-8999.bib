@article{ WOS:000232427800013,
Author = {Rodríguez, A and Medina, L},
Title = {Improved SNR of phased-array PERES coils via simulation study},
Journal = {PHYSICS IN MEDICINE AND BIOLOGY},
Year = {2005},
Volume = {50},
Number = {18},
Pages = {N215-N225},
Month = {SEP 21},
Abstract = {computational comparison of signal-to-noise ratio (SNR) was performed
   between a conventional phased array of two circular-shaped coils and a
   petal resonator surface array. The quasi-static model and phased-array
   optimum SNR were combined to derive an SNR formula for each array.
   Analysis of mutual inductance between coil petals was carried out to
   compute the optimal coil separation and optimum number of petal coils.
   Mutual interaction between coil arrays was not included in the model
   because this does not drastically affect coil performance. Phased arrays
   of PERES coils show a 114\% improvement in SNR over that of the simplest
   circular configuration.},
