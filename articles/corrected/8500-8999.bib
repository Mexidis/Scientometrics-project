@article{ WOS:000233517400011,
Author = {Manríquez-Monán, NL and Cruz, MV and Cruz, FRM},
Title = {Reproductive biology of the parthenogenetic lizard, Aspidoscelis
   cozumela},
Journal = {HERPETOLOGICA},
Year = {2005},
Volume = {61},
Number = {4},
Pages = {435-439},
Month = {DEC},
Abstract = {The reproductive biology of thic parthenogenetic lizard Aspidoscelis
   cozumela was studied from November 1994 to October 1995 on Cozumel
   Island, Quintana Roo, Mexico. Females exhibit a seasonal pattern with
   maximum reproductive activity during spring and summer (March to August)
   associated with day length. Clutch size averaged 1.8 (range 1-4) and was
   positively correlated with female body size. Females Produced at least
   two clutches within the reproductive season.},
