@article{ WOS:000237623900002,
Author = {Lopez-Riquelme, German Octavio and Moles, Maria Luisa Fanjul},
Title = {The ant Camponotus atriceps shows electroretinogram circadian
   rhythms},
Journal = {BIOLOGICAL RHYTHM RESEARCH},
Year = {2006},
Volume = {37},
Number = {2},
Pages = {111-115},
Month = {APR},
Abstract = {We studied the circadian variation of the electroretinogram (ERG)
   response of individual isolated ants of two castes: major workers and
   virgin queens of the species Campanotus atriceps subjected to different
   experimental light protocols. The experiments demonstrated that both
   castes of this species show similar ERG endogenous circadian rhythms
   able to entrain to 24 h LD cycles changing phase and period. This is the
   first work reporting circadian changes in the eye's electrophysiological
   response to light in ants.},
