@inproceedings{ WOS:000245812000006,
Author = {Frank, A. and Lopez Vieyra, J. C. and Barea, J. and Hirsch, J. G. and
   Velazquez, V. and Van Isacker, P.},
Editor = {Civitarese, O and Dorso, C and Bermudez, GG and Kreiner, AJ and Pacheco, AJ and Scoccola, NN},
Title = {Nuclear mass. forecasting:: Can observed pattern determine mass values?},
Booktitle = {VI LATIN AMERICAN SYMPOSIUM ON NUCLEAR PHYSICS AND APPLICATIONS},
Series = {AIP Conference Proceedings},
Year = {2007},
Volume = {884},
Pages = {61+},
Note = {6th Latin American Symposium on Nuclear Physics and Applications,
   Iguazu, ARGENTINA, OCT 03-07, 2005},
Organization = {Agencia Nacl Promoc Cient Tecnol; Ctr Latinoamer Fis; Consejo Nacl
   Invest Cient Tecn Argentina; Int Ctr Theoret Phys; Fdn Antorchas},
Abstract = {Theoretical prediction of nuclear masses is analyzed as a pattern
   recognition problem on the N-Z plane. A global pattern is observed by
   plotting the differences between measured masses and Liquid Drop Model
   (LDM) predictions. After unfolding the data by removing the smooth LDM
   mass contributions, the remaining microscopic effects have proved
   difficult to model, although they display a striking pattern. These
   deviations carry information related to shell closures, nuclear
   deformation and the residual nuclear interactions. In the present work
   the more than 2000 known nuclear masses are studied as an array in the
   N-Z plane viewed through a mask, behind which the approximately 7000
   unknown unstable nuclei that can exist between the proton and neutron
   drip lines are hidden. Employing a Fourier transform deconvolution
   method these masses can be predicted. Measured masses are reconstructed
   with and r.m.s. error of less than 200 keV. The existence of an island
   of stability around (Z approximate to 116, N approximate to 194) is
   strongly suggested. Other potential applications of the present approach
   are outlined.},
Publisher = {AMER INST PHYSICS},
Address = {2 HUNTINGTON QUADRANGLE, STE 1NO1, MELVILLE, NY 11747-4501 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Frank, A (Corresponding Author), Univ Nacl Autonoma Mexico, Inst Ciencias Nucl, AP 70-543, Mexico City 04510, DF, Mexico.
   Frank, A.; Lopez Vieyra, J. C.; Barea, J.; Hirsch, J. G., Univ Nacl Autonoma Mexico, Inst Ciencias Nucl, AP 70-543, Mexico City 04510, DF, Mexico.
