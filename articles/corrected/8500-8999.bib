@article{ WOS:000243398700008,
Author = {Gadomski, A. and Dressler, M. and Santamaria-Holek, I. and Rubi, J. M.},
Title = {Formation of soft material in terms of a coupled matter
   migration-and-relaxation picture: a synchronous mode},
Journal = {MATERIALS SCIENCE-POLAND},
