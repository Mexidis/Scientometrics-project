@article{ WOS:000233977400012,
Author = {Gordillo, MM and de Luna, E},
Title = {New species of Croton (Euphorbiaceae) in Brazil},
Journal = {NOVON},
Year = {2005},
Volume = {15},
Number = {4},
Pages = {568-571},
Abstract = {Croton longibracteatus (Euphorbiaceae), a new species from Brazil, is
   described and illustrated. It belongs to Croton sect. Barhamia
   (Klotzsch) Baillon and appears similar to C. muscicapa Muller
   Argoviensis, but differs from the latter by presenting well-developed
   stipules, larger bracteoles, large and accrescent pistillate sepals, and
   exserted stamens. A dichotomous key for distinguishing both taxa and an
   illustration of the new species are included.},
Publisher = {MISSOURI BOTANICAL GARDEN},
Address = {4344 Shaw Blvd, ST LOUIS, MO 63110 USA},
