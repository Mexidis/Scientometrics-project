@article{ WOS:000250800100015,
Author = {Orozco, S. and Ortiz, M. A. and Mendez-Moreno, R. M. and Moreno, M.},
Title = {Influence of the charge concentration on the density of states in a
   two-dimensional superconducting system},
Journal = {APPLIED SURFACE SCIENCE},
