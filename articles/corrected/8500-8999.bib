Journal = {ZEITSCHRIFT FUR NATURFORSCHUNG SECTION B-A JOURNAL OF CHEMICAL SCIENCES},
Year = {2005},
Volume = {60},
Number = {5},
Pages = {548-554},
Month = {MAY},
Abstract = {The known nor-diterpene (16R)-ent-17-hydroxy-19-nor-kaur-4-en-3-one and
   the new nor-diterpene (16R)-ent-19-nor-kaur-4-en-3-oxo-17-oic acid were
   obtained as a crystalline mixture from roots of C. ghiesbregthiana.
   Their structures were deduced by spectroscopic means and confirmed by a
   X-ray diffraction study of the crystalline mixture. Additionally,
   ursolic and betulinic acids, skimmin, and sucrose were isolated. This is
   the first chemical study of a member of the Coutaportla genus.},
