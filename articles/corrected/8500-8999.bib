@article{ WOS:000224909400008,
Author = {Pardo, A and Selman, M},
Title = {MMP-1: the elder of the family},
Journal = {INTERNATIONAL JOURNAL OF BIOCHEMISTRY \& CELL BIOLOGY},
Year = {2005},
Volume = {37},
Number = {2},
Pages = {283-288},
Month = {FEB},
Abstract = {The matrix metalloproteinases (MMPs) area family of zinc-containing
   endopeptidases that play a key role in both physiological and
   pathological tissue remodeling. Human fibroblast collagenase (MMP-1) was
   the first vertebrate collagenase purified as a protein and cloned as a
   cDNA, and is considered the prototype for all the interstitial
   collagenases. It is synthesized as a zymogen where N-terminal residues
   are removed by proteolysis and shares with other MMPs a catalytic domain
   and a carboxy terminal domain with sequence similarity to hemopexin.
   Importantly, MMP-1 should be considered a multifunctional molecule since
   it participates not only in the turnover of collagen fibrils in the
   extracellular space but also in the cleavage of a number of non-matrix
   substrates and cell surface molecules suggesting a role in the
   regulation of cellular behaviour. Furthermore, an extensive body of
   evidence indicates that MMP-1 plays an important role in diverse
   physiologic processes such as development, tissue morphogenesis, and
   wound repair. Likewise, it seems to be implicated in a variety of human
   diseases including cancer, rheumatoid arthritis, pulmonary emphysema and
   fibrotic disorders, suggesting that its inhibition or stimulation may
   open therapeutic avenues. (C) 2004 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Pardo, A (Corresponding Author), Univ Nacl Autonoma Mexico, Fac Ciencias, Apartado Postal 21-630, Mexico City 04000, DF, Mexico.
   Univ Nacl Autonoma Mexico, Fac Ciencias, Mexico City 04000, DF, Mexico.
   Inst Nacl Enfermedades Resp, Mexico City 04000, DF, Mexico.},
DOI = {10.1016/j.biocel.2004.06.017},
ISSN = {1357-2725},
EISSN = {1878-5875},
Keywords = {fibrosis; collagenase; matrix metalloproteinases; cancer},
Keywords-Plus = {HUMAN FIBROBLAST COLLAGENASE; C-TERMINAL DOMAIN; MATRIX
