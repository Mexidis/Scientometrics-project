@article{ WOS:000255507200002,
Author = {Palacios-Vargas, Jose G. and Benito, Jose Carlos Simon},
Title = {A new genus and three new species of Neanuridae (Collembola) from North
   America},
Journal = {JOURNAL OF CAVE AND KARST STUDIES},
Year = {2007},
Volume = {69},
Number = {3},
Pages = {318-325},
Month = {DEC},
Abstract = {Speleonura n. g. (Neanurinae) and the type species S. kenchristianseni
   n. sp., are described and illustrated from Porter's Cave, Bath County,
   Virginia. The new genus is characterized by the lack of eyes and the
   presence of well developed tubercles on the head and body, it is similar
   to Paleonura but the shape and disposition of the tubercles
   differentiate the new genus from others Neanurinae. The other two
   species described are Paleonura petebellingeri n. sp. (Neanurinae) from
   Skyline Caverns, Warren County, Virginia, similar to Paleonura anops
   (Christiansen \& Bellinger, 1980) but they differ in the chaetotaxy on
   abdominal segments, and Morulina stevehopkini n. sp. (Morulininae) from
   litter of Mitchell County, North Carolina, which is easy to distinguish
   from other members of the genus because of its strong hypertrichosis.},
