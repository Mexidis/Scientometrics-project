@article{ WOS:000228871500006,
Author = {Yépez, E and Soto, JR and Castro, JJ and Calles, A},
Title = {A simple algorithm for the group theoretical classification of quantum
   states II. The case of molecular electronic states},
Journal = {APPLIED MATHEMATICS AND COMPUTATION},
Year = {2005},
Volume = {164},
Number = {3},
Pages = {719-729},
Month = {MAY 25},
Abstract = {This paper presents an extension of an algorithm recently published
   {[}Appl. Math. Comput. 133 (2002) 119] for the group theoretical
   classification of quantum states for molecular systems. In the original
   paper it was shown how this algorithm Could be used to classify
   vibrational states. Here we show how to perforin the classification of
   electronic states and discussed the advantage of using this technique
   over the traditional methods. It consists in finding the minimal set of
   symmetry operations needed to identify unequivocally the symmetry for
   each state and a direct calculation of the character of the
   representation expanded by the vector state. In order to illustrate the
   application of our method we show the classification of the electronic
   states for two different cluster systems of symmetries D-4h and I-h. (c)
   2004 Elsevier Inc. All rights reserved.},
