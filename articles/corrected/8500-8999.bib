@inproceedings{ WOS:000250828000016,
Author = {Horie, S. and Suzuki, A. and Fujita, S. and Peerzada, L. and Godoy,
   Salvador and Olvera, N.},
Editor = {Fujita, S and Obata, T and Suzuki, A},
Title = {Theory of the Shubnikov-de Haas oscillations in GaAs/AlGaAs},
Booktitle = {STATISTICAL AND CONDENSED MATTER PHYSICS: OVER THE HORIZON},
Year = {2007},
Pages = {223+},
Note = {10th International Workshop on Similarity in Diversity (SiD 10), Tokyo,
   JAPAN, SEP 07-09, 2005},
Abstract = {A quantum theory is developed for the Shubnikov-de Haas oscillation in
   GaAs/AlGaAs. The envelope of the oscillation for the magnetoresistance
   is shown to be proportional to {[}sinh(2 pi M-2{*} k(B)T/heB)](-1),
   where M{*} is the carrier mass. Comparison between theory and experiment
   directly gives the M{*}-value: M{*} = 0.30 m, which is 4.5 times the
   cyclotron mass m{*} = 0.067 m. The carriers are electrons, each with two
   flux quanta. The theory avoids the use of the Dingle temperature arising
   from the ``Landau level damping{''}. The susceptibility is an
   equilibrium property which must be calculated without introducing the
