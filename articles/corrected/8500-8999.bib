   Inst Nacl Ciencias Med \& Nutr Salvador Zubiran, Dept Biol Reproducc, Mexico City 14000, DF, Mexico.},
DOI = {10.1002/jez.a.98},
ISSN = {2471-5638},
EISSN = {2471-5646},
