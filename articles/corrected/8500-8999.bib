Title = {Comparison of the performance of seven classifiers as effective decision
   support tools for the cytodiagnosis of breast cancer:: A case study},
Booktitle = {ANALYSIS AND DESIGN OF INTELLIGENT SYSTEMS USING SOFT COMPUTING
   TECHNIQUES},
