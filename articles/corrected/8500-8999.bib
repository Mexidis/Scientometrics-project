Volume = {212},
Number = {1},
Pages = {228-243},
Month = {JAN},
Abstract = {We define derived equivalent invariants for gentle algebras, constructed
   in an easy combinatorial way from the quiver with relations defining
   these algebras. Our invariants consist of pairs of natural numbers and
   contain important information about the algebra and the structure of the
   stable Auslander-Reiten quiver of its repetitive algebra. As a
   by-product we obtain that the number of arrows of the quiver of a gentle
   algebra is invariant under derived equivalence. Finally, our invariants
   separate the derived equivalence classes of gentle algebras with at most
   one cycle. (C) 2007 Elsevier B.V. All rights reserved.},
