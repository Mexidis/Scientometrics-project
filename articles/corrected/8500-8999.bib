@article{ WOS:000248784100050,
Author = {Fuentes, B. E. and Tejeda, A. and Martinez, H.},
Title = {Dissociative capture and collision-induced dissociation of
   H2+ in SF6},
Journal = {NUCLEAR INSTRUMENTS \& METHODS IN PHYSICS RESEARCH SECTION B-BEAM
   INTERACTIONS WITH MATERIALS AND ATOMS},
Year = {2007},
Volume = {261},
Number = {1-2},
