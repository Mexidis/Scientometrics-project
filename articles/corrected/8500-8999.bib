@article{ WOS:000230153200001,
Author = {Canseco-Márquez, L and Gutiérrez-Mayén, G},
Title = {New species of Pseudoeurycea (Caudata: Plethodontidae) from the
   mountains of the Mixteca region of Oaxaca, Mexico},
Journal = {JOURNAL OF HERPETOLOGY},
Year = {2005},
Volume = {39},
Number = {2},
Pages = {181-185},
Month = {JUN},
Abstract = {A new terrestrial species of Pseudoeurycea is described from the
   mountains of the Mixteca region of Oaxaca. Compared with other members
   of the genus, the new species is relatively slender and short-legged.
   The background color of the dorsum of this species is dark gray with
   reddish-brown spots. The Mixteca region of Oaxaca has long been poorly
   explored biologically, and the knowledge of the distribution of its
   salamanders is scarce. Herein, we present new information regarding
   salamanders species in this region.},
