@article{ WOS:000233976400011,
Author = {Martínez-Pérez, F and Zinker, S and Aguilar, G and Valdés, J and
   Aréchiga, H},
Title = {Circadian oscillations of RPCH gene expression in the eyestalk of the
   crayfish Cherax quadricarinatus},
Journal = {PEPTIDES},
Year = {2005},
Volume = {26},
Number = {12},
Pages = {2434-2444},
Month = {DEC},
Abstract = {The RPCH and beta-actin cDNAs from the crayfish Cherax quadricarinatus
   were amplified, cloned and sequenced. The primary structure sequences of
   these cDNAs were compared to other members of the AKH/RPCH family.
   Fluctuations in the amount of the C quadricarinatus RPCH and beta-actin
   mRNAs, as cDNAs, were quantified every 3 h by RT-PCR. Single cosinor
   analysis supports the notion of beta-actin and RPCH mRNA circadian
   behavior in animals subjected to 12 h: 12 h light/dark regimes. In
   constant darkness RPCH mRNA concentration changes to ultradian cycles.
