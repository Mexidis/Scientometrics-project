@article{ WOS:000251601600053,
Author = {Barea, J. and Frank, A. and Hirsch, J. G. and Van Isacker, P. and
   Velazquez, V.},
Title = {Masses of atomic nuclei far from stability},
Journal = {EUROPEAN PHYSICAL JOURNAL-SPECIAL TOPICS},
Year = {2007},
Volume = {150},
Pages = {189-192},
Month = {NOV},
Note = {7th International Conference on Radioactive Nuclear Beams, Cortina,
   ITALY, JUL 02-07, 2006},
Organization = {Ist Nazl Fis Nucl; Padova Lab Nazl Sud; Lab Nazl Legnaro},
Abstract = {It is shown that a new way of applying a set of nuclear-mass relations
   among neighbouring nuclei, known as the Garvey-Kelson (GK) relations,
   holds exceptionally well for all currently measured masses. It is then
   demonstrated that these relationships are not adequately fulfilled for
   the best-known procedures to predict unknown masses. This suggests that
   these models may be optimized by constraining them to satisfy the
   (generalized) GK equations.},
