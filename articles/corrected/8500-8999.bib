Year = {2005},
Volume = {118},
Number = {3},
Pages = {605-618},
Month = {SEP 2},
Abstract = {A new mouse species in the genus Habromys, H. schmidlyi, from the
   Mexican states of Guerrero and Estado de Mexico, is described. Closest
   affinities of the new species are with H. simulatus and H. chinanteco,
   although strong morphometric differentiation and ample geographic
   isolation are evident. Penis structure and the basic karyotype of the
   new species are described.},
