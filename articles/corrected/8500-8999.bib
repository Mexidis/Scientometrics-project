@article{ WOS:000209821000008,
Author = {Raggi, Francisco and Rios, Jose and Rincon, Hugo and Fernandez-Alonso,
   Rogelio and Signoret, Carlos},
Title = {PRIME AND IRREDUCIBLE PRERADICALS},
Journal = {JOURNAL OF ALGEBRA AND ITS APPLICATIONS},
