Year = {2007},
Volume = {43},
Number = {1},
Pages = {217-224},
Month = {APR},
Abstract = {While performing uvby-beta photoelectric photometry of some RR Lyrae
   stars in Bootes, acquired in 2005 at the Observatorio Astronomico
   Nacional, Mexico, we also observed several standard stars, HD115520
   among them. After the reduction this star showed indications of
   variability and a compilation of all the data of this star reinforced
   this conclusion. In view of this, a new observing run was carried out in
   2006 during which we were able to demonstrate its variability. We
   present here the data we acquired as well as some conclusions on its
   nature as a delta Scuti star.},
