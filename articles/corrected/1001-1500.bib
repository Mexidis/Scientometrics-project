@article{ WOS:000178425400003,
Author = {Godoy, S},
Title = {Classical Landauer coefficients for neutrons and photons in amorphous
   materials},
Journal = {REVISTA MEXICANA DE FISICA},
Year = {2002},
Volume = {48},
Number = {1},
Pages = {9-13},
Month = {SEP},
Note = {Conference held in honor of Leopoldo Garcia Colin Scherers 70th
   Birthday, UNIV AUTONOMA METROPOLITANA, IZTAPALAPA, MEXICO, NOV 29-30,
   2000},
Abstract = {We use Boltzmann's transport equation to calculate the 3D version of the
   Landauer equation for incoherent neutrons and photons diffusing in a
   slab of amorphous material. We use the P-1 approximation to calculate
   the multiple-scattering transmission coefficient as a function of the
   diffusion coefficient. The 3D transmission coefficient is, apart from
   numerical coefficients, similar to the 1D case. The result is valid only
   for positions far away from the boundaries and for slabs having a
   thickness much greater than one mean free path.},
