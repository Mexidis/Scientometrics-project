Organization = {Amer Math Soc; Soc Matemat Mexicana},
Abstract = {In this note we prove the next claim: If C is a hereditarily
   decomposable arc-like continuum and f : C --> C is a continuous mapping
   with a periodic point of period 3, then f has positive topological
   entropy.
