@article{ WOS:A1995QL73600220,
Author = {BETANCOURT, I and JIMENEZ, M and ABURTO, S and MARQUINA, V and GOMEZ, R
   and MARQUINA, ML and RIDAURA, R and MIKI, M and VALENZUELA, R},
Title = {NANOCRYSTALLIZATION STUDIES IN CO-RICH AMORPHOUS-ALLOYS},
Journal = {JOURNAL OF MAGNETISM AND MAGNETIC MATERIALS},
Year = {1995},
Volume = {140},
Number = {1},
Pages = {459-460},
Month = {FEB},
Note = {International Conference on Magnetism - ICM 94 (13th IUPAP Triennial
   Conference on Magnetism), WARSAW, POLAND, AUG 22-26, 1994},
Organization = {INT UNION PURE \& APPL PHYS},
Abstract = {Nanocrystallization from Vitrovac(R) amorphous ribbons was studied by
   Mossbauer spectroscopy, transmission electron microscopy and
   differential scanning calorimetry. Results are interpreted in terms of a
   crystallization of Co, Co2B, and Co3B, leading to an increase in Fe
   content in the residual amorphous phase, which in turn results in an
