Year = {1997},
Volume = {265},
Number = {3-5},
Pages = {434-444},
Month = {FEB 7},
Abstract = {The hydrodynamic interactions between any number of spheres immersed in
   a viscous fluid that has an internal structure have been studied. These
   effects are due to the internal angular momentum of the fluid molecules.
   The scheme proposed by Mazur and van Saarloos has been generalized, and
   general expressions for the translational, rotational and cross
   mobilities for the case under study have been obtained. The dependence
   on the distances of these mobilities is presented up to an order of
   R(-7) and the spin dependences of their leading terms are explicitly
   given.},
