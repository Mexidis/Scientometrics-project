@article{ WOS:A1992JX47400025,
Author = {OROZCO, S and ORTIZ, MA and RAMIREZ, A and MENDEZMORENO, RM},
Title = {DENSITY OF STATES FOR A FERMION GAS IN THE DEFORMABLE JELLIUM MODEL},
Journal = {REVISTA MEXICANA DE FISICA},
Year = {1992},
Volume = {38},
Number = {1},
Pages = {221-226},
Month = {SEP},
Note = {INTERNATIONAL COLLOQUIUM ON TOPICS IN PHYSICS AND CHEMISTRY, IN HONOUR
   OF PROFESSOR DR A MONDRAGON BALLESTEROS ON THE OCCASION OF HIS 35 YEARS
   OF ACADEMIC LABOUR, UNIV NACL AUTONOMA MEXICO, MEXICO, AUG 15-16, 1991},
Abstract = {The density of states for a fermion gas in the deformable jellium model
   is evaluated. A screened Coulombic potential is used. The state function
   is proposed as a cosine series which presents periodic charge density
   along one axis. Calculations in terms of the polar angle are done in
