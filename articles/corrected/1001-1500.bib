Note = {International Conference on Topology and Its Applications, YOKOHAMA,
   JAPAN, AUG 23-27, 1999},
Abstract = {We characterize the given extent in finite powers of X in terms of the
   topology of C-p(X). It is shown that many properties of C-p(X) are
   determined by dense subsets of C-p(X). We introduce the density
