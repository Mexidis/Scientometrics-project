@article{ WOS:A1993LV67100001,
Author = {FLORES, CG and DEJIMENEZ, ES and GUZMAN, JM},
Title = {INDUCTION AND MAINTENANCE OF EMBRYOGENIC CULTURES OF ZEA-MAYS L
   (POACEAE)},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1993},
Volume = {54},
Number = {1},
Pages = {1-6},
Abstract = {Formation of callus from developed corn embryos of Zea mays L, var
   VS-22, was achieved. From these tissues the process of somatic
   embryogenesis was induced. Cultures obtained under in vitro conditions
   were treated with Ag NO3 at high sucrose concentrations; this led to
   embryogenic callus formation. Calli were transferred to a medium free of
   phytoregulators to further develop somatic embryos. Embryos at globular
   stage were identified through histological analysis.},
