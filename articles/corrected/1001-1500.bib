@article{ WOS:000174407900004,
Author = {Kuelbs, J and Meda, A},
Title = {Rates of convergence for the Nummelin conditional weak law of large
   numbers},
Journal = {STOCHASTIC PROCESSES AND THEIR APPLICATIONS},
