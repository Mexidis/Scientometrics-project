Pages = {273-278},
Month = {SEP},
Abstract = {Techniques for impregnation with ammoniacal silver carbonate provide
   valuable information on all types of tissue; however, the time
   investment required to impregnate a few sections has limited their
   application. We have shortened the impregnation times by using
   microwaves in techniques for reticular fibers, astrocytes, nerve fibers
   and chromaffin cells. The results were satisfactory with markedly
   reduced impregnation time and elimination of nonspecific silver
   deposits.},
