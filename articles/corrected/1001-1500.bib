@article{ WOS:A1993KM62300016,
Author = {GOLDSTEIN, P and DELCASTILLO, LF and GARCIACOLIN, LS},
Title = {DETERMINATION OF THE ISOENTROPIC TEMPERATURE IN THE GLASS-TRANSITION},
Journal = {MACROMOLECULES},
Year = {1993},
Volume = {26},
Number = {4},
Pages = {655-658},
Month = {FEB 15},
Abstract = {The form for the specific heat proposed by Di Marzio and Dowell based on
   the lattice model of Gibbs-Di Marzio for the glass transition of
   polymeric substances is used to find an expression for the logarithmic
   shift factor which through a comparison with the empirical relation of
   Williams-Landel-Ferry enables us to find a value for the isoentropic
   temperature for which the configurational entropy of the system
   vanishes.},
Publisher = {AMER CHEMICAL SOC},
Address = {1155 16TH ST, NW, WASHINGTON, DC 20036},
Type = {Article},
