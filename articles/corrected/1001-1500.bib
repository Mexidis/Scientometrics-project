@article{ WOS:A1991GX30800069,
Author = {CALLES, A and CABRERA, A and RAMOSGOMEZ, F and YEPEZ, E and CASTRO, JJ
   and SALCIDO, A},
Title = {JAHN-TELLER EFFECT IN THE LA-SR-CU-O SUPERCONDUCTOR},
Journal = {PHYSICA C},
