@article{ WOS:A1995TN13700012,
Author = {HernandezBecerril, DU and Pena, MIT},
Title = {Planktonic diatoms from the Gulf of California and coasts off Baja
   California: Species of the genus Thalassiosira},
Journal = {BOTANICA MARINA},
Year = {1995},
Volume = {38},
Number = {6},
Pages = {543-555},
Month = {NOV},
Abstract = {Net phytoplankton samples from the Gulf of California and coasts of Baja
   California were analyzed, and observations are given on the species
   encountered of the diatom genus Thalassiosira. The material was studied
   by light and electron microscopy. Nineteen taxa (18 species and one
   variety) were identified, with two tentative identifications.
   Morphological details are provided for most of the species. Four species
   are new records for the Pacific Mexican waters (including the Gulf of
   California). This appears to be the first record of the species T.
   exigua, since its original description. Some species are fairly rare in
   tropical regions; the most widely distributed species in the areas
   studied was T. eccentrica. Fairly small species, mainly belonging to the
   nanoplankton, had not been noticed in the study area as perhaps they
   were overlooked or misidentified in previous works.},
