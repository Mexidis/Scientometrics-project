@article{ WOS:A1993LU72200081,
Author = {GOLDSTEIN, P and GARCIACOLIN, LS},
Title = {A THERMODYNAMIC BASIS FOR TRANSPORT PHENOMENA IN VISCOELASTIC FLUIDS},
Journal = {JOURNAL OF CHEMICAL PHYSICS},
Year = {1993},
Volume = {99},
Number = {5},
Pages = {3913-3918},
Month = {SEP 1},
Abstract = {A calculation for the longitudinal stress modulus in a viscoelastic
   medium is obtained introducing the stress tensor, its trace and the heat
   flux as additional variables, without requiring the specific form of the
   dynamic structure factor of the system. By using extended irreversible
   thermodynamics, we derive the time evolution equations for the state
   variables. These equations are used to obtain general wave vector and
   frequency dependent expressions for measurable properties of the system.
   We recover for a particular case results that have been derived
   previously in the literature.},
