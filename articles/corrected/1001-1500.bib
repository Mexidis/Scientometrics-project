@article{ WOS:A1993MP91600002,
Author = {AGUILAR, R and ESQUINCA, AG and AMADOR, MCP and JIMENEZ, FG},
Title = {REGULATION OF HYDROLYSIS OF KAURANOIC GLUCOSIDES AND ISOLATION OF THEIR
   AGLUCONES FROM EMBRYOS OF TURBINA-CORYMBOSA (L) RAF (CONVOLVULACEAE)},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1993},
Volume = {54},
Number = {2},
Pages = {87-90},
Abstract = {The kauranoic glucosides of Turbina corymbosa (L.) Raf., located in the
   seed embryo, are not hydrolyzed if they are incubated in a 0.1M solution
   of galactose and mannose, thus indicating that these sugars regulate the
   hydrolysis of the glucosides. On the other hand, if the embryos are
   incubated in water, the glucosides are hydrolyzed; their aglycones, the
   diterpenic alcohols 6,16,17- and 16,17,19-kaurantriol, were isolated
   from these embryos and identified by their melting points and proton
   magnetic resonance spectra of their acetates.},
