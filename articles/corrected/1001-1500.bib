Organization = {AMER NUCL SOC},
Abstract = {This research addresses itself to the study of the mechanism of the
   acetic acid decarboxylation in Na-Montmorillonite exposed to ionizing
   radiation. The results obtained indicated that the decarboxylation
   reaction is enhanced several times by the irradiation. This behavior is
   probably due to an oxidation reaction at the edges of the clay. Also it
   is by energy transfer from the clay to adsorbed molecules by an
   interaction of non-equilibrium charge carriers with the adsorbed
   molecules.},
