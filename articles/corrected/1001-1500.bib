   and RIDAURA, R and ESCUDERO, R and MORALES, F},
Title = {MOSSBAUER STUDIES ON MAGNETIC AND ELECTRICAL-PROPERTIES OF
   LA1.85SR0.15CUO.99FE0.01O4-DELTA},
Journal = {PHYSICA C},
Year = {1994},
Volume = {235},
Number = {3},
Pages = {1611-1612},
Month = {DEC},
Abstract = {The local magnetic and electric fields in the Cu-O planes of Fe doped
   and Sr-doped La2Cu1O4 superconductor can be sensed, using Mossbauer
   spectroscopy, if a small fraction of the Cu atoms is substituted for Fe
   atoms. In this work we report the results of such substitution in the
   superconducting La1.85Sr0.15Cu0.99Fe0.01O4-delta system. Mossbauer
   spectra were obtained at different temperatures ranging from 13 to 300
   K. The observed spectra consist of two quadrupole doublets, associates
   with two inequivalent sites. One site may be associate with a narrow
   range of x centered at x = 0.15 and the other site with x = 0.},
