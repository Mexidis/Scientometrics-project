@article{ WOS:000243047800003,
Author = {Delaye, Luis and Becerra, Arturo and Orgel, Leslie and Lazcano, Antonio},
Title = {Molecular evolution of peptide methionine sulfoxide reductases (MsrA and
   MsrB): On the early development of a mechanism that protects against
   oxidative damage},
Journal = {JOURNAL OF MOLECULAR EVOLUTION},
Year = {2007},
Volume = {64},
Number = {1},
Pages = {15-32},
Month = {JAN},
Abstract = {Methionine sulfoxide reductases, enzymes that reverse the oxidation of
   methionine residues, have been described in a wide range of species. The
   reduction of the diastereoisomers of oxidized methionine is catalyzed by
   two different monomeric methionine sulfoxide reductases (MsrA and MsrB)
   and is best understood as an evolutionary response to high levels of
   oxygen either in the Earth's atmosphere or possibly in more localized
   environments. Phylogenetic analyses of these proteins suggest that their
   distribution is the outcome of a complex history including many paralogy
   and lateral gene transfer events.},
