@inproceedings{ WOS:A1995BF02F00008,
Author = {Lazcano, A},
Editor = {Moran, F and Moreno, A and Merelo, JJ and Chacon, P},
Title = {Prebiotic chemistry, artificial life, and complexity theory: What do
   they tell us about the origin of biological systems?},
Booktitle = {ADVANCES IN ARTIFICIAL LIFE},
Series = {LECTURE NOTES IN ARTIFICIAL INTELLIGENCE},
Year = {1995},
Volume = {929},
Pages = {105-115},
Note = {3rd European Conference on Artificial Life, GRANADA, SPAIN, JUN 04-06,
   1995},
Organization = {ISSOL; Spanish RIG IEEE Neural Networks Council; Silicon Graph Spain;
   IBM Spain; Parque Cienc Granada},
Abstract = {Although the origin of self-sustaining, autoreplicating systems capable
   of undergoing Darwinian evolution is still unknown, a research program
   based on the hypothesis of chemical and precellular evolution has
   provided a framework within which the abiotic synthesis of biochemical
   monomers and membrane components, the experimental study of replicative
   systems, and the interactions between different ribozymes and a
   potentially wide range of substrates including amino acids, can be
   incorporated into a coherent historical narrative of evolutionary
   events. The significance of mathematical models and computer-based
   simulations of autocatalytic cycles based on complexity theory to the
   study of the origin of life will be considerable enhanced when
   experimental evidence supporting them becomes available.},
