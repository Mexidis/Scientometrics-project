@article{ WOS:A1992GZ91300078,
Author = {BARRERA, RG and NOGUEZ, C and ANDA, EV},
Title = {A NEW DIAGRAMMATIC SUMMATION FOR THE EFFECTIVE DIELECTRIC RESPONSE OF
   COMPOSITES},
