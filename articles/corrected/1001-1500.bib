@article{ WOS:A1994PK64800003,
Author = {JIMENEZGARCIA, LF and SEGURAVALDEZ, MD and OCHS, RL and ROTHBLUM, LI and
   HANNAN, R and SPECTOR, DL},
Title = {NUCLEOLOGENESIS - U3 SNRNA-CONTAINING PRENUCLEOLAR BODIES MOVE TO SITES
   OF ACTIVE PRE-RIBOSOMAL-RNA TRANSCRIPTION AFTER MITOSIS},
Journal = {MOLECULAR BIOLOGY OF THE CELL},
Year = {1994},
Volume = {5},
Number = {9},
Pages = {955-966},
Month = {SEP},
Abstract = {We have investigated the distribution of U3 snRNA and rRNA in HeLa cells
   and normal rat kidney cells during interphase and mitosis. U3 snRNA,
   known to be involved in pre-rRNA processing, was detected in nucleoli
   and coiled bodies during interphase, whereas rRNA was distributed in the
   nucleoli and throughout the cytoplasm. By comparison, ribosomal protein
   S6 was detected in nucleoli, coiled bodies, and in the cytoplasm. During
   nucleologenesis, pre-rRNA was observed in newly forming nucleoli during
   late telophase but not in prenucleolar bodies (PNBs), whereas U3 snRNA
   was detected in forming nucleoli and PNBs. Similar findings to those
   reported here for the localization of U3 snRNA have been reported
   previously for the U3 small nuclear ribonucleoprotein fibrillarin. These
   results suggest that components involved in pre-rRNA processing localize
   to discrete PNBs at the end of mitosis. The nucleolus is formed at
   specific telophase domains (nucleolar organizing regions) and the PNBs,
   containing factors essential for pre-rRNA processing, are recruited to
   these sites of rRNA transcription and processing.},
