@article{ WOS:A1993MW78700003,
Author = {VAZQUEZNIN, GH and ECHEVERRIA, OM and ROUELLEROSSIER, VB and FAKAN, S},
Title = {A NEW-TYPE OF RIBONUCLEOPROTEIN CONSTITUENT OF THE POLYTENE NUCLEUS OF
   THE SALIVARY-GLANDS OF CHIRONOMUS-THUMMI AND CH-TENTANS},
Journal = {CHROMOSOMA},
Year = {1993},
Volume = {102},
Number = {10},
Pages = {693-699},
Month = {DEC},
Abstract = {Using electron spectroscopic imaging, a new type of small granular
   structural constituent has been observed in the extrachromosomal zone of
   the polytene nucleus of the salivary gland cells of Chironomus thummi
   and Chironomus tentans. These granules appear isolated or in small
   clumps and are often seen to be connected with surrounding thin fibrils.
   They are stained by the EDTA procedure, which is preferential for
   nuclear ribonucleoprotein (RNP) constituents, and by the bismuth
   oxynitrate method for visualizing phosphorylated compounds. The granules
   are 15-23 nm in diameter and are digested by prolonged post-embedding
   RNAse hydrolysis. These structural elements contain the highest
   concentration of phosphorus in the interchromosomal space as revealed by
   electron energy loss spectroscopy. The small granules exhibit several
   morphological and cytochemical features in common with interchromatin
   granules, but they are not labeled with antibodies directed against
   extranucleolar small nuclear RNPs (snRNPs), as are interchromatin
   granules.},
Publisher = {SPRINGER},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
