@article{ WOS:A1995TK43800029,
Author = {Goldstein, P and GarciaColin, LS and Pina, E},
Title = {Irreversible thermodynamics of a binary mixture of dissimilar hard
   spheres},
Journal = {PHYSICA A},
Year = {1995},
Volume = {222},
Number = {1-4},
Pages = {411-436},
Month = {DEC 15},
Abstract = {Within the framework of the Standard Enskog Theory, we prove the
   consistency of the kinetic theory of a binary mixture of dissimilar hard
   spheres with Linear Irreversible Thermodynamics. The thermodynamic
   fluxes and forces arise from the entropy production which may be derived
   from a proposed kinetic entropy function. A straightforward proof of
   Onsager's reciprocity theorem is presented.},
