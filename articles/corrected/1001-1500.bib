@article{ WOS:000171172900008,
Author = {Márquez, J},
Title = {Systematic review of Heterolinus Sharp (Coleoptera:
   Staphylinidae: Xantholinini)},
Journal = {COLEOPTERISTS BULLETIN},
Year = {2001},
Volume = {55},
Number = {3},
Pages = {317-329},
Month = {SEP},
Abstract = {The genus Heterolinus Sharp, 1885 is revised, with generic
   redescription, description of a new species, a key to the species,
   remarks, illustrations, and a distributional map. Heterolinus distinctus
   Bernhauer, 1905 is a junior synonym of H. xanthogaster (Solsky 1875) new
   combination. Lectotypes are designated for Xantholinus puncticeps
   Guerin-Meneville, 1844 and Xantholinus xanthogaster Solsky, 1875.
   Heterolinus puncticeps is distributed in Colombia and Ecuador, H.
   xanthogaster in Peru and Bolivia, and H. basiniger new species in Costa
   Rica, Colombia and Ecuador. According to a cladistic analysis based on
   47 transformation series from external morphology and male genitalia,
   Heterolinus is a monophyletic group, and is the sister group of
   Ehomalolinus plus Homalolinus. Heterolinus puncticeps is the sister
   species of H. xanthogaster and H. basiniger is the most plesiomorphic
   species of the genus.},
