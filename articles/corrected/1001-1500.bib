@inproceedings{ WOS:A1994BC58D00047,
Author = {LAZCANO, A and DIAZVILLAGOMEZ, E and MILLS, T and ORO, J},
Editor = {Greenberg, JM and Oro, J and Brack, A and Devincenzi, DL and Banin, A and Friedmann, EI and Rummel, JD and Raulin, F and McKay, CP and Baltscheffsky, H and Schwartz, AW and Schidlowski, M and Roessler, K},
Title = {ON THE LEVELS OF ENZYMATIC SUBSTRATE-SPECIFICITY - IMPLICATIONS FOR THE
   EARLY EVOLUTION OF METABOLIC PATHWAYS},
Booktitle = {LIFE SCIENCES AND SPACE RESEARCH XXV (4): PLANETARY BIOLOGY AND ORIGINS
   OF LIFE},
Series = {ADVANCES IN SPACE RESEARCH-SERIES},
Year = {1994},
Volume = {15},
Number = {3},
Pages = {345-356},
Note = {Topical Meeting of the COSPAR Interdisciplinary Scientific Commission F
   (Meeting F3) of the COSPAR 29th Plenary Meeting, WASHINGTON, D.C., AUG
   28-SEP 05, 1992},
Organization = {COMM SPACE RES; INT ACAD ASTRON; INT ASTRON FEDERAT; NASA; EUROPEAN
   SPACE AGCY; DEUT AGENTUR RAUMFAHRTANGELEGENHEITEN GMBH; INT SOC STUDY
   ORIGIN LIFE},
Abstract = {The most frequently invoked explanation for the origin of metabolic
   pathways is the retrograde evolution hypothesis. In contrast, according
   to the so-called `'patchwork'' theory, metabolism evolved by the
   recruitment of relatively inefficient small enzymes of broad specificity
   that could react with a wide range of chemically related substrates. In
   this paper it is argued that both sequence comparisons and experimental
   results on enzyme substrate specificity support the patchwork assembly
   theory. The available evidence supports previous suggestions that gene
   duplication events followed by a gradual neoDarwinian accumulation of
   mutations and other minute genetic changes lead to the narrowing and
   modification of enzyme function in at least some primordial metabolic
   pathways.},
