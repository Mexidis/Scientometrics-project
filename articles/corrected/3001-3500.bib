@article{ WOS:000919223500001,
Author = {Rocha-Ortega, Maya and Rodriguez, Pilar and Nava-Bolanos, Angela and
   Cordoba-Aguilar, Alex},
Title = {New insights into the geographic patterns of functional role and
   taxonomic richness of ants from Mexico},
Journal = {JOURNAL OF INSECT CONSERVATION},
