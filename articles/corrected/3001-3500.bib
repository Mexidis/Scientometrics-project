@article{ WOS:001150646300002,
Author = {de Luna, Manuel and Garcia-Barrios, Roberto and Cuellar-Rodriguez,
   Gerardo and Lopez-Mora, Ulises},
Title = {A new record of a winged stick insect (Phasmatodea) from Mexico, with a
   checklist and key to the species of the family Pseudophasmatidae from
   continental North America},
Journal = {JOURNAL OF ORTHOPTERA RESEARCH},
Year = {2023},
Volume = {32},
Number = {2},
Pages = {171-176},
Month = {SEP 21},
Abstract = {The winged stick insect Metriophasma iphicles (Redtenbacher, 1906)
   (Phasmatodea: Pseudophasmatidae) is recorded for the first time from
   Mexico (state of Veracruz), making this the northernmost record of both
   the species and genus. A checklist of species in the family
   Pseudophasmatidae from Mexico and the USA is presented, and a key to the
   species listed is proposed. With the current record, the number of
   continental North American species of Phasmatodea increases to 108, and
   the number of genera in the region increases to 23.},
