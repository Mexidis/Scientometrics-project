Author = {Florez-Gomez, Nathalia and Ayala, Ricardo and Hinojosa-Diaz, Ismael and
   Morrone, Juan J.},
Title = {THE NEOTROPICAL SPECIES OF SMALL CARPENTER BEES OF THE SUBGENUS
   CERATINA (ZADONTOMERUS) ASHMEAD, 1899 (HYMENOPTERA: APIDAE)},
Journal = {ZOOTAXA},
