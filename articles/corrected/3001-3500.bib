@article{ WOS:001045088800001,
Author = {Gonzalez-Bayona, Francisco and Pardo-Guerra, Sebastian and Rincon-Mejia,
   Hugo Alberto and Zorrilla-Noriega, Manuel Gerardo},
Title = {On torsion theories and open classes of linear modular lattices},
Journal = {COMMUNICATIONS IN ALGEBRA},
Year = {2024},
Volume = {52},
Number = {1},
Pages = {371-391},
Month = {JAN 2},
Abstract = {Given a ring R, a bijection exists between torsion theories and
   idempotent radicals. Further, the class of hereditary torsion theories
   contains the skeleton of the open classes. In this work, we extend the
   notions and main results in R-Mod about torsion classes, torsion-free
   classes, and open classes to the category L-M of linear lattices, whose
   objects are complete modular lattices and whose morphisms are linear
   morphisms.},
