@article{ WOS:000875635800009,
Author = {Madariaga-Mazon, Abraham and Naveja, Jose J. and Becerra, Arturo and
   Alberto Campillo-Balderas, Jose and Hernandez-Morales, Ricardo and
   Jacome, Rodrigo and Lazcano, Antonio and Martinez-Mayorga, Karina},
Title = {Subtle structural differences of nucleotide analogs may impact
   SARS-CoV-2 RNA-dependent RNA polymerase and exoribonuclease activity},
Journal = {COMPUTATIONAL AND STRUCTURAL BIOTECHNOLOGY JOURNAL},
Year = {2022},
Volume = {20},
Pages = {5181-5192},
Abstract = {The rapid spread and public health impact of the novel SARS-CoV-2
   variants that cause COVID-19 con-tinue to produce major global impacts
   and social distress. Several vaccines were developed in record time to
   prevent and limit the spread of the infection, thus playing a pivotal
   role in controlling the pandemic. Although the repurposing of available
   drugs attempts to provide therapies of immediate access against
   COVID-19, there is still a need for developing specific treatments for
   this disease. Remdesivir, molnupi-ravir and Paxlovid remain the only
   evidence-supported antiviral drugs to treat COVID-19 patients, and only
   in severe cases. To contribute on the search of potential Covid-19
   therapeutic agents, we targeted the viral RNA-dependent RNA polymerase
   (RdRp) and the exoribonuclease (ExoN) following two strate-gies. First,
   we modeled and analyzed nucleoside analogs sofosbuvir, remdesivir,
   favipiravir, ribavirin, and molnupiravir at three key binding sites on
   the RdRp-ExoN complex. Second, we curated and virtually screened a
   database containing 517 nucleotide analogs in the same binding sites.
   Finally, we character-ized key interactions and pharmacophoric features
   presumably involved in viral replication halting at multiple sites. Our
   results highlight structural modifications that might lead to more
   potent SARS-CoV-2 inhibitors against an expansive range of variants and
   provide a collection of nucleotide analogs useful for screening
   campaigns.(c) 2022 The Authors. Published by Elsevier B.V. on behalf of
   Research Network of Computational and Structural Biotechnology. This is
   an open access article under the CC BY-NC-ND license
   (http://creative-commons.org/licenses/by-nc-nd/4.0/).},
