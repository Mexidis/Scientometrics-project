@article{ WOS:001024005000006,
Author = {Casas-De La Rosa, J. and Mascarua, A. Tamariz},
Title = {ON SPACES WITH STAR KERNEL MENGER},
Journal = {ACTA MATHEMATICA HUNGARICA},
Year = {2023},
Volume = {170},
Number = {1},
Pages = {379-404},
Month = {JUN},
Abstract = {Given a topological property P, a space X is called star-P if for any
   open cover U of the space X, there exists a set Y subset of X with
   property P such that St(Y, U) = X; the set Y is called a star kernel of
   the cover U. In this paper, we introduce and study spaces with star
   kernel Menger, that is, spaces star determined by Menger spaces, denoted
   by star-S-fin(O, O). Some examples are given to show the relationship
   with some other related properties studied previously, and the behaviour
   of the star-S-fin(O, O) property with respect to subspaces, products,
   continuous images and preimages are investigated. Additionally, some
   comments on the star selection principles theory are given.
   Particularly, some questions posed by Song within this theory are
   addressed. Finally, several new properties are introduced as well as
   some general questions on them are posed.},
