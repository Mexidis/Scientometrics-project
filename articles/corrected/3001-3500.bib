@article{ WOS:000949008500001,
Author = {Castillo, Juan Martin Hernandez and Brito, Bertha Molina and Mercado,
   Jorge Ramon Soto and Santiago, Pedro Francisco},
Title = {Design and theoretical characterization of neomycin-guanine and
   neomycin-thymine using DFT methods},
Journal = {MRS ADVANCES},
Year = {2023},
Volume = {8},
Number = {4, SI},
Pages = {125-130},
Month = {MAY},
Abstract = {Neomycin B is a drug of the bacteriologic category of aminoglycosides,
   built by four sugar rings joined with glycosidic bonds, that recently
   has attracted a lot of attention because its derivatives have shown
   anti-carcinogenic and antiviral properties, in addition to some gene
   therapy applications. Although some derivatives have been synthesized,
   there are no theoretical studies about them. In this work, we carried
   out DFT calculations to predict and study stable neomycin B derivatives,
   obtained by substituting its first ring by Thymine, as done in previous
   experiments, and for Guanine as a theoretical proposal. For the two
   nucleobases, we obtained stable quasi-degenerated structures, pointing
   out that there is equal probability to synthesize their isomers.
   Moreover, we calculated the electrostatic potential surface to elucidate
   the long-range interaction mechanism.},
