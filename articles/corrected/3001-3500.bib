@article{ WOS:000892218500006,
Author = {Palacios-Vargas, Jose G. and Arbea, Javier i.},
Title = {The subfamily Pachyotominae in Mexico (Collembola: Isotomidae) with
   description of a new Pachyotoma species},
Journal = {ZOOTAXA},
Year = {2022},
Volume = {5194},
Number = {2},
Pages = {245-259},
Month = {OCT 5},
Abstract = {Pachyotoma primamexicana sp. nov, from Popocatepetl, Mexico is
   described; it is similar to Pachyotoma alpa (Christiansen \& Bellinger,
   1980) and P. muskegis (Guthrier, 1903). It can be distinguished from all
   other the members of the genus by the small size of PAO (about half the
   size of closest eye) and the formula (2,3,3) of the slightly capitate
   tenent hairs. An identification key for Nearctic Pachyotominae and a
   table with diagnostic morphological characters to the Nearctic species
   of the genus with integument clearly granulated is given. Three new
   records of species from Mexico are listed: Pachyotoma crassicauda
   (Tullberg, 1871), Coloburella octogenaria (Mills \& Schmidt, 1957) and
   Bonetrura boneti (Yosii, 1962). A discussion on the distribution of the
   subfamily Pachyotominae and some notes on the biogeography of the
   subfamily are provided.},
