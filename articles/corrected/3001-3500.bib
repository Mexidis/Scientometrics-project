@article{ WOS:000978649000001,
Author = {Lazarus, Benjamin S. and Luu, Rachel K. and Ruiz-Perez, Samuel and
   Barbosa, Josiane D. V. and Jasiuk, Iwona and Meyers, Marc A.},
Title = {Equine Hoof Wall Deformation: Novel Aspects Revealed},
Journal = {SMALL STRUCTURES},
Year = {2023},
Volume = {4},
Number = {10},
Month = {OCT},
Abstract = {The equine hoof wall has a unique hierarchical structure that allows it
   to survive high-impact scenarios. Previous authors have explored the
   compressive, viscoelastic, and fracture control properties of the hoof
   wall and suggested that this complex structure plays a vital role in the
   hoof's behavior. However, the link between the structure and the
   behavior of the hoof wall has been made primarily with the use of
   post-fracture analysis. Here, periodic microcomputed tomography scans
   are used to observe the temporal behavior of the hoof's meso and
   microstructures during compression, fracture, and relaxation. These
   results shed light on the structural anisotropy of the hoof wall and how
   its hollow tubules behave when compressed in different directions, at
   different hydration levels, and in various locations within the hoof
   wall. The behavior of tubule bridges during compression is also reported
   for the first time. This study elucidates several fracture phenomena,
   including the way cracks are deflected at tubule interfaces and tubule
   bridging, tubule arresting, and fiber bridging. Finally, relaxation
   tests are used to show how the tubule cavities can regain their shape
   after compression.},
