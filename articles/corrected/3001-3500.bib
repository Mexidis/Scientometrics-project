@article{ WOS:000936053400001,
Author = {Vergara-Ovalle, Fabian and Ayala-Guerrero, Fructuoso and Rosas, Carlos
   and Sanchez-Castillo, Hugo},
Title = {Novel object recognition in Octopus maya},
Journal = {ANIMAL COGNITION},
Year = {2023},
Volume = {26},
Number = {3},
Pages = {1065-1072},
Month = {JUN},
Abstract = {The Novel Object Recognition task (NOR) is widely used to study
   vertebrates' memory. It has been proposed as an adequate model for
   studying memory in different taxonomic groups, allowing similar and
   comparable results. Although in cephalopods, several research reports
   could indicate that they recognize objects in their environment, it has
   not been tested as an experimental paradigm that allows studying
   different memory phases. This study shows that two-month-old and older
   Octopus maya subjects can differentiate between a new object and a known
   one, but one-month-old subjects cannot. Furthermore, we observed that
   octopuses use vision and tactile exploration of new objects to achieve
   object recognition, while familiar objects only need to be explored
   visually. To our knowledge, this is the first time showing an
   invertebrate performing the NOR task similarly to how it is performed in
   vertebrates. These results establish a guide to studying object
   recognition memory in octopuses and the ontological development of that
   memory.},
