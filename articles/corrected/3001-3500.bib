@article{ WOS:001012194500001,
Author = {Fuentes-Garcia, Ruth and Pena-Cruz, Luis and Nieto-Castaneda, Georgina
   and Aldana-Gutierrez, Giovanni and de Leon-Hill, Claudia Alejandra Ponce},
Title = {Use of Home-Laboratory Chemistry Sets during the COVID Pandemic to
   Impart Learning in a Public University: Comparison of Two Cohorts},
Journal = {JOURNAL OF CHEMICAL EDUCATION},
