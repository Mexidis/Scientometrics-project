@article{ WOS:001011166100001,
Author = {Solana-Madruga, Elena and Mentre, Olivier and Arevalo-Lopez, Eugenia P.
   and Khalyavin, Dmitry and Fauth, Francois and Missiul, Alexandr and
   Arevalo-Lopez, Angel M.},
Title = {High-pressure ilmenite-type MnVO3: crystal and spin
   structures in the itinerant-localized regimes},
Journal = {JOURNAL OF MATERIALS CHEMISTRY C},
Year = {2023},
Volume = {11},
Number = {27},
Pages = {9238-9244},
Month = {JUL 13},
Abstract = {Herein we report the Peierls-like transition in the high-pressure
   ilmenite-type MnVO3. The first-order structural transition from a
   low-temperature P1 to a high-temperature R3 occurs at 475 K, accompanied
   by a semiconductor to metal-like transition. The triclinic distorted
   phase presents a V-V dimerization with a short similar to 2.85 angstrom
   bond formation at 300 K. Below 80 K MnVO3 orders antiferromagnetically
   with a small ferromagnetic component. Neutron diffraction reveals that
   both Mn and V cations contribute to the magnetic ordering, contrary to
   what expected on the V-V dimer formed. Extended Huckel and DFT
   calculations expose that the formation of covalent pairing is only
   partially achieved, contrary to the MgVO3 and CoVO3 counterparts.},
