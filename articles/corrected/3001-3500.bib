@article{ WOS:000984616900001,
Author = {Ochoa-Ochoa, Leticia M. and Devillamagallon, Rafa and Castillo-Ramirez,
   Guillermo and Cordero-Marines, Liliana},
Title = {Effects of Atlanticists policies and visions: The legacy of colonialism
   in conservation},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2023},
Volume = {282},
Month = {JUN},
Abstract = {The aim of the present manuscript is to lay on the table issues of
   inequity that affect several aspects of the conservation process, from
   basic research and media relations, to planning and implementation. The
   unifying central core is the legacy and impacts of colonialism (across
   several social orders) embodied in what we address as Atlanticism. We
   show how some differential standards are detectable through the
   conservation process. Finally, we propose some lines of reflection that
   may help level the influence of colonialism (reflected or expressed as
   whiteness and discrimination) in societies, and truly preserve
   biodiversity (diverse human societies included).},
