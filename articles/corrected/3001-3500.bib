@article{ WOS:001088404400007,
Author = {Diaz Guevara, Hector Hernan},
Title = {Beyond the Cold War: Changes and Continuities in the Ideological and
   Technological Dispute for the Third World Between the United States and
   China},
Journal = {REVISTA MEXICANA DE CIENCIAS POLITICAS Y SOCIALES},
Year = {2023},
Volume = {68},
Number = {248},
Pages = {141-170},
Abstract = {This research shows how the changes and continuities in the ideological
   and technological dispute for the Third World in the Cold War can help
   us analyze the commercial and diplomatic conflict that the United States
   pushed for during the Donald Trump administration (2017-2021) against
   the People's Republic of China, as a possible preface to a new Cold War.
   The methodology we have employed is comparative and links the
   historiography surrounding this conflict with the discipline of Grand
   Strategy. The originality of this research lies in taking continuity
   lines from the conflict between the Soviet Union and the United States
   as the starting point for the analysis of the American relationship with
   China at the beginning of the 2020s, focusing on the economic and
   technological dispute as part of the strategy of both countries.},
