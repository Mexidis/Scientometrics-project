Year = {2023},
Volume = {326},
Month = {MAR 1},
Abstract = {Let C be a Cantor set in the real line. Tymchatyn and Walker in {[}3]
   proved that every embedding h of C x {[}0,1] into the plane R2 is tame,
   i.e., there is a homeomorphism H : R2 -> R2 such that H (h (C x {[}0,
   1])) subset of C x {[}0, 1]. In this paper we answer a question of L.
   Oversteegen {[}2] by proving that every embedding of a closed subset of
   C x {[}0, 1] into the plane is tame. (c) 2023 Elsevier B.V. All rights
