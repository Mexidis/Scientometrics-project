@article{ WOS:001080453700012,
Author = {Lopez, Sergio I. and Pimentel, Leandro P. R.},
Title = {On the two-point function of the one-dimensional KPZ equation},
Journal = {BRAZILIAN JOURNAL OF PROBABILITY AND STATISTICS},
Year = {2023},
Volume = {37},
Number = {2, SI},
Pages = {455-462},
Month = {JUN},
Abstract = {In this short communication, we show that basic tools from Malli-avin
   calculus can be applied to derive the two-point function of the slope of
   the one-dimensional KPZ equation, starting from a two-sided Brownian
   mo-tion with an arbitrary diffusion parameter, in terms of the polymer
   end-point annealed distribution associated to the stochastic heat
   equation. We also prove that this distribution is given in terms of the
   derivative of the variance of the solution of the KPZ equation.},
Publisher = {BRAZILIAN STATISTICAL ASSOCIATION},
