@article{ WOS:000897504500001,
Author = {Borunda, Monica and Ramirez, Adrian and Garduno, Raul and Ruiz, Gerardo
   and Hernandez, Sergio and Jaramillo, O. A.},
Title = {Photovoltaic Power Generation Forecasting for Regional Assessment Using
   Machine Learning},
Journal = {ENERGIES},
