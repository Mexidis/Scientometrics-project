@article{ WOS:001072283600001,
Author = {Randazzo-Eisemann, Angela and Garza-Perez, Joaquin Rodrigo},
Title = {Alacranes reef: A refuge for structurally complex coral species from
   increasing stressors},
Journal = {OCEAN \& COASTAL MANAGEMENT},
Year = {2023},
Volume = {244},
Month = {OCT 1},
Abstract = {Coral reefs worldwide are being exposed to an interconnected myriad of
   anthropogenic stressors degrading their structure and functions.
   Therefore, global coral cover and coral reef ecosystem services have
   declined by half since the 1950s. Yet, remote reefs represent a time
   capsule to study ecological processes on minimally disturbed reefs, and
   these findings can steer management decisions and actions to enhance
   resilience. Combining in situ and satellite-derived data from the remote
   Alacranes Reef system located in the Gulf of Mexico, we evaluated
   benthic cover data and coral structural complexity together with
   physical drivers and direct coral stressors to better understand the
   current reef conditions of this remote system. Our main results show
   that 57\% of the reef sites have >10\% hard coral cover and are
   dominated by structurally complex species. Moreover, sites with >20\%
   coral cover were associated with significantly shallower depths, smaller
   wave significant height, fewer bleaching impacts, as well as fewer
   macroalgae and cyanobacteria cover. Despite cumulative stressors
   impacting the Alacranes reef system, coral species assemblages and
   conditions are still driven by natural physical gradients, and the
   system hosts potential refuges for structurally complex species in the
   wider Caribbean. However, not all these refuges are fully protected, and
   strategic local management is key to maintaining and enhancing coral
   resilience in the context of increasing global stressors.},
