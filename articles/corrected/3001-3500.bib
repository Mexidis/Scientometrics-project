@article{ WOS:000866722600001,
Author = {Parra-Rodriguez, Lorena and Reyes-Ramirez, Edward and Luis
   Jimenez-Andrade, Jose and Carrillo-Calvet, Humberto and Garcia-Pena,
   Carmen},
Title = {Self-Organizing Maps to Multidimensionally Characterize Physical
   Profiles in Older Adults},
Journal = {INTERNATIONAL JOURNAL OF ENVIRONMENTAL RESEARCH AND PUBLIC HEALTH},
Year = {2022},
Volume = {19},
Number = {19},
Month = {OCT},
Abstract = {The aim of this study is to automatically analyze, characterize and
   classify physical performance and body composition data of a cohort of
   Mexican community-dwelling older adults. Self-organizing maps (SOM) were
   used to identify similar profiles in 562 older adults living in Mexico
   City that participated in this study. Data regarding demographics,
   geriatric syndromes, comorbidities, physical performance, and body
   composition were obtained. The sample was divided by sex, and the
   multidimensional analysis included age, gait speed over height, grip
   strength over body mass index, one-legged stance, lean appendicular mass
   percentage, and fat percentage. Using the SOM neural network, seven
   profile types for older men and women were identified. This analysis
   provided maps depicting a set of clusters qualitatively characterizing
   groups of older adults that share similar profiles of body composition
   and physical performance. The SOM neural network proved to be a useful
   tool for analyzing multidimensional health care data and facilitating
   its interpretability. It provided a visual representation of the
   non-linear relationship between physical performance and body
   composition variables, as well as the identification of seven
   characteristic profiles in this cohort.},
