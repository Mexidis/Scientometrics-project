@article{ WOS:001057256700001,
Author = {Lopez-Bago, Ana and Lascurain, Ricardo and Hernandez-Carreno, Pavel E.
   and Gallardo-Vera, Francisco and Argueta-Donohue, Jesus and
   Jimenez-Trejo, Francisco and Fuentes-Zavaleta, David A. and
   Beltran-Ontiveros, Saul A. and Becerril-Camacho, Delia M. and
   Contreras-Rodriguez, Victor A. and Diaz, Daniel},
Title = {Sex, Age, and Regional Disparities in the Burden of Asthma in Mexico
   from 1990 to 2019: A Secondary Analysis of the Global Burden of Disease
   Study 2019},
Journal = {SUSTAINABILITY},
Year = {2023},
Volume = {15},
Number = {16},
Month = {AUG},
Abstract = {Asthma is the most prevalent cause of chronic respiratory diseases.
   Herein, we evaluate the asthma burden in Mexico based on results from
   the Global Burden of Disease (GBD 2019) study 2019. Using data from the
   GBD 2019, we estimated asthma prevalence, incidence, mortality, and
   disability-adjusted lived years (DALYs) counts and crude and
   age-standardized rates per 100,000 people with a 95\% uncertainty
   interval (UI) by sex and age at the national and subnational levels in
   Mexico from 1990 to 2019. At the national level, asthma affected 3.35
   million (95\% UI, 2.59-4.37) people, with 606.0 thousand (433.0-811.1)
   new incident cases and 1655 (3-1931) deaths during 2019. Asthma caused a
   slightly higher burden in females and affected mainly age groups between
   1 and 14 years of age. The burden of asthma gradually decreased from
   1990 to 2010. However, during the last decade (2010-2019), prevalence
   increased by 8.2\%, as did incidence, by 11.3\%, whereas mortality and
   DALYs decreased by 23.3 and 1.6\%, respectively. Finally, the burden of
   asthma displayed a heterogeneous pattern of disease at the subnational
   level. In conclusion, asthma causes a significant health loss in Mexico
   that differentially affects the population distributed among the states
   of the country, thus causing health disparities that should be addressed
   to provide sustainable asthma diagnosis and control to reduce its
   burden, especially in the early stages of life.},
