@article{ WOS:001016111900005,
Author = {Leon-Olvera, Rita Gabriela and Loser, Hannes and Sanchez-Beristain,
   Francisco and Garcia-Barrera, Pedro},
Title = {First report of Columactinastraea formosa Goldfuss, 1829 (Scleractinia)
   from the western Tethys},
Journal = {BOLETIN DE LA SOCIEDAD GEOLOGICA MEXICANA},
Year = {2023},
Volume = {75},
Number = {2},
Abstract = {The fossil coral Columactinastraea formosa Goldfuss, 1829 (Scleractinia)
   is reported for the first time from the westernmost part of the Tethys
   Ocean. The fossil was found in the Ocozocoautla Formation (Cretaceous,
   Maastrichtian) in Chiapas, Mexico. There are earlier reports of the
   species from the United Arab Emirates (Campanian and Maastrichtian) and
   from some European localities (Coniacian and Santonian). The possible
   palaeobiogeographic origin of C. formosa and the dispersal of the
   species are discussed.},
