@article{ WOS:000892588600005,
Author = {Aguilar, Silvana and Brunetti, Andres E. and Garay, Aisel Valle and
   Santos, Liem Canet and Perez, Luis O. and Moreira, Daniel and
   Cancelarich, Natalia L. and Barbosa, Eder Alves and Basso, Nestor G. and
   de Freitas, Sonia Maria and Faivovich, Julian and Brand, Guilherme and
   Cabrera, Gabriela M. and Leite, Jose R. S. A. and Marani, Mariela M.},
Title = {Structure and function of cationic hylin bioactive peptides from the
   tree frog Boana pulchella in interaction with lipid membranes},
Journal = {PEPTIDES},
Year = {2023},
Volume = {159},
Month = {JAN},
Abstract = {Amphibians have a great diversity of bioactive peptides in their skin.
   The cDNA prepro-peptide sequencing allowed the identification of five
   novel mature peptides expressed in the skin of Boana pulchella, four
   with similar sequences to hylin peptides having a cationic
   amphipathic-helical structure. Whole mature peptides and some of their
   fragments were chemically-synthesized and tested against Gram-positive
   and Gram-negative bacterial strains. The mature peptide hylin-Pul3 was
   the most active, with a MIC= 14 mu M against Staphylococcus aureus.
   Circular dichroism assays indicated that peptides are mostly
   unstructured in buffer solutions. Still, adding large unilamellar
   vesicles composed of dimyristoyl phosphatidylcholine and
   dimyristoylphosphatidylglycerol increased the alpha-helix content of
   novel hylins. These results demonstrate the strong influence of the
   environment on peptide conformation and highlight its significance while
   addressing the pharmacology of peptides and their biological function in
   frogs.},
