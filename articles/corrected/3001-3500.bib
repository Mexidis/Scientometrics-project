@article{ WOS:001082206500001,
Author = {Silvas-Baltazar, Monserrat and Lopez-Oropeza, Grecia and Duran, Pilar
   and Martinez-Canabal, Alonso},
Title = {Olfactory neurogenesis and its role in fear memory modulation},
