@article{ WOS:001078599100001,
Author = {Palacios, Lourdes and Ramos-Martinez, Pavel and Signoret, Carlos},
Title = {On the density of CV0(X) ⊗ A in CV0(X, A)},
Journal = {JOURNAL OF MATHEMATICAL ANALYSIS AND APPLICATIONS},
Year = {2024},
Volume = {530},
Number = {2},
Month = {FEB 15},
Abstract = {Let X be a completely regular Hausdorff space and V a Nachbin family on
   X. For a locally convex algebra A, let CV0(X, A) be the algebra of all
   weighted vector-valued continuous functions which vanish at infinity
   with the topology given by the uniform seminorms induced by V. In this
   paper we present some sufficient conditions under which CV0(X) circle
   times A is a dense subspace of CV0(X, A) or isomorphic to it. (c) 2023
   Elsevier Inc. All rights reserved.},
