@inproceedings{ WOS:000405307700045,
Author = {Lizbeth Hernandez-Vargas, Mireya and Castillo-Perez, Ruben and
   Hernandez-Guerrero, Oscar and Flores-Cedillo, Osvaldo and Fabian
   Campillo-Illanes, Bernardo},
Editor = {Meyers, MA and Benavides, HAC and Bruhl, SP and Colorado, HA and Dalgaard, E and Elias, CN and Figueiredo, RB and GarciaRincon, O and Kawasaki, M and Langdon, TG and Mangalaraja, RV and Marroquin, MCG and Rocha, AD and Schoenung, JM and Silva, ACE and Wells, M and Yang, W},
Title = {Thermo-mechanical Properties of Waterborne Acrylate Hybrid
   Nanocomposites},
Booktitle = {PROCEEDINGS OF THE 3RD PAN AMERICAN MATERIALS CONGRESS},
Series = {Minerals Metals \& Materials Series},
Year = {2017},
Pages = {447-455},
Note = {3rd Pan American Materials Congress (PAMC), The Minerals, Met \& Mat
   Soc, San Diego, CA, FEB 26-MAR 02, 2017},
Abstract = {Waterborne acrylate hybrid nanocomposites containing 1 wt\%
   nanoparticles were synthesized by in situ polymerization using SiO2 and
   Fe2O3 nanoparticles. The synthesized latex hybrids were characterized by
   thermogravimetric analysis, uniaxial tension, nano-indentation and
   scanning electron microscopy (SEM). Films drawn from the latex exhibited
   excellent optical transparency and no evidence of aggregation was
   detected by SEM and X-ray energy dispersive spectroscopy (EDS) analysis
   confirmed the presence of silica and iron throughout the films. The
   thermal properties showed a decrease of the glass transition temperature
   in the presence of Fe2O3 nanoparticles as demonstrated by the dynamic
   mechanical analysis. The nano-SiO2 induced significantly higher thermal
   stability, as decomposition temperatures of the nanocomposites increases
   by as much as 40 degrees C relative to the neat acrylic. On the other
   hand, the Young's modulus and hardness of the nanocomposites films
   decrease about 30 and 65\%, denoting a modification of macromolecular
   dynamic by the SiO2 and Fe2O3 nanoparticles, respectively.},
