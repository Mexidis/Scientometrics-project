@article{ WOS:000381953400030,
Author = {Sierra-Morales, Pablo and Carlos Almazan-Nunez, R. and Beltran-Sanchez,
   Elizabeth and Rios-Munoz, Cesar A. and del Coro Arizmendi, Maria},
Title = {Geographical distribution and habitat of Trochillidae (Ayes) in the
   state of Guerrero, Mexico},
Journal = {REVISTA DE BIOLOGIA TROPICAL},
Year = {2016},
Volume = {64},
Number = {1},
Pages = {363-376},
Month = {MAR},
Abstract = {The distribution and abundance of species of Trochillidae family is
   usually influenced by the flowering and phenology of plants used as a
   feeding source, mainly in primary forest, so that changes in vegetation
   cover could impact their populations. We analyzed and characterized the
   geographical distribution and habitat for 22 species of resident
   hummingbirds in the state of Guerrero using the vegetation and the land
   use map of INEGI Series IV (2007-2010). Distribution models were
   generated with the Genetic Algorithm for Rule Set Production (GARP),
   using historical records of scientific collections and fieldwork
   (2001-2009), in combination with climatic and topographic variables. Of
   the 22 modeled species, six are endemic to Mexico, the same number of
   species found in a risk category. The highest concentration with regards
   to richness (14-20 species), endemism (5-6 species) and number of
   threatened species of hummingbirds (5-6 species) occurred in the biotic
   province of Sierra Madre del Sur. However, the potential distribution of
   most of the hummingbirds occurred in disturbed sites or agroecosystems,
   as a result of changes in land-use. For Campylopterus hemileucurus,
   Lamprolahna rhatni and Heliomaster longisrostris, their potential
   distribution was highest in areas of primary vegetation. Areas of high
   hummingbirds presence do not coincide with the Important Bird Areas
   proposed for bird conservation in Guerrero, considering that, despite
   its diversity and its extreme popularity, from the conservation
   perspective hummingbirds have received relatively little attention.},
Publisher = {REVISTA DE BIOLOGIA TROPICAL},
Address = {UNIVERSIDAD DE COSTA RICA CIUDAD UNIVERSITARIA, SAN JOSE, 00000, COSTA
   RICA},
Type = {Article},
Language = {Spanish},
Affiliation = {Sierra-Morales, P (Corresponding Author), Univ Autonoma Guerrero, Unidad Acad Ciencias Quim Biol, Lab Integral Fauna Silvestre, Ave Lazaro Cardenas S-N,Ciudad Univ, Chilpancingo 39000, Guerrero, Mexico.
   Sierra-Morales, Pablo; Carlos Almazan-Nunez, R., Univ Autonoma Guerrero, Unidad Acad Ciencias Quim Biol, Lab Integral Fauna Silvestre, Ave Lazaro Cardenas S-N,Ciudad Univ, Chilpancingo 39000, Guerrero, Mexico.
   Beltran-Sanchez, Elizabeth, Univ Autonoma Guerrero, Inst Invest Cient Area Ciencias Nat, Ave Lazaro Cardenas S-N,Ciudad Univ, Chilpancingo 39000, Guerrero, Mexico.
   Rios-Munoz, Cesar A., Univ Nacl Autonoma Mexico, Fac Ciencias, Museo Zool Alfonso L Herrera, Mexico City 04510, DF, Mexico.
   del Coro Arizmendi, Maria, Univ Nacl Autonoma Mexico, Lab Ecol, Unidad Biotecnol \& Prototipos, Mexico City 05490, DF, Mexico.},
