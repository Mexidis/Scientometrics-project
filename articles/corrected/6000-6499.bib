@incollection{ WOS:000411982900026,
Author = {Laguna-Hernandez, Guillermo and Enriqueta Brechu-Franco, Alicia and De
   la Cruz-Chacon, Ivan and Rosa Gonzalez-Esquinca, Alma},
Editor = {Pellicciari, C and Biggiogera, M},
Title = {A Histochemical Technique for the Detection of Annonaceous Acetogenins},
Booktitle = {HISTOCHEMISTRY OF SINGLE MOLECULES: METHODS AND PROTOCOLS},
Series = {Methods in Molecular Biology},
Year = {2017},
Volume = {1560},
Pages = {331-338},
Abstract = {Annonaceous acetogenins (ACGs) are molecules with carbon numbers
   C35-C37, usually with tetrahydrofuran and tetrahydropyran rings and one
   terminal gamma-lactone (usually alpha,beta-unsaturated), in a large
   aliphatic chain that is varyingly hydroxylated, acetoxylated or
   ketonized. ACGs have ecological functions as insecticides and are
   pharmacologically promising due to their cytotoxic and antitumoral
   properties. They are found in the seeds, leaves, roots, flowers and
   fruits of annonaceous plants and can be detected during isolation via
   thin-layer chromatography using Kedde's reagent, which reacts with the
   unsaturated lactone. This chapter describes the location in situ of ACGs
   in fresh sections of annonaceous seeds using Kedde's reagent.
   The acetogenins are located in the idioblasts, in the endosperm and in
   the embryonic axis during differentiation. This method can aid in the
   detection of ACGs with a terminal unsaturated.-lactone in organs and
   tissues.},
