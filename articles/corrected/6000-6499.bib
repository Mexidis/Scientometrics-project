@article{ WOS:000378766500021,
Author = {Solano-Zavaleta, Israel and Nieto-Montes de Oca, Adrian and Campbell,
   Jonathan A.},
Title = {A New Species of Mesaspis (Squamata: Anguidae) from the High
   Cuchumatanes of Guatemala},
Journal = {JOURNAL OF HERPETOLOGY},
Year = {2016},
Volume = {50},
Number = {2},
Pages = {327-336},
Month = {JUN},
Abstract = {We describe a new species of anguid lizard of the genus Mesaspis from
   the Sierra de los Cuchumatanes of northwestern Guatemala. This species
   reaches a maximum snout-vent length of about 72 mm, making it much
   smaller than Mesaspis moreletii. In the Sierra de los Cuchumatanes it
   occurs sympatrically with Mesaspis moreletii temporalis, the only such
   instance of congeneric sympatry known in Nuclear Central America. The
   new species appears most similar to the widely distributed species M.
   moreletii, whichmay be polytypic. Mesaspis cuchumatanus may be
   distinguished from M. moreletii by usually having expanded supranasals,
   16 longitudinal scale rows, small and granular scales covering the side
   of the neck from about the level of upper edge of auricular opening to
   ventrolateral fold, and smaller body size.},
