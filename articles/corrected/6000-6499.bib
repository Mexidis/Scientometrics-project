Title = {Live Rock},
Booktitle = {MARINE ORNAMENTAL SPECIES AQUACULTURE},
Year = {2017},
Pages = {385-401},
Abstract = {Live rock is widely used in marine aquariums and aquaculture systems all
   over the world for filtering and aesthetic purposes. The present chapter
   provides a general introduction and overview of the general types and
   classifications of live rock available in the market, as well as their
   prices and characteristics. A compilation and synthesis of the most
   widely used ``recipes{''} to make your own artificial live rock, and
   review of the financial aspects related to the aquaculture of live
   artificial rock are provided. Scientific bibliographic information is
   reviewed and new data is added that confirm many long-assumed but seldom
   demonstrated roles of live rock in contained seawater systems. The pros
   and cons of the use of live rock are identified and briefly discussed.
   The chapter ends with a proposal of future directions and
   recommendations for the aquaculture of live rock.},
