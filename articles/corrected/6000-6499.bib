Title = {A compilation of the birds of La Libertad Region, Peru},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2016},
Volume = {87},
Number = {1},
Pages = {200-215},
Month = {MAR},
Abstract = {We present a list of the species of birds that have been recorded in La
   Libertad Region, a highly diverse semi-arid region located in
   northwestern Peru. Records are based on field observations, literature
   research, and databases of scientific collections. We recorded a total
   of 484 species in this region. These include 45 endangered species, and
   42 species endemic to Peru. This list is intended as a guide for future
   programs of management and conservation of biodiversity in the region.
