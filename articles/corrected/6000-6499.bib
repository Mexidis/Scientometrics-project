@article{ WOS:000378071600024,
Author = {Barrios-Izas, Manuel and Coty, David},
Title = {A NEW FOSSIL SPECIES OF CAULOPHILUS WOLLASTON, 1854 (COLEOPTERA:
   CURCULIONIDAE: COSSONINAE) FROM MEXICAN AMBER},
Journal = {COLEOPTERISTS BULLETIN},
Year = {2016},
Volume = {70},
Number = {1},
Pages = {177-179},
Month = {MAR},
Abstract = {A new fossil weevil species of the cossonine genus Caulophilus
   Wollaston, Caulophilus ayotzinapa Barrios-Izas, new species, from the
   late Oligocene to middle Miocene amber of Totolapa, Chiapas, Mexico, is
   described. This represents the first record of the genus from Mexican
   amber. Diagnostic characters are the subquadrate shape of the pronotum,
   the lesser distance between eyes in dorsal view, the shallow
   seriate-punctate pattern of striae, interstices 8 and 9 costate, and the
   shape of the basal half of the tibiae widening apicad from the base to
   the middle of the tibiae.},
