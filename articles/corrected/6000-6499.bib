Author = {Sanchez-Montes, Sokani and Guzman-Cornejo, Carmen and Herrera-Montalvo,
   Gerardo and Richman, Adam D. and Flores-Martinez, Jose J. and
   Garcia-Ruiz, Gilberto F. and Berzunza-Cruz, Miriam and Gaytan-Colin,
   Paul and Perez-Montfort, Ruy and Alcantara-Rodriguez, Virginia E. and
   Becker, Ingeborg},
Title = {First Record of Bartonella vinsonii in the Sucking Louse
   Hoplopleura hirsuta Collected from Hispid Cotton Rats,
   Sigmodon hispidus, in Mexico},
Journal = {SOUTHWESTERN ENTOMOLOGIST},
Year = {2016},
Volume = {41},
Number = {4},
Pages = {1031-1036},
Month = {DEC},
Abstract = {This study determined the presence of Bartonella species in sucking lice
   from hispid cotton rat, Sigmodon hispidus Say and Ord, at San Luis
   Potosi, Mexico. Louse specimens were processed for morphological
   identification and evaluated for Bartonella DNA. A single sucking louse
   species was found and identified as Hoplopleura hirsuta Ferris. DNA was
   extracted from 20 adults, and a 379-bp fragment of Bartonella citrate
   synthase (gltA) gene was amplified. Six lice (30\%) were positive for
   Bartonella DNA, and all sequences found belonged to Bartonella vinsonii
   Brenner et al. To our knowledge, this is the first report of a member of
   B. vinsonii complex associated with sucking lice.},
