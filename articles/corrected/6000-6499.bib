@inproceedings{ WOS:000400609300063,
Author = {Hernandez L, R. T. and Cortes S, V. and Granados S, J. and Orozco S, S.},
Book-Group-Author = {IOP},
Title = {Reducing hydrogen permeation in 304 stainless steel by compound layers
   of Al, Zr and Ti oxides films},
Booktitle = {VIII INTERNATIONAL CONGRESS OF ENGINEERING PHYSICS},
Series = {Journal of Physics Conference Series},
Year = {2017},
Volume = {792},
Note = {8th International Congress of Engineering Physics, Merida, MEXICO, NOV
   07-11, 2016},
Abstract = {A single and double layer formed by thin films coatings of aluminium
   oxide, zirconium oxide and titanium oxide were deposited over 304
   stainless steel surface by ultrasonic spray pyrolysis technique. The
   steel samples were conformed for tensile tests. The purpose of these
   layers is to reduce hydrogen embrittlement effect in steel. An
   electrochemical cell was used in hydrogen charged, where a low
   concentration of sulfuric acid is utilized like electrolytic solution.
   Tension trials show the change the fracture type in samples with or
   without coating after hydrogen charged. The embrittlement percent factor
   and SEM micrographs indicate a reduction of hydrogen permeation for
   coated samples with double layer.},
