Year = {2016},
Volume = {461},
Pages = {366-373},
Month = {NOV 1},
Abstract = {The behavior of the viscosity of supercooled liquids with temperature
   has been extensively studied in different regimes. We present a
   universal behavior for the Logarithmic Shift Factor for fragile and
   polymeric glassformers in two temperature regions, above and below the
   crossover temperature To respectively. We find two different equations,
   one for each region, that may be represented as master plots which show
   universal behaviors for both cases. (C) 2016 Elsevier B.V. All rights
   reserved.},
