@article{ WOS:000369408400001,
Author = {Hanna, Zachary R. and Ortiz-Ramirez, Marco F. and Rios-Munoz, Cesar A.
   and Cayetano-Rosas, Hector and Bowie, Rauri C. K. and Navarro-Sigueenza,
   Adolfo G.},
Title = {Phylogenetic and morphologic evidence confirm the presence of a new
   montane cloud forest associated bird species in Mexico, the Mountain
   Elaenia (Elaenia frantzii; Aves: Passeriformes: Tyrannidae)},
Journal = {PEERJ},
Year = {2016},
Volume = {4},
Month = {FEB 1},
Abstract = {Here we provide evidence to support an extension of the recognized
   distributional range of the Mountain Elaenia (Elaenia frantzii) to
   include southern Mexico. We collected two specimens in breeding
   condition in northwestern Sierra Norte de Chiapas, Mexico. Morphologic
   and genetic evidence support their identity as Elaenia frantzii. We
   compared environmental parameters of records across the entire
   geographic range of the species to those at the northern Chiapas survey
   site and found no climatic differences among localities.},
