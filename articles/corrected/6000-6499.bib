@article{ WOS:000377057400008,
Author = {Lozada-Perez, Lucio and Rojas Gutierrez, Jorge},
Title = {A New Species, Omiltemia guerrerensis (Rubiaceae) from Guerrero,
   Mexico},
Journal = {NOVON},
Year = {2016},
Volume = {24},
Number = {4},
Pages = {365-368},
Month = {MAY},
Abstract = {Omiltemia guerrerensis Lozada-Perez \& J. Rojas is described and
   illustrated as a new endemic species from the mountain zone of Guerrero
   State, Mexico. This new species is characterized by long helicoid-cymose
   inflorescences, long stamens inserted at the same height near the base
   of the corolla tube, and seeds united by the middle to the placenta.
   These same characters differentiate it from O. longipes Standl. The
   existence of the genus Pseudomiltemia Borhidi is evaluated.},
