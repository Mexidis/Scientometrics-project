@article{ WOS:000394094500004,
Author = {Hernandez, D. and Herrera-Hernandez, E. C. and Nunez-Lopez, M. and
   Hernandez-Coronado, H.},
Title = {Self-similar Turing patterns: An anomalous diffusion consequence},
Journal = {PHYSICAL REVIEW E},
Year = {2017},
Volume = {95},
Number = {2},
Month = {FEB 16},
Abstract = {In this work, we show that under specific anomalous diffusion
   conditions, chemical systems can produce well-ordered self-similar
   concentration patterns through diffusion-driven instability. We also
   find spiral patterns and patterns with mixtures of rotational
   symmetries. The type of anomalous diffusion discussed in this work,
   either subdiffusion or superdiffusion, is a consequence of the medium
   heterogeneity, and it is modeled through a space-dependent diffusion
   coefficient with a power-law functional form.},
