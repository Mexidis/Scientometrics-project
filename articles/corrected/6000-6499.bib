@inproceedings{ WOS:000494428100008,
Author = {Castillo, F. and Valdes, D. and Flores, O. and Campillo, B. and
   Martinez, H.},
Book-Group-Author = {IEEE},
Title = {Study of an atmospheric-pressure discharge in air},
Booktitle = {2017 16TH LATIN AMERICAN WORKSHOP ON PLASMA PHYSICS (LAWPP 2017)},
