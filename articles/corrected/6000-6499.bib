@article{ WOS:000399419900002,
Author = {Sofia Islas-Hernandez, C. and Lozada-Perez, Lucio and Alvarado-Cardenas,
   Leonardo O.},
Title = {A new species of Spigelia L. (Loganiaceae) from Mexico},
Journal = {PHYTOTAXA},
Year = {2017},
Volume = {303},
Number = {2},
Pages = {118-124},
Month = {APR 11},
Abstract = {A new Mexican species of Spigelia (Loganiaceae), distributed in the
   states of Guerrero and Michoacan, is here described. The new species can
   be distinguished from the similar-looking S. humboldtiana by its corolla
   with innerly purple lobes, inserted stamens above the proximal half of
   the corolla tube and exserted style. With this contribution, Mexico
   reaches a total of 20 species, of which 50\% are endemic, highlighting
   this country as a center of diversity for this genus. A dichotomous key
   for the species recorded in the states of Guerrero and Michoacan is
   included.},
