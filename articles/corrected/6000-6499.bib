Title = {A new species of Diplocentrus (Scorpiones: Diplocentridae) with
   punctate pedipalp surfaces, a diagnostic character within the
   ``mexicanus'' group},
Journal = {COMPTES RENDUS BIOLOGIES},
Year = {2017},
