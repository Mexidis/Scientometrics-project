   Guillen, J. and Soni, A. A. and Huepa, H.},
Title = {A STUDY OF BO LYN, A NEGLECTED HADS STAR},
Journal = {REVISTA MEXICANA DE ASTRONOMIA Y ASTROFISICA},
Year = {2016},
Volume = {52},
Number = {2},
Pages = {385-398},
Month = {OCT},
Abstract = {uvby - beta photometry of the high amplitude delta Scuti (HADS) star BO
   Lyn allowed us to determine its physical characteristics. A secular
   period variation was established through the O-C of all the available
   times of maximum light and those newly acquired through CCD photometry.
   In the present study we have demonstrated that BO Lyn is pulsating with
   one stable varying period whose O-C residuals show a sinusoidal pattern
   compatible with a light-travel time effect.},
