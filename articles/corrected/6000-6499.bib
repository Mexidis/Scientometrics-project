Pages = {37-42},
Note = {16th Latin American Workshop on Plasma Physics (LAWPP), Univ Nacl
   Autonoma Mexico, Mexico City, MEXICO, SEP 04-08, 2017},
Organization = {Soc Mexicana Fis, Div Plasma Phys; CONACYT; IEEE Nucl \& Plasma Sci Soc},
Abstract = {The characterization of has been active region of the corona discharge,
   it is critical and important for several applications. In this work, it
   investigated an air discharge at atmospheric pressure between a needle
   electrode and a flat metal cathode, as well as between a needle
   electrode and a cathode immersed in water. The voltage and current of
   the plasma discharge were analyzed; the power used was of 14 kW. The air
   discharge was analyzed by optical emission spectroscopy (OES), using a
   spectrometer (Model HR2000CG-UV-NIR). The optical emission spectroscopy
   were measured in the UV-visible-NIR wavelength range between 200 nm and
   1100 nm, in order to identify the excited species formed in a corona air
   discharge. The species observed were: NO transitions A(2)Pi -> X-2 Pi at
   222.2, 272.2 nm; NH transition, A(3)Pi -> X-3 Sigma(g) at 336.1 nm;
   N-2(+) transitions B-2 Sigma(u) -> X-2 Sigma(g) at 391.4, 423.7, 427.8
   and 495.73 nm; N-2(+) at 567.95 and 593.17 nm; O at 777.1, 844.6 and
   869.56 nm; H2O at 618.8 and 657.8 nm The electron temperature (T-e) and
   electron density (n(e)) were evaluated using the Boltzmann and Saha
   equations, they were found to be 7.07 eV and 2.43 x 10 15 cm(-3)
   respectively.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
