@inproceedings{ WOS:000454705600015,
Author = {Cruz y Cruz, S. and Escamilla, N. and Velazquez, V.},
Book-Group-Author = {IOP},
Title = {Generation of Sources of Light with Well Defined Orbital Angular
   Momentum},
Booktitle = {QUANTUM FEST 2015},
Series = {Journal of Physics Conference Series},
Year = {2016},
Volume = {698},
Note = {6th Annual Conference on Quantum Phenomena, Quantum Control and Geometry
   of Quantum States (Quantum Fest), Tecnologico Monterrey, Mexico City,
   MEXICO, OCT 19-23, 2015},
Organization = {Ctr Res \& Adv Studies; Unidad Profes Interdisciplinaria Ingn
   Tecnologias Avanzadas I P N},
Abstract = {In this work, a technique to produce spatial electromagnetic modes with
   definite orbital angular momentum is presented. The method is based in
   the construction of binary diffractive gratings generated by computer.
   In the classical regime the gratings produce the well known
   Laguerre-Gaussian modes distributions when illuminated by a plane wave.
   In the quantum regime the grating is placed in the signal path of a
   spontaneous parametric down conversion layout and the diffraction
   pattern, observed in the coincidence count rate, shows that the single
   photons are projected onto spatial states consistent with a
   Laguerre-Gaussian modes distribution.},
