@inproceedings{ WOS:000438022300025,
Author = {Ruiz, A. I. and Caudillo, R. and Velazquez, V. M. and Barrios, E.},
Book-Group-Author = {IOP},
Title = {Using Spatial Correlations of SPDC Sources for Increasing the Signal to
   Noise Ratio in Images},
Booktitle = {QUANTUM FEST 2016 INTERNATIONAL CONFERENCE ON QUANTUM PHENOMENA, QUANTUM
   CONTROL AND QUANTUM OPTICS},
Series = {Journal of Physics Conference Series},
Year = {2017},
Volume = {839},
Note = {7th International Conference on Quantum Phenomena, Quantum Control and
   Quantum Optics (Quantum Fest), Cinvestav, Mexico City, MEXICO, OCT
   17-21, 2016},
Organization = {Inst Politecnico Nacl, Unidad Profes Interdisciplinaria Ingn Tecnologias
   Avanzadas; Inst Politecnico Nacl; Tecnologico Monterrey, Campus Estado
   Mexico},
Abstract = {We experimentally show that, by using spatial correlations of photon
   pairs produced by Spontaneous Parametric Down-Conversion, it is possible
   to increase the Signal to Noise Ratio in images of objects illuminated
   with those photons; in comparison, objects illuminated with light from a
   laser present a minor ratio. Our simple experimental set-up was capable
   to produce an average improvement in signal to noise ratio of 11dB of
   Parametric Down-Converted light over laser light. This simple method can
   be easily implemented for obtaining high contrast images of faint
   objects and for transmitting information with low noise.},
