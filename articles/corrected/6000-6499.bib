@article{ WOS:000395686600012,
Author = {Salazar-Blas, Amed and Noriega-Calixto, Laura and Campos, Maria E. and
   Eapen, Delfeena and Cruz-Vazquez, Tania and Castillo-Olamendi, Luis and
   Sepulveda-Jimenez, Gabriel and Porta, Helena and Dubrovsky, Joseph G.
   and Cassab, Gladys I.},
Title = {Robust root growth in altered hydrotropic response
   1 (ahr1) mutant of Arabidopsis is maintained by
   high rate of cell production at low water potential gradient},
Journal = {JOURNAL OF PLANT PHYSIOLOGY},
Year = {2017},
Volume = {208},
Pages = {102-114},
Month = {JAN},
Abstract = {Hydrotropism is the directional root growth response determined by water
   stimulus. In a water potential gradient system (WPGS) the roots of the
   Arabidopsis wild type have a diminished root growth compared to normal
   medium (NM). In contrast, the altered hydrotropic response] (ahrl)
   mutant roots maintain their robust growth in the same WPGS. The aims of
   this work were to ascertain how ahrl roots could sustain growth in the
   WPGS, with a special focus on the integration of cellular processes
   involved in the signaling that determines root growth during abiotic
   stress and their relation to hydrotropism. Cellular analysis of the root
   apical meristem of ahrl mutant contrary to the wild type showed an
   absence of changes in the meristem length, the elongation zone length,
   the length of fully elongated cells, and the cell cycle duration. The
   robust and steady root growth of ahrl seedlings in the WPGS is explained
   by the mutant capacity to maintain cell production and cell elongation
   at the same level as in the NM. Analysis of auxin response at a
   transcriptional level showed that roots of the ahrl mutant had a lower
   auxin response when grown in the WPGS, compared to wild type, indicating
   that auxin signaling participates in attenuation of root growth under
   water stress conditions. Also, wild type plants exhibited a high
   increase in proline content while ahrl mutants showed minimum changes in
   the Normal Medium Water Stress Medium (NM WSM), a lower water potential
   gradient system than the WPGS. Accordingly, in this condition, gene
   expression of Delta 1- 6 Pyrroline-5-Carboxylate Synthetasel (p5CS1)
   involved in proline synthesis strongly increased in wild type but not in
   ahrl seedlings. The ahrl phenotype shows unique features since the
   mutant root cells continue to proliferate and grow in the presence of a
