Pages = {751-763},
Month = {OCT},
Abstract = {We study the spectrum of periodic Jacobi matrices. We concentrate on the
   case of slowly oscillating diagonal terms and study the behaviour of the
   zeros of the associated orthogonal polynomials in the spectral gap. We
   find precise estimates for the distance from single eigenvalues of
   truncated matrices in the spectral gap to the diagonal entries of the
   matrix. We include a brief numerical example to show the exactness of
