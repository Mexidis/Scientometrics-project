Title = {COMPARATIVE-ANALYSIS OF TAXONOMIC MARKERS IN CHROMATOGRAPHIC PROFILES OF
   LEAVES FROM SOME ARBORESCENT SPECIES OF THE GENUS IPOMOEA
   (CONVOLVULACEAE)},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1992},
Volume = {53},
Number = {1},
Pages = {1-4},
Abstract = {Chromatographic profiles of alkaloids, kauranoic glucosides and
   glycoresins were obtained from the leaves of:  Ipomoea murucoides Roem.
   et Schult., I. pauciflora Mart. et Gal., I. arborescens Hum. et Bonpl.,
   I. wolcottiana Rose and I. carnea Jacq.  The presence of the taxonomic
   markers, established for the 3 groups of secondary metabolites, was
   determined in the profiles and the index of similitude was calculated. 
   There is a 100\% similitude in the profiles of the markers in I.
   pauciflora and I. wolcottiana.  For I. murucoides the index of
   similitude was 83\%, for I. carnea, 58\% and for I. arborescens, 47\%.},
