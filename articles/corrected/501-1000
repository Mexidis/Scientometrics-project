Pages = {45-50},
Month = {JAN},
Abstract = {We say a group G satisfies properties (M) and (NM) if every nontrivial
   finite subgroup of G is contained in a unique maximal finite subgroup,
   and every nontrivial finite maximal subgroup is self-normalizing. We
   prove that the Bredon cohomological dimension and the virtual
   cohomological dimension coincide for groups that admit a cocompact model
   for EG and satisfy properties (M) and (NM). Among the examples of groups
   satisfying these hypothesis are cocompact and arithmetic Fuchsian
   groups, one-relator groups, the Hilbert modular group, and 3-manifold
   groups.},
