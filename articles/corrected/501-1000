Title = {Assessing functional connectivity and anthropogenic impacts on
   Ambystoma altamirani populations in Bosque De Agua, Central
   Mexico},
Journal = {EUROPEAN JOURNAL OF WILDLIFE RESEARCH},
Year = {2024},
