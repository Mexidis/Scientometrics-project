@article{ WOS:000377009900004,
Author = {Camargo, H. A. and Gonzalez de Urreta, E. J. and Socolovsky, M.},
Title = {Weyl geometry, anti-de Sitter space, and Φ4-theory},
Journal = {EUROPEAN PHYSICAL JOURNAL PLUS},
Year = {2016},
Volume = {131},
Number = {5},
Month = {MAY 26},
Abstract = {We study the Gaussian approximation to the quantum fluctuations of the
   metric of the four-dimensional anti-de Sitter spacetime. The associated
   massless scalar field has a quartic self-interaction, for which we
   construct the generating functional of the n-point correlation
   functions. The concomitant infrared divergence is cured by a mass
   renormalization provided by the cosmological constant, which is also
   responsible for the renormalization of the coupling constant of the
   field theory.},
