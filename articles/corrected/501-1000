@article{ WOS:000260906700009,
Author = {Bonfil-Sanders, Consuelo and Cajero-Lazaro, Isahel and Evans, Richard Y.},
Title = {SEED GERMINATION OF SIX Bursera SPECIES FROM CENTRAL MEXICO},
Journal = {AGROCIENCIA},
Year = {2008},
