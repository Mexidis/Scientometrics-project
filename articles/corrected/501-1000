@article{ WOS:000383701100008,
Author = {Cevallos-Ferriz, Sergio R. S. and Vazquez-Rueda, Mar-Allesha},
Title = {Permineralized infructescence from the Cerro del Pueblo Formation, Upper
   Cretaceous, Coahuila, Mexico},
