   SPECIES},
Journal = {PHYTON-INTERNATIONAL JOURNAL OF EXPERIMENTAL BOTANY},
Year = {1994},
Volume = {56},
Pages = {51-58},
Abstract = {In seeds of Alnus firmifolia Ferm. (Betulaceae), Abies religiosa (HBK)
   Schl. et Cham. (Pinaceae), Cedrela odorala L. (Meliaceae), Swietenia
   macrophylla King (Meliaceae) and Cordia eleagnoides DC (Boraginaceae)
