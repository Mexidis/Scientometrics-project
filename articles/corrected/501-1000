@article{ WOS:000239471000015,
Author = {Neumann-Lara, Victor and Pellicer-Covarrubias, Patricia and Puga, Isabel},
Title = {On 1/2-homogeneous continua},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2006},
Volume = {153},
Number = {14},
Pages = {2518-2527},
Month = {AUG 1},
Abstract = {A continuum is 1/2-homogeneous provided there are exactly two orbits for
