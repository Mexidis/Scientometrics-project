Year = {2015},
Volume = {67},
Number = {3},
Pages = {401-412},
Abstract = {Chondrules are the major constituents of chondritic meteorites; however,
   their origin is still an enigma for meteoritic science. In this work we
   report the results of melting minerals to experimentally generate
   objects similar to chondrules. The degree of fusion of olivine appears
   to be an important factor in determining the width of the bars in
   samples with barred-type olivine (BO) chondrules. On the other hand, the
   contribution of clays and carbon (possible precursor grains) is an
   important factor in those experiments where the melted samples showed
   porphyritic texture.},
