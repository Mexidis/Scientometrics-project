@article{ WOS:000387092500006,
Author = {Antonio Arias-Medellin, Luis and Bonfil, Consuelo and Valverde, Teresa},
Title = {Demographic analysis of Agave angustifolia (Agavaceae) with an
   emphasis on ecological restoration},
Journal = {BOTANICAL SCIENCES},
