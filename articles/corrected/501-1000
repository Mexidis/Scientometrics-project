@article{ WOS:000457530700006,
Author = {Hernandez-Morales, Ricardo and Becerra, Arturo and Lazcano, Antonio},
Title = {Alarmones as Vestiges of a Bygone RNA World},
Journal = {JOURNAL OF MOLECULAR EVOLUTION},
Year = {2019},
Volume = {87},
