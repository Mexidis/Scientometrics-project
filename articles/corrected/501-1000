Title = {Quantification of Anti-Addictive Alkaloids Ibogaine and Voacangine in
   In Vivo- and In Vitro-Grown Plants of Two Mexican
   Tabernaemontana Species},
Journal = {CHEMISTRY \& BIODIVERSITY},
Year = {2016},
