Author = {Romero Fuster, Maria Carmen and Sanchez-Bringas, Federico},
Title = {Isometric immersions with prefixed second order geometry in minimal
   codimension},
Journal = {REVISTA DE LA REAL ACADEMIA DE CIENCIAS EXACTAS FISICAS Y NATURALES
   SERIE A-MATEMATICAS},
Year = {2016},
Volume = {110},
