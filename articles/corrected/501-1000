   Ramirez-Rodriguez, Rocio},
Title = {Phenology of Sirodotia suecica (Batrachospermaceae, Rhodophyta)
   in a high-altitude stream in central Mexico},
Journal = {PHYCOLOGICAL RESEARCH},
Year = {2009},
