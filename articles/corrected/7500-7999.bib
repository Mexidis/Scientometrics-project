@article{ WOS:000297447800012,
Author = {Santos-Barrera, G. and Flores Villela, O.},
Title = {A New Species of Toad of the Genus Incilius from the Sierra Madre
   Occidental of Chihuahua, Mexico (Anura: Bufonidae)},
Journal = {JOURNAL OF HERPETOLOGY},
Year = {2011},
Volume = {45},
Number = {2},
Pages = {211-215},
Month = {JUN},
Abstract = {In this paper we describe a new species of toad of the genus Incilius.
   This species was originally recorded as Bufo sinus, a synonym of I.
   occidentalis. It differs from I. occidentalis by having the following
   combination of characters: a pale brown dorsal ground color with
   numerous dark brown spots and lacking a vertebral stripe and a high
   density of granules on the dorsum producing a rugose skin texture. The
   most developed of the cranial crests is the supraorbital, while the
   parietal is poorly developed. Incilius mccoyi inhabits pine and pine-oak
   forests of the southwestern Sierra Madre Occidental in Chihuahua,
   Mexico.},
