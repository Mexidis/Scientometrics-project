@article{ WOS:000307428300003,
Author = {Castano-Meneses, Gabriela and Palacios-Vargas, Jose G.},
Title = {COMPARISON OF THE WORLDWIDE CAVE COLLEMBOLA AT THE GENERIC LEVEL},
