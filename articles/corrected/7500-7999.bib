@article{ WOS:000301990400017,
Author = {Ake-Castillo, Jose A. and Okolodkov, Yuri B. and Espinosa-Matias, Silvia
   and Merino-Virgilio, Fany del C. and Herrera-Silveira, Jorge A. and
   Ector, Luc},
Title = {Cyclotella marina (Tanimura, Nagumo et Kato) Ake-Castillo,
   Okolodkov et Ector comb. et stat. nov (Thalassiosiraceae): a
   bloom-forming diatom in the southeastern Gulf of Mexico},
Journal = {NOVA HEDWIGIA},
Year = {2012},
Number = {141},
Pages = {263-274},
Abstract = {A new combination Cyclotella marina (Tanimura, Nagumo et Kato)
   Ake-Castillo, Okolodkov et Ector comb. et stat. nov. is proposed for the
   diatom Cyclotella atomus var. marina Tanimura, Nagumo et Kato. This
   taxon is clearly distinguishable from C. atomus Hustedt by its smaller
   diameter and in lacking the valve-face fultoportula. Open chambers seem
   to be a constant character, in contrast to C. atomus var. atomus and
   var. gracilis Genkal et Kiss. It is represented by solitary
   low-cylindrical cells of 4-5 mu m in diameter and 2.3-3.1 mu m along the
   pervalvar axis. This diatom was identified as a causative agent of a
   harmful algal bloom event in late May 2009, in the neritic zone of the
   Yucatan Peninsula, Gulf of Mexico, reaching an abundance of 1.167 x
   10(7) cells/l. In contrast to the freshwater-brackish water preference
   of the nominate variety of C. aromas and the variety gracilis, the taxon
   studied here shows preference for normal marine salinities (>= 30 psu).
   Our morphological observations revealed (1) the possession of two
   chloroplasts, (2) the presence of granules/spinules around the external
   short tubes of the fultoportulae, (3) areolated valvocopulae, and (4)
   the presence of one or two bands in addition to the valvocopulae.
   Cyclotella marina differs from two other species of the genus known only
   from freshwater and also without a central valve-face fultoportula,
   namely C. meduanae Germain and C. katiana Sala et Ramirez, by having two
   satellite pores in the marginal fultoportulae and no ornamentation on
   the valve face. Cyclotella marina seems to be restricted to neritic
   shallow waters rich in nutrients originating in freshwater discharges
   and high detritus content. It may attach to submerged macrophytes until
   environmental conditions favour rapid growth and bloom formation in the
   water column. The record of this taxon in the Gulf of Mexico is the
   first report for both the American seas and the Atlantic Ocean,
   extending its known distribution beyond temperate waters.},
Publisher = {GEBRUDER BORNTRAEGER},
Address = {JOHANNESSTR 3A, D-70176 STUTTGART, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Aké-Castillo, JA (Corresponding Author), Univ Veracruzana, Inst Ciencias Marinas \& Pesquerias, Calle Hidalgo 617, Boca Del Rio 94290, Veracruz, Mexico.
   Ake-Castillo, Jose A.; Okolodkov, Yuri B., Univ Veracruzana, Inst Ciencias Marinas \& Pesquerias, Boca Del Rio 94290, Veracruz, Mexico.
