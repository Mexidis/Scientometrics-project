Month = {AUG},
Abstract = {This study revelead the presence of several euglenophyte taxa
   (Euglenophyta) in Lake Chignahupan, in the Upper Lerma Basin (Mexico). A
   total of 21 taxa were identified, 10 belonging to the genus Phacus, 5 to
   Lepocinclis, 2 to Euglena, 2 to Monomorphina, one to Cryptoglena and one
   to Trachelomonas. The species Crytoglena skujae, Euglena caudata, E.
   limnophila, Lepocinclis ovum var. dimidio-minor. L. salina, L steinii.
   Monomorphina aenigmatica, Phacus condoms, P. ichthydion, P. inflexus, P.
   orbicularis, P. polytrophos and P. raciborskii were recorded for the
   first time in Mexico. All observed taxa are described briefly and
   illustrated by microphotographs or line drawings.},
