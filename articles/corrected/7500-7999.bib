   Zamudio-Varela, Graciela and Magana-Cota, Gloria},
Title = {An unpublished manuscript of Alfredo Duges related to the classification
   of lizards according to tongue morphology, c. 1898},
Journal = {ARCHIVES OF NATURAL HISTORY},
Year = {2010},
Volume = {37},
Number = {2},
Pages = {246-254},
Month = {OCT},
Abstract = {An unpublished manuscript of Alfredo Duges was found in Guanajuato,
   Mexico. This manuscript is interesting in depicting some of the ideas
   Duges held about the phylogenetic position of many lizard groups in the
   nineteenth century, in particular, his conclusion on the phylogenetic
   position of Heloderma, the only known venomous lizard at that time.
   Duges's discussion is important in the context of a science dominated by
   Europeans and North Americans, putting this lizard in a modern
   phylogenetic context.},
