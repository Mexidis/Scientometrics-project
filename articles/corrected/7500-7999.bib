@article{ WOS:000306892000006,
Author = {Zamora-Silva, Andrea and Ortigosa, Deneb},
Title = {New opisthobranch records in the Veracruz Reef System National Park,
   Mexico},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2012},
Volume = {83},
Number = {2},
Pages = {359-369},
Month = {JUN},
Abstract = {Several studies have been conducted on the richness and abundance of
   molluscs in the coastal coral reefs of the Gulf of Mexico since 1960's,
   but these have focused mainly on knowledge of prosobranch gastropods and
   bivalves species, while only 6 species of opisthobranchs have been
   registered for this ecosystem. In this paper we present a list of 23
   species of opisthobranchs from the Veracruz Reef System National Park, a
   complex of 23 coral formations located on the coast of Veracruz on the
   Gulf of Mexico. The list includes 9 new records, a systematic
   arrangement and pictures of several of the species mentioned here.},
