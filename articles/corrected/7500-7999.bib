@article{ WOS:000300563600020,
Author = {Illanes, Alejandro and Martinez-Montejano, Jorge M.},
Title = {ZERO-DIMENSIONAL CLOSED SET APOSYNDESIS AND SYMMETRIC PRODUCTS},
Journal = {HOUSTON JOURNAL OF MATHEMATICS},
Year = {2011},
Volume = {37},
Number = {4},
Pages = {1333-1346},
Abstract = {A continuum is a compact, connected, metric space. It is said that a
   continuum X is zero-dimensional closed set aposyndetic provided that for
   each zero-dimensional closed subset A of X and for each p is an element
   of X \textbackslash{} A, there exists a subcontinuum M of X such that p
   is an element of intM and M boolean AND A = phi. In this paper we show
   that if X is a continuum and n >= 2, then F-n(X), the n-fold symmetric
   product of X, is zero-dimensional closed set aposyndetic.},
