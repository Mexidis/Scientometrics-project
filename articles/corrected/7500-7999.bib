@article{ WOS:000281437500003,
Author = {Alberto Duran-Ramirez, Carlos and Maria Fonseca-Juarez, Rosa and
   Ibarra-Manriquez, Guillermo},
Title = {Floristic study of Ficus (Moraceae) in the state of Guerrero,
   Mexico},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2010},
Volume = {81},
