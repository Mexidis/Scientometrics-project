@article{ WOS:000302749800001,
Author = {Miramontes, Octavio and DeSouza, Og and Hernandez, Diego and Ceccon,
   Eliane},
Title = {Non-Levy Mobility Patterns of Mexican Me'Phaa Peasants Searching for
   Fuel Wood},
Journal = {HUMAN ECOLOGY},
Year = {2012},
Volume = {40},
Number = {2},
Pages = {167-174},
Month = {APR},
Abstract = {We measured mobility patterns that describe walking trajectories of
   individual Me'Phaa peasants searching for and collecting fuel wood in
   the forests of ``La Montaa de Guerrero{''} in Mexico. These 1-day
   excursions typically follow a mixed pattern of nearly-constant steps
   when individuals displace from their homes towards potential collecting
   sites and a mixed pattern of steps of different lengths when actually
   searching for fallen wood in the forest. Displacements in the searching
   phase seem not to be compatible with L,vy flights described by
   power-laws with optimal scaling exponents. These findings, however, can
   be interpreted in the light of deterministic searching on heavily
   degraded landscapes where the interaction of the individuals with their
   fuel wood-scarce environment produces alternative searching strategies
   than the expected L,vy flights. These results have important
   implications for future management and restoration of degraded forests
   and the improvement of the ecological services they may provide to their
   inhabitants.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Miramontes, O (Corresponding Author), UFPR, Dept Fis, BR-81530900 Curitiba, Parana, Brazil.
   Miramontes, Octavio, Univ Nacl Autonoma Mexico, Inst Fis, Coyoacan 04510, DF, Mexico.
   Miramontes, Octavio, Univ Nacl Autonoma Mexico, Ctr Ciencias Complejidad, Coyoacan 04510, DF, Mexico.
   DeSouza, Og, Univ Fed Vicosa, Lab Termitol, Vicosa, MG, Brazil.
   Hernandez, Diego, Univ Nacl Autonoma Mexico, Fac Ciencias, Coyoacan 04510, DF, Mexico.
   Ceccon, Eliane, Univ Nacl Autonoma Mexico, Ctr Reg Invest Multidisciplinarias, Cuernavaca 62210, Morelos, Mexico.},
DOI = {10.1007/s10745-012-9465-8},
ISSN = {0300-7839},
EISSN = {1572-9915},
Keywords = {Levy flights; Human mobility; Deterministic walks; Me'Phaa; Fuel wood;
   Ecological restoration; Foraging; Mexico},
