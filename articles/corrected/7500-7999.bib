@article{ WOS:000282115100021,
Author = {Sanchez-Gonzalez, Luis A. and Oliveros, Carl and Puna, Nevong and Moyle,
   Robert G.},
Title = {Nests, Nest Placement, and Eggs of Three Philippine Endemic Birds},
Journal = {WILSON JOURNAL OF ORNITHOLOGY},
Year = {2010},
Volume = {122},
Number = {3},
Pages = {587-591},
Month = {SEP},
Abstract = {We describe the nest and eggs of two Philippine endemic passerines, the
   Rusty-faced Babbler (Robsonius rabori) and the Blue-breasted Blue
   Fly-catcher (Cyornis herioti). We also describe a novel type of nest and
   nest placement for the Short-crested Monarch (Hypothymis helenae), and
   provide the first description of the eggs of this species. We discuss
   similarities among eggs and nests of these species with their relatives,
   and the need for more information regarding natural history and breeding
   habits for the Philippine avifauna.},
