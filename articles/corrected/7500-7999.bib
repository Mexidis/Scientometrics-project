@article{ WOS:000292362500030,
Author = {Aguirre-Villasenor, Hugo and Castillo-Velazquez, Rosalina},
Title = {New depth record of Cherublemma emmelas, black brotula
   (Ophidiiformes: Ophidiidae) from the Gulf of California, Mexico},
Journal = {REVISTA MEXICANA DE BIODIVERSIDAD},
Year = {2011},
Volume = {82},
Number = {2},
Pages = {713-715},
Month = {JUN},
Abstract = {Seven black brotulas Cherublemma emmelas inhabiting deep-sea soft bottom
   in the southeastern Gulf of California were collected using a benthic
   sledge during 2 oceanographic cruises (TALUD project) at a depth range
   of 905 to 1 010 m, a temperature range of 4.6 to 5.2 degrees C, and
   hypoxic (0.13 to 0.20 ml/l) conditions. Until now, the presence of C.
   emmelas below 750 m had not been reported in the literature. This new
   record extends the known depth range of occurrence approximately 260 m
   deeper than the previously reported limit.},
