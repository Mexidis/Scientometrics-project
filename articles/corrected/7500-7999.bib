@inproceedings{ WOS:000295993300019,
Author = {Chernicoff, Mariano and Antonio Garcia, J. and Gueijosa, Alberto},
Editor = {Ayala, A and Contreras, G and Leon, I and Podesta, P},
Title = {Radiation Damping in a Non-Abelian Strongly-Coupled Gauge Theory},
Booktitle = {XII MEXICAN WORKSHOP ON PARTICLES AND FIELDS},
Series = {AIP Conference Proceedings},
Year = {2011},
Volume = {1361},
