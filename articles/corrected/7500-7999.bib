@article{ WOS:000310111900003,
Author = {Carlos Sema-Ojeda, Juan and Alberto Castanon-Gonzalez, Jorge and Macias,
   Alejandro E. and Mansilla-Olivares, Armando and Dominguez-Cherit,
   Guillermo and Polanco-Gonzalez, Carlos},
Title = {Survey about responsiveness of third-level hospitals to a medical
   disaster: after the pandemic influenza in Mexico},
Journal = {GACETA MEDICA DE MEXICO},
Year = {2012},
Volume = {148},
Number = {3},
Pages = {227-235},
Month = {MAY-JUN},
Abstract = {Background: The recent pandemic influenza AH1N1 virus made it clear that
   planning for medical disaster response is critical. Objective: To know
   the responsiveness of a sample of highly specialized hospitals in Mexico
   to a medical disaster with the previous pandemic influenza AH1N1 as
   reference. Methods: A survey was conducted among the Medical Directors
   of a sample of highly specialized hospitals, covering: previous
   experience with the pandemic influenza, space considerations, material
   resources, staff, logistics, and current general perspectives.
   Descriptive statistics were used for analysis. Results: A 95\% response
   was obtained from the institutions (19 hospitals). Of these, 47.4\%
   considered that the medical institution was not ready to respond to
   pandemic influenza. The median surge capacity for the Intensive Care
   Unit beds was 30\% (range 0 to 32 beds). The least reserve in medication
   was found in the antivirals (26.3\%). Only 47.4\% considered having
   enough intensive care nurses and 57.9\% enough respiratory technicians;
   42.1\% would not have an easy access to resources in an emergency.
   Conclusions: Prevention is key in responsiveness to medical disasters,
   and therefore the basic steps for planning strategies must be
   considered.},
