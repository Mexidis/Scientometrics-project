   Socorro Gonzalez-Elizondo, M., Ctr Interdisciplinario Invest Desarrollo Integral, Durango 34220, Mexico.
   Luna-Vega, Isolda, Univ Nacl Autonoma Mexico, Dept Evolut Biol, Fac Ciencias, Mexico City 04510, DF, Mexico.},
ISSN = {1870-3453},
EISSN = {2007-8706},
Keywords = {oak-pine forest; pine-oak forest; grassland; point center quarter method},
Research-Areas = {Biodiversity \& Conservation},
