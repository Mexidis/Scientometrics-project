Volume = {63},
Number = {3},
Pages = {321-324},
Month = {SEP},
Abstract = {Holographis lizethae (Acanthaceae), a new species from Guerrero, Mexico,
   is described and illustrated. This new species is similar to Holographis
   pallida, but differs by the revolute leaf margin, deltate-cymbiform
   bracts, larger corolla held vertically in anthesis, longer stamens and
   style, and by its distribution and flowering period.},
