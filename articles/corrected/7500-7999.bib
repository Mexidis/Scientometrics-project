@article{ WOS:000301548700002,
Author = {Welti-Chanes, Carlos},
Title = {Demography in Mexico, the initial stages of its evolution and its
   contributions to national development},
Journal = {PAPELES DE POBLACION},
Year = {2011},
Volume = {17},
Number = {69},
Pages = {9-47},
Month = {JUL-SEP},
Abstract = {Demography in Mexico, the initial stages of its evolution and its
   contributions to national development
   The aim of this article is to show, through an historical journey, the
   development of Demography in Mexico as a scientific discipline, which
   seeks to know social reality and make evident the determinants of
   population growth and its interaction with other social variables, so
   that this knowledge serves to support actions that are intended to
   modify the population dynamics through policies and programs in this
   field. A particularly novel aspect of this article are the references
   made to show to the pioneers of Demography, who from the author's
   viewpoint have been ignored or at least not sufficiently recognized in
