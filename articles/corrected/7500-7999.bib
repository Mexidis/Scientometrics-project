   Pinto, B. Mario and Sandoval-Ramirez, Jesus},
Title = {Synthesis and selective anticancer activity of steroidal glycoconjugates},
Journal = {EUROPEAN JOURNAL OF MEDICINAL CHEMISTRY},
Year = {2012},
Volume = {54},
Pages = {721-727},
Month = {AUG},
Abstract = {The synthesis of glucosamine derivatives of the steroidal sapogenins
   diosgenin and hecogenin using the N-phthaloyl protected
   trichloroacetimidate of D-glucosamine as donor and TMSOTf as promoter is
   reported. The corresponding glycoconjugates were transformed into their
   acetamido derivatives and the hydrochloride salt (from diosgenin) and
   tested against HeLa, CaSki, and ViBo cervicouterine cancer cells. These
   compounds showed low cytotoxicity values on tumor cells and human
   lymphocytes, indicating that the main cell death process is presumably
   not necrosis. Significantly, the antiproliferative activity of these
   compounds on tumor cells did not affect the proliferative potential of
   peripheral blood lymphocytes. (C) 2012 Elsevier Masson SAS. All rights
   reserved.},
