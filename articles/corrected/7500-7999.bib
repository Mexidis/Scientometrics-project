@article{ WOS:000300604500024,
Author = {Antonyan, Natella and Antonyan, Sergey A. and Varela-Velasco, Ruben D.},
Title = {Universal G-spaces for proper actions of locally compact groups},
Journal = {TOPOLOGY AND ITS APPLICATIONS},
Year = {2012},
Volume = {159},
Number = {4, SI},
Pages = {1159-1168},
Month = {MAR 1},
Note = {5th Joint Meeting Japan-Mexico in Topology and its Applications, Colima,
   MEXICO, SEP 27-OCT 01, 2010},
Abstract = {We establish the existence of universal G-spaces for proper actions of
   locally compact groups on Tychonoff spaces. A typical result sounds as
   follows: for each infinite cardinal number tau every locally compact,
   non-compact, sigma-compact group G of weight w(G) <= tau can act
   properly on R-tau \textbackslash{} \{0\} such that R-tau
   \textbackslash{} \{0\} contains a G-homeomorphic copy of every Tychonoff
   proper G-space of weight <= tau. The metric cones Cone(G/H) with H
   subset of G a compact subgroup such that G/H is a manifold, are the main
   building blocks in our approach. As a byproduct we prove that the
   cardinality of the set of all conjugacy classes of such subgroups H
   subset of G does not exceed the weight of G. (C) 2011 Elsevier B.V. All
   rights reserved.},
Publisher = {ELSEVIER SCIENCE BV},
