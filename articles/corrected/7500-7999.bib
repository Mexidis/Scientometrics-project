Month = {MAR 5},
Abstract = {We have theoretically investigated the formation of Li:B:H clusters from
   standard reactants in gas phase. Molecular electronic structure
   computations as well as Born-Oppenheimer molecular dynamics have been
   carried out to investigate the early stages of the formation of Li:B:H
