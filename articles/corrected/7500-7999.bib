Year = {2012},
Volume = {83},
Number = {2},
Pages = {313-328},
Month = {JUN},
Abstract = {Six species of the genus Fomitiporia are described and illustrated for
   the first time from Mexico and they are F. apiahyna, F calkinsii, F
   dryophila, F langloisii, F maxonii y F. texana; F. sonorae is reported
   from Queretaro State. The specimens are deposited in the Herbaria
   CESUES, ENCB, FCME, IBUG, ITCV, MEXU, UJAT, UNL, USED from Mexico and
   MUCL and proceed from 18 states of the Mexican Republic. Besides, a
   distribution map of the species is presented.},
