@article{ WOS:000702545800001,
Author = {De Aquino, Itzel and Platas-Neri, Diana and Carlos Sanchez-Ferrer, Jose
   and Jimenez, Said and Munoz-Delgado, Jairo},
Title = {Tactical deception in sociosexual behaviour of stump-tailed macaques
   (Macaca arctoides): an exploratory study},
Journal = {BEHAVIOUR},
Year = {2021},
Volume = {158},
Number = {11},
Pages = {945-969},
Month = {SEP},
Abstract = {Tactical deception (TD) is a social strategy in which a subject performs
   an action to its own benefit causing disadvantage for a competitor. In
   primates, the cognitive mechanisms involved in TD have been described at
   different levels. Sneaky mating is a common context within which to
   study TD because in many primate groups, dominant males monopolize
   access to females and subordinate males must find a way to copulate with
   females avoiding the alpha's presence. The objective of this study was
   to explore which of the TD behavioural strategies are involved in the
   male sociosexual behaviour of a group of stump-tailed macaques (Macaca
   arctoides). We found that the subordinate males participated in more
   interactions when they were in a section of the enclosure where the
   alpha male was not present. The alpha male had more copulation
   interactions, but the beta male's interactions lasted longer on average.
   Our data offer evidence in support of the hypothesis that stump-tailed
   macaques may use TD strategies that are related to operant conditioning.},
