Author = {Raga, Graciela B. and Ladino, Luis A. and Baumgardner, Darrel and
   Ramirez-Romero, Carolina and Cordoba, Fernanda and Alvarez-Ospina, Harry
   and Rosas, Daniel and Amador, Talib and Miranda, Javier and Rosas, Irma
   and Jaramillo, Alejandro and Yakobi-Hancock, Jacqueline and Kim, Jong
   Sung and Martinez, Leticia and Salinas, Eva and Figueroa, Bernardo},
Title = {ADABBOY},
