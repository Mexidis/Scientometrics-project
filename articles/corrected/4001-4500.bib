   Lopez-Moreno, Enrique and Frank, Alejandro},
Title = {Quantum Chaos in Time Series of Single Photons as a Superposition of
   Wave and Particle States},
Journal = {PHOTONICS},
Year = {2021},
Volume = {8},
Number = {8},
Month = {AUG},
Abstract = {We build a time series of single photons with quantum chaos statistics,
   using a version of the Grangier anti-correlation experiment. The
   criteria utilized to determine the presence of quantum chaos is the
   frame of the Fano factor and the power spectrum. We also show that
   photons with chaotic statistics are in a balanced superposition of
   photons with both wave-like and particle like behaviors. To support the
   presence of quantum chaos, we study both Shannon's entropy, and the
   complexity of single photons time series.},
