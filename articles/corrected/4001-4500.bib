@article{ WOS:000701761800017,
Author = {Velazquez-Abunader, Ivan and Brule, Thierry and Cabrera, Miguel A. and
   Lopez-Rocha, Jorge A.},
Title = {Length-weight relationships of four finfish commercial species from the
   southern Gulf of Mexico},
Journal = {LATIN AMERICAN JOURNAL OF AQUATIC RESEARCH},
Year = {2021},
Volume = {49},
Number = {2},
Pages = {369-375},
Abstract = {The relationship between total length and total weight (LWR) of four
   commercial species of finfish captured in the southern Gulf of Mexico
   (Lachnolaimus maximus, Ocyurus chrysurus, Mycteroperca bonaci, and
   Mycteroperca microlepis) was estimated. Two of these species are
   captured in the region by the small-scale fleet, while the other two are
   targeted by small-scale and semi-industrial fleets using harpoons,
   handlines, and long-lines. For the assessment, the organisms were
   sampled at the landing decks in the study area in two periods: 1996-1999
   (semi-industrial fleet) and from April 2017 to May 2018 (small-scale
   fleet). A total of 2780 individuals were sampled which 2775 individuals
   were used to obtain LWR functions. The four species showed negative
   allometric growth with b < 3 for the 2017-2018 period, two species
   showed positive allometric growth with b > 3 for the 1996-1999 period.
   This type of information is an important input for the stock assessment
   of these species that support important fisheries in the zone and are
   under high fishing pressure levels.},
Publisher = {PONTIFICIA UNIV CATOLICA VALPARAISO},
Address = {AV BRASIL 2950, PO BOX 4059, VALPARAISO, CHILE},
Type = {Article},
Language = {English},
Affiliation = {López-Rocha, JA (Corresponding Author), Univ Nacl Autonoma Mexico, Lab Anal Espacial Zonas Costeras, Unidad Multidisciplinaria Docencia \& Invest, Fac Ciencias, Sisal, Yucatan, Mexico.
