@article{ WOS:000634505300006,
Author = {Alonso Solis-Marin, Francisco and Sandino, Osmar Benito and Andres
   Conejeros-Vargas, Carlos and Alejandra Caballero-Ochoa, Andrea},
Title = {First record of the genus Lepuipentacta (Cucumariidae:
   Colochirinae) for the Nicaraguan Caribbean},
Journal = {REVISTA DE BIOLOGIA TROPICAL},
Year = {2021},
Volume = {69},
Number = {1},
Pages = {80-88},
Month = {MAR},
Abstract = {Introduction: The genus Leptopentacta has only been previously reported
   from Florida, Cuba, Colombia, Costa Rica, and Suriname. Objective: To
   present the first record of the genus for Nicaragua. Methods: The
   morphological characters of Nicaraguan material at the Smithsonian
   Institution (USNM 1014529), were corroborated with the original
   description. Results: The live specimens collected in the Nicaraguan
   Caribbean match the genus. Conclusions: Leptopentacta is reported for
   the first time from the Nicaraguan Caribbean Sea. This increases the
   number of Nicaraguan echinoderms to 194 species.},
