@article{ WOS:000680915300001,
Author = {Diaz-Bautista, Erik and Oliva-Leyva, Maurice},
Title = {Coherent states for dispersive pseudo-Landau-levels in strained
   honeycomb lattices},
Journal = {EUROPEAN PHYSICAL JOURNAL PLUS},
Year = {2021},
Volume = {136},
Number = {7},
Month = {JUL 23},
Abstract = {Dirac fermions in graphene may experiment dispersive pseudo-Landau
   levels due to a homogeneous pseudomagnetic field and a
   position-dependent Fermi velocity induced by strain. In this paper, we
   study the (semi-classical) dynamics of these particles under such a
   physical context from an approach of coherent states. For this purpose
   we use a Landau-like gauge to built Perelomov coherent states by the
   action of a non-unitary displacement operator D(alpha) on the
   fundamental state of the system. We analyze the time evolution of the
   probability density and the generalized uncertainty principle as well as
   the Wigner function for the coherent states. Our results show how
   x-momentum dependency affects the motion periodicity and the Wigner
   function shape in phase space.},
