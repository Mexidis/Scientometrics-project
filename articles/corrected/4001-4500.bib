@article{ WOS:000693570700002,
Author = {Hernandez, America and Martinez-Gomez, Margarita and
   Beamonte-Barrientos, Rene and Montoya, Bibiana},
Title = {Colourful traits in female birds relate to individual condition,
   reproductive performance and male-mate preferences: a meta-analytic
   approach},
Journal = {BIOLOGY LETTERS},
Year = {2021},
Volume = {17},
Number = {9},
Month = {SEP 8},
Abstract = {Colourful traits in females are suggested to have evolved and be
   maintained by sexual selection. Although several studies have evaluated
   this idea, support is still equivocal. Evidence has been compiled in
   reviews, and a handful of quantitative syntheses has explored cumulative
   support for the link between condition and specific colour traits in
   males and females. However, understanding the potential function of
   females' colourful traits in sexual communication has not been the
   primary focus of any of those previous studies. Here, using a
   meta-analytic approach, we find that evidence from empirical studies in
   birds supports the idea that colourful female ornaments are positively
   associated with residual mass and immune response, clutch size and
   male-mate preferences. Hence, colourful traits in female birds likely
   evolved and are maintained by sexual selection as condition-dependent
   signals.},
Publisher = {ROYAL SOC},
Address = {6-9 CARLTON HOUSE TERRACE, LONDON SW1Y 5AG, ENGLAND},
