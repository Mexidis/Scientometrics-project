@article{ WOS:000702556500002,
Author = {Leon-Flores, J. and Perez-Mazariego, J. L. and Flores-Morales, S. S. and
   Hinojosa, R. and Arevalo-Lopez, E. P. and Escamilla, R. and Gomez, R. W.},
Title = {Spectroscopic characterization of iron bismuth (antimony/tantalum)
   pyrochlores synthesized by the molten salts method},
Journal = {CERAMICS INTERNATIONAL},
Year = {2021},
Volume = {47},
Number = {22},
Pages = {31983-31989},
Month = {NOV 15},
Abstract = {Polycrystalline samples of iron bismuth antimony pyrochlore
   (Bi1.48Fe0.10)(Sb-1.48 Fe-0.59)O-7 and iron bismuth tantalum pyrochlore
   (Bi1.51Fe0.06)(Ta1.51Fe0.55)O-7 were synthesized by the molten salts
   method. The crystalline structures were determined by X ray diffraction
   and Rietveld refinement. Through Mossbauer and X-ray photoelectron
   spectroscopies (XPS), the distribution and the ionic states of the
   cations in the pyrochlore structure were investigated. Additionally,
   through XPS and UV-Vis spectroscopy via diffuse reflection measurements,
   the optical bandgaps were obtained Eg = 2.78 eV for the Sb pymchlore and
   Eg = 2.70 eV for the Ta pymchlore together with the energetic location
   of the valence and conduction band.},
