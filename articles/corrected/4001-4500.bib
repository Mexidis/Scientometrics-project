@article{ WOS:000634505300025,
Author = {Lizbeth Esteban-Vazquez, Brenda and De los Palos-Pena, Magdalena and
   Alonso Solis-Marin, Francisco and Laguarda-Figueras, Alfredo},
Title = {Morphology of endoskeleton and spination in the sea star Midgardia
   xandaros (Brisingida: Brisingidae) from the Gulf of Mexico},
Journal = {REVISTA DE BIOLOGIA TROPICAL},
Year = {2021},
Volume = {69},
Number = {1},
Pages = {404-422},
Month = {MAR},
Abstract = {Introduction. The deep-sea asteroid species of Brisingida have a nearly
   global distribution but have remained poorly understood due to their
   deep bathymetric distributions and fragile skeletons. Objective. To
   describe the external and internal morphology of Midgardia xandaros
   including the skeletal arrangement, through multifocal and SEM
   techniques. Methods. We examined a total of 21 specimens, including 27
   arm fragments, from the Gulf of Mexico and Honduras. Two specimens were
   dissected. Results. Detailed descriptions of pedicellariae, abactinal,
   intercostal, inferomarginal, adambulacral, ambulacral, odontophore. and
   oral ossicles, and their spines are provided, emphasizing the
   articulations and muscle attachments. C-shaped valves pedicellariae and
   small pedicellariae valves with shorter denticulation areas were
   recognized. Conclusions. The morphological description of M. xandaros is
   expanded, providing the most extensive description of abactinal, first
   adambulacral, first and subsequent inferomarginal ossicles, abactinal
   spines, and C-shaped, crossed pedicellariae, as well as the distal arm
   plates, for a brisingid species using SEM to date.},
Publisher = {REVISTA DE BIOLOGIA TROPICAL},
Address = {UNIVERSIDAD DE COSTA RICA CIUDAD UNIVERSITARIA, SAN JOSE, 00000, COSTA
   RICA},
Type = {Article},
