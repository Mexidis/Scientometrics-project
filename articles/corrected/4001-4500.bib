Year = {2021},
Volume = {37},
Pages = {227-265},
Abstract = {We prove that the bisimplicial set obtained by applying the 2-nerve
   functor of Lack and Paoli ({[}Lack, Paoli, 2008]) to a 2-group ({[}Baez,
   Lauda, 2004]) seen as a bicategory with one object, is a fibrant object
   in the universal simplicial replacement of Dugger ({[}Dugger, 2001]) of
   the model category of reduced homotopy 2-types. As an application we
   deduce a well known theorem about (non-symmetric) determinant functors
   for Waldhausen categories or derivators ({[}Deligne, 1987], {[}Knudsen,
   2002], {[}Muro, Tonks, 2007] and {[}Muro, Tonks, Witte, 2015]).},
