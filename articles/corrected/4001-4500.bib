@article{ WOS:000655253100008,
Author = {Fernandez, Juan Carlos and Palmas, Oscar},
Title = {An ODE reduction method for the semi-Riemannian Yamabe problem on space
   forms},
Journal = {NONLINEAR ANALYSIS-THEORY METHODS \& APPLICATIONS},
Year = {2021},
Volume = {209},
Month = {AUG},
Abstract = {We consider the semi-Riemannian Yamabe type equations of the form
   -square u + lambda u = mu vertical bar u vertical bar(p-1)u on M
   where M is either the semi-Euclidean space or the pseudosphere of
   dimension m >= 3, rectangle is the semi-Riemannian Laplacian in M,
   lambda >= 0, mu is an element of R \textbackslash{} \{0\} and p > 1.
   Using semi-Riemannian isoparametric functions on M, we reduce the PDE
   into a generalized Emden-Fowler ODE of the form
   w `'+ q(r) w' + lambda w = mu vertical bar w vertical bar(p-1)w on I,
   where I subset of R is {[}0, infinity) or {[}0, pi], q(r) blows-up at 0
   and w is subject to the natural initial conditions w'(0) = 0 in the
   first case and w'(0) = w'(pi) = 0 in the second. We prove the existence
   of blowing-up and globally defined solutions to this problem, both
   positive and sign-changing, inducing solutions to the semi-Riemannian
   Yamabe type problem with the same qualitative properties, with level and
   critical sets described in terms of semi-Riemannian isoparametric
   hypersurfaces and focal varieties. In particular, we prove the existence
   of sign-changing blowing-up solutions to the semi-Riemannian Yamabe
   problem in the pseudosphere having a prescribed number of nodal domains.
   (C) 2021 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
