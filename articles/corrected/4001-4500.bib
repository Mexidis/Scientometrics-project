@article{ WOS:000648159300001,
Author = {Mateos, Gisela and Suarez-Diaz, Edna},
Title = {Atomic ambassadors: the IAEA's first Preliminary Assistance Mission
   (1958)},
Journal = {HISTORY AND TECHNOLOGY},
Year = {2021},
