Pages = {5273-5296},
Month = {DEC 2},
Abstract = {Gabriel showed that for a unital ring R, there exists a bijective
   correspondence between the set of Gabriel filters of R and the set of
   Giraud subcategories of Mod(R). In this paper we prove a result
   analogous to the one given by Gabriel: for a small preadditive category
   C, there exists a bijective correspondence between the left Gabriel
   filters of C and Giraud subcategories of Mod(C).},
