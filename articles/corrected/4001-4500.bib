@article{ WOS:000634505300019,
Author = {Mireles-Velazquez, Daniel and Itzel Rosales-Contreras, Gloria and Andres
   Conejeros-Vargas, Carlos and Alonso Solis-Marin, Francisco and
   Granja-Fernandez, Rebeca},
Title = {Ophiuroids (Echinodermata: Ophiuroidea) from Chamela bay, Jalisco,
   Mexico},
