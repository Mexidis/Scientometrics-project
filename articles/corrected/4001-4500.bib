@article{ WOS:000604096600001,
Author = {Dominguez, P. and Sienra, G. and Hernandez, I.},
Title = {Dynamics of a Family of Meromorphic Functions with Two Essential
   Singularities Which Are Not Omitted Values},
Journal = {QUALITATIVE THEORY OF DYNAMICAL SYSTEMS},
Year = {2021},
Volume = {20},
Number = {1},
Month = {APR},
Abstract = {In this article we investigate the dynamics of the family
   F-lambda,F-c,F-mu(z) = lambda e(1/(z2+c)) + mu, where lambda, c is an
   element of C\textbackslash{}\{0\} and mu is an element of
   C\textbackslash{}\{+/- i root c\}, with two essential singularities
   which are not omitted values. Choosing a slice of the space of
   parameters, we prove that for certain parameters lambda, c and mu, the
   Fatou set contains a completely invariant and multiply connected
   attracting domain, a parabolic domain and a Siegel disc. Moreover, we
   prove that the triple (F-lambda,F-c,F-mu, U, V) is a polynomial-like
   mapping of degree two for certain values of the parameters lambda, c,
   mu, and some domains U and V. Also, some examples of the Fatou and Julia
   sets for the polynomial-like mapping are given.},
