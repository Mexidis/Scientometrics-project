@article{ WOS:000629112500001,
Author = {Ferreira, Aila Soares and Arango, Angela and Palacios-Vargas, Jose G.},
Title = {Two New Species of Sminthurides Borner, 1900 (Collembola:
   Sminthurididae) from Mexico with Comments on the Genus and a Key to the
   Members from the Americas},
Journal = {NEOTROPICAL ENTOMOLOGY},
Year = {2021},
Volume = {50},
Number = {3},
Pages = {408-429},
Month = {JUN},
Abstract = {A survey of Sminthurides Borner, 1900 with specimens from the Americas
   was performed and two new species from Mexico are described and
   illustrated (drawings and SEM photographs), including a detailed study
   of body chaetotaxy. Sminthurides cihuatlensissp. nov. is part of the
   Aquaticus group by the presence of ciliate seta B1 on Ant. II; it has a
   narrow mucro and lives in soil from the slopes of Iztaccihuatl volcano.
   Sminthurides fridakahloaesp. nov. belongs to the Penicillifer group by
   the presence of Tra-2 on the Ant. II; it has a broad, trilamellate
   mucro, dens with plurichaetosis, and lives on surface freshwater from
   Colima and Morelos states. In addition, a key for the species is
   provided.},
