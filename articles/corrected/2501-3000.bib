Title = {Global age-sex-specific mortality, life expectancy, and population
   estimates in 204 countries and territories and 811 subnational
   locations, 1950-2021, and the impact of the COVID-19 pandemic: a
   comprehensive demographic analysis for the Global Burden of Disease
   Study 2021},
