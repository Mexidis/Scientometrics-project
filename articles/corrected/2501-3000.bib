@article{ WOS:001099807100001,
Author = {Medina-Barcenas, Mauricio and Rincon Mejia, Hugo},
Title = {m-Baer and m-Rickart Lattices},
Journal = {ORDER-A JOURNAL ON THE THEORY OF ORDERED SETS AND ITS APPLICATIONS},
Year = {2024},
Volume = {41},
Number = {3},
Pages = {643-670},
Month = {DEC},
Abstract = {In this paper we introduce the notions of Rickart and Baer lattices and
   their duals. We show that part of the theory of Rickart and Baer modules
   can be understood just using techniques from the theory of lattices.
   For, we use linear morphisms introduced by T. Albu and M. Iosif. We
   focus on a submonoid with zero m of the monoid of all linear
   endomorphism of a lattice L in order to give a more general approach and
   apply our results in the theory of modules. We also show that m-Rickart
   and m-Baer lattices can be characterized by the annihilators in m
   generated by idempotents as in the case of modules.},
Publisher = {SPRINGER},
Address = {VAN GODEWIJCKSTRAAT 30, 3311 GZ DORDRECHT, NETHERLANDS},
