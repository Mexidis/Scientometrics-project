   Mascaro, Maite; Simoes, Nuno, Univ Nacl Autonoma Mexico, Fac Ciencias, Unidad Multidisciplinaria Docencia \& Invest Sisal, Sisal, Mexico.},
DOI = {10.1111/jwas.13076},
EarlyAccessDate = {MAY 2024},
ISSN = {0893-8849},
EISSN = {1749-7345},
Keywords = {bioeconomics; growth; H. erectus; profits; survival},
