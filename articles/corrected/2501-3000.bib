@article{ WOS:001215080800001,
Author = {Bowen, Matt and Hansberg, Adriana and Montejano, Amanda and Muyesser,
   Alp},
Title = {Colored unavoidable patterns and balanceable graphs},
Journal = {ELECTRONIC JOURNAL OF COMBINATORICS},
Year = {2024},
Volume = {31},
Number = {2},
Month = {MAY 3},
Abstract = {We study a Tur \& aacute;n-type problem on edge -colored complete
   graphs. We show that for any r and t, any sufficiently large r -edge
   -colored complete graph on n vertices with ohm(n2-1/trr) edges in each
   color contains a member from a certain finite family Ftrof r -edge
   -colored complete graphs. Next, we study a related problem where the
   corresponding Tur \& aacute;n threshold is linear. We call an edge
   -coloring of a path with rk edges balanced if each color appears k times
   in the coloring. We show that any 3 -edge -coloring of a large complete
   graph with kn + o(n) edges in each color contains a balanced P3k. This
   is tight up to a constant factor of 2. For more colors, the problem
   becomes surprisingly more delicate. Already for r = 7, we show that even
   n2-o(1) edges from each color do not guarantee the existence of a
   balanced path on 7k edges.},
