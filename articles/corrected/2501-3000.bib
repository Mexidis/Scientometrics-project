Month = {APR 23},
Abstract = {Two new species and a subspecies, Emesis ( Aphacites ) hypoaithos,
   Callaghan, Trujano-Ortega \& R \& iacute;os-M \& aacute;laver, sp. nov.,
   , Emesis ( Aphacites ) hypoaithos ochros, , Callaghan, Trujano-Ortega \&
   R \& iacute;os-M \& aacute;laver, ssp. nov., , Emesis ( Tenedia ) pacis,
   Callaghan, Trujano-Ortega \& R \& iacute;os-M \& aacute;laver, sp. nov.
   are described from Northwestern South and Central America. The biology,
   habits, habitat, and distribution of these taxa are described from
   museum specimens and field observations. Male and female genitalia of
   the new taxa are illustrated and compared with similar taxa for proper
   identification.},
