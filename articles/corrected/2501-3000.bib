@article{ WOS:001363160700011,
Author = {Aizencang-Kane, Perla},
Title = {Digital Diaspora: a New Conceptual Dimension},
Journal = {REVISTA MEXICANA DE CIENCIAS POLITICAS Y SOCIALES},
