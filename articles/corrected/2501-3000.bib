Title = {Metazoan parasites of the Ocellated killifish, Floridichthys
   polyommus (Cyprinodontidae) in La Carbonera coastal lagoon,
   Yucat<acute accent>an, Mexico},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
