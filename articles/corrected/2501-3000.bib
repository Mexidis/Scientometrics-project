Title = {Pioneering role of RNA in the early evolution of life},
Journal = {GENETICS AND MOLECULAR BIOLOGY},
Year = {2024},
Volume = {47},
Number = {1},
Abstract = {The catalytic, regulatory and structural properties of RNA, combined
   with their extraordinary ubiquity in cellular processes, are consistent
   with the proposal that this molecule played a much more conspicuous role
   in heredity and metabolism during the early stages of biological
   evolution. This review explores the pivotal role of RNA in the earliest
   life forms and its relevance in modern biological systems. It examines
   current models that study the early evolution of life, providing
   insights into the primordial RNA world and its legacy in contemporary
   biology.},
