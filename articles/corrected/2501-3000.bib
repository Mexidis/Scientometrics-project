@article{ WOS:001137426800001,
Author = {Villasenor-Amador, Damian and Janda, Milan and Rosas-Mejia, Madai and
   Sandoval-Becerra, Fatima Magdalena and Morrone, Juan J.},
Title = {Leaf litter weevil richness increases with elevation in a
   tropical-temperate transitional forest in El Cielo Biosphere Reserve,
   northeastern Mexico},
Journal = {BIOTROPICA},
Year = {2024},
Volume = {56},
Number = {2},
Month = {MAR},
Abstract = {We studied communities of leaf litter weevils along a 2000 m elevation
   gradient in El Cielo Biosphere Reserve, northeastern Mexico, an area
   where Nearctic and Neotropical biotas overlap. After achieving high
   inventory completeness (0.922 site sample coverage), we encountered 81
   weevil morphospecies, of which 55 were known to be leaf litter
   specialists. The diversity of leaf litter weevils increased with
   elevation. Beta diversity across the elevational gradient was mostly
   explained by species turnover rather than nestedness. The interaction
   between forest structure (measured as median DBH of trees) and
   precipitation seasonality explained more than 20\% of the variation in
   weevil species richness: weevil richness showed a negative relationship
   with tree DBH and was positively associated with low climate seasonality
   variation, characteristics of tropical montane cloud forests. In
   contrast with insect taxa such as ants and dung beetles, which attain
   their highest richness at lower elevations, leaf litter weevil richness
   peaked at 1600 m. These results suggest that most litter weevil species
   are highly associated with a particular elevation range and the overall
   pattern of richness increasing with elevation is probably the result of
   an association of many weevil species with tropical montane cloud forest
   habitats, which occur close to the top of the mountain.Abstract in
   Spanish is available with online material.
   Se estudiaron comunidades de gorgojos (Coleoptera: Curculionidae) de la
   hojarasca a lo largo de un gradiente altitudinal de 2000 m en la Reserva
   de la Biosfera El Cielo, Mexico. Una zona donde se empalman biotas
   Neartica y Neotropical. Se obtuvo una alta completitud del inventario
   (0.922 cobertura de la muestra), se encontraron 81 morfoespecies de
   gorgojos, de las cuales 55 fueron especialistas en hojarasca. La
   diversidad de gorgojos de la hojarasca incremento con la altitud. La
   diversidad beta en el gradiente altitudinal se explico principalmente
   por el recambio de especies en lugar del anidamiento. La interaccion
   entre la estructura del bosque (medida como la mediana del diametro a la
   altura del pecho de los arboles) y la estacionalidad de las lluvias,
   explico mas del 20\% de la variacion en la riqueza de especies de
   gorgojos. La riqueza taxonomica mostro una relacion negativa con el
   diametro de los troncos de los arboles y estuvo positivamente asociada
   con una baja variacion en la estacionalidad de las lluvias,
   caracteristicas de los bosques de niebla tropicales de montana. En
   contraste con otros insectos como hormigas y escarabajos estercoleros,
   que alcanzan su mayor riqueza taxonomica en elevaciones bajas, la
   riqueza de gorgojos de la hojarasca alcanzo su maximo a los 1600 m.
   Estos resultados sugieren que la mayoria de las especies de gorgojos de
   la hojarasca estan altamente asociados a un rango de elevacion
   delimitado. El patron general de incremento de la riqueza con la
   elevacion es el resultado de una asociacion de multiples especies de
   gorgojos con habitats de bosques de niebla tropicales de montana, los
   cuales se encuentran cerca de la cima de la montana.
   In a mountain in northeastern Mexico, leaf litter weevil richness
   increased with elevation peaking in a tropical montane cloud forest
   habitat. This pattern is unlike many invertebrate groups, whose species
   richness decreases with elevation. Our study highlights the need to
   further study under-researched insect taxa, to better comprehend
