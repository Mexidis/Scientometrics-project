@article{ WOS:001187274500001,
Author = {Castro, Carlos Daniel Tamayo and Reyes, Juan Bory and Blaya, Ricardo
   Abreu},
Title = {Reduction procedure for obtaining solutions of the scalar additive Jump
   problem and Riemann boundary value problem in vectorial Clifford
   analysis},
Journal = {MATHEMATICAL METHODS IN THE APPLIED SCIENCES},
Year = {2024},
Volume = {47},
Number = {11},
Pages = {8611-8625},
Month = {JUL 30},
Abstract = {In this paper, we study existence of solutions to the scalar additive
   Jump problem and the Riemann boundary value problems in the context of
