@article{ WOS:001116520000001,
Author = {Salcedo, Roberto and Molina, Bertha and Vargas, Jaquebet and Rios,
   Citlalli},
Title = {The scandium organometallic behavior. Design of a chamber of reaction to
   trap CO2},
Journal = {COMPUTATIONAL AND THEORETICAL CHEMISTRY},
Year = {2023},
Volume = {1230},
Month = {DEC},
Abstract = {Scandium has shown it can interact with aromatic rings in eta 5 or eta 1
   fashion, in this work both possibilities are studied by means DFT
   methods and the properties of the resultant structures are exploited for
   the design of a reaction chamber. Interestingly, according to our first
   results analyzed, the origin of this chamber is an organometallic
   complex which bears two eta 4-Cp and one eta 1-benzene unities. From the
   frontier molecular orbitals and AIM analysis we inferred that this last
   bond can be described as a a dative bond C-Sc. Whit base on AIM and NBO
   analysis, the association of six of these species gives place to a
   complex containing two cavities, where an electron density coming from
   the acetylene fragments in the wall of the chamber can conform a
   reactive zone, that due to its properties is studied with the aim to
   trap CO2 and H2 in order to produce formic acid. Thermodynamic and
   kinetic results predict that this reaction can occur with an activation
   energy of 24.79 Kcal/mol and energy of reaction of -7.05 kcal/mol.},
