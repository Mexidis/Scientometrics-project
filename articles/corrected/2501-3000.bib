@article{ WOS:001091328200001,
Author = {Severiano-Perez, Patricia and Cristians, Sol and Bye, Robert and
   Lucas-Florentino, Bernardo and Ramirez-Orejel, Juan Carlos and Linares,
   Edelmira and Mera-Ovando, Luz Maria and Castro-Lara, Delia and
   Enriquez-Maldonado, Daniel and Rodriguez-Servin, Joel and
   Gonzalez-Pedroza, Maria de Guadalupe and Escalante-Martinez, Viridiana
   and del Valle, Jose Emiliano Palma Perez and Mendoza-Cruz, Myrna and
   Nevarez-Duran, Alejandro and Silvestre-Lara, Perla},
Title = {Quelites Pasados of the Sierra Tarahumara, Chihuahua, Mexico: An
   Interdisciplinary Ethnobotanical Study of Leafy Green Vegetables},
Journal = {ECONOMIC BOTANY},
Year = {2023},
Volume = {77},
Number = {4},
Pages = {433-454},
Month = {DEC},
Abstract = {Leafy green vegetables have been a part of human diets throughout human
   history. Globally, they are gaining recognition since these wild foods
   could play an important role in food security. Quelites (the Mexican
   term for these resources) are dehydrated to produce ``quelites
   pasados{''} by the Raramuri in anticipation of the scarcity of food in
   winter. The diversity of quelites in the state of Chihuahua includes
   species of the widely consumed Amaranthus, as well as endemic, native,
   and introduced species that are eaten locally. The present work
   generated nutritional, sensory, and molecular information on four
   species that are consumed in the Sierra Tarahumara: Amaranthus palmeri,
   Amaranthus powellii, Arracacia edulis, and Phacelia platycarpa. Their
   nutritional analysis exhibited high protein values and a significant
   concentration of macro- and micronutrients. The acceptance by the public
   of the species of Amaranthus was high, while that of Arracacia edulis
   and Phacelia platycarpa was lower. Because of the morphological
   similarity within the two pairs of quelites, their DNA barcodes were
   generated as an identification tool which, together with the nutritional
   and sensory results, provides added value to the four ``quelites
   pasados{''} of the Sierra Tarahumara. This study could be considered a
   starting point for sustainable use of native vegetables in future
   economic programs of regional agrobiodiversity, and even replicated
   globally.
   Las verduras de hoja verde han sido una parte importante de la dieta
   humana que estan ganando reconocimiento a nivel global, ya que estos
   recursos silvestres podrian jugar un papel importante en la seguridad
   alimentaria. Los quelites (el termino en nahuatl para planta tierna
   comestible) son deshidratados por los raramuri para producir quelites
   pasados como prevision de la escasez de alimentos en invierno. La
   diversidad de quelites en el estado de Chihuahua incluye especies de
   gran consumo, como el amaranto, asi como especies endemicas, nativas e
   introducidas que se comen localmente. El presente trabajo genero
   informacion nutricional, sensorial y molecular de cuatro especies que se
   consumen en la Sierra Tarahumara: Amaranthus palmeri, Amaranthus
   powellii, Arracacia edulis y Phacelia platycarpa. Su estudio nutricional
   exhibio altos valores de proteina y una concentracion significativa de
   macro- y micronutrientes. La aceptacion por parte del publico en general
   de las especies de Amaranthus fue alta, mientras que la de Arracacia
   edulis y Phacelia platycarpa fue menor. Debido a la similitud
   morfologica entre los dos pares de quelites analizados, se generaron sus
   codigos de barras moleculares como una herramienta de identificacion
   que, junto con los resultados nutricionales y sensoriales, brindan un
   valor agregado a los cuatro quelites pasados de la Sierra Tarahumara.
   Este estudio podria considerarse un punto de partida para el uso
   sostenible de vegetales nativos en futuros programas economicos de la
   agrobiodiversidad regional, e incluso replicarse a nivel mundial.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {Cristians, S; Bye, R (Corresponding Author), Univ Nacl Autonoma Mexico, Inst Biol, Mexico City, Mexico.
   Severiano-Perez, Patricia; Lucas-Florentino, Bernardo; Gonzalez-Pedroza, Maria de Guadalupe, Univ Nacl Autonoma Mexico, Fac Quim, Mexico City, Mexico.
   Cristians, Sol; Bye, Robert; Linares, Edelmira; Mendoza-Cruz, Myrna, Univ Nacl Autonoma Mexico, Inst Biol, Mexico City, Mexico.
   Ramirez-Orejel, Juan Carlos, Univ Nacl Autonoma Mexico, Fac Med Vet \& Zootecnia, Mexico City, Mexico.
