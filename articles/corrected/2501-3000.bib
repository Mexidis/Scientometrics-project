@article{ WOS:001107793900001,
Author = {Rios-Lopez, Diana G. and Tecalco-Cruz, Angeles C. and Martinez-Pastor,
   David and Sosa-Garrocho, Marcela and Tapia-Urzua, Gustavo and
   Aranda-Lopez, Yuli and Ortega-Dominguez, Bibiana and Recillas-Targa,
   Felix and Vazquez-Victorio, Genaro and Macias-Silva, Marina},
Title = {TGF-β/SMAD canonical pathway induces the expression of transcriptional
   cofactor TAZ in liver cancer cells},
Journal = {HELIYON},
Year = {2023},
Volume = {9},
Number = {11},
Month = {NOV},
Abstract = {The TGF-beta and Hippo pathways are critical for liver size control,
   regeneration, and cancer progression. The transcriptional cofactor TAZ,
   also named WWTR1, is a downstream effector of Hippo pathway and plays a
   key role in the maintenance of liver physiological functions. However,
   the up-regulation of TAZ expression has been associated with liver
   cancer progression. Recent evidence shows crosstalk of TGF-beta and
   Hippo pathways, since TGF-beta modulates TAZ expression through
   different mechanisms in a cellular context-dependent manner but
   supposedly independent of SMADs. Here, we evaluate the molecular
   interplay between TGF-beta pathway and TAZ expression and observe that
   TGF-beta induces TAZ expression through SMAD canonical pathway in liver
   cancer HepG2 cells. Therefore, TAZ cofactor is a primary target of
   TGF-beta/SMAD-signaling, one of the pathways altered in liver cancer.},
