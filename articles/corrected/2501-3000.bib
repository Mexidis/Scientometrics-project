@article{ WOS:001231083600005,
Author = {Higueras-Montano, Luisa F. and Jonard-Perez, Natalia},
Title = {A TOPOLOGICAL INSIGHT INTO THE POLAR INVOLUTION OF CONVEX SETS},
Journal = {ISRAEL JOURNAL OF MATHEMATICS},
Year = {2024},
Volume = {263},
Number = {1},
Pages = {437-474},
Month = {OCT},
Abstract = {Denote by Kn0 the family of all closed convex sets A. Rn containing the
   origin 0. Rn. For A. Kn0, its polar set is denoted by A.. In this paper,
   we investigate the topological nature of the polar mapping A. A. on
   (Kn0, dAW), where dAW denotes the Attouch-Wets metric. We prove that
   (Kn0, dAW) is homeomorphic to the Hilbert cube Q = 8 i=1 {[}- 1, 1] and
   the polar mapping is topologically conjugate with the standard
   based-free involution s : Q. Q, defined by s(x) = - x for all x. Q. We
   also prove that among the inclusion-reversing involutions on Kn0 (also
   called dualities), those and only those with a unique fixed point are
   topologically conjugate with the polar mapping, and they can be
   characterized as all the maps f : Kn0. Kn0 of the form f(A) = T(A.),
   with T a positive-definite linear isomorphism of Rn.},
