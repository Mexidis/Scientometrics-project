@article{ WOS:001186098000002,
Author = {Santos-Lopez, F. J. and Martinez, J. R. and Lobo-Guerrero, A. and
   Marquina, M. L. and Mazariego, J. L. Perez and Aranda-Espinoza, S. and
   Garcia-Gallegos, J. H.},
Title = {Remanence properties and Mössbauer analysis of the strontium hexaferrite
   with copper deposited by sputtering},
Journal = {JOURNAL OF MATERIALS SCIENCE},
Year = {2024},
Volume = {59},
Number = {15},
Pages = {6425-6435},
Month = {APR},
Abstract = {In this work, the remanence properties and the hyperfine parameters of
   the strontium hexaferrite were investigated when a copper layer was
   deposited on its surface using magnetron sputtering. The magnetic
   properties and maximum energy product were significantly improved after
   the copper was deposited on the hexaferrite. The magnetic interactions
   were studied using IRM and DCD remanent magnetization processes and by
   the construction of the Henkel plots and the delta M curves which
   allowed us to assess the effect of copper on the observed enhancement of
   the magnetic properties. X-ray diffraction confirms the copper
   deposition while scanning electron microscopy shows a homogeneous
   deposited layer. The Mossbauer spectroscopy was used to analyze the
   effect of copper on the hyperfine parameters of the iron nuclei. Results
   showed a competition between the magnetizing-like and the
   demagnetizing-like interactions in the uncoated hexaferrite. However,
   the strength of the demagnetization-like interaction is significantly
   weakened because of the copper layer deposited on the hexaferrite
   surface. This behavior suggests the emergence of a magnetic coupling
   with a magnetizing effect. In addition, the Mossbauer analysis revealed
   that copper increased the hyperfine fields and strongly affected the
   electronic cloud of the 4fI and 2a iron sites.},
