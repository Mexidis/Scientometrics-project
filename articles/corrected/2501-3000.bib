Title = {Chapter 2: What Is Life?},
Journal = {ASTROBIOLOGY},
Year = {2024},
Volume = {24},
Number = {1},
Pages = {S40-S56},
Month = {MAR 1},
Abstract = {The question ``What is life?{''} has existed since the beginning of
   recorded history. However, the scientific and philosophical contexts of
   this question have changed and been refined as advancements in
   technology have revealed both fine details and broad connections in the
   network of life on Earth. Understanding the framework of the question
   ``What is life?{''} is central to formulating other questions such as
   ``Where else could life be?{''} and ``How do we search for life
   elsewhere?{''} While many of these questions are addressed throughout
   the Astrobiology Primer 3.0, this chapter gives historical context for
   defining life, highlights conceptual characteristics shared by all life
   on Earth as well as key features used to describe it, discusses why it
   matters for astrobiology, and explores both challenges and opportunities
   for finding an informative operational definition.},
