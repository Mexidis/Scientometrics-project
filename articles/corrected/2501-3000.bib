@article{ WOS:001363160700005,
Author = {Martinez, Khemvirg Puente},
Title = {Origin and Development of Legislative Studies: Topics, Schools and
   Trends},
Journal = {REVISTA MEXICANA DE CIENCIAS POLITICAS Y SOCIALES},
Year = {2024},
Volume = {69},
Number = {252},
Pages = {49-86},
Month = {SEP-DEC},
Abstract = {Legislative Studies is a sub-discipline of the social sciences that aims
   to analyze parliamentary behavior through diverse methodological
   strategies and approaches. This paper offers a general overview of the
   origins, development, and contemporary debates surrounding the study of
   political representation and legislative performance. It also explores
   the academic collaboration spaces that have fostered the consolidation
   of specialized legislative research. Finally, it highlights some of the
   key challenges for this field, such as theoretical and methodological
   limitations, narrow disciplinary perspectives, limited relevance for
   institutional reform and decision-making utility, the need for
   comparative studies and more visibility.},
Publisher = {UNAM, FAC CIENCIAS POLITICAS \& SOCIALES},
