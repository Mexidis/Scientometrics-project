@article{ WOS:001180238700007,
Author = {Lahnstein, Ana I. Benavides and Chi, Arely A. Paredes and Vazquez,
   Ameyalli Rios and Galindo-De Santiago, Maria del Carmen and Khatun,
   Kaysara and Delfin, Erika Vazquez and Robinson, Lucy and Brodie, Juliet
   and Wardlaw, Jessica},
Title = {Not Everything is Sargassum: Learning from a Marine-Coastal Citizen
   Science Project},
Journal = {ENSENANZA DE LAS CIENCIAS},
Year = {2024},
Volume = {42},
Number = {1},
Abstract = {center dot The effects of the abundant arrival of macroalgae, such as
   Sargassum, to the Yucatan Peninsula motivated the monitoring of beach
   -cast seaweeds through a citizen science project aimed at affected and
   interested populations. Questionnaires and semi -structured interviews
   were employed to analyse the learning outcomes of 18 participants (16 to
   18 years) in the project's first stage. Among the findings, the
   interrelation of new disciplinary learning about macroalgae and skills
   for fieldwork stood out. Participants showed renewed and positive
   attitudes toward science and beach -cast seaweeds. We reflect on which
   factors drove their learning and research skills when addressing the
   scientific objectives, including the relevance of the problem, the
   introductory workshop, and the socialisation between the scientists
   involved and the participants.},
