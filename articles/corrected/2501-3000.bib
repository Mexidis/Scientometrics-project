Month = {JUN 18},
Abstract = {Tzeltalia graciellae (Solanaceae), a new species from the states of
   Guerrero and Oaxaca, Mexico, is described and illustrated. This species
   is related to T. esenbeckii, but can be distinguished by its
   (4-)6-10(-11) flowers per fascicle, pedicels 10-16 mm long, spherical
   fruit calyx 4.5-7 mm long, fruits 3-6 mm in diameter, and entire leaf
   margins. A detailed comparison table, a key to the known species of
   Tzeltalia, and photographic illustrations are provided.},
