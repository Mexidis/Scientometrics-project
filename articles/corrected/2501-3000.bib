Pages = {941-967},
Month = {NOV},
Abstract = {We address some phenomena about the interaction between lower
   semicontinuous submeasures on N and F-sigma ideals. We analyze the
   pathology degree of a submeasure and present a method to construct
   pathological F-sigma ideals. We give a partial answers to the question
   of whether every nonpathological tall Fs ideal is Kat.etov above the
   random ideal or at least has a Borel selector. Finally, we show a
   representation of nonpathological F-sigma ideals using sequences in
   Banach spaces.},
