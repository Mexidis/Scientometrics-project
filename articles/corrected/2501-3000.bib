Title = {Ion-induced surface effects on soda-lime, amorphous silica
   (aSiO2) and silicon (100) substrates with 1.5 MeV Cu ion
   implantation},
Journal = {NUCLEAR INSTRUMENTS \& METHODS IN PHYSICS RESEARCH SECTION B-BEAM
   INTERACTIONS WITH MATERIALS AND ATOMS},
Year = {2024},
Volume = {550},
Month = {MAY},
Abstract = {Soda-lime, silica and silicon (100) substrates were implanted with 1.5
   MeV Cu+ ions with observable macroscopic surface effects. All substrates
   were irradiated at 70 degrees, at 200-nA currents, in room temperature
   conditions, and for a total ion fluence between 3x10(16) and 2x10(17)
   ions cm(-2). Surface characterization was carried out using SEM and AFM.
   Changes on the morphology result in the emergence of surface structures
   resembling ripples in the early stage which evolve into complex
   wrinkling structures at high ion doses. The formation and growth of
   surface patterns may be elucidated in terms of low and medium energies
   theories.},
