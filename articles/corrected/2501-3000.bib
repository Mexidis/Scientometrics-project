@article{ WOS:001265632900004,
Author = {Martinez-pedroza, Eduardo and Sanchez Saldana, Luis Jorge},
Title = {Bowditch Taut Spectrum and Dimensions of Groups},
Journal = {MICHIGAN MATHEMATICAL JOURNAL},
