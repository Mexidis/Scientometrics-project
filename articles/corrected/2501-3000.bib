@article{ WOS:001074496500001,
Author = {Pardo-Guerra, Sebastian and Rincon-Mejia, Hugo A. and Zorrilla-Noriega,
   Manuel G. and Gonzalez-Bayona, Francisco},
Title = {On the lattice of conatural classes of linear modular lattices},
Journal = {ALGEBRA UNIVERSALIS},
Year = {2023},
Volume = {84},
Number = {4},
Month = {NOV},
Abstract = {The collection of all cohereditary classes of modules over a ring R is a
   pseudocomplemented complete big lattice. The elements of its skeleton
   are the conatural classes of R-modules. In this paper we extend some
   results about cohereditary classes in R-Mod to the category L-M of
   linear modular lattices, which has as objects all complete modular
   lattices and as morphisms all linear morphisms. We introduce the big
   lattice of conatural classes in L-M, and we obtain some results about
   it, paralleling the case of R-Mod and arriving at its being boolean.
   Finally, we prove some closure properties of conatural classes in L-M.},
