@inproceedings{ WOS:001429153800052,
Author = {Al-Jarah, Ahmed Imad Hammoodi and Ortega Arjona, Jorge Luis},
Editor = {Paul, R and Kundu, A},
Title = {A parallel steganography algorithm using a new secret key generation},
Booktitle = {2024 IEEE 15TH ANNUAL UBIQUITOUS COMPUTING, ELECTRONICS \& MOBILE
   COMMUNICATION CONFERENCE, UEMCON},
Year = {2024},
Pages = {356-365},
Note = {15th Ubiquitous Computing Electronics and Mobile Communication
   Conference, Yorktown Heights, NY, OCT 17-19, 2024},
Abstract = {Computation has mostly used parallelism for high-performance
   computation, and multicore processors have gained popularity because
   they offer better processing time. However, one of the most challenging
   tasks to achieve is securely exchange confidential data over the network
   between sender and receiver. The research work in this paper explains
   how secret key steganography, combined with parallel processing, is
   utilized to conceal secret data within an image. The proposed algorithm
   describes and focuses on the generation method of a secret key while
   merging it with the Least Significant Bit (LSB) algorithm to achieve
   robustness, as well as parallel computing to improve the processing time
   in both the encoding/decoding phases. The proposed algorithm adds
   another layer of security by adding a robustness parameter (secret key),
   convenient for keeping secret, confidential, and crucial data. Parallel
   processing, combined with the new method to formulate the secret key is
   the novelty and strongest attribute of the proposed algorithm. When
   parallel computing is applied, the process speeds up compared with the
   same algorithm in the sequential version. The results are compared with
   the LSB algorithm in terms of the peak signal to noise ratio (PSNR) and
   mean square error (MSE) values, aspiring to present that the proposed
   algorithm adds robustness without affecting image imperceptibility.},
