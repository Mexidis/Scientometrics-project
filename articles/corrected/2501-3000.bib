@article{ WOS:001280619800001,
Author = {Bonaldo, Alexandre B. and Galan-Sanchez, M. Antonio and Garcia, Fabian},
Title = {Advances on the taxonomy of Megalostrata Karsch, 1880 (Araneae,
   Corinnidae, Corinninae), with descriptions of two new species},
Journal = {ZOOTAXA},
Year = {2024},
Volume = {5458},
Number = {4},
Pages = {495-523},
Month = {MAY 30},
Abstract = {Two new species of Megalostrata Karsch, 1880 are described: M. paludosa
   spec. nov. based on male and female specimens gathered in mangrove
   swamps in the Colombian Caribbean, and M. pacifica spec. nov., based on
   a female specimen from Heredia, Costa Rica. Megalostrata monistica
   (Chamberlin, 1924) from the Mexican west coast is redescribed, M.
   bruneri (Bryant, 1936) from the Island of Cuba is re-diagnosed based on
   photographs of the holotype, and the female of M. depicta (O.
   Pickard-Cambridge, 1895) from Southeast Mexico is described for the
   first time. The known range of M. raptor (L. Koch, 1866), which was
   previously known from the Central American mainland, is extended to Cura
   \& ccedil;ao, Caribbean Netherlands. A distribution map and key to the
   six known species of Megalostrata are also provided.},
